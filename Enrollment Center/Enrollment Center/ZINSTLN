BEGIN_METHOD GETRECORDERCODE CHANGING CONTAINER.
************************************************************************
* Created by  : Judy Jarone
* Created on  : 05/14/2007
* Description : Determine reconnect order code.  Assumption is a meter
************************************************************************
* Changed by  : Gilbert Chong
* Change date : 07/25/2007
* Description : Collection of error messages
************************************************************************
CONSTANTS: C_DISCON_STATUS TYPE EDISCDOC-STATUS VALUE '21',
           C_MARKED        TYPE C VALUE 'X'.
DATA:
  LV_HARDSHIPFLAG TYPE ZTFO_REC_ORD_CD-HARDSHIP_FLAG,
  MOVEINONLY      TYPE REGEN-KENNZX,
  HARDSHIPFLAG    TYPE EBAGEN-ACTSTAT,
  ORDERCODEDTLS   TYPE ZTFO_REC_ORD_CD,
*     lv_discdocstatus TYPE ediscdoc-status,
  LV_INSTSTATUS   TYPE EDISCOBJ-DISCSTATE,
*     o_discdoc        TYPE swc_object OCCURS 0,
  LV_DISCNO       TYPE EDISCDOC-DISCNO,
  O_DIVISION      TYPE SWC_OBJECT,
  O_CONTRACT      TYPE SWC_OBJECT OCCURS 0,
  WA_CONTRACT     TYPE SWC_OBJECT,
  WA_DISCDOC      TYPE SWC_OBJECT,
  I_CONTAINER     TYPE TABLE OF SWCONT,
  LV_DISCTYPE     TYPE EDISCPOS-DISCTYPE,
  LV_DIVISION     TYPE TSPA-SPART,
  LV_DISCREASON   TYPE EDISCDOC-DISCREASON,
  LV_DUNNING_FLAG TYPE KENNZX,
  LV_MOVEIN_DATE  TYPE EVER-EINZDAT.
DATA : WA_ERR_MSG TYPE ZSFO_BAL_MSG,
       IT_ERR_MSG TYPE STANDARD TABLE OF ZSFO_BAL_MSG.
DATA : L_V_ANLAGE TYPE ANLAGE.
SWC_GET_OBJECT_KEY SELF L_V_ANLAGE.
SWC_GET_TABLE CONTAINER 'ErrMsg' IT_ERR_MSG.

SWC_GET_ELEMENT CONTAINER 'HardshipFlag' HARDSHIPFLAG.
SWC_GET_ELEMENT CONTAINER 'MoveInOnly' MOVEINONLY.
* swc_get_property self 'DiscDocStatus' lv_discdocstatus. "ADE

* CHECK lv_discdocstatus = c_discon_status. "ADE

SWC_GET_PROPERTY SELF 'Division' O_DIVISION.
SWC_GET_PROPERTY O_DIVISION 'Division' LV_DIVISION.
* swc_get_table_property self 'ActDisconnectionDocuments' o_discdoc."ADE
SWC_GET_TABLE_PROPERTY SELF 'CurrentContract' O_CONTRACT.
CASE HARDSHIPFLAG.
  WHEN '2'.
    MOVE C_MARKED TO LV_HARDSHIPFLAG.
  WHEN OTHERS.
    CLEAR LV_HARDSHIPFLAG.
ENDCASE.
* Start of commenting by ADE
* Loop at each disc activity for the one we want.
*LOOP AT o_discdoc INTO wa_discdoc.
*  swc_get_property wa_discdoc 'State' lv_discdocstatus.
** In the event that more than one disconnect doc exist perform the
** following check to ensure the status of 21.
*  CHECK lv_discdocstatus = c_discon_status.
*  swc_set_element container 'CURRDISCDOC' wa_discdoc.
** Get the reconnect reason
*  swc_get_property wa_discdoc 'Reason' lv_discreason.
*  CLEAR lv_dunning_flag.
** check if the reconnect should be dunning related.
*  IF lv_discreason = '01' AND moveinonly IS INITIAL.
*    LOOP AT o_contract INTO wa_contract.
*      swc_get_property wa_contract 'MoveInDate' lv_movein_date.
*      IF lv_movein_date < sy-datum.
*        MOVE 'X' TO lv_dunning_flag.
*        EXIT.
*      ENDIF.
*    ENDLOOP.
*  ENDIF.
**   Get the reconnect order type.
*  swc_set_element i_container 'Installation' object-key.
*  swc_call_method wa_discdoc 'DetermineDiscType' i_container.
*  swc_get_element i_container 'DiscType' lv_disctype.
*  SELECT * INTO ordercodedtls
*    FROM ztfo_rec_ord_cd UP TO 1 ROWS
*      WHERE hardship_flag = lv_hardshipflag
*        AND dunning_flag  = lv_dunning_flag
*        AND sparte        = lv_division
*        AND discreason    = lv_discreason
*        AND disctype      = lv_disctype.
*  ENDSELECT.
*  IF sy-subrc = 0.
*    EXIT.
*  ENDIF.
*ENDLOOP.
* End of commenting by ADE
CALL FUNCTION 'Z_GET_INSTLN_DISCON_STATUS'
  EXPORTING
    X_ANLAGE       = L_V_ANLAGE
  IMPORTING
    Y_STATUS       = LV_INSTSTATUS
    Y_DISCNO       = LV_DISCNO
  EXCEPTIONS
    INTERNAL_ERROR = 1
    OTHERS         = 2.
IF SY-SUBRC <> 0.
  MOVE :  SY-MSGID TO WA_ERR_MSG-MSGID,
          SY-MSGNO TO WA_ERR_MSG-MSGNO,
          SY-MSGTY TO WA_ERR_MSG-MSGTY,
          SY-MSGV1 TO WA_ERR_MSG-MSGV1,
          SY-MSGV2 TO WA_ERR_MSG-MSGV2,
          SY-MSGV3 TO WA_ERR_MSG-MSGV3,
          SY-MSGV4 TO WA_ERR_MSG-MSGV4.
  APPEND WA_ERR_MSG TO IT_ERR_MSG.
  SWC_SET_TABLE CONTAINER 'ErrMsg' IT_ERR_MSG.
  EXIT_RETURN 9002 SPACE SPACE SPACE SPACE.
ENDIF.

CHECK LV_INSTSTATUS = '03'. "Disconnection order generated

SWC_CREATE_OBJECT WA_DISCDOC 'DISCONNECT' LV_DISCNO.
SWC_SET_ELEMENT CONTAINER 'CURRDISCDOC' WA_DISCDOC.

* Get the reconnect reason
SWC_GET_PROPERTY WA_DISCDOC 'Reason' LV_DISCREASON.
CLEAR LV_DUNNING_FLAG.
* check if the reconnect should be dunning related.
IF LV_DISCREASON = '01' AND MOVEINONLY IS INITIAL.
  LOOP AT O_CONTRACT INTO WA_CONTRACT.
    SWC_GET_PROPERTY WA_CONTRACT 'MoveInDate' LV_MOVEIN_DATE.
    IF LV_MOVEIN_DATE <= SY-DATUM.
      MOVE 'X' TO LV_DUNNING_FLAG.
      EXIT.
    ENDIF.
  ENDLOOP.
ENDIF.

*   Get the reconnect order type.
SWC_SET_ELEMENT I_CONTAINER 'Installation' OBJECT-KEY.
SWC_CALL_METHOD WA_DISCDOC 'DetermineDiscType' I_CONTAINER.
SWC_GET_ELEMENT I_CONTAINER 'DiscType' LV_DISCTYPE.
SELECT * INTO ORDERCODEDTLS
  FROM ZTFO_REC_ORD_CD UP TO 1 ROWS
   WHERE HARDSHIP_FLAG = LV_HARDSHIPFLAG
      AND DUNNING_FLAG  = LV_DUNNING_FLAG
      AND SPARTE        = LV_DIVISION
      AND DISCREASON    = LV_DISCREASON
      AND DISCTYPE      = LV_DISCTYPE.
ENDSELECT.

IF ORDERCODEDTLS IS INITIAL.
  MOVE : 'ZFO_PMI'   TO WA_ERR_MSG-MSGID,
         '013'       TO WA_ERR_MSG-MSGNO,
         'E'         TO WA_ERR_MSG-MSGTY,
         LV_DIVISION TO WA_ERR_MSG-MSGV1,
         LV_DISCTYPE TO WA_ERR_MSG-MSGV2,
         ' '         TO WA_ERR_MSG-PROBCLASS.
  APPEND WA_ERR_MSG TO IT_ERR_MSG.
  SWC_SET_TABLE CONTAINER 'ErrMsg' IT_ERR_MSG.
  EXIT_RETURN 9001 LV_DIVISION LV_DISCTYPE HARDSHIPFLAG SPACE.
ENDIF.
SWC_SET_ELEMENT CONTAINER 'OrderCodeDtls' ORDERCODEDTLS.
END_METHOD.

