        EXPORTING
          IV_SERNR        = LWA_EQUI_DET-SERNR
          IV_MATNR        = LWA_EQUI_DET-MATNR
          IV_INSTALLATION = LV_ANLAGE
          IV_DEVLOC       = LWA_INST_DET-DEVLOC
          IV_TARIFTYP     = LV_TARIFTYP
          IV_OLD_TARIFTYP = LV_OLD_TARIFTYP
          IV_ACTVT_DATE   = LV_ACTVTY_DT
          IV_DEVMODIF     = ABAP_TRUE
          IV_SEND_EMAIL   = ABAP_TRUE.
    ENDIF.
  ENDIF.
ENDIF.
*----|END-OF-CHANGE|HMS|12/01/2014|Post Cutover Billing R4B|----*

END_METHOD.

BEGIN_METHOD GETDATATOUPDATEREGISTER CHANGING CONTAINER.

