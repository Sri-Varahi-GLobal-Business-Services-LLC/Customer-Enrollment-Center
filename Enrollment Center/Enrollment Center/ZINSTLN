CONSTANTS: LC_OPEN_MR       TYPE EABL-ABLSTAT  VALUE '0'.

TYPES : BEGIN OF TY_INST_DET,
          INST   TYPE ANLAGE,
          SERNR  TYPE GERNR,
          EQUNR  TYPE EQUNR,
          DEVLOC TYPE DEVLOC,
        END OF TY_INST_DET,

        BEGIN OF TY_EQUI_DET,
          EQUNR TYPE EQUNR,
          SERNR TYPE GERNR,
          MATNR TYPE MATNR,
        END OF TY_EQUI_DET.

DATA : LWA_INST_DET    TYPE TY_INST_DET,
       LWA_EQUI_DET    TYPE TY_EQUI_DET,
       LV_TARIFTYP     TYPE TARIFTYP,
       LV_OLD_TARIFTYP TYPE TARIFTYP,
       LV_ANLAGE       TYPE ANLAGE,
       LV_ACTVTY_DT    TYPE DATS,
       LV_DIVISION     TYPE SWC_OBJECT,
       LV_SPARTE       TYPE SPARTE,
       LV_OWNER_FLAG   TYPE CHAR1,
       LV_OWNER_DT     TYPE DATS,
       LV_MOVEIN_DT    TYPE DATS.

DATA:  LV_NEW_RATE TYPE EANLH-TARIFTYP,
       LV_OLD_RATE TYPE EANLH-TARIFTYP.

CLEAR : LWA_INST_DET,
        LWA_EQUI_DET,
        LV_ANLAGE,
        LV_ACTVTY_DT.

SWC_GET_PROPERTY SELF 'Division' LV_DIVISION.
SWC_GET_PROPERTY LV_DIVISION 'Division' LV_SPARTE.
SWC_GET_ELEMENT CONTAINER 'OLD_RATE' LV_OLD_TARIFTYP.
SWC_GET_ELEMENT CONTAINER 'NEW_RATE' LV_TARIFTYP.

SWC_GET_OBJECT_KEY SELF LV_ANLAGE.

CHECK LV_OLD_TARIFTYP <> LV_TARIFTYP.

CHECK LV_SPARTE = '01'.

SELECT SINGLE A~ANLAGE
       B~LOGIKNR
       B~EQUNR
       B~DEVLOC
INTO LWA_INST_DET
FROM EASTL AS A
INNER JOIN EGERH AS B ON A~LOGIKNR = B~LOGIKNR
WHERE A~ANLAGE = LV_ANLAGE AND
      A~BIS = CO_DATE_INFINITE AND
      B~BIS = CO_DATE_INFINITE AND
      B~KOMBINAT IN ('Z', 'M' ).
IF SY-SUBRC IS INITIAL.
  SELECT SINGLE EQUNR
                SERNR
                MATNR
         INTO LWA_EQUI_DET
         FROM EQUI
         WHERE EQUNR = LWA_INST_DET-EQUNR.
  IF SY-SUBRC IS INITIAL.
    SELECT SINGLE AB
                  TARIFTYP
           INTO (LV_ACTVTY_DT, LV_TARIFTYP)
           FROM EANLH
           WHERE ANLAGE = LV_ANLAGE AND
                 BIS = CO_DATE_INFINITE.
    IF SY-SUBRC IS INITIAL.
*      SELECT COUNT(*)
*        FROM eablg
*        WHERE anlage = lv_anlage
*          AND ablesgr = '06'
*          AND adatsoll = lv_actvty_dt.
*      IF sy-subrc = 0.
*        lv_actvty_dt = lv_actvty_dt + 1.
*      ENDIF.

      CLEAR: LV_MOVEIN_DT.
      SELECT SINGLE EINZDAT
        INTO LV_MOVEIN_DT
        FROM EVER
        WHERE ANLAGE = LV_ANLAGE
          AND AUSZDAT = '99991231'.

      SELECT COUNT(*)
        FROM V_EABL
       WHERE ABLESGR = '06'
         AND EQUNR    EQ LWA_INST_DET-EQUNR
         AND ABLSTAT  EQ LC_OPEN_MR
         AND ADATSOLL = LV_MOVEIN_DT.
      IF SY-SUBRC IS INITIAL.
        LV_OWNER_FLAG = 'X'.
        IF LV_MOVEIN_DT > SY-DATUM.
          LV_OWNER_DT = LV_MOVEIN_DT + 1.
        ELSE.
          LV_OWNER_DT = LV_MOVEIN_DT + 2.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDIF.

SWC_SET_ELEMENT CONTAINER 'ACTVTY_DT' LV_ACTVTY_DT.
SWC_SET_ELEMENT CONTAINER 'TARIFTYP' LV_TARIFTYP.
SWC_SET_ELEMENT CONTAINER 'DEVLOC' LWA_INST_DET-DEVLOC.
SWC_SET_ELEMENT CONTAINER 'ANLAGE' LV_ANLAGE.
SWC_SET_ELEMENT CONTAINER 'MATNR' LWA_EQUI_DET-MATNR.
SWC_SET_ELEMENT CONTAINER 'SERNR' LWA_EQUI_DET-SERNR.
SWC_SET_ELEMENT CONTAINER 'OWNER_FLG' LV_OWNER_FLAG.
SWC_SET_ELEMENT CONTAINER 'OWNER_DT' LV_OWNER_DT.

END_METHOD.

BEGIN_METHOD UPDATEREGISTER CHANGING CONTAINER.
DATA:  LV_SERNR        TYPE GERNR,
       LV_DEVLOC       TYPE DEVLOC,
       LV_MATNR        TYPE MATNR,
       LV_NEW_TARIFTYP TYPE TARIFTYP,
       LV_OLD_TARIFTYP TYPE TARIFTYP,
       LV_TARIFTYP     TYPE TARIFTYP,
       LV_ANLAGE       TYPE ANLAGE,
       LV_ACTVTY_DT    TYPE DATS.
DATA:  LT_CONTAINER TYPE TABLE OF SWR_CONT,
       LW_CONTAINER TYPE SWR_CONT,
       LV_OBJKEY    TYPE SWO_TYPEID,
       LT_RETURN    TYPE BAPIRET2_T.
CONSTANTS: C_INSTLN   TYPE SWO_OBJTYP VALUE 'INSTLN',
           C_UPD_COMP TYPE SWO_EVENT VALUE 'DeviceRegupdate_completed',
           C_COMMIT   TYPE FLAG VALUE 'X'.

CLEAR : LV_SERNR, LV_DEVLOC, LV_MATNR, LV_OLD_TARIFTYP, LV_ANLAGE, LV_ACTVTY_DT.

SWC_GET_ELEMENT CONTAINER 'OLD_RATE' LV_OLD_TARIFTYP.
SWC_GET_ELEMENT CONTAINER 'NEW_RATE' LV_TARIFTYP.
SWC_GET_ELEMENT CONTAINER 'ACTVTY_DT' LV_ACTVTY_DT.
SWC_GET_ELEMENT CONTAINER 'TARIFTYP' LV_TARIFTYP.
SWC_GET_ELEMENT CONTAINER 'DEVLOC' LV_DEVLOC.
SWC_GET_ELEMENT CONTAINER 'ANLAGE' LV_ANLAGE.
SWC_GET_ELEMENT CONTAINER 'MATNR' LV_MATNR.
SWC_GET_ELEMENT CONTAINER 'SERNR' LV_SERNR.

CALL FUNCTION 'Z_REG_AMCG_PROFILE_UPDATE'
  EXPORTING
    IV_SERNR        = LV_SERNR
    IV_MATNR        = LV_MATNR
    IV_INSTALLATION = LV_ANLAGE
    IV_DEVLOC       = LV_DEVLOC
    IV_TARIFTYP     = LV_TARIFTYP
    IV_OLD_TARIFTYP = LV_OLD_TARIFTYP
    IV_ACTVT_DATE   = LV_ACTVTY_DT
    IV_DEVMODIF     = ABAP_TRUE
    IV_SEND_EMAIL   = ABAP_TRUE
  IMPORTING
    ET_RETURN       = LT_RETURN.

* Check for Errors.
LOOP AT LT_RETURN TRANSPORTING NO FIELDS WHERE TYPE CA 'AEX'.
ENDLOOP.
* if there was atleast one error or abort message dont raise the event
IF SY-SUBRC <> 0.

* Raise Event Device Reg update completed which will be recieved by
* Workflow WS93200342 to update the Backend processing update to
* the enrollment table

* Key
  LV_OBJKEY = LV_ANLAGE.
  LW_CONTAINER-ELEMENT = 'New_RateCategory'.
  LW_CONTAINER-VALUE   = LV_TARIFTYP.
  APPEND LW_CONTAINER TO LT_CONTAINER.

  LW_CONTAINER-ELEMENT = 'Old_RateCategory'.
  LW_CONTAINER-VALUE   = LV_OLD_TARIFTYP.
  APPEND LW_CONTAINER TO LT_CONTAINER.

  LW_CONTAINER-ELEMENT = 'DevLoc'.
  LW_CONTAINER-VALUE   = LV_DEVLOC.
  APPEND LW_CONTAINER TO LT_CONTAINER.

* Raise the Event
  CALL FUNCTION 'SAP_WAPI_CREATE_EVENT'
    EXPORTING
      OBJECT_TYPE     = C_INSTLN
      OBJECT_KEY      = LV_OBJKEY
      EVENT           = C_UPD_COMP
      COMMIT_WORK     = 'X'
*     EVENT_LANGUAGE  = SY-LANGU
*     LANGUAGE        = SY-LANGU
*     USER            = SY-UNAME
*     IFS_XML_CONTAINER       =
* IMPORTING
*     RETURN_CODE     =
*     EVENT_ID        =
    TABLES
      INPUT_CONTAINER = LT_CONTAINER
*     MESSAGE_LINES   =
*     MESSAGE_STRUCT  =
    .

  IF SY-SUBRC = 0.
    COMMIT WORK AND WAIT.
  ENDIF.

ENDIF.
END_METHOD.

BEGIN_METHOD GETMETERREADS CHANGING CONTAINER.
CONSTANTS c_periodic TYPE ablesgr VALUE '01'.
* 04/07/2009 PM847082 GCHONG END
* 04/24/2009 PM847082 GCHONG BEGIN
* Constants
CONSTANTS : c_billable TYPE ablstat VALUE '1',
            c_released TYPE ablstat VALUE '4'.

