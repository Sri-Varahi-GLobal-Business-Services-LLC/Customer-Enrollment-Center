      OTHERS = 01.
  CASE SY-SUBRC.
    WHEN 0.            " OK

LOOP AT i_mrdata INTO wa_mrdata
  WHERE allocationdate GE l_key_date
* 04/24/2009 PM847082 GCHONG BEGIN
*  AND   allocationdate LE lv_alloc_bis.
    AND allocationdate LE sy-datum.
*    AND ( meterreadingstatus EQ c_billable OR
*         meterreadingstatus EQ c_released ).
* 04/24/2009 PM847082 GCHONG END

* 04/07/2009 PM847082 GCHONG BEGIN
* Only recognise meter read if it is not control read (reason 10) nor
* move-out read
*  LOOP AT i_mrreason INTO wa_mrreason
*                     WHERE mridnumber EQ wa_mrdata-mridnumber
*                       AND mrreason   EQ c_periodic.
*  ENDLOOP.
** Refresh object if found
*  IF sy-subrc EQ 0.
*    swc_set_objectkey wa_mrdata-mridnumber.
*    swc_refresh_object self.
  SWC_SET_ELEMENT CONTAINER 'ExitLoopFlag' 'X'.
    EXIT.
*  ELSE.
*    swc_set_objectkey space.
*    swc_refresh_object self.
*  ENDIF.
ENDLOOP.

    WHEN OTHERS.       " to be implemented
  ENDCASE.
END_METHOD.
