*Developer: Chad Essenmacher
*Date:      July 2007
*Desc:      This will load up the installation fact desc if present.
****************************************************************
DATA: R_ERR_OBJ        TYPE REF TO CX_ROOT.
DATA: L_ANLAGE         TYPE ANLAGE.

TRY.
    L_ANLAGE = OBJECT-KEY.
    CALL FUNCTION 'Z_80PCT_GET_INSTALL_FACTS'
      EXPORTING
        PI_ANLAGE        = L_ANLAGE
      IMPORTING
        PE_MAIN_FACT_TXT = OBJECT-ZINSTLFACTMAINDESC
      EXCEPTIONS
        UNEXPECTED_ERROR = 1
        OTHERS           = 2.
    IF SY-SUBRC <> 0.
      CLEAR OBJECT-ZINSTLFACTMAINDESC.
    ENDIF.

  CATCH CX_ROOT INTO R_ERR_OBJ.
    CLEAR OBJECT-ZINSTLFACTMAINDESC.
ENDTRY.

SWC_SET_ELEMENT CONTAINER 'ZInstlFactMainDesc'
     OBJECT-ZINSTLFACTMAINDESC.
END_PROPERTY.

BEGIN_METHOD SORTMOVEININSTLN CHANGING CONTAINER.
****************************************************************
*Developer: Judy Jarone
*Date:      July 18, 2007
*Desc:      Sort move in installations gas first.
****************************************************************

DATA:  INSTLNS     TYPE SWC_OBJECT OCCURS 0,
       WA_INSTLNS  TYPE SWC_OBJECT,
       WA_DIVISION TYPE SWC_OBJECT,
       IO_INSTLNS  TYPE SWC_OBJECT,
       LV_SPARTE   TYPE TSPA-SPART,
       BEGIN OF I_INSTLNS OCCURS 0,
         INSTLN TYPE SWC_OBJECT,
         SPARTE TYPE TSPA-SPART,
       END OF I_INSTLNS.

SWC_GET_TABLE CONTAINER 'Instlns' INSTLNS.
LOOP AT INSTLNS INTO I_INSTLNS-INSTLN.
  SWC_GET_PROPERTY I_INSTLNS-INSTLN 'Division' WA_DIVISION.
  SWC_GET_OBJECT_KEY WA_DIVISION I_INSTLNS-SPARTE.
  APPEND I_INSTLNS.
ENDLOOP.
SORT I_INSTLNS BY SPARTE DESCENDING.
REFRESH INSTLNS.
LOOP AT I_INSTLNS.
  MOVE I_INSTLNS-INSTLN TO WA_INSTLNS.
  APPEND WA_INSTLNS TO INSTLNS.
ENDLOOP.
SWC_SET_TABLE CONTAINER 'Instlns' INSTLNS.
END_METHOD.

