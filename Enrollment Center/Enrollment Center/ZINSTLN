BEGIN_METHOD ZDETERMINEOPERANDCHANGE CHANGING CONTAINER.
***Types for CDHDR table
TYPES : BEGIN OF TY_CDHDR ,
          OBJECTCLAS LIKE CDHDR-OBJECTCLAS ,
          OBJECTID   LIKE CDHDR-OBJECTID ,
          CHANGENR   LIKE CDHDR-CHANGENR ,
          UDATE      LIKE CDHDR-UDATE ,
          UTIME      LIKE CDHDR-UTIME ,
        END OF TY_CDHDR .
*** Types for CDPOS
TYPES  : BEGIN OF TY_CDPOS ,
           OBJECTCLAS LIKE CDPOS-OBJECTCLAS ,
           OBJECTID   LIKE CDPOS-OBJECTID ,
           CHANGENR   LIKE CDPOS-CHANGENR ,
           TABKEY     LIKE CDPOS-TABKEY ,
           FNAME      LIKE CDPOS-FNAME ,
           CHNGIND    LIKE CDPOS-CHNGIND ,
           VALUE_NEW  LIKE CDPOS-VALUE_NEW ,
           VALUE_OLD  LIKE CDPOS-VALUE_OLD ,
         END OF TY_CDPOS .

***Internal table for CDHDR and CDPOS
DATA: T_CDHDR TYPE STANDARD TABLE OF TY_CDHDR WITH HEADER LINE ,
      T_CDPOS TYPE STANDARD TABLE OF TY_CDPOS WITH HEADER LINE .
***Work variables
DATA: W_WERT1            LIKE ETTIFN-WERT1 ,                 " Demand Value
      W_CLASSIFICATION   LIKE EKUN-CLASSIFICATION , " Classification
      W_WKFL_DATE        LIKE SYST-DATUM ,               " Workflow date
      W_WKFL_INITIATOR   LIKE WFSYST-INITIATOR,     " Workflow initiator
      W_LIMIT            LIKE ETTIFN-WERT1,                  " Demand limit
      W_CURRENT_CONTRACT LIKE EVER-VERTRAG ,      " Contract no.
      W_CONTRACT_OBJECT  TYPE SWC_OBJECT ,         " Ref Contract obj
      W_PARTNER          LIKE BUT000-PARTNER ,             " Business partner no.
      W_PARTNER_OBJECT   TYPE SWC_OBJECT,         " Ref Partner Obj
      WA_CDHDR           TYPE TY_CDHDR ,                 " For cdhdr work area
      W_INSTLN           LIKE EANL-ANLAGE ,      " Instalation key
      W_TMP_WERT1        LIKE ETTIFN-WERT1 ,  " Demand value when moveout occur
***R3DK904642: Begin Changes 41324 - youngja
      W_EVENT            LIKE SWFREVTLOG-EVENT.          " Event name
***R3DK904642: End Changes 41324 - youngja
***Contants
CONSTANTS : C_ISU_ETTIF        LIKE CDPOS-OBJECTCLAS VALUE 'ISU_ETTIF' ,
            C_WERT1(5)         TYPE C VALUE 'WERT1' ,
            C_OPERAND(10)      TYPE C VALUE 'C-KW_CNMIN',
***R3DK904642: Begin Changes 41324 - youngja
            C_MOVEIN_EVENT(14) TYPE C VALUE 'MOVEINOCCURRED'.
***R3DK904642: End Changes 41324 - youngja
***Working variables for import parameters
DATA :NEWVALUE LIKE ETTIFN-WERT1,         " New demand value
      OLDVALUE LIKE ETTIFN-WERT1.        " Old demand value

***Get event data and Creator
SWC_GET_ELEMENT CONTAINER 'EventDate' W_WKFL_DATE.
SWC_GET_ELEMENT CONTAINER 'WorkFlowinitiator' W_WKFL_INITIATOR.
***R3DK904642: Begin Changes 41324 - youngja
CLEAR W_EVENT.
SWC_GET_ELEMENT CONTAINER 'EventName' W_EVENT.

IF W_EVENT EQ C_MOVEIN_EVENT.
  CLEAR: W_PARTNER, NEWVALUE.
  SWC_GET_ELEMENT CONTAINER 'BusinessPartner' W_PARTNER.
  IF W_PARTNER IS NOT INITIAL.
***Perform to update EKUN-CLASSIFICTION to 'KA'
    PERFORM  UPDATE_EKUN USING  W_PARTNER.
  ENDIF.
***Get entry value from table ETTIFN
  SELECT WERT1  INTO W_WERT1
    UP TO 1 ROWS  FROM ETTIFN
    WHERE OPERAND = C_OPERAND AND
          AB      LE W_WKFL_DATE AND
          BIS     GT W_WKFL_DATE AND
          ANLAGE  EQ OBJECT-KEY .
  ENDSELECT .
***Export New Value
  MOVE  W_WERT1 TO  NEWVALUE.
  SWC_SET_ELEMENT CONTAINER 'NewValue'  NEWVALUE.
***set Exception "New Move In"
  SWC_SET_ELEMENT CONTAINER 'Returncode' '1005'.
  EXIT.
ENDIF.
***R3DK904642: End Changes 41324 - youngja
***Get demand vlaue limit from custom table .
SELECT SINGLE VALUE_LIMIT INTO W_LIMIT FROM ZIS_DEMAND_VALUE .
IF SY-SUBRC NE 0  .
  CLEAR W_LIMIT .
ENDIF .


**Get CDHDR Table Values
REFRESH T_CDHDR .
SELECT OBJECTCLAS OBJECTID CHANGENR UDATE UTIME
INTO TABLE T_CDHDR
FROM CDHDR WHERE OBJECTCLAS = C_ISU_ETTIF AND
                 OBJECTID   =  OBJECT-KEY  AND
                 USERNAME   =  W_WKFL_INITIATOR+2(12)  AND
                 UDATE      =  W_WKFL_DATE .
IF T_CDHDR[] IS NOT INITIAL .
**Get CDPOS values
  SELECT OBJECTCLAS OBJECTID CHANGENR TABKEY FNAME CHNGIND
          VALUE_NEW VALUE_OLD
  INTO TABLE T_CDPOS
  FROM CDPOS
  FOR ALL ENTRIES IN T_CDHDR
  WHERE    OBJECTCLAS =  T_CDHDR-OBJECTCLAS AND
           OBJECTID   =  T_CDHDR-OBJECTID  AND
           CHANGENR   =  T_CDHDR-CHANGENR AND
           TABKEY     LIKE '%C-KW_CNMIN%' .

ENDIF .

SORT  T_CDPOS  BY CHANGENR DESCENDING.
READ TABLE T_CDPOS INDEX 1 .
IF SY-SUBRC EQ 0 .
  CASE T_CDPOS-CHNGIND .
***If Insert
    WHEN 'I' .
***Get entry value from table ETTIFN
      SELECT WERT1  INTO W_WERT1
      UP TO 1 ROWS  FROM ETTIFN
      WHERE OPERAND = C_OPERAND AND
            AB      LE W_WKFL_DATE AND
            BIS     GT W_WKFL_DATE AND
            ANLAGE  EQ OBJECT-KEY .
      ENDSELECT .
***If demand value is greater than limit
      IF W_WERT1 GE  W_LIMIT  .
**Set Classification field to KA
        CLEAR : W_CURRENT_CONTRACT  , W_PARTNER_OBJECT  , W_PARTNER .
***Get current contract
        SWC_GET_PROPERTY SELF 'CurrentContract'  W_CONTRACT_OBJECT.
        SWC_GET_PROPERTY  W_CONTRACT_OBJECT  'Partner' W_PARTNER_OBJECT  .
        SWC_GET_PROPERTY W_PARTNER_OBJECT 'Partner' W_PARTNER .
        IF  W_PARTNER IS NOT INITIAL .
***Perform to update EKUN-CLASSIFICTION to 'KA'
          PERFORM  UPDATE_EKUN USING  W_PARTNER .
        ENDIF .
***Export New Value
        MOVE  W_WERT1 TO  NEWVALUE.
        SWC_SET_ELEMENT CONTAINER 'NewValue'  NEWVALUE.
***set Exception "New Contract >= Limit"
        SWC_SET_ELEMENT CONTAINER 'Returncode' '1001' .
      ELSE .
***set Exception "No Processing Required"
        SWC_SET_ELEMENT CONTAINER 'Returncode' '1000' .
      ENDIF .
***When Update
    WHEN 'U' .
      IF T_CDPOS-FNAME EQ C_WERT1 .
        IF T_CDPOS-VALUE_OLD LT  W_LIMIT .
          IF T_CDPOS-VALUE_NEW GE W_LIMIT .
***Export old value / new value
            SWC_SET_ELEMENT CONTAINER 'NewValue' T_CDPOS-VALUE_NEW.
            SWC_SET_ELEMENT CONTAINER 'OldValue' T_CDPOS-VALUE_OLD.
****Set exception Exstg Cntrct Chngd from < Limit to >= Limit
            SWC_SET_ELEMENT CONTAINER 'Returncode' '1002' .
***Get current contract
            SWC_GET_PROPERTY SELF 'CurrentContract'  W_CONTRACT_OBJECT.
            SWC_GET_PROPERTY  W_CONTRACT_OBJECT  'Partner' W_PARTNER_OBJECT .
            SWC_GET_PROPERTY W_PARTNER_OBJECT 'Partner' W_PARTNER .
            IF  W_PARTNER IS NOT INITIAL .
***Perform to update EKUN-CLASSIFICTION to 'KA'
              PERFORM  UPDATE_EKUN USING  W_PARTNER .
            ENDIF.
          ELSE .
***set Exception "No Processing Required"
            SWC_SET_ELEMENT CONTAINER 'Returncode' '1000' .
          ENDIF.
        ELSE .
***Export old value / new value
          SWC_SET_ELEMENT CONTAINER 'NewValue' T_CDPOS-VALUE_NEW.
          SWC_SET_ELEMENT CONTAINER 'OldValue' T_CDPOS-VALUE_OLD.
****Set exception Exstg Cntrct Chngd from > = Limit to x
          SWC_SET_ELEMENT CONTAINER 'Returncode' '1003' .
        ENDIF .
      ELSE.
***Set exception No processing required
        SWC_SET_ELEMENT CONTAINER 'Returncode' '1000' .
      ENDIF .
***When deleted
    WHEN 'D' .
***Get current contract / contract no. / partner
      CLEAR : W_CURRENT_CONTRACT  , W_PARTNER_OBJECT  , W_PARTNER .
      SWC_GET_PROPERTY SELF 'CurrentContract'  W_CONTRACT_OBJECT.
      SWC_GET_PROPERTY  W_CONTRACT_OBJECT  'Partner' W_PARTNER_OBJECT  .
      SWC_GET_PROPERTY W_PARTNER_OBJECT 'Partner' W_PARTNER .
      CLEAR W_CLASSIFICATION .
      IF W_PARTNER IS NOT INITIAL.
***Get classification
        SELECT SINGLE CLASSIFICATION INTO W_CLASSIFICATION FROM EKUN
        WHERE PARTNER = W_PARTNER .
        IF W_CLASSIFICATION = 'KA' .
***Set exception "Contract Deleted"
          SWC_SET_ELEMENT CONTAINER 'Returncode' '1004' .
        ELSE .
****Set Exception "No Processing Required"
          SWC_SET_ELEMENT CONTAINER 'Returncode' '1000' .
        ENDIF .
      ENDIF .
    WHEN OTHERS.
***Set Exception "No Processing Required"
      SWC_SET_ELEMENT CONTAINER 'Returncode' '1000' .
  ENDCASE .
ENDIF .        " Read table sy-subrc

END_METHOD.
*&---------------------------------------------------------------------*
*&      Form  UPDATE_EKUN
*&---------------------------------------------------------------------*
