GET_PROPERTY ZMOVINOBJPRES CHANGING CONTAINER.
************************************************************************
* Created by  : James Young
* Created on  : 11/18/2005
* Description : Retrieve attributes for display in move-in process.
*               Utilized in "Define Object Presentation node in SPRO.
*               Inst Typ desc & rate added by commented out in case
*               MTEMC would like to adjust pop-up.
************************************************************************
* Change History
*----------------------------------------------------------------------*
*     Date   |   Programmer   |   Corr. #   |   Description
*----------------------------------------------------------------------*
* 11/18/2005 | James Young    |  R3DK904615 | v.1 Incident 41287      |
************************************************************************

*Declaration
DATA: W_INST_INFO    TYPE EWOGEN-OBJSTEXT50, "bp long name
*        W_DESCRPT      TYPE TE439T-TEXT30,     "inst typ desc
      W_TYPE         TYPE EANL-ANLART,       "inst typ
      W_NEWTYPE(5)   TYPE C,
      W_MO_DTE       TYPE EVER-AUSZDAT VALUE '19000101',
      W_TMP_DTE      TYPE EVER-AUSZDAT,
      W_DIS_DTE      TYPE TBO01-TXT10,       "MM/DD/YYYY
      W_FLAG         TYPE C,
      W_RATE         TYPE EANLD-TARIFTYP,
      W_NEWRATE(10)  TYPE C,
      W_CONTRACT_OBJ TYPE SWC_OBJECT,        "contract obj
      OBJREF         TYPE TABLE OF SWC_OBJECT WITH HEADER LINE.

CONSTANTS : C_M TYPE TE439T-TEXT30 VALUE 'Moved Out:',
            C_E TYPE TE439T-TEXT30 VALUE 'No Previous Service'.

*Initialization
CLEAR W_INST_INFO.
CLEAR W_TYPE.
CLEAR W_NEWTYPE.
CLEAR W_TMP_DTE.
CLEAR W_FLAG.
CLEAR W_CONTRACT_OBJ.
CLEAR W_RATE.
CLEAR W_NEWRATE.
*  CLEAR W_DESCRPT.

REFRESH: OBJREF.

*Get Rate Category
SWC_GET_PROPERTY SELF 'ZRATECAT' W_RATE.

**Get Install Type Description
*  SWC_GET_PROPERTY SELF 'ZInstTypeDesc' W_DESCRPT.

*Get installation type description.
SWC_GET_PROPERTY SELF 'InstallationType' W_TYPE.

*Get business partner name from current contract.
SWC_GET_PROPERTY SELF 'CurrentContract' W_CONTRACT_OBJ.
SWC_GET_TABLE_PROPERTY SELF 'ISUCONTRACTS' OBJREF.

*Check existence of current contract & bp.
IF NOT W_CONTRACT_OBJ IS INITIAL.
  W_FLAG = 'B'.  "Display BP name.
ELSE.
  IF NOT OBJREF IS INITIAL.
    LOOP AT OBJREF.
      SWC_GET_PROPERTY OBJREF 'MoveOutDate' W_TMP_DTE.
      IF W_TMP_DTE > W_MO_DTE.
        W_MO_DTE = W_TMP_DTE.
        CLEAR W_TMP_DTE.
      ENDIF.
      CLEAR OBJREF.
    ENDLOOP.
    CONCATENATE W_MO_DTE+4(2) W_MO_DTE+6(2) W_MO_DTE(4) INTO
    W_DIS_DTE SEPARATED BY '/'.
    W_FLAG = 'M'.  "Display last m/o date.
  ELSE.
    W_FLAG = 'E'.  "No previous contracts.
  ENDIF.
ENDIF.

IF NOT W_FLAG IS INITIAL.
  CASE W_FLAG.
    WHEN 'B'.
      SWC_GET_PROPERTY W_CONTRACT_OBJ 'PartnerNamE' W_INST_INFO.
    WHEN 'M'.
      CONCATENATE C_M W_DIS_DTE INTO W_INST_INFO.
    WHEN 'E'.
      W_INST_INFO = C_E.
  ENDCASE.
ENDIF.

*Case statement to derive correct pop-up display for inst type.
CASE STRLEN( W_TYPE ).
  WHEN '2'.
    CONCATENATE W_TYPE '  |' INTO W_NEWTYPE.
  WHEN '3'.
    CONCATENATE W_TYPE ' |' INTO W_NEWTYPE.
  WHEN OTHERS.
    CONCATENATE W_TYPE '|' INTO W_NEWTYPE.
ENDCASE.

*Case statement to derive correct pop-up display for rate.
CASE STRLEN( W_RATE ).
  WHEN '4'.
    CONCATENATE W_RATE '     |' INTO W_NEWRATE.
  WHEN '5'.
    CONCATENATE W_RATE '    |' INTO W_NEWRATE.
  WHEN '6'.
    CONCATENATE W_RATE '   |' INTO W_NEWRATE.
  WHEN '7'.
    CONCATENATE W_RATE '  |' INTO W_NEWRATE.
  WHEN '8'.
    CONCATENATE W_RATE ' |' INTO W_NEWRATE.
  WHEN OTHERS.
    CONCATENATE W_RATE '|' INTO W_NEWRATE.
ENDCASE.

*Build text line with installation info.
CONCATENATE W_NEWTYPE W_NEWRATE INTO OBJECT-ZMOVINOBJPRES.

*Build remaining text line including bp info.
CONCATENATE OBJECT-ZMOVINOBJPRES W_INST_INFO
      INTO OBJECT-ZMOVINOBJPRES.

*Set container elememt.
SWC_SET_ELEMENT CONTAINER 'ZMovInObjPres' OBJECT-ZMOVINOBJPRES.
END_PROPERTY.

