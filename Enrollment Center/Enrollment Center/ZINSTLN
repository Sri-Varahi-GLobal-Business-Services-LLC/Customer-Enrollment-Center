* Description : FO_ENH_670_4
*               Estimate Installation Meter Reads
************************************************************************
* Programmer:  Michael Robson
* Date:        08/06/2009
* SC Problem:  PM864500
* Transport:   ECDK960786
* Description: Add a check to prevent estimation for an MV-90
*              installation, where the installation's meter read unit
*              starts with "MV".
************************************************************************

*----------------------------------------------------------------------*
* Modification Log                Place latest at top :                *
*----------------------------------------------------------------------*
* Author       Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------*
* Haritha D   10/22/2014         E2DK934877    Initial                 *
*----------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
CONSTANTS: C_TRUE      TYPE C VALUE 'X',
           C_OPEN_READ TYPE ABLESGRE VALUE '0'.
DATA: READREASON    TYPE ABLESGRE,
      METERREADDATE TYPE EABL-ADATSOLL,
      LV_ANLAGE     TYPE ANLAGE,
      LV_ABLBELNR   TYPE ABLBELNR,
      WA_ERR_MSG    TYPE ZSFO_BAL_MSG,
      I_ERR_MSG     TYPE STANDARD TABLE OF ZSFO_BAL_MSG.

FIELD-SYMBOLS : <FS_ERR_MSG> TYPE ZSFO_BAL_MSG. "CS_WF_RTF_002: RDR block Meter estimation |22-10-2014 HDANNAMA

CONSTANTS : CO_MSGID     TYPE SYMSGID VALUE 'ZFO_PMI', "CS_WF_RTF_002: RDR block Meter estimation |22-10-2014 HDANNAMA
            CO_MSGNO     TYPE SYMSGNO VALUE '67',
            CO_MSGTY     TYPE SYMSGTY VALUE 'I',
            CO_PROBCLASS TYPE BALPROBCL VALUE '3',
            CO_METER     TYPE STRING VALUE 'AdvancedMeter',
            CO_VALUE     TYPE C VALUE 'X'.
*
*FIELD-SYMBOLS: <lfs_mara> LIKE LINE OF t_mara.
*      lv_counter  TYPE syst-index,    "TE107 change
*      lv_maxcount  TYPE syst-index.   "TE107 change
*----|START-OF-CHANGE|MMRobson|08/06/2009|PM864500|----*
DATA: L_EXCLUDE_MV90 TYPE REGEN-KENNZX.
*----|END-OF-CHANGE|MMRobson|08/06/2009|PM864500|----*
SWC_GET_ELEMENT CONTAINER 'ReadReason' READREASON.
SWC_GET_ELEMENT CONTAINER 'MeterReadDate' METERREADDATE.
SWC_GET_TABLE CONTAINER 'ErrMsg' I_ERR_MSG.
*CLEAR: lv_counter,                                 "TE107 change
*       lv_maxcount.                                "TE107 change
*swc_get_element container 'Counter' lv_counter.    "TE107 change
*swc_get_element container 'MaxCount' lv_maxcount.  "TE107 change

LV_ANLAGE = OBJECT-KEY.
** change for MR estimate process at MI/MO
* based on discussion with Joe G regarding MI/MO and over estimation
* Meter Reading.
* Findings/Problem. Currently, when a MO/MI happens system does the
* MR estimation and check the weather temp factor. This temp factor is
* entered manually by users and they do it at the end of the day.
* thus estimation occurs during the day time does not consider it and
* and calculation goes off
* Solution:2 steps
* Step1: check the entry in table TE107 for temp factor, if no entry
* then do not proceed.
* Step2:If step 1 is OK, then check and compare the MO date. If Schd
* bill date is withing next 5 days, then do not do estimate and wait
* for automatic bill to get exeecuted otherwise execute
DATA: LT_TE107 TYPE TABLE OF TE107,
      NO_LINES TYPE N.

*DO. DATA lv_debug TYPE char1 VALUE 'X'. IF NOT lv_debug IS INITIAL. EXIT. ENDIF. ENDDO.
* get rate category
CLEAR SY-SUBRC.
SELECT * FROM TE107 INTO TABLE LT_TE107
  WHERE GRADTDAT  = METERREADDATE. "sy-datum.
IF SY-SUBRC <> '0'.

  MOVE: 'ZBILL' TO WA_ERR_MSG-MSGID,
        '187'     TO WA_ERR_MSG-MSGNO,
        'E'      TO WA_ERR_MSG-MSGTY,
*            'I'       TO wa_err_msg-msgty,
        '3'       TO WA_ERR_MSG-PROBCLASS.
  APPEND WA_ERR_MSG TO I_ERR_MSG.
*  swc_set_element container 'SuccessFlgTE107' abap_false. "TE107 change
*  swc_set_table container 'ErrMsg' i_err_msg.             "TE107 change
*  IF lv_maxcount NE 0                                     "TE107 change
*  AND lv_maxcount EQ lv_counter.                          "TE107 change
*    "Do Nothing                                           "TE107 change
*  ELSE.                                                   "TE107 change
*    EXIT.                                                 "TE107 change
*  ENDIF.                                                  "TE107 change
*ELSE.                                                     "TE107 change
*  swc_set_element container 'SuccessFlgTE107' abap_true.  "TE107 change
ENDIF.

*----|START-OF-CHANGE|MMRobson|08/06/2009|PM864500|----*
SWC_GET_ELEMENT CONTAINER 'ExcludeMV90' L_EXCLUDE_MV90.
IF L_EXCLUDE_MV90 IS NOT INITIAL.
* Check whether the installation has an MV-90 meter reading unit
  SELECT COUNT(*)
    FROM EANLH
    WHERE ANLAGE     = LV_ANLAGE
      AND BIS       >= METERREADDATE
      AND AB        <= METERREADDATE
      AND ABLEINH LIKE 'MV%'.

* Exit if an MV-90 meter reading unit is found
  CHECK SY-SUBRC <> 0.
ENDIF.
*----|END-OF-CHANGE|MMRobson|08/06/2009|PM864500|----*

*  First lets just make sure the move out read order has not been
*  satisfied.
SELECT ABLBELNR INTO LV_ABLBELNR
  FROM V_EABL UP TO 1 ROWS
    WHERE ANLAGE = LV_ANLAGE
      AND ABLESGR = READREASON
      AND ABLSTAT  = C_OPEN_READ.
ENDSELECT.
IF SY-SUBRC = 0.
  CALL FUNCTION 'ZFO_METER_READ_ESTIMATE'
    EXPORTING
      X_ANLAGE           = LV_ANLAGE
      X_DATE             = METERREADDATE
      X_MRREASON         = READREASON
      X_NODIALOG         = C_TRUE
      X_COMMIT           = C_TRUE
    EXCEPTIONS
      GENERAL_ERROR      = 1
      NO_MRREL_REGISTERS = 2
      OTHERS             = 3.

  IF SY-SUBRC <> 0.
    "CS_WF_RTF_002: RDR block Meter estimation |22-10-2014 HDANNAMA
    IF SY-SUBRC = 3."Installtion has Smart Meter
      APPEND INITIAL LINE TO I_ERR_MSG ASSIGNING <FS_ERR_MSG>.
      <FS_ERR_MSG>-MSGID = CO_MSGID.
      <FS_ERR_MSG>-MSGNO = CO_MSGNO.
      <FS_ERR_MSG>-MSGTY = CO_MSGTY.
      <FS_ERR_MSG>-MSGV1 = LV_ANLAGE.
      <FS_ERR_MSG>-PROBCLASS = CO_PROBCLASS.
      UNASSIGN  <FS_ERR_MSG>.
      SWC_SET_ELEMENT CONTAINER CO_METER CO_VALUE. "CS_WF_RTF_002: RDR block Meter estimation |22-10-2014 HDANNAMA

    ELSEIF SY-MSGID = 'E9' AND SY-MSGNO = '029'.
      EXIT_RETURN '9001' SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
    ELSE.
      MOVE: 'ZFO_PMI' TO WA_ERR_MSG-MSGID,
            '026'     TO WA_ERR_MSG-MSGNO,
*            'E'       TO wa_err_msg-msgty,    "20081125 Change E to I
            'I'       TO WA_ERR_MSG-MSGTY,
            LV_ANLAGE TO WA_ERR_MSG-MSGV1,
            '3'       TO WA_ERR_MSG-PROBCLASS.
      APPEND WA_ERR_MSG TO I_ERR_MSG.
    ENDIF.
  ENDIF.
ENDIF.
SWC_SET_TABLE CONTAINER 'ErrMsg' I_ERR_MSG.
