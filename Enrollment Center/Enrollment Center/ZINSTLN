GET_PROPERTY ZPROPERTY CHANGING CONTAINER.
DATA W_PROPERTY TYPE EPROPH-PROPERTY. "Property
DATA W_PROPERTY_REV TYPE EPROPH-PROPERTY. "Property Rev
SWC_SET_ELEMENT CONTAINER 'ZPROPERTY' OBJECT-ZPROPERTY.
* Obtain value of property from table EPROPH where Fromdate <= system dt
* and Todate > system date and the language is logon language.
SELECT SINGLE PROPERTY FROM EPROPH INTO W_PROPERTY
       WHERE FROMDATE <= SY-DATUM AND
             TODATE   >  SY-DATUM AND
             ANLAGE   = OBJECT-KEY-NUMBER.
* check if deleted, reversed.
SELECT SINGLE PROPERTY FROM EPROP INTO W_PROPERTY_REV
         WHERE STORNOKZ = 'X' AND PROPERTY = W_PROPERTY.

IF SY-SUBRC = 0.
  CLEAR W_PROPERTY.
ENDIF.
* set the value os attr ZPROPERTY using W_PROPERTY
SWC_SET_ELEMENT CONTAINER 'ZPROPERTY' W_PROPERTY.
END_PROPERTY.

GET_PROPERTY ZDISCDOC CHANGING CONTAINER.
************************************************************************
* Created by  : Gilbert Chong
* Created on  : 02/05/2005
* Description : Find installation based disconnection document
* Tech Spec   : <MTEMC shared network drive - probably S:>\
*                3_Realization\Development\Technical Specifications\
*                Customer Overview (80% Screen) Technical Design.doc
************************************************************************
* Version     :
* Date        :
* Name        :
* Ch. Req.    :
* SAP corr.   :
* Description :
************************************************************************

* Declaration
DATA IT_EDISCDOC TYPE EDISCDOC OCCURS 0 WITH HEADER LINE.
DATA L_STAT      TYPE DOMVALUE_L.
DATA L_STXT      TYPE VAL_TEXT.
DATA L_DISCORD   TYPE AUFNR.

* Initialisation
CLEAR   IT_EDISCDOC.
REFRESH IT_EDISCDOC.
CLEAR   L_STAT.
CLEAR   L_STXT.
CLEAR   L_DISCORD.

* Look for installation typed disconnection
SELECT * FROM EDISCDOC
         INTO TABLE IT_EDISCDOC
        WHERE REFOBJTYPE EQ C_INSTLN
          AND REFOBJKEY  EQ OBJECT-KEY
          AND STATUS     GT C_NEW
          AND STATUS     LT C_RECONNECTED.

* Proceed only if found
CHECK SY-SUBRC EQ 0.

* Sort the table and get the latest record
SORT IT_EDISCDOC DESCENDING BY ERDAT DISCNO.
READ TABLE IT_EDISCDOC INDEX 1.

* Assign values
OBJECT-ZDISCDOC = IT_EDISCDOC-DISCNO.
L_STAT          = IT_EDISCDOC-STATUS.

* Find either the disconnection order creation date or disconnection
* date
CASE IT_EDISCDOC-STATUS.
  WHEN C_DISCONORDER.
*   Get the discon order from the disconnection order
    SELECT SINGLE ORDERNUM FROM EDISCACT
                           INTO L_DISCORD
                          WHERE DISCNO      EQ IT_EDISCDOC-DISCNO
                            AND DISCACTTYP  EQ C_ACTDISCORD
                            AND DISCCANCELD EQ SPACE.
*   If successful
    IF SY-SUBRC EQ 0.
      SELECT SINGLE GSTRP FROM VIAUFKS
                          INTO IT_EDISCDOC-ERDAT
                         WHERE AUFNR EQ L_DISCORD.
      WRITE IT_EDISCDOC-ERDAT TO OBJECT-ZDISCDOCDATE.
    ENDIF.
  WHEN C_DISCONNECTED OR C_RECONORDER.
*   Get the activity date for the disconnection
    SELECT SINGLE ACTDATE FROM EDISCACT
                          INTO IT_EDISCDOC-ERDAT
                         WHERE DISCNO      EQ IT_EDISCDOC-DISCNO
                           AND DISCACTTYP  EQ C_ACTDISCENT
                           AND DISCCANCELD EQ SPACE.
    WRITE IT_EDISCDOC-ERDAT TO OBJECT-ZDISCDOCDATE.
ENDCASE.

* Reason
CASE IT_EDISCDOC-DISCPROCV.
  WHEN C_CUST.
    OBJECT-ZDISCDOCRSN = C_CUSTTXT.
  WHEN C_VACA.
    OBJECT-ZDISCDOCRSN = C_VACATXT.
ENDCASE.

* Extract domain values
CALL FUNCTION 'DOMAIN_VALUE_GET'
  EXPORTING
    I_DOMNAME  = C_STATDOM
    I_DOMVALUE = L_STAT
  IMPORTING
    E_DDTEXT   = L_STXT
  EXCEPTIONS
    NOT_EXIST  = 1
    OTHERS     = 2.

* Get the status description
CONCATENATE L_STAT '-' L_STXT INTO OBJECT-ZDISCDOCSTAT
                              SEPARATED BY SPACE.

* Set property
SWC_SET_ELEMENT CONTAINER 'ZDiscDoc' OBJECT-ZDISCDOC.

END_PROPERTY.

