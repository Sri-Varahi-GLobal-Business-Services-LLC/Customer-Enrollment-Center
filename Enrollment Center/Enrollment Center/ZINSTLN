BEGIN_METHOD RATECATCHANGEFOLLOWUP CHANGING CONTAINER.
***********************************************************************
* Programmer:  Michael Robson  Date:       07/14/2011
* Object:      CM_WFL_370      Transport:  E2DK911786
* Add handling for the commit and wait parameters.
***********************************************************************
* Programmer:  Michael Robson  Date:       04/29/2010
* Ticket:      CM159974        Transport:  E2DK905598
* Created to handle follow-up updates to the contracts, contract
* accounts, and registers that are affected by an installation's rate
* category change. This should already be called in the installation
* customer enhancement EMDI0001. The intent of this method is to let
* a work item handle delayed updates on contract accounts with more
* than one contract.
***********************************************************************
CHECK OBJECT-KEY-NUMBER IS NOT INITIAL.

TYPE-POOLS: ZCC01.

DATA: L_O_DIVISION TYPE SWC_OBJECT.
DATA: L_WA_OBJ TYPE ZCC01_WA_OBJ.
DATA: L_KEY_DATE   TYPE REGEN-STICHTAG,
      L_PRORATE    TYPE REGEN-KENNZX,
      L_COMMIT     TYPE REGEN-KENNZX,
      L_WAIT       TYPE REGEN-KENNZX,
      L_UPD_ONLINE TYPE REGEN-UPD_ONLINE,
      L_SUBRC      TYPE SYST-SUBRC,
      L_SPARTE     TYPE EANL-SPARTE.

SWC_GET_ELEMENT CONTAINER 'KeyDate' L_KEY_DATE.
SWC_GET_ELEMENT CONTAINER 'Prorate' L_PRORATE.
SWC_GET_ELEMENT CONTAINER 'Commit'  L_COMMIT.
SWC_GET_ELEMENT CONTAINER 'Wait'    L_WAIT.

IF L_PRORATE IS NOT INITIAL.
  L_PRORATE = 'X'.
ENDIF.

SWC_GET_PROPERTY SELF 'Division' L_O_DIVISION.
SWC_GET_OBJECT_KEY L_O_DIVISION L_SPARTE.

CALL FUNCTION 'ZINSTLN_RCAT_PROVIDE'
  EXPORTING
    IM_ANLAGE    = OBJECT-KEY-NUMBER
    IM_SPARTE    = L_SPARTE
    IM_KEYDATE   = L_KEY_DATE
    IM_PRORATE   = L_PRORATE
    IM_WMODE     = '2' " change mode
  IMPORTING
    EX_OBJ       = L_WA_OBJ
  EXCEPTIONS
    FOREIGN_LOCK = 1
    OTHERS       = 99.

L_SUBRC = SY-SUBRC.

IF L_SUBRC <> 0.
  SWC_SET_TABLE CONTAINER 'Messages' L_WA_OBJ-ERRORS.

  CALL FUNCTION 'ZINSTLN_RCAT_CLOSE'
    CHANGING
      EX_OBJ = L_WA_OBJ.

  CASE L_SUBRC.
    WHEN 0. " do nothing
    WHEN 1. " foreign_lock
      EXIT_RETURN 9001 SPACE SPACE SPACE SPACE.
    WHEN OTHERS.
      EXIT_RETURN 9002 SPACE SPACE SPACE SPACE.
  ENDCASE.
ENDIF.

CALL FUNCTION 'ZINSTLN_RCAT_CHECK'
  CHANGING
    EX_OBJ = L_WA_OBJ.

IF L_WA_OBJ-CONTROL-CHANGE IS NOT INITIAL.
  CALL FUNCTION 'ZINSTLN_RCAT_CHANGE'
    CHANGING
      EX_OBJ       = L_WA_OBJ
    EXCEPTIONS
      FOREIGN_LOCK = 1
      OTHERS       = 99.

  L_SUBRC = SY-SUBRC.
ENDIF.

SWC_SET_TABLE CONTAINER 'Messages' L_WA_OBJ-ERRORS.

CALL FUNCTION 'ZINSTLN_RCAT_CLOSE'
  CHANGING
    EX_OBJ = L_WA_OBJ.

CASE L_SUBRC.
  WHEN 0. " do nothing after commit
*----|START-OF-CHANGE|MMRobson|07/14/2011|CM_WFL_370|----*
    IF L_COMMIT = 'X'.
      IF L_WAIT = 'X'.
        COMMIT WORK AND WAIT.
      ELSE.
        COMMIT WORK.
      ENDIF.
    ENDIF.
*----|END-OF-CHANGE|MMRobson|07/14/2011|CM_WFL_370|----*
  WHEN 1. " foreign lock
    EXIT_RETURN 9001 SPACE SPACE SPACE SPACE.
  WHEN OTHERS.
    EXIT_RETURN 9002 SPACE SPACE SPACE SPACE.
ENDCASE.
END_METHOD.

BEGIN_METHOD CHANGEDIRECT2 CHANGING CONTAINER.
***********************************************************************
* Programmer:  Michael Robson  Date:      05/05/2010
* Change:      CM159974        Transport: E2DK905598
* Created as a wrapper to the Instln.ChangeDirect method. If a new
* rate category is given without a billing class, then the billing
* class is found for the given rate category and added to the changed
* fields.
***********************************************************************
DATA: L_WA_FIELDS  TYPE ISU_INSTLN_CHANGE_DIRECT,
      L_WA_FIELDSX TYPE ISU_INSTLN_CHANGE_DIRECT_X.

DATA: L_KEYDATE             LIKE SYST-DATUM,
      L_PRORATE             LIKE REGEN-KENNZX,
      L_AUTHORIZATION_GROUP TYPE EANL-BEGRU.



SWC_CONTAINER L_WA_CONT.

SWC_GET_ELEMENT CONTAINER 'KeyDate'             L_KEYDATE.
SWC_GET_ELEMENT CONTAINER 'Prorate'             L_PRORATE.
SWC_GET_ELEMENT CONTAINER 'InstallationFields'  L_WA_FIELDS.
SWC_GET_ELEMENT CONTAINER 'InstallationFieldsX' L_WA_FIELDSX.
SWC_GET_ELEMENT CONTAINER 'AuthorizationGroup'  L_AUTHORIZATION_GROUP.

IF L_WA_FIELDSX-TARIFTYP IS NOT INITIAL AND
   L_WA_FIELDS-TARIFTYP  IS NOT INITIAL AND
   L_WA_FIELDSX-AKLASSE  IS INITIAL.
* A rate category change is being requested without specifying the
* billing class. Add the billing class of the new rate category to
* the fields and selection fields structures, in case the new rate
* category is on a different billing class.
  SELECT SINGLE AKLASSE
    INTO L_WA_FIELDS-AKLASSE
    FROM ETTA
    WHERE TARIFTYP = L_WA_FIELDS-TARIFTYP.
  IF SY-SUBRC = 0.
    L_WA_FIELDSX-AKLASSE = 'X'.
  ENDIF.
ENDIF.

SWC_SET_ELEMENT L_WA_CONT 'KeyDate'             L_KEYDATE.
SWC_SET_ELEMENT L_WA_CONT 'Prorate'             L_PRORATE.
SWC_SET_ELEMENT L_WA_CONT 'InstallationFields'  L_WA_FIELDS.
SWC_SET_ELEMENT L_WA_CONT 'InstallationFieldsX' L_WA_FIELDSX.
SWC_SET_ELEMENT L_WA_CONT 'AuthorizationGroup'  L_AUTHORIZATION_GROUP.

SWC_CALL_METHOD SELF 'ChangeDirect' L_WA_CONT.

CASE SY-SUBRC.
  WHEN 0.      " success, do nothing
  WHEN 1001.   " foreign lock
    EXIT_RETURN 1001 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  WHEN 1002.   " not authorized
    EXIT_RETURN 1002 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  WHEN 1003.   " other errors
    EXIT_RETURN 1003 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  WHEN 1004.   " not found
    EXIT_RETURN 1004 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  WHEN 1005.   " invalid key date
    EXIT_RETURN 1005 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  WHEN 1006.   " input error
    EXIT_RETURN 1006 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
ENDCASE.
END_METHOD.

BEGIN_METHOD CHANGEDIRECT3 CHANGING CONTAINER.

TYPES: BEGIN OF TY_EANLH,
         ANLAGE   TYPE ANLAGE,
         BIS      TYPE BISZEITSCH,
         AB       TYPE ABZEITSCH,
         TARIFTYP TYPE TARIFTYP_ANL,
       END OF TY_EANLH .

DATA: L_WA_FIELDS  TYPE ISU_INSTLN_CHANGE_DIRECT,
      L_WA_FIELDSX TYPE ISU_INSTLN_CHANGE_DIRECT_X.

DATA: L_KEYDATE             LIKE SYST-DATUM,
      L_RE_KEYDATE          TYPE SYST-DATUM,
      L_PRORATE             LIKE REGEN-KENNZX,
      L_AUTHORIZATION_GROUP TYPE EANL-BEGRU,
      L_CONTRACT            TYPE VERTRAG.

DATA: LI_EANLH  TYPE STANDARD TABLE OF TY_EANLH INITIAL SIZE 0,
      LWA_EANLH TYPE TY_EANLH .
* E2DK923261       BJAYARAM     RM00066791 - Add two variables
DATA: W_CURRENT_CONTRACT LIKE EVER-VERTRAG ,      " Contract no.
      W_CONTRACT_OBJECT  TYPE SWC_OBJECT .         " Ref Contract obj

SWC_CONTAINER L_WA_CONT.

SWC_GET_ELEMENT CONTAINER 'KeyDate'             L_KEYDATE.
SWC_GET_ELEMENT CONTAINER 'RE_KEYDATE'          L_RE_KEYDATE.
SWC_GET_ELEMENT CONTAINER 'Prorate'             L_PRORATE.
SWC_GET_ELEMENT CONTAINER 'InstallationFields'  L_WA_FIELDS.
SWC_GET_ELEMENT CONTAINER 'InstallationFieldsX' L_WA_FIELDSX.
SWC_GET_ELEMENT CONTAINER 'AuthorizationGroup'  L_AUTHORIZATION_GROUP.

* E2DK923261       BJAYARAM     RM00066791 - Read Contract#
* Read the current contract no. from BOR object of installation instance
SWC_GET_PROPERTY SELF 'CurrentContract'  W_CONTRACT_OBJECT.
SWC_GET_PROPERTY W_CONTRACT_OBJECT 'Number' W_CURRENT_CONTRACT.


IF L_WA_FIELDSX-TARIFTYP IS NOT INITIAL.
* A rate category change is being requested. If the installation is
* under a contract on the given key date, then we are not allowed
* to do a direct rate category change.
  SELECT VERTRAG UP TO 1 ROWS
    INTO L_CONTRACT
    FROM EVER
    WHERE ANLAGE   = OBJECT-KEY-NUMBER
      AND AUSZDAT >= L_KEYDATE
      AND EINZDAT <= L_KEYDATE
* E2DK923261       BJAYARAM     RM00066791 - Add two variables
      AND VERTRAG <> W_CURRENT_CONTRACT.
  ENDSELECT.
  IF SY-SUBRC = 0.
*   There is a contract, exit right away.
    EXIT_RETURN 1007 L_CONTRACT OBJECT-KEY-NUMBER L_KEYDATE SPACE.
  ENDIF.

  IF L_WA_FIELDSX-AKLASSE  IS INITIAL.
*   A rate category change is being requested without specifying the
*   billing class. Add the billing class of the new rate category to
*   the fields and selection fields structures, in case the new rate
*   category is on a different billing class.
    SELECT SINGLE AKLASSE
      INTO L_WA_FIELDS-AKLASSE
      FROM ETTA
      WHERE TARIFTYP = L_WA_FIELDS-TARIFTYP.
    IF SY-SUBRC = 0.
      L_WA_FIELDSX-AKLASSE = 'X'.
    ENDIF.
  ENDIF.
ENDIF.

SELECT  ANLAGE
        BIS
        AB
        TARIFTYP
  FROM EANLH
  INTO TABLE LI_EANLH
   WHERE ANLAGE  = OBJECT-KEY
   AND AB       >= L_KEYDATE
   AND AB       <= L_RE_KEYDATE .
IF SY-SUBRC = 0 .

  LOOP AT LI_EANLH INTO LWA_EANLH .
    SWC_SET_ELEMENT L_WA_CONT 'KeyDate'             LWA_EANLH-AB.
    SWC_SET_ELEMENT L_WA_CONT 'Prorate'             L_PRORATE.
    SWC_SET_ELEMENT L_WA_CONT 'InstallationFields'  L_WA_FIELDS.
    SWC_SET_ELEMENT L_WA_CONT 'InstallationFieldsX' L_WA_FIELDSX.
    SWC_SET_ELEMENT L_WA_CONT 'AuthorizationGroup'
      L_AUTHORIZATION_GROUP.

    SWC_CALL_METHOD SELF 'ChangeDirect' L_WA_CONT.

    CASE SY-SUBRC.
      WHEN 0.      " success, do nothing
      WHEN 1001.   " foreign lock
        EXIT_RETURN 1001 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      WHEN 1002.   " not authorized
        EXIT_RETURN 1002 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      WHEN 1003.   " other errors
        EXIT_RETURN 1003 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      WHEN 1004.   " not found
        EXIT_RETURN 1004 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      WHEN 1005.   " invalid key date
        EXIT_RETURN 1005 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      WHEN 1006.   " input error
        EXIT_RETURN 1006 SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
    ENDCASE.
  ENDLOOP .
ENDIF .
END_METHOD.

BEGIN_METHOD GETRECORDERCODECRM CHANGING CONTAINER.

************************************************************************
* Created by  : Vinay Gorrela
* Created on  : 10/10/2011
* Description : This is a copy of existing GETRECORDERCODE method
*               Determine reconnect order code.  Assumption is a meter
************************************************************************
* Changed by  :
* Change date :
* Description :
************************************************************************
CONSTANTS: C_DISCON_STATUS TYPE EDISCDOC-STATUS VALUE '21',
           C_MARKED        TYPE C VALUE 'X'.
DATA:
  LV_HARDSHIPFLAG TYPE ZTFO_REC_ORD_CD-HARDSHIP_FLAG,
  MOVEINONLY      TYPE REGEN-KENNZX,
  HARDSHIPFLAG    TYPE EBAGEN-ACTSTAT,
  ORDERCODEDTLS   TYPE ZTFO_REC_ORD_CD,
*     lv_discdocstatus TYPE ediscdoc-status,
  LV_INSTSTATUS   TYPE EDISCOBJ-DISCSTATE,
*     o_discdoc        TYPE swc_object OCCURS 0,
  LV_DISCNO       TYPE EDISCDOC-DISCNO,
  O_DIVISION      TYPE SWC_OBJECT,
  O_CONTRACT      TYPE SWC_OBJECT OCCURS 0,
  WA_CONTRACT     TYPE SWC_OBJECT,
  WA_DISCDOC      TYPE SWC_OBJECT,
  I_CONTAINER     TYPE TABLE OF SWCONT,
  LV_DISCTYPE     TYPE EDISCPOS-DISCTYPE,
  LV_DIVISION     TYPE TSPA-SPART,
  LV_DISCREASON   TYPE EDISCDOC-DISCREASON,
  LV_DUNNING_FLAG TYPE KENNZX,
  LV_MOVEIN_DATE  TYPE EVER-EINZDAT.
DATA : WA_ERR_MSG TYPE ZSFO_BAL_MSG,
       IT_ERR_MSG TYPE STANDARD TABLE OF ZSFO_BAL_MSG.
DATA : L_V_ANLAGE TYPE ANLAGE.
SWC_GET_OBJECT_KEY SELF L_V_ANLAGE.
SWC_GET_TABLE CONTAINER 'ErrMsg' IT_ERR_MSG.

SWC_GET_ELEMENT CONTAINER 'HardshipFlag' HARDSHIPFLAG.
SWC_GET_ELEMENT CONTAINER 'MoveInOnly' MOVEINONLY.
* swc_get_property self 'DiscDocStatus' lv_discdocstatus. "ADE

* CHECK lv_discdocstatus = c_discon_status. "ADE

SWC_GET_PROPERTY SELF 'Division' O_DIVISION.
SWC_GET_PROPERTY O_DIVISION 'Division' LV_DIVISION.
* swc_get_table_property self 'ActDisconnectionDocuments' o_discdoc."ADE
SWC_GET_TABLE_PROPERTY SELF 'CurrentContract' O_CONTRACT.
CASE HARDSHIPFLAG.
  WHEN '2'.
    MOVE C_MARKED TO LV_HARDSHIPFLAG.
  WHEN OTHERS.
    CLEAR LV_HARDSHIPFLAG.
ENDCASE.
* Start of commenting by ADE
* Loop at each disc activity for the one we want.
*LOOP AT o_discdoc INTO wa_discdoc.
*  swc_get_property wa_discdoc 'State' lv_discdocstatus.
** In the event that more than one disconnect doc exist perform the
** following check to ensure the status of 21.
*  CHECK lv_discdocstatus = c_discon_status.
*  swc_set_element container 'CURRDISCDOC' wa_discdoc.
** Get the reconnect reason
*  swc_get_property wa_discdoc 'Reason' lv_discreason.
*  CLEAR lv_dunning_flag.
** check if the reconnect should be dunning related.
*  IF lv_discreason = '01' AND moveinonly IS INITIAL.
*    LOOP AT o_contract INTO wa_contract.
*      swc_get_property wa_contract 'MoveInDate' lv_movein_date.
*      IF lv_movein_date < sy-datum.
*        MOVE 'X' TO lv_dunning_flag.
*        EXIT.
*      ENDIF.
*    ENDLOOP.
*  ENDIF.
**   Get the reconnect order type.
*  swc_set_element i_container 'Installation' object-key.
*  swc_call_method wa_discdoc 'DetermineDiscType' i_container.
*  swc_get_element i_container 'DiscType' lv_disctype.
*  SELECT * INTO ordercodedtls
*    FROM ztfo_rec_ord_cd UP TO 1 ROWS
*      WHERE hardship_flag = lv_hardshipflag
*        AND dunning_flag  = lv_dunning_flag
*        AND sparte        = lv_division
*        AND discreason    = lv_discreason
*        AND disctype      = lv_disctype.
*  ENDSELECT.
*  IF sy-subrc = 0.
*    EXIT.
*  ENDIF.
*ENDLOOP.
* End of commenting by ADE
CALL FUNCTION 'Z_GET_INSTLN_DISCON_STATUS'
  EXPORTING
    X_ANLAGE       = L_V_ANLAGE
  IMPORTING
    Y_STATUS       = LV_INSTSTATUS
    Y_DISCNO       = LV_DISCNO
  EXCEPTIONS
    INTERNAL_ERROR = 1
    OTHERS         = 2.
IF SY-SUBRC <> 0.
  MOVE :  SY-MSGID TO WA_ERR_MSG-MSGID,
          SY-MSGNO TO WA_ERR_MSG-MSGNO,
          SY-MSGTY TO WA_ERR_MSG-MSGTY,
          SY-MSGV1 TO WA_ERR_MSG-MSGV1,
          SY-MSGV2 TO WA_ERR_MSG-MSGV2,
          SY-MSGV3 TO WA_ERR_MSG-MSGV3,
          SY-MSGV4 TO WA_ERR_MSG-MSGV4.
  APPEND WA_ERR_MSG TO IT_ERR_MSG.
  SWC_SET_TABLE CONTAINER 'ErrMsg' IT_ERR_MSG.
  EXIT_RETURN 9002 SPACE SPACE SPACE SPACE.
ENDIF.

CHECK LV_INSTSTATUS = '03'. "Disconnection order generated

SWC_CREATE_OBJECT WA_DISCDOC 'DISCONNECT' LV_DISCNO.
SWC_SET_ELEMENT CONTAINER 'CURRDISCDOC' WA_DISCDOC.

* Get the reconnect reason
SWC_GET_PROPERTY WA_DISCDOC 'Reason' LV_DISCREASON.
CLEAR LV_DUNNING_FLAG.
* check if the reconnect should be dunning related.
IF LV_DISCREASON = '01' AND MOVEINONLY IS INITIAL.
  MOVE 'X' TO LV_DUNNING_FLAG.
ENDIF.

*   Get the reconnect order type.
SWC_SET_ELEMENT I_CONTAINER 'Installation' OBJECT-KEY.
SWC_CALL_METHOD WA_DISCDOC 'DetermineDiscType' I_CONTAINER.
SWC_GET_ELEMENT I_CONTAINER 'DiscType' LV_DISCTYPE.
SELECT * INTO ORDERCODEDTLS
  FROM ZTFO_REC_ORD_CD UP TO 1 ROWS
   WHERE HARDSHIP_FLAG = LV_HARDSHIPFLAG
      AND DUNNING_FLAG  = LV_DUNNING_FLAG
      AND SPARTE        = LV_DIVISION
      AND DISCREASON    = LV_DISCREASON
      AND DISCTYPE      = LV_DISCTYPE.
ENDSELECT.

IF ORDERCODEDTLS IS INITIAL.
  MOVE : 'ZFO_PMI'   TO WA_ERR_MSG-MSGID,
         '013'       TO WA_ERR_MSG-MSGNO,
         'E'         TO WA_ERR_MSG-MSGTY,
         LV_DIVISION TO WA_ERR_MSG-MSGV1,
         LV_DISCTYPE TO WA_ERR_MSG-MSGV2,
         ' '         TO WA_ERR_MSG-PROBCLASS.
  APPEND WA_ERR_MSG TO IT_ERR_MSG.
  SWC_SET_TABLE CONTAINER 'ErrMsg' IT_ERR_MSG.
  EXIT_RETURN 9001 LV_DIVISION LV_DISCTYPE HARDSHIPFLAG SPACE.
ENDIF.
SWC_SET_ELEMENT CONTAINER 'OrderCodeDtls' ORDERCODEDTLS.


END_METHOD.

BEGIN_METHOD DEV_MODIF_ON_INSTL_CHANGE CHANGING CONTAINER.
*----|START-OF-CHANGE|HMS|12/01/2014|Post Cutover Billing R4B|----*
CONSTANTS : CO_DATE_INFINITE     TYPE ISU_TIMESL-AB              VALUE '99991231'.

TYPES : BEGIN OF TY_INST_DET,
          INST   TYPE ANLAGE,
          SERNR  TYPE GERNR,
          EQUNR  TYPE EQUNR,
          DEVLOC TYPE DEVLOC,
        END OF TY_INST_DET,

        BEGIN OF TY_EQUI_DET,
          EQUNR TYPE EQUNR,
          SERNR TYPE GERNR,
          MATNR TYPE MATNR,
        END OF TY_EQUI_DET.

DATA : LWA_INST_DET    TYPE TY_INST_DET,
       LWA_EQUI_DET    TYPE TY_EQUI_DET,
       LV_TARIFTYP     TYPE TARIFTYP,
       LV_OLD_TARIFTYP TYPE TARIFTYP,
       LV_ANLAGE       TYPE ANLAGE,
       LV_ACTVTY_DT    TYPE DATS,
       LV_DIVISION     TYPE SWC_OBJECT,
       LV_SPARTE       TYPE SPARTE.

CLEAR : LWA_INST_DET,
        LWA_EQUI_DET,
        LV_ANLAGE,
        LV_ACTVTY_DT.



SWC_GET_PROPERTY SELF 'Division' LV_DIVISION.
SWC_GET_PROPERTY LV_DIVISION 'Division' LV_SPARTE.
SWC_GET_ELEMENT CONTAINER 'Old_RateCategory' LV_OLD_TARIFTYP.
SWC_GET_ELEMENT CONTAINER 'New_RateCategory' LV_TARIFTYP.

SWC_GET_OBJECT_KEY SELF LV_ANLAGE.

CHECK LV_SPARTE = '01'.
*    lv_actvty_dt.
SELECT SINGLE A~ANLAGE
       B~LOGIKNR
       B~EQUNR
       B~DEVLOC
INTO LWA_INST_DET
FROM EASTL AS A
INNER JOIN EGERH AS B ON A~LOGIKNR = B~LOGIKNR
WHERE A~ANLAGE = LV_ANLAGE AND
      A~BIS = CO_DATE_INFINITE AND
      B~BIS = CO_DATE_INFINITE AND
      B~KOMBINAT IN ('Z', 'M' ).
IF SY-SUBRC IS INITIAL.
  SELECT SINGLE EQUNR
                SERNR
                MATNR
         INTO LWA_EQUI_DET
         FROM EQUI
         WHERE EQUNR = LWA_INST_DET-EQUNR.
  IF SY-SUBRC IS INITIAL.
    SELECT SINGLE AB
                  TARIFTYP
           INTO (LV_ACTVTY_DT, LV_TARIFTYP)
           FROM EANLH
           WHERE ANLAGE = LV_ANLAGE AND
                 BIS = CO_DATE_INFINITE.
    IF SY-SUBRC IS INITIAL.
