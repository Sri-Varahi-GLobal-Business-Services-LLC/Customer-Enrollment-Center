BEGIN_METHOD ZOBTAININSTLNSTATUS CHANGING CONTAINER.
************************************************************************
* Created by  : Gilbert Chong
* Created on  : 10/03/2007
* Description : Obtain installation information
* Reason      : Defect 6712
************************************************************************

* Declaration
DATA : O_MARKEDINSTLN TYPE SWC_OBJECT,
       L_MOVEDOUTDATE TYPE EVER-AUSZDAT,
       IT_ODEV        TYPE SWC_OBJECT OCCURS 0 WITH HEADER LINE,
       L_CONTRACT     TYPE VERTRAG,
       L_EQUNR        TYPE EQUNR,
       L_LOGIKNR      TYPE LOGIKNR,
       L_INSTLN       TYPE ANLAGE,
       L_INSTALLDATE  TYPE ABZEITSCH,
       O_MARKEDDEVICE TYPE SWC_OBJECT,
       O_MOVEIN       TYPE SWC_OBJECT,
       L_MOVEIN       TYPE EINZBELEG.

* Initialisation
CLEAR : O_MARKEDINSTLN, L_MOVEDOUTDATE, IT_ODEV, L_CONTRACT,
        IT_ODEV[], L_EQUNR, L_LOGIKNR, L_INSTLN,
        L_INSTALLDATE, O_MARKEDDEVICE, O_MOVEIN, L_MOVEIN.

* Get the initial values.
SWC_GET_ELEMENT CONTAINER 'MoveInObj'    O_MOVEIN.
SWC_GET_ELEMENT CONTAINER 'MarkedInstln' O_MARKEDINSTLN.
SWC_GET_OBJECT_KEY O_MARKEDINSTLN L_INSTLN.
SWC_GET_OBJECT_KEY O_MOVEIN       L_MOVEIN.

* Check for the device installation installation
SWC_GET_TABLE_PROPERTY O_MARKEDINSTLN 'CurrentDevices' IT_ODEV.
* Set values if devices found
IF NOT IT_ODEV IS INITIAL.
* Find the contract
  SELECT SINGLE VERTRAG FROM EEINV
                        INTO L_CONTRACT
                       WHERE EINZBELEG EQ L_MOVEIN
                         AND ANLAGE    EQ L_INSTLN.
* Find a move-out date if contract found
  IF SY-SUBRC EQ 0.
    SELECT SINGLE AUSZDAT FROM EVER
                          INTO L_MOVEDOUTDATE
                         WHERE VERTRAG EQ L_CONTRACT
                           AND LOEVM   EQ SPACE.
  ENDIF.
ENDIF.

* Get the install date
LOOP AT IT_ODEV.
  CLEAR : L_EQUNR, L_LOGIKNR.
* Get the equipment number
  O_MARKEDDEVICE = IT_ODEV.
  SWC_GET_OBJECT_KEY IT_ODEV L_EQUNR.
* Obtain the logical device number
  SELECT SINGLE LOGIKNR FROM EGERH
                        INTO L_LOGIKNR
                       WHERE EQUNR EQ L_EQUNR
                         AND BIS   EQ C_FOREVER.
* Find the install date if successful
  IF SY-SUBRC EQ 0.
    SELECT SINGLE AB FROM EASTL
                     INTO L_INSTALLDATE
                    WHERE LOGIKNR EQ L_LOGIKNR
                      AND ANLAGE  EQ L_INSTLN.
    EXIT.
  ENDIF.
ENDLOOP.

* Pass the values out
SWC_SET_ELEMENT CONTAINER 'MovedOutDate' L_MOVEDOUTDATE.
SWC_SET_ELEMENT CONTAINER 'InstallDate'  L_INSTALLDATE.
SWC_SET_ELEMENT CONTAINER 'MarkedDevice' O_MARKEDDEVICE.
END_METHOD.

