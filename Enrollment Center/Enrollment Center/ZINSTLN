GET_PROPERTY SHORTTEXT CHANGING CONTAINER.

IF OBJECT-SHORTTEXT IS INITIAL.
  DATA:
    RC         LIKE SY-SUBRC,
    ADRLINES   LIKE EADRLN,
    DIVTEXT    LIKE TSPAT-VTEXT,
    LV_EANL    TYPE EANL,
    LV_STRING2 TYPE STRING2.

  CALL FUNCTION 'ISU_DB_EANLS_SINGLE'
    EXPORTING
      X_ANLAGE     = OBJECT-KEY-NUMBER
    IMPORTING
      Y_EANL       = LV_EANL
    EXCEPTIONS
      NOT_FOUND    = 1
      SYSTEM_ERROR = 2
      OTHERS       = 3.

  IF RC <> 0.
    EXIT_OBJECT_NOT_FOUND.
  ENDIF.

* get division-text
  SWC_GET_PROPERTY SELF 'DivisionText' DIVTEXT.

* get address
  CALL FUNCTION 'ISU_ADDRESS_PROVIDE'
    EXPORTING
      X_ADDRESS_TYPE   = 'I'
      X_LENGTH         = 39
      X_EANL           = LV_EANL
    IMPORTING
      Y_ADDR_LINES     = ADRLINES
    EXCEPTIONS
      NOT_FOUND        = 1
      PARAMETER_ERROR  = 2
      OBJECT_NOT_GIVEN = 3
      OTHERS           = 99.
  IF SY-SUBRC <> 0.
    CLEAR ADRLINES.
    ADRLINES-LINE1 = TEXT-001.
  ENDIF.
  OBJECT-SHORTTEXT(10)   = DIVTEXT.
  OBJECT-SHORTTEXT+10(1) = SY-VLINE.
  OBJECT-SHORTTEXT+11    = ADRLINES-LINE1.

*   if the installation is a child of an aggregate display the type
  SELECT SINGLE STRING2 FROM ETTIFN
    INTO LV_STRING2
    WHERE ANLAGE = OBJECT-KEY-NUMBER
      AND OPERAND = 'PRIME_INST'.
  IF SY-SUBRC EQ 0.
*   we also want the current rate category

    DATA : LV_RCAT     TYPE SWC_OBJECT,
           LV_TARIFTYP TYPE TARIFTYP.
    SWC_GET_PROPERTY SELF 'ActRateCat' LV_RCAT.
    SWC_GET_OBJECT_KEY LV_RCAT LV_TARIFTYP.
    CONCATENATE OBJECT-SHORTTEXT SY-VLINE LV_STRING2 SY-VLINE
              LV_TARIFTYP INTO OBJECT-SHORTTEXT.

  ENDIF.
ENDIF.

SWC_SET_ELEMENT CONTAINER 'ShortText' OBJECT-SHORTTEXT.
END_PROPERTY.

BEGIN_METHOD ZDETERMINEOARATECAT CHANGING CONTAINER.
************************************************************************
* Created by  : Gilbert Chong
* Created on  : 08/16/2007
* Description : Look for historical A_250 or A_260 rate category.
*               Otherwise default to A_250.
************************************************************************
* Changed by  : Ashwin Sonkusare
* Changed on  : 04/05/2011
* Object ID   : CM_WFL_230
* Transport   : E2DK911040
* Description : Changes done to update Rate Category of installation
*              with last Non-ROA rate category
************************************************************************
* Changed by  : Atul Kumar
* Changed on  : 16th Dec, 2015
* Transport   : E2DK943747
* Description : Changes done to update the Rate Category.
************************************************************************


* Constants
*CONSTANTS : c_a250 TYPE tariftyp_anl VALUE 'A_250',
*            c_a260 TYPE tariftyp_anl VALUE 'A_260'.
*  Begin of changes by ANSONKUS for CM_WFL_230
TYPES: BEGIN OF T_ETTAF,
         TARIFTYP TYPE TARIFTYP,
       END OF T_ETTAF .
*  End of changes by ANSONKUS for CM_WFL_230
*Declaration
TYPES : BEGIN OF T_INSTRATECAT,
          BIS      TYPE BISZEITSCH,
          TARIFTYP TYPE TARIFTYP_ANL,
        END OF T_INSTRATECAT.
TYPES: BEGIN OF TYPE_RESULT,
         ANLAGE TYPE ANLAGE,
       END OF TYPE_RESULT.

DATA : L_UPDRATECAT        TYPE EANLH-TARIFTYP,
       IT_INSTRATECAT      TYPE T_INSTRATECAT OCCURS 0 WITH HEADER LINE,
       LV_CURRENT_RATE_CAT TYPE EANLD-TARIFTYP.

* Begin of changes by MMRobson for CM_WFL_230
*DATA: it_results TYPE TABLE OF type_result,
*      lv_results LIKE LINE OF it_results.
* End of changes by MMRobson for CM_WFL_230

* Begin of changes by ANSONKUS for CM_WFL_230
DATA: I_ETTAF TYPE STANDARD TABLE OF T_ETTAF INITIAL SIZE 0.
* End of changes by ANSONKUS for CM_WFL_230

CLEAR : IT_INSTRATECAT, IT_INSTRATECAT[].

* Get the current rate category
SWC_GET_PROPERTY SELF 'ZRateCat' LV_CURRENT_RATE_CAT.
* Begin of changes by MMROBSON for CM_WFL_230
*SELECT start_tariftyp INTO TABLE it_results
*  FROM zide_rcat_sw
*    WHERE end_tariftyp = lv_current_rate_cat.
* End of changes by MMROBSON for CM_WFL_230


*{ Start of change for RM00157175 by Akumar9 on 16th Dec, 2015
DATA: LO_DIVISION    TYPE SWC_OBJECT,
      LV_DIVISION    TYPE EANL-SPARTE,
      LO_CONTRACT    TYPE SWC_OBJECT,
      LV_CONTRACT    TYPE VERTRAG,
      IT_O_CONTRACTS TYPE TABLE OF SWC_OBJECT WITH HEADER LINE,
      LV_ACNT_CLASS  TYPE FKKVKP-KTOKL,
      LV_CNTRCT_ACNT TYPE EVER-VKONTO,
      IT_RATE_CAT    TYPE TABLE OF ZTFO_DFLT_RATE,
      WA_RATE_CAT    TYPE ZTFO_DFLT_RATE.


CLEAR : LV_DIVISION, LV_CONTRACT, LV_CNTRCT_ACNT, LV_ACNT_CLASS.

* Getting the Divison here.
SWC_GET_PROPERTY SELF 'Division' LO_DIVISION.
SWC_GET_OBJECT_KEY LO_DIVISION LV_DIVISION.

* Getting the Contract here.
SWC_GET_TABLE_PROPERTY SELF 'IsuContracts' IT_O_CONTRACTS.

LOOP AT IT_O_CONTRACTS.
*  swc_get_object_key it_o_contracts lv_contract.
  SWC_GET_PROPERTY IT_O_CONTRACTS 'Number' LV_CONTRACT.
ENDLOOP.

IF LV_CONTRACT IS NOT INITIAL.
* Fetching the Contract Account number based on Contract
  SELECT SINGLE VKONTO
    FROM EVER
    INTO LV_CNTRCT_ACNT
    WHERE VERTRAG = LV_CONTRACT.

  IF SY-SUBRC = 0.
* Fetching the Account class based on Contract Account
    SELECT SINGLE KTOKL
      FROM FKKVKP
      INTO LV_ACNT_CLASS
      WHERE VKONT = LV_CNTRCT_ACNT.
  ENDIF.
ENDIF.

*{ Ins : Tapas Pradhan : RM00157175 : 22nd Feb, 2016
* For Account class 'IND', the FM to get the rate category was not working.
* So added the below code.
IF LV_ACNT_CLASS = 'IND'.
  CLEAR : IT_RATE_CAT[], WA_RATE_CAT.

  SELECT *
    FROM ZTFO_DFLT_RATE INTO TABLE IT_RATE_CAT
    WHERE CLASS  = LV_ACNT_CLASS
      AND SPARTE = LV_DIVISION.

  IF SY-SUBRC = 0.
    SORT IT_RATE_CAT BY CLASS SPARTE SP_TARIFTYP.
    DELETE ADJACENT DUPLICATES FROM IT_RATE_CAT COMPARING CLASS SPARTE SP_TARIFTYP.

    READ TABLE IT_RATE_CAT INTO WA_RATE_CAT WITH KEY CLASS       = LV_ACNT_CLASS
                                                     SPARTE      = LV_DIVISION
                                                     SP_TARIFTYP = LV_CURRENT_RATE_CAT BINARY SEARCH.
    IF SY-SUBRC = 0.
      L_UPDRATECAT = WA_RATE_CAT-NEW_TARIFTYP.

    ELSE.
      READ TABLE IT_RATE_CAT INTO WA_RATE_CAT WITH KEY CLASS       = LV_ACNT_CLASS
                                                       SPARTE      = LV_DIVISION
                                                       SP_TARIFTYP = SPACE BINARY SEARCH.
      IF SY-SUBRC = 0.
        L_UPDRATECAT = WA_RATE_CAT-NEW_TARIFTYP.
      ENDIF.
    ENDIF.
  ENDIF.

ELSE.
*} Ins : Tapas Pradhan : RM00157175 : 25th Feb, 2016
*   Getting the new Rate Category here.
  CALL FUNCTION 'Z_GET_NEW_MI_RATE_CAT'
    EXPORTING
      IM_CLASS            = LV_ACNT_CLASS           " Account Class
      IM_DIVISION         = LV_DIVISION             " Divison
      IM_CURRENT_RATE_CAT = LV_CURRENT_RATE_CAT     " Current Rate Category
    IMPORTING
      EX_NEW_RATE_CAT     = L_UPDRATECAT.           " New Rate Category
ENDIF.                                " Ins : Tapas Pradhan : RM00157175 : 25th Feb, 2016

CLEAR : LV_DIVISION, LV_CONTRACT, LV_CNTRCT_ACNT, LV_ACNT_CLASS.


* Current rate category will be equal to Update rate category, when there is no entry in the table ZTFO_DFLT_RATE.
* In that case, the New rate category will be updated as per old logic.
IF LV_CURRENT_RATE_CAT = L_UPDRATECAT.

  CLEAR : L_UPDRATECAT.
*} End of change for RM00157175 by Akumar9 on 16th Dec, 2015

* The current rate category needs to change to full service
  IF SY-SUBRC = 0.
  ENDIF.
*   Get all rate category history
  SELECT BIS TARIFTYP FROM EANLH
     INTO TABLE IT_INSTRATECAT
    WHERE ANLAGE EQ OBJECT-KEY
      AND BIS NE '99991231'.

*   Sort and check the results
  SORT IT_INSTRATECAT DESCENDING BY BIS.
* Begin of changes by ANSONKUS for CM_WFL_230
  IF IT_INSTRATECAT[] IS NOT INITIAL.
    SELECT TARIFTYP
      FROM ETTAF
      INTO TABLE I_ETTAF
      FOR ALL ENTRIES IN IT_INSTRATECAT
      WHERE ( TARIFTYP = IT_INSTRATECAT-TARIFTYP OR
      TARIFTYP = LV_CURRENT_RATE_CAT ) AND
       ( OPERAND = 'FLG_ROA' OR OPERAND = 'FLGG_ROA' ) .
    IF SY-SUBRC = 0 .
      SORT I_ETTAF BY  TARIFTYP .
    ENDIF .
*endif .

    READ TABLE I_ETTAF WITH KEY TARIFTYP = LV_CURRENT_RATE_CAT
    BINARY SEARCH TRANSPORTING NO FIELDS .
    IF SY-SUBRC = 0 .
* End of changes by ANSONKUS for CM_WFL_230
      LOOP AT IT_INSTRATECAT.
*      read table it_results into lv_results with key
*                                      anlage = it_instratecat-tariftyp.
*       if sy-subrc = 0.
*
* Begin of changes by ANSONKUS for CM_WFL_230
        READ TABLE I_ETTAF WITH KEY TARIFTYP = IT_INSTRATECAT-TARIFTYP
        BINARY SEARCH TRANSPORTING NO FIELDS .
        IF SY-SUBRC NE 0 .
* End of changes by ANSONKUS for CM_WFL_230

          L_UPDRATECAT = IT_INSTRATECAT-TARIFTYP.
          EXIT.
* Begin of changes by ANSONKUS for CM_WFL_230
        ENDIF .
* End of changes by ANSONKUS for CM_WFL_230
*       endif.
      ENDLOOP.
    ENDIF.
* Begin of changes by ANSONKUS for CM_WFL_230
  ENDIF.
* End of changes by ANSONKUS for CM_WFL_230
ENDIF.          " Inserted by Akumar9 for RM00157175 : SAP Owner AllocationMove In change request


* Set value for return
SWC_SET_ELEMENT CONTAINER 'UpdRateCat' L_UPDRATECAT.

END_METHOD.

