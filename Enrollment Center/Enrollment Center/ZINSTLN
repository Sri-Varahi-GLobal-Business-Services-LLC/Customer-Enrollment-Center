BEGIN_METHOD GETTIMESLICES CHANGING CONTAINER.
************************************************************************
* Programmer:  Michael Robson
* Date:        02/24/2009
* SC Problem:  PM797408
* Transport:   ECDK956709
* Description: Created to return installation time slice records. If
*              no offsets are given, then only the currently active
*              time slice record will be returned. If offsets are
*              given, then the resulting time slice table will contain
*              one record per offset record. The record positions will
*              corresond. Offsets start from zero and increment by 1.
*              Offset 0 represents the time slice record with the
*              greatest end date. Offset 1 represents the time slice
*              with the next greatest end date and so on. If a time
*              slice record does not exist for a given offset, then
*              the time slice table will contain an empty record for
*              the corresponding position.
************************************************************************
* Programmer:  Ashwin Sonkusare
* Date:        05/05/2011
* Transport :  E2DK911786
* Description: If the MRU has been changed after move-in date.
*              Rate category reversal is not happening in installation.
*              changes are done in this method to fix this issue.
************************************************************************

DATA: LI_OFFSETS     TYPE TABLE OF SYST-INDEX,
      LI_TIME_SLICES LIKE EANLH OCCURS 0,
      LI_EANLH       TYPE TABLE OF EANLH.
DATA: LWA_EANLH TYPE EANLH.
DATA: L_OFFSET TYPE SYST-INDEX.

* Begin of changes by ANSONKUS for CM_WFL_240
DATA: L_KEYDATE    TYPE EINZDAT,  "Move-in date
      L_RE_KEYDATE TYPE EINZDAT.
* End of changes by ANSONKUS for CM_WFL_240

SWC_GET_TABLE CONTAINER 'Offsets' LI_OFFSETS.

* Begin of changes by ANSONKUS for CM_WFL_240
* Get the move-in date from container
CLEAR: L_KEYDATE .
SWC_GET_ELEMENT CONTAINER 'KEYDATE' L_KEYDATE .

* End of changes by ANSONKUS for CM_WFL_240



CLEAR: LI_TIME_SLICES, LI_TIME_SLICES[].

IF OBJECT-KEY IS INITIAL.
  EXIT_OBJECT_NOT_FOUND.
ELSEIF LI_OFFSETS[] IS INITIAL.
* Get the current active time slice record
  SELECT *
    INTO TABLE LI_TIME_SLICES
    FROM EANLH
    WHERE ANLAGE  = OBJECT-KEY-NUMBER
      AND BIS    >= SY-DATUM
      AND AB     <= SY-DATUM.
ELSE.
* Get all time slice records for this installation
  SELECT *
    INTO TABLE LI_EANLH
    FROM EANLH
    WHERE ANLAGE = OBJECT-KEY-NUMBER.

* Begin of changes by ANSONKUS for CM_WFL_240
  IF SY-SUBRC = 0 .
    SORT LI_EANLH BY BIS DESCENDING.
*  Fetch only those records for which start date is less
*  than move-in date
    CLEAR LWA_EANLH.
    READ TABLE LI_EANLH INTO LWA_EANLH INDEX 1.
    IF SY-SUBRC = 0 .
      L_RE_KEYDATE =  LWA_EANLH-AB .
      SWC_SET_ELEMENT CONTAINER 'RE_KEYDATE'  L_RE_KEYDATE .
    ENDIF.
    DELETE LI_EANLH WHERE AB >  L_KEYDATE .
  ENDIF.
* End of changes by ANSONKUS for CM_WFL_240

  LOOP AT LI_OFFSETS INTO L_OFFSET.
    CLEAR LWA_EANLH.
*   Offsets are one less than the corresponding table index
    ADD 1 TO L_OFFSET.

    IF L_OFFSET > 0.
      READ TABLE LI_EANLH INTO LWA_EANLH INDEX L_OFFSET.
    ENDIF.

    APPEND LWA_EANLH TO LI_TIME_SLICES.
  ENDLOOP.
ENDIF.

SWC_SET_TABLE CONTAINER 'TimeSlices' LI_TIME_SLICES.
END_METHOD.

BEGIN_METHOD GETOPENPERIODICREAD CHANGING CONTAINER.
***********************************************************************
* Programmer:  Michael Robson
* Date:        04/01/2009
* SC Problem:  PM800192
* Transport:   ECDK957944
* Description: Created to return the billing period date for this
*              installation instance. The billing period date is
*              adjusted by the given period offset parameter.
*
*              05/07/2009 - Added a key date. If the schedule date is
*              greater than the key date, then the periodic date should
*              not be found.
***********************************************************************
* Programmer:  Michael Robson  Date:      10/20/2009
* SC Ticket:   PM873361        Transport: ECDK962037
* Description: Updated to look ahead in the schedule if an open
* periodic read cannot be found.
***********************************************************************

CHECK OBJECT-KEY-NUMBER IS NOT INITIAL.

*----|START-OF-CHANGE|MMRobson|10/20/2009|PM873361|----*
*DATA: l_read_unit          TYPE v_eabl-ableinh,
*      l_sched_date         TYPE v_eabl-adatsoll,
*      l_period_date_offset TYPE syst-index,
DATA: L_PERIOD_DATE_OFFSET TYPE SYST-INDEX,
*----|END-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*
      L_PERIOD_DATE        TYPE TE418-TERMTDAT,
      L_KEY_DATE           TYPE SYST-DATUM.

*----|START-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*
DATA: BEGIN OF L_I_MRDOCS OCCURS 0,
        READ_UNIT  TYPE V_EABL-ABLEINH,
        SCHED_DATE TYPE V_EABL-ADATSOLL,
      END OF L_I_MRDOCS,
      L_I_BILLING_PERIOD_DATES TYPE TABLE OF TE418-TERMTDAT.
DATA: L_WA_MRDOC LIKE LINE OF L_I_MRDOCS.
DATA: L_LOOK_AHEAD_DAYS TYPE SYST-INDEX,
      L_LOOK_AHEAD_DATE TYPE SYST-DATUM.
*----|END-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*

SWC_GET_ELEMENT CONTAINER 'KeyDate'          L_KEY_DATE.
SWC_GET_ELEMENT CONTAINER 'PeriodDateOffset' L_PERIOD_DATE_OFFSET.

*----|START-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*
SWC_GET_ELEMENT CONTAINER 'LookAheadDays' L_LOOK_AHEAD_DAYS.
*----|END-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*

* Find an open, periodic meter read record for this installation object
*----|START-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*
*SELECT ABLEINH         " Meter read unit
*       ADATSOLL        " Scheduled meter reading date
*  FROM V_EABL UP TO 1 ROWS
*  INTO (L_READ_UNIT, L_SCHED_DATE)
*  WHERE ANLAGE  = OBJECT-KEY-NUMBER
*    AND ABLESGR = '01' " Meter read reason = periodic meter reading
*    AND ABLSTAT = '0'. " Meter read status = created.
*ENDSELECT.
*
*IF sy-subrc = 0 AND l_sched_date <= l_key_date.
** Get the billing period date for the retrieved meter read record
*  SELECT termtdat                 " Date of schedule record, A.K.A
*    FROM te418 UP TO 1 ROWS       " billing period date
*    INTO l_period_date
*    WHERE adatsoll = l_sched_date " Scheduled meter reading date
*      AND termschl = l_read_unit. " Schedule record for meter read unit
*  ENDSELECT.
*
*  IF sy-subrc = 0.
**   Modify the period date by the offset
*    ADD l_period_date_offset TO l_period_date.
*  ENDIF.
*ENDIF.

* Find an open periodic read document
SELECT ABLEINH                         " Meter read unit
       ADATSOLL                        " Scheduled meter reading date
  FROM V_EABL
  INTO TABLE L_I_MRDOCS
  WHERE ANLAGE    = OBJECT-KEY-NUMBER  " Installation number
    AND ABLESGR   = '01'               " Periodic meter reading reason
    AND ABLSTAT   = '0'                " Created status
    AND ADATSOLL <= L_KEY_DATE.        " Scheduled meter reading date

IF SY-SUBRC = 0.
* At least one is found, get the latest record
  SORT L_I_MRDOCS DESCENDING BY SCHED_DATE.
  READ TABLE L_I_MRDOCS INTO L_WA_MRDOC INDEX 1.

* Find the billing period date
  SELECT TERMTDAT
    FROM TE418
    INTO TABLE L_I_BILLING_PERIOD_DATES
    WHERE TERMSCHL = L_WA_MRDOC-READ_UNIT
      AND ADATSOLL = L_WA_MRDOC-SCHED_DATE.
ELSEIF L_LOOK_AHEAD_DAYS IS NOT INITIAL.
* An open periodic read could not be found. Look for a future scheduled
* read within the look-ahead days threshold.
  L_LOOK_AHEAD_DATE = L_KEY_DATE + L_LOOK_AHEAD_DAYS.
  IF L_LOOK_AHEAD_DATE >= SY-DATUM.
*   The look-ahead date, the upper bound, must be equal to or greater
*   than the current date, the lower bound.
    SWC_GET_PROPERTY SELF 'ActReadUnitKey' L_WA_MRDOC-READ_UNIT.
    IF L_WA_MRDOC-READ_UNIT IS NOT INITIAL.
      SELECT TERMTDAT
        FROM TE418
        INTO TABLE L_I_BILLING_PERIOD_DATES
        WHERE TERMSCHL  = L_WA_MRDOC-READ_UNIT
          AND ADATSOLL >= SY-DATUM
          AND ADATSOLL <= L_LOOK_AHEAD_DATE.
    ENDIF.
  ENDIF.
ENDIF.

IF L_I_BILLING_PERIOD_DATES[] IS NOT INITIAL.
* Billing period dates found, get the earliest one
  SORT L_I_BILLING_PERIOD_DATES ASCENDING.
  READ TABLE L_I_BILLING_PERIOD_DATES INTO L_PERIOD_DATE INDEX 1.

* Add the offset to the date
  ADD L_PERIOD_DATE_OFFSET TO L_PERIOD_DATE.
ENDIF.
*----|END-OF-CHANGE|MMRobson|10/19/2009|PM873361|----*

SWC_SET_ELEMENT CONTAINER 'PeriodDate' L_PERIOD_DATE.
END_METHOD.

BEGIN_METHOD GETFACTS CHANGING CONTAINER.
***********************************************************************
* Programmer:  Michael Robson
* Date:        05/19/2009
* SC Problem:  PM844409
* Transport:   ECDK954607
* Description: Created to return the installation facts.
***********************************************************************
CHECK OBJECT-KEY IS NOT INITIAL.

DATA: L_I_NORMAL_FACTS      TYPE TABLE OF ETTIFN,
      L_I_REFERENCE_FACTS   TYPE TABLE OF ETTIFB,
      L_I_SPECIFIC_OPERANDS TYPE TABLE OF E_OPERAND.
DATA: L_WA_NORMAL_FACT    TYPE ETTIFN,
      L_WA_REFERENCE_FACT TYPE ETTIFB.
DATA: L_KEY_DATE    TYPE SYST-DATUM,
      L_ONLY_ACTIVE TYPE SYST-BATCH,
      L_FROM_DATE   TYPE SYST-DATUM,
      L_TO_DATE     TYPE SYST-DATUM,
      L_OPERAND     TYPE E_OPERAND,
      L_INDEX       TYPE SYST-TABIX.

SWC_GET_ELEMENT CONTAINER 'KeyDate'       L_KEY_DATE.
SWC_GET_ELEMENT CONTAINER 'OnlyActive'    L_ONLY_ACTIVE.
SWC_GET_ELEMENT CONTAINER 'SpecificOperands' L_I_SPECIFIC_OPERANDS.

IF L_KEY_DATE IS INITIAL.
  L_FROM_DATE = '19000101'.
  L_TO_DATE   = '99991231'.
ELSE.
  L_FROM_DATE = L_KEY_DATE.
  L_TO_DATE   = L_KEY_DATE.
ENDIF.

IF L_I_SPECIFIC_OPERANDS[] IS NOT INITIAL.
  SORT L_I_SPECIFIC_OPERANDS.
  DELETE ADJACENT DUPLICATES FROM L_I_SPECIFIC_OPERANDS.
ENDIF.

CALL FUNCTION 'ISU_DB_ETTIFN_SELECT'
  EXPORTING
    X_ANLAGE      = OBJECT-KEY-NUMBER
    X_AB          = L_FROM_DATE
    X_BIS         = L_TO_DATE
  IMPORTING
    Y_IETTIFN     = L_I_NORMAL_FACTS
  EXCEPTIONS
    NOT_FOUND     = 1
    NOT_QUALIFIED = 2
    OTHERS        = 3.

IF SY-SUBRC = 0 AND
   ( L_I_SPECIFIC_OPERANDS[] IS NOT INITIAL OR
     L_ONLY_ACTIVE           IS NOT INITIAL ).
* Remove unwanted fact operands
  LOOP AT L_I_NORMAL_FACTS INTO L_WA_NORMAL_FACT.
    L_INDEX = SY-TABIX.
    IF L_ONLY_ACTIVE = 'X' AND L_WA_NORMAL_FACT-INAKTIV = 'X'.
*     Inactive, remove the fact
      DELETE L_I_NORMAL_FACTS INDEX L_INDEX.
    ELSEIF L_I_SPECIFIC_OPERANDS[] IS NOT INITIAL.
      READ TABLE L_I_SPECIFIC_OPERANDS TRANSPORTING NO FIELDS
        WITH KEY TABLE_LINE = L_WA_NORMAL_FACT-OPERAND BINARY SEARCH.

      IF SY-SUBRC <> 0.
*       Not in the list, remove the fact
        DELETE L_I_NORMAL_FACTS INDEX L_INDEX.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDIF.

* Select all the reference facts
CALL FUNCTION 'ISU_DB_ETTIFB_SELECT'
  EXPORTING
    X_ANLAGE      = OBJECT-KEY-NUMBER
    X_AB          = L_FROM_DATE
    X_BIS         = L_TO_DATE
  IMPORTING
    Y_IETTIFB     = L_I_REFERENCE_FACTS
  EXCEPTIONS
    NOT_FOUND     = 1
    NOT_QUALIFIED = 2
    OTHERS        = 3.

IF L_I_SPECIFIC_OPERANDS[] IS NOT INITIAL AND
   L_I_REFERENCE_FACTS[] IS NOT INITIAL.
* Remove unspecified fact operands
  LOOP AT L_I_REFERENCE_FACTS INTO L_WA_REFERENCE_FACT.
    L_INDEX = SY-TABIX.
    READ TABLE L_I_SPECIFIC_OPERANDS TRANSPORTING NO FIELDS
      WITH KEY TABLE_LINE = L_WA_REFERENCE_FACT-OPERAND BINARY SEARCH.

    IF SY-SUBRC <> 0.
*     Remoev this fact, since the operand isn't in the specified list
      DELETE L_I_REFERENCE_FACTS INDEX L_INDEX.
    ENDIF.
  ENDLOOP.
ENDIF.

SWC_SET_TABLE CONTAINER 'NormalFacts'    L_I_NORMAL_FACTS.
SWC_SET_TABLE CONTAINER 'ReferenceFacts' L_I_REFERENCE_FACTS.
END_METHOD.

BEGIN_METHOD EXPIREFACTS CHANGING CONTAINER.
***********************************************************************
* Programmer:  Michael Robson
* Date:        05/29/2009
* SC Problem:  PM873559
* Transport:   ECDK954607
* Description: Created to change the end date for installation facts
*              that are active during the given date range for the
*              given operands. The ChangeFacts method does not behave
*              quite as expected.
***********************************************************************
CHECK OBJECT-KEY IS NOT INITIAL.
DATA: L_I_OPERANDS  TYPE TABLE OF ETTIFN-OPERAND,
      L_I_NEW_FACTS TYPE ISU_IETTIFN,
      L_I_OLD_FACTS TYPE ISU_IETTIFN.
DATA: L_WA_FACT LIKE LINE OF L_I_NEW_FACTS.
DATA: L_START_DATE   TYPE SYST-DATUM,
      L_END_DATE     TYPE SYST-DATUM,
      L_NEW_END_DATE TYPE SYST-DATUM,
      L_COMMIT       TYPE REGEN-KENNZX,
      L_WAIT         TYPE REGEN-KENNZX.

SWC_GET_TABLE   CONTAINER 'Operands'   L_I_OPERANDS.
SWC_GET_ELEMENT CONTAINER 'StartDate'  L_START_DATE.
SWC_GET_ELEMENT CONTAINER 'EndDate'    L_END_DATE.
SWC_GET_ELEMENT CONTAINER 'NewEndDate' L_NEW_END_DATE.
SWC_GET_ELEMENT CONTAINER 'Commit'     L_COMMIT.
SWC_GET_ELEMENT CONTAINER 'Wait'       L_WAIT.

CHECK L_I_OPERANDS[] IS NOT INITIAL.

IF L_START_DATE IS INITIAL.
  L_START_DATE = SY-DATUM.
ENDIF.

IF L_END_DATE IS INITIAL.
  L_END_DATE = SY-DATUM.
ENDIF.

SELECT *
  FROM ETTIFN
  INTO TABLE L_I_OLD_FACTS
  FOR ALL ENTRIES IN L_I_OPERANDS
  WHERE ANLAGE   = OBJECT-KEY-NUMBER
    AND OPERAND  = L_I_OPERANDS-TABLE_LINE
    AND AB      <= L_END_DATE
    AND BIS     >= L_START_DATE.

