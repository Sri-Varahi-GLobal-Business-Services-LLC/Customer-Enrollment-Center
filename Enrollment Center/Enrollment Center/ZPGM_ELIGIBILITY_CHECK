FUNCTION zpgm_eligibility_check.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(IV_ELIGIBILITY) TYPE  ZSENRL_INT_STRUC
*"  TABLES
*"      ET_MESSAGES STRUCTURE  BAPIRET2 OPTIONAL
*"      ET_MESS STRUCTURE  ZSPGM_BRF_RETURN OPTIONAL
*"----------------------------------------------------------------------
******************************************************************
*  Author                    : Rajanidhi Rajasekeran
*  Date                      : 09/21/2015
*----------------------------------------------------------------*
*  Description: This FM calls the BRF+ Function
*               FUNC_PGM_VALIDATION_CHECK to check eligibility and
*               returns error message if any
*----------------------------------------------------------------*
* MODIFICATION HISTORY
*
*  SAP Transport Request #   :
*  Author                    :
*  Modification Date         :
*  Description               :
*  Defect #                  :
*  Modification flag         :
******************************************************************
*  CONSTANTS : lc_function_id TYPE if_fdt_types=>id VALUE '68B5999264261EE59797122063EB532A',
*              lc_input       TYPE char20 VALUE 'ZSENRL_INT_STRUC'.
*
*  DATA:   loref_context TYPE REF TO if_fdt_context,
*          loref_result  TYPE REF TO if_fdt_result,
*          loref_func    TYPE REF TO if_fdt_function,
*          lx_fdt        TYPE REF TO cx_fdt,
*          lt_message    TYPE bapiret2_t,
*          lwa_bapiret2  TYPE bapiret2.
*  FIELD-SYMBOLS : <fs_error_message> TYPE if_fdt_types=>s_message.
*
*  CLEAR: loref_context, loref_result, loref_func, lx_fdt, lwa_bapiret2, et_messages[].
*
** Clear the Factory instance
*  cl_fdt_factory=>destruct_object( ).
*  cl_fdt_factory=>clear_buffers( ).
*
*
** Get Instance of BRF Function
*  loref_func = cl_fdt_factory=>get_instance( )->get_function( lc_function_id ).
*  loref_context = loref_func->get_process_context( ).
*  loref_context->set_value( EXPORTING iv_name = lc_input
*                                      ia_value = iv_eligibility ).
*
*  TRY.
**     Process the Rules
*      loref_func->process( EXPORTING io_context = loref_context
*                           IMPORTING eo_result  = loref_result ).
*
**     Get Errors if any
*      loref_result->get_value( IMPORTING ea_value = lt_message ).
*      et_messages[] = lt_message.
*    CATCH cx_fdt INTO lx_fdt.
*      LOOP AT lx_fdt->mt_message ASSIGNING <fs_error_message>.
*        MOVE :
*               <fs_error_message>-id            TO lwa_bapiret2-id,
*               <fs_error_message>-msgty         TO lwa_bapiret2-type,
*               <fs_error_message>-msgno         TO lwa_bapiret2-number,
*               <fs_error_message>-msgv1         TO lwa_bapiret2-message_v1,
*               <fs_error_message>-msgv2         TO lwa_bapiret2-message_v2,
*               <fs_error_message>-msgv3         TO lwa_bapiret2-message_v3,
*               <fs_error_message>-msgv4         TO lwa_bapiret2-message_v4.
*
*        APPEND lwa_bapiret2 TO et_messages.
*      ENDLOOP.
*  ENDTRY.

  CONSTANTS : lc_function_id TYPE if_fdt_types=>id VALUE '68B5999264261ED5A6C69ADD5FA75200',
              lc_input       TYPE char20 VALUE 'ZSENRL_INT_STRUC'.

  DATA:   loref_context TYPE REF TO if_fdt_context,
          loref_result  TYPE REF TO if_fdt_result,
          loref_func    TYPE REF TO if_fdt_function,
          lx_fdt        TYPE REF TO cx_fdt,
          lt_mess       TYPE STANDARD TABLE OF zspgm_brf_return,
          ls_mess       TYPE zspgm_brf_return,
          lt_message    TYPE bapiret2_t,
          lwa_bapiret2  TYPE bapiret2.
  FIELD-SYMBOLS : <fs_error_message> TYPE if_fdt_types=>s_message.

  CLEAR: loref_context, loref_result, loref_func, lx_fdt,
         lwa_bapiret2, et_messages[], lt_mess[], ls_mess, et_mess[].

* Clear the Factory instance
  cl_fdt_factory=>destruct_object( ).
  cl_fdt_factory=>clear_buffers( ).


* Get Instance of BRF Function
  loref_func = cl_fdt_factory=>get_instance( )->get_function( lc_function_id ).
  loref_context = loref_func->get_process_context( ).
  loref_context->set_value( EXPORTING iv_name = lc_input
                                      ia_value = iv_eligibility ).

  TRY.
*     Process the Rules
      loref_func->process( EXPORTING io_context = loref_context
                           IMPORTING eo_result  = loref_result ).

*     Get Errors if any
      loref_result->get_value( IMPORTING ea_value = lt_mess ).
      et_mess[] = lt_mess.
      LOOP AT lt_mess INTO ls_mess.
        CLEAR lwa_bapiret2.
        MOVE-CORRESPONDING ls_mess TO lwa_bapiret2.
        APPEND lwa_bapiret2 TO lt_message.
      ENDLOOP.
      et_messages[] = lt_message.
    CATCH cx_fdt INTO lx_fdt.
      LOOP AT lx_fdt->mt_message ASSIGNING <fs_error_message>.
        MOVE :
               <fs_error_message>-id            TO lwa_bapiret2-id,
               <fs_error_message>-msgty         TO lwa_bapiret2-type,
               <fs_error_message>-msgno         TO lwa_bapiret2-number,
               <fs_error_message>-msgv1         TO lwa_bapiret2-message_v1,
               <fs_error_message>-msgv2         TO lwa_bapiret2-message_v2,
               <fs_error_message>-msgv3         TO lwa_bapiret2-message_v3,
               <fs_error_message>-msgv4         TO lwa_bapiret2-message_v4.

        APPEND lwa_bapiret2 TO et_messages.
      ENDLOOP.
  ENDTRY.

ENDFUNCTION.

