* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>PROCESS_MOVEIN
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_EINZBELEG                   TYPE        EINZBELEG
* | [--->] IV_BP                          TYPE        ZENRLBP
* | [--->] IV_CA                          TYPE        ZENRLCA
* | [--->] IV_EVT_NAME                    TYPE        HR_S_EVENT(optional)
* | [--->] IV_MICANCELLED                 TYPE        ABAP_BOOL(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD process_movein.
    DATA: lv_error TYPE boolean,
          ls_input TYPE zsdpp_int_data,
          lr_dimpl TYPE REF TO zcl_isu_se_impl_dpp_drms.

*   Check Event Name
    CHECK iv_evt_name = 'CANCELLED'.

*   Get Open enrollment
    SELECT SINGLE *
      INTO ls_input-pgm_enroll
      FROM ztpgm_enroll
    WHERE zenrlbp = iv_bp
    AND   zenrlca = iv_ca
    AND   zpgm_type IN ( 'CPP', 'PTR' )
    AND   zenrlstatus IN ( '001', '002' ).

*   Check return code
    CHECK sy-subrc = 0.
    IF ls_input-pgm_enroll-zenrlstatus = '001'.
      ls_input-pgm_enroll-zenrlstatus = '003'.
    ELSEIF ls_input-pgm_enroll-zenrlstatus = '002'.
      ls_input-pgm_enroll-zenrlstatus = '004'.
    ENDIF.
    ls_input-pgm_enroll-zenrl_dedat = sy-datum."iv_modate.

*   Get interface data
    SELECT SINGLE *
      INTO ls_input-pgm_int_data
      FROM ztpgm_int_data
    WHERE zenrlbp      = ls_input-pgm_enroll-zenrlbp
    AND   zenrlca      = ls_input-pgm_enroll-zenrlca
    AND   zpgm_type    = ls_input-pgm_enroll-zpgm_type
    AND   zenrl_date = ls_input-pgm_enroll-zenrl_reqdat.

*   Check return code
    CHECK sy-subrc = 0.
    CONCATENATE iv_einzbeleg ': Movein Reversed'
      INTO ls_input-pgm_int_data-zenrlnote
    SEPARATED BY space.

*   Update Enrollment
    update_enrollment( ls_input ).

*   Create IR
    update_ir( ls_input ).

*   Create Object
    CREATE OBJECT: lr_dimpl.

*   Get Error
    lv_error =  lr_dimpl->process_outbound_proxy( CHANGING x_input = ls_input ). "Call DRMS Enrollment Request Outbound

    IF lv_error = abap_true.
      ls_input-pgm_enroll-zenrldrms_stat = '5'.
      ls_input-pgm_enroll-zdrms_dat = sy-datum.
    ELSE.
      IF ls_input-pgm_enroll-zenrlstatus = '004'.
        ls_input-pgm_enroll-zenrldrms_stat = '4'.
        ls_input-pgm_enroll-zdrms_dat = sy-datum.
        ls_input-pgm_enroll-zenrl_msg = 'Account De-Enrolled Successfully'(001).

      ELSE.
        CLEAR: ls_input-pgm_enroll-zenrldrms_stat,
               ls_input-pgm_enroll-zdrms_dat.
        ls_input-pgm_enroll-zenrl_msg = 'Account Enrolled Cancelled Successfully'(001).

      ENDIF.
    ENDIF.
    ls_input-pgm_enroll-zenrl_msgtyp = 'S'.

*   Update Enrollment
    update_enrollment( ls_input ).

  ENDMETHOD.


