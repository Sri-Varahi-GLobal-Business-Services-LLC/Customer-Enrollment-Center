* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD process_rmoveout.
    DATA: lv_error  TYPE boolean,
          ls_input  TYPE zsdpp_int_data,
          ls_eaus   TYPE eaus,
          lt_enroll TYPE STANDARD TABLE OF ztpgm_enroll,
          lr_dimpl  TYPE REF TO zcl_isu_se_impl_dpp_drms.

*   Check Event Name
    CHECK iv_evt_name = 'CANCELLED'.

*   Get Moveout date
    SELECT SINGLE *
      INTO ls_eaus
      FROM eaus
    WHERE auszbeleg = iv_auszbeleg.

*   Check return code
    CHECK sy-subrc = 0.
    IF ls_eaus-departuredate IS INITIAL.
      SELECT *
        INTO TABLE lt_enroll "ls_input-pgm_enroll
        FROM ztpgm_enroll
      WHERE zenrlbp = iv_bp
      AND   zenrlca = iv_ca
      AND   zpgm_type IN ( 'CPP', 'PTR' )
      AND   zenrlstatus IN ( '003', '004' ).
*      AND   zenrl_dedat = ls_eaus-departuredate."iv_modate.


    ELSE.
*     Get Open enrollment
      SELECT *
        INTO TABLE lt_enroll "ls_input-pgm_enroll
        FROM ztpgm_enroll
      WHERE zenrlbp = iv_bp
      AND   zenrlca = iv_ca
      AND   zpgm_type IN ( 'CPP', 'PTR' )
      AND   zenrlstatus IN ( '003', '004' )
      AND   zenrl_dedat = ls_eaus-departuredate."iv_modate.

    ENDIF.
*   Check return code
    CHECK sy-subrc = 0.
    SORT lt_enroll BY zcrtdat zcrttm DESCENDING.
    READ TABLE lt_enroll
      INTO ls_input-pgm_enroll
    INDEX 1.

    IF ls_input-pgm_enroll-zenrlstatus = '003'.
      ls_input-pgm_enroll-zenrlstatus = '001'.
    ELSEIF ls_input-pgm_enroll-zenrlstatus = '004'.
      ls_input-pgm_enroll-zenrlstatus = '002'.
    ENDIF.
    CLEAR ls_input-pgm_enroll-zenrl_dedat.
*     ls_input-pgm_enroll-zenrl_dedat = iv_modate.

*   Get interface data
    SELECT SINGLE *
      INTO ls_input-pgm_int_data
      FROM ztpgm_int_data
    WHERE zenrlbp      = ls_input-pgm_enroll-zenrlbp
    AND   zenrlca      = ls_input-pgm_enroll-zenrlca
    AND   zpgm_type    = ls_input-pgm_enroll-zpgm_type
    AND   zenrl_date = ls_input-pgm_enroll-zenrl_reqdat.

*   Check return code
    CHECK sy-subrc = 0.
    CONCATENATE iv_auszbeleg ': Moveout Reversed'
      INTO ls_input-pgm_int_data-zenrlnote
    SEPARATED BY space.
*    ls_input-pgm_int_data-zenrlnote = iv_auszbeleg.

*   Update Enrollment
    update_enrollment( ls_input ).

*   Create IR
    update_ir( ls_input ).

*   Create Object
    CREATE OBJECT: lr_dimpl.

*   Get Error
    lv_error =  lr_dimpl->process_outbound_proxy_rmout( CHANGING x_input = ls_input ). "Call DRMS Enrollment Request Outbound

    IF lv_error = abap_true.
      ls_input-pgm_enroll-zenrldrms_stat = '5'.
      ls_input-pgm_enroll-zdrms_dat = sy-datum.
    ELSE.

      IF ls_input-pgm_enroll-zenrlstatus = '002'.
        ls_input-pgm_enroll-zenrldrms_stat = '3'.
        ls_input-pgm_enroll-zdrms_dat = sy-datum.
      ELSE.
        CLEAR : ls_input-pgm_enroll-zenrldrms_stat,
                ls_input-pgm_enroll-zdrms_dat.
      ENDIF.
    ENDIF.
    ls_input-pgm_enroll-zenrl_msgtyp = 'S'.
    ls_input-pgm_enroll-zenrl_msg = 'Account Re-Enrolled Successfully'(001).

*   Update Enrollment
    update_enrollment( ls_input ).

  ENDMETHOD.


