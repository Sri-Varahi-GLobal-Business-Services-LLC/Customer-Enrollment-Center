* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>CHECK_DPP
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BP                          TYPE        ZENRLBP
* | [--->] IV_CA                          TYPE        ZENRLCA
* | [<---] EV_ERROR                       TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD check_dpp.
    DATA: ls_enroll     TYPE ztpgm_enroll.

*   Set Error
    ev_error = abap_true.

*   Check DPP enrollment exist
    SELECT SINGLE *
      INTO ls_enroll
      FROM ztpgm_enroll
    WHERE zenrlbp = iv_bp
    AND   zenrlca = iv_ca
    AND   zpgm_type IN ( 'CPP', 'PTR' ).

*   Check return code
    CHECK sy-subrc = 0.
    CLEAR ev_error.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>CHECK_DPP_BDPROCESS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BP                          TYPE        ZENRLBP
* | [--->] IV_CA                          TYPE        ZENRLCA
* | [--->] IV_SPARTE                      TYPE        SPARTE(optional)
* | [--->] IV_NEW_RATE                    TYPE        TARIFTYP_ANL(optional)
* | [--->] IV_OLD_RATE                    TYPE        TARIFTYP_ANL(optional)
* | [<-->] EV_DPP                         TYPE        FLAG(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD check_dpp_bdprocess.
    DATA: lv_error  TYPE boolean,
          ls_progid TYPE ztpgm_progid.

*   Check Electric
    CHECK iv_sparte = '01'.

*   Check CPP or PTR
    SELECT SINGLE *
      FROM ztpgm_progid
      INTO ls_progid
    WHERE program_type IN ( 'CPP', 'PTR' )
    AND   tariftyp IN ( iv_new_rate, iv_old_rate ).

*   Check return code
    CHECK sy-subrc = 0.

*   Check for DPP Enrollment
    check_dpp(
      EXPORTING
        iv_bp    = iv_bp    " Enrollment Business Partner Number
        iv_ca    = iv_ca    " Enrollment Contract Account Number
      IMPORTING
        ev_error = lv_error
    ).

*   Proceed if no errors
    CHECK lv_error = abap_false.
    ev_dpp = abap_true.


  ENDMETHOD.


