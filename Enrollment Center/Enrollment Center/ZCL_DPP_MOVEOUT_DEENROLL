* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>CHECK_ELECTRIC
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_AUSZBELEG                   TYPE        AUSZBELEG
* | [<---] EV_ERROR                       TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD check_electric.
    DATA: lv_vertrag    TYPE vertrag.

    ev_error = abap_true.

*   Check Electric contract
    SELECT SINGLE b~vertrag
      INTO lv_vertrag
      FROM eausv AS a
      INNER JOIN ever AS b
      ON a~vertrag = b~vertrag
    WHERE auszbeleg = iv_auszbeleg
    AND   sparte = '01'.

*   Check return code
    CHECK sy-subrc = 0.
    CLEAR ev_error.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>MOVEOUT_DEENROLL
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_AUSZBELEG                   TYPE        AUSZBELEG
* | [--->] IV_EVT_NAME                    TYPE        HR_S_EVENT(optional)
* | [--->] IV_MOCANCELLED                 TYPE        ABAP_BOOL(optional)
* | [--->] IV_MOFORCED                    TYPE        ABAP_BOOL(optional)
* | [--->] IV_MODATE                      TYPE        AUSZDAT(optional)
* | [--->] IV_BP                          TYPE        ZENRLBP
* | [--->] IV_CA                          TYPE        ZENRLCA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD moveout_deenroll.
    DATA: lv_error      TYPE boolean.

*   Check for DPP Enrollment
    check_dpp(
      EXPORTING
        iv_bp    = iv_bp    " Enrollment Business Partner Number
        iv_ca    = iv_ca    " Enrollment Contract Account Number
      IMPORTING
        ev_error = lv_error
    ).

*   Proceed if no errors
    CHECK lv_error = abap_false.

*   Check Electric Contract
    check_electric(
      EXPORTING
        iv_auszbeleg = iv_auszbeleg " Consecutive number of move-out document
      IMPORTING
        ev_error     = lv_error
    ).

*   Proceed if no errors
    CHECK lv_error = abap_false.

*   Process Move-out
    process_moveout(
      EXPORTING
        iv_auszbeleg   =  iv_auszbeleg   " Consecutive number of move-out document
        iv_evt_name    = iv_evt_name
        iv_mocancelled = iv_mocancelled
        iv_moforced    = iv_moforced
        iv_modate      = iv_modate
        iv_bp          = iv_bp    " Enrollment Business Partner Number
        iv_ca          = iv_ca   " Enrollment Contract Account Number
    ).

*   Process Reverse-Moveout
    process_rmoveout(
      EXPORTING
        iv_auszbeleg   =  iv_auszbeleg   " Consecutive number of move-out document
        iv_evt_name    = iv_evt_name
        iv_mocancelled = iv_mocancelled
        iv_moforced    = iv_moforced
        iv_modate      = iv_modate
        iv_bp          = iv_bp    " Enrollment Business Partner Number
        iv_ca          = iv_ca   " Enrollment Contract Account Number
    ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>PROCESS_BD_INSTUPDATE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BP                          TYPE        ZENRLBP
* | [--->] IV_CA                          TYPE        ZENRLCA
* | [--->] IV_EVT_NAME                    TYPE        HR_S_EVENT(optional)
* | [--->] IV_SPARTE                      TYPE        SPARTE(optional)
* | [--->] IV_OLD_RATE                    TYPE        TARIFTYP_ANL(optional)
* | [--->] IV_NEW_RATE                    TYPE        TARIFTYP_ANL(optional)
* | [--->] IV_DEVLOC                      TYPE        DEVLOC(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD process_bd_instupdate.
    DATA: lv_error  TYPE boolean,
          lv_status TYPE zenstatus,
          lt_enroll TYPE STANDARD TABLE OF ztpgm_enroll,
          ls_enroll TYPE ztpgm_enroll,
          lv_bdps   TYPE zenrl_bdps,
          ls_input  TYPE zsdpp_int_data.

    DATA: lr_range TYPE RANGE OF ztpgm_enroll-zenrlstatus,
          lr_line  LIKE LINE OF lr_range.

    IF iv_new_rate = 'RS_1000'.

      lr_line-sign = 'I'.
      lr_line-option = 'EQ'.
      lr_line-low = '004'.
      APPEND lr_line TO lr_range.
      lv_status = '004'.
    ELSE.
      lr_line-sign = 'I'.
      lr_line-option = 'EQ'.
      lr_line-low = '002'.
      APPEND lr_line TO lr_range.

      lr_line-sign = 'I'.
      lr_line-option = 'EQ'.
      lr_line-low = '004'.
      APPEND lr_line TO lr_range.

    ENDIF.

*   Get Open enrollment
    SELECT *
      INTO TABLE lt_enroll
      FROM ztpgm_enroll
    WHERE zenrlbp = iv_bp
    AND   zenrlca = iv_ca
    AND   zpgm_type IN ( 'CPP', 'PTR' )
    AND   zenrlstatus IN lr_range.

*   Check return code
    CHECK sy-subrc = 0.
    SORT lt_enroll BY zcrtdat zcrttm DESCENDING.

    IF lv_status IS NOT INITIAL.
      READ TABLE lt_enroll
        INTO ls_enroll
      WITH KEY zenrlstatus = lv_status.
    ELSE.
      READ TABLE lt_enroll
        INTO ls_enroll
      WITH KEY zenrlstatus = '002'.

      IF sy-subrc <> 0.
        READ TABLE lt_enroll
          INTO ls_enroll
        WITH KEY zenrlstatus = lv_status.
      ENDIF.
    ENDIF.

    CHECK sy-subrc = 0.
    ls_input-pgm_enroll = ls_enroll.

*   Check Event Name
    IF iv_evt_name = 'FO_RATECATEGORY_CHANGE'.
      lv_bdps = '02'.
    ELSE.
      lv_bdps = '03'.
    ENDIF.

    IF iv_new_rate = 'RS_1000'.
      ls_input-pgm_enroll-zdenrl_bdps = lv_bdps.
    ELSE.
      ls_input-pgm_enroll-zenrl_bdps = lv_bdps.
    ENDIF.


*   Get interface data
    SELECT SINGLE *
      INTO ls_input-pgm_int_data
      FROM ztpgm_int_data
    WHERE zenrlbp      = ls_input-pgm_enroll-zenrlbp
    AND   zenrlca      = ls_input-pgm_enroll-zenrlca
    AND   zpgm_type    = ls_input-pgm_enroll-zpgm_type
    AND   zenrl_date = ls_input-pgm_enroll-zenrl_reqdat.

*   Check return code
    CHECK sy-subrc = 0.
*   Check Event Name
    IF iv_evt_name = 'FO_RATECATEGORY_CHANGE'.
      ls_input-pgm_int_data-zenrlnote = 'Installation Rate Changed'.

    ELSE.
      ls_input-pgm_int_data-zenrlnote = 'Register Update Completed'.

    ENDIF.

*   Update Enrollment
    update_enrollment( ls_input ).

  ENDMETHOD.


