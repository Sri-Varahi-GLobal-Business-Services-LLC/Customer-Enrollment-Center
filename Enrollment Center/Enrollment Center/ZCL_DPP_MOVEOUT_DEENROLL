* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_DPP_MOVEOUT_DEENROLL=>UPDATE_IR
* +-------------------------------------------------------------------------------------------------+
* | [--->] X_INPUT                        TYPE        ZSDPP_INT_DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD update_ir.
******************************************************************
*  Author                    : Rajanidhi Rajasekeran
*  Date                      : 12/05/2015
*----------------------------------------------------------------*
*  Description: This Method handles the Enrollment Request from
*               Enrollment Vendor
*----------------------------------------------------------------*
* MODIFICATION HISTORY
*
*  SAP Transport Request #   :
*  Author                    :
*  Modification Date         :
*  Description               :
*  Defect #                  :
*  Modification flag         :
******************************************************************
    DATA: lt_pgm_data     TYPE STANDARD TABLE OF ztpgm_enroll,
          lt_pgm_int_data TYPE STANDARD TABLE OF ztpgm_int_data,
          lv_contract     TYPE vertrag,
          lv_appid        TYPE char20,
          lv_msg          TYPE zexmsg,
          lv_created      TYPE boolean,
          lv_number       TYPE crmt_object_id_db,
          lv_text         TYPE string.
    DATA: lr_impl TYPE REF TO zcl_isu_se_impl_dpp.
    CREATE OBJECT lr_impl.
    lv_contract = lr_impl->get_contract( x_input-pgm_enroll-zenrlsdp ).

*   Create Interaction record
    IF x_input-pgm_enroll-zpgm_type = 'CPP'.
      CASE x_input-pgm_enroll-zenrlstatus.
        WHEN '001'.
          lv_appid = 'SE_DPP_CPP_PENDING'.
          CONCATENATE 'Enroll pending to' x_input-pgm_enroll-zpgm_type 'for' 'Contract' lv_contract 'from caller'
          x_input-pgm_int_data-zcallername INTO lv_text SEPARATED BY space.

        WHEN '002'.
          lv_appid = 'SE_DPP_CPP_ENROLLED'.
          CONCATENATE 'Enrollment completed to' 'CPP' 'for' 'Contract' lv_contract 'from caller' x_input-pgm_int_data-zcallername INTO lv_text SEPARATED BY space.

        WHEN '003' OR '004'.
          lv_appid = 'SE_DPP_CPP_DEENROLL'.
          CONCATENATE 'De-Enrollment completed from' 'CPP' 'for' 'Contract' lv_contract INTO lv_text SEPARATED BY space.

      ENDCASE.

    ELSEIF x_input-pgm_enroll-zpgm_type = 'PTR'.
      CASE x_input-pgm_enroll-zenrlstatus.
        WHEN '001'.
          lv_appid = 'SE_DPP_PTR_PENDING'.
          CONCATENATE 'Enroll pending to' x_input-pgm_enroll-zpgm_type 'for' 'Contract' lv_contract 'from caller'
          x_input-pgm_int_data-zcallername INTO lv_text SEPARATED BY space.

        WHEN '002'.
          lv_appid = 'SE_DPP_PTR_ENROLLED'.
          CONCATENATE 'Enrollment completed to' 'PTR' 'for' 'Contract' lv_contract 'from caller' x_input-pgm_int_data-zcallername INTO lv_text SEPARATED BY space.

        WHEN '003' OR '004'.
          lv_appid = 'SE_DPP_PTR_DEENROLL'.
          CONCATENATE 'De-Enrollment completed from' 'PTR' 'for' 'Contract' lv_contract INTO lv_text SEPARATED BY space.

      ENDCASE.
    ENDIF.
*
*
*    CONCATENATE 'Enroll pending to' x_input-pgm_enroll-zpgm_type 'for' 'Contract' lv_contract 'from caller'
*    x_input-pgm_int_data-zcallername INTO lv_text SEPARATED BY space.

    CLEAR: lv_created, lv_number, lv_msg.
    CALL METHOD lr_impl->create_ir_record
      EXPORTING
        iv_bp                 = x_input-pgm_enroll-zenrlbp
        iv_app_id             = lv_appid
        iv_text               = lv_text
        iv_buag               = x_input-pgm_enroll-zenrlca
      IMPORTING
        er_created            = lv_created
        er_number             = lv_number
      EXCEPTIONS
        ir_not_created        = 1
        no_bp_passed          = 2
        no_business_agreement = 3
        no_confirmed_bp       = 4
        no_application_id     = 5
        bus_agr_rel_error     = 6
        bus_agr_set_notfound  = 7
        system_error          = 8
        OTHERS                = 9.
    CASE sy-subrc.
      WHEN 1.
        CONCATENATE 'IR creation failed'
        'IR_NOT_CREATED' INTO lv_msg
        SEPARATED BY space.
      WHEN 2.
        CONCATENATE 'IR creation failed'
        'NO_BP_PASSED' INTO lv_msg
        SEPARATED BY space.
      WHEN 3.
        CONCATENATE 'IR creation failed'
        'NO_BUSINESS_AGREEMENT' INTO lv_msg
        SEPARATED BY space.
      WHEN 4.
        CONCATENATE 'IR creation failed'
        'NO_CONFIRMED_BP' INTO lv_msg
        SEPARATED BY space.
      WHEN 5.
        CONCATENATE 'IR creation failed'
        'NO_APPLICATION_ID' INTO lv_msg
        SEPARATED BY space.

      WHEN 6.
        CONCATENATE 'IR creation failed'
        'BUS_AGR_REL_ERROR' INTO lv_msg
        SEPARATED BY space.
      WHEN 7.
        CONCATENATE 'IR creation failed'
        'BUS_AGR_SET_NOTFOUND' INTO lv_msg
        SEPARATED BY space.
      WHEN 0.
        CONCATENATE 'IR created :'
        lv_number INTO lv_msg
        SEPARATED BY space.
      WHEN 8.
        CONCATENATE 'IR creation failed'
        'SYSTEM_ERROR' INTO lv_msg
        SEPARATED BY space.

      WHEN OTHERS.
        CONCATENATE 'IR creation failed'
        ' ' INTO lv_msg
        SEPARATED BY space.
    ENDCASE.
*     Implement suitable error handling here
    CALL METHOD lr_impl->update_ir_msg
      EXPORTING
        x_msgtype = 'I'
        x_msg     = lv_msg
      CHANGING
        x_input   = x_input.

  ENDMETHOD.
ENDCLASS.
