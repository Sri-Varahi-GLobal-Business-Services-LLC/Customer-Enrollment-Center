**&      Form  WRITE_SPOOL
**&---------------------------------------------------------------------*
**       Print the error records via the spool
**----------------------------------------------------------------------*
**  -->  p1        text
**  <--  p2        text
**----------------------------------------------------------------------*
FORM write_spool .

*--- Local variables declaration
  DATA: lv_total  TYPE i,
        lv_sucess TYPE i,
        lv_error  TYPE i.

*--- Local work areas declaration
  DATA: lwa_error_data LIKE LINE OF i_final_error_data.

  DESCRIBE TABLE i_validated_dloc LINES lv_total.

  DESCRIBE TABLE i_final_error_data LINES lv_error.

  lv_sucess = lv_total - lv_error.

  WRITE:/2 'Routeset Selected for Cutover'(015), 60 p_route.

  WRITE:/2  'Total Validated Device Locations in the Routeset'(020), 60 p_tot.

  WRITE:/2 'Total Device Locations that do not need AMCG Change'(019), 60 p_nocut.

  SKIP 2.

  WRITE:/2 'Total Device Locations that need AMCG Change'(001), 60 lv_total.

  WRITE:/2 'Sucessfully Switched Device Locations to AMCG'(002), 60 lv_sucess.

  WRITE:/2 'Total Error Records'(003), 60 lv_error.


  SKIP 1.

  IF i_final_error_data IS NOT INITIAL.
    WRITE:/ sy-uline.
    WRITE:/2 'Error Records with reasons as below'(004).
    WRITE:/ sy-uline.
    WRITE:/2 'Device Location'(005),
          20 'Serial Number'(006),
          38 'Equipment'(007),
          60 'Key Date',
          72 'Error'(008).

    LOOP AT i_final_error_data INTO lwa_error_data.

      WRITE:/2   lwa_error_data-zdevloc," Device Location
             20  lwa_error_data-zsernr, " Serial Number
             38  lwa_error_data-zequnr, " Equipment Number
             60  lwa_error_data-keydate, " Key Date
             72  lwa_error_data-error.  " Error Message,

    ENDLOOP.
  ENDIF.

ENDFORM.                    " WRITE_SPOOL
