*&      Form  FETCH_DEVICE_CATEGORY
*&---------------------------------------------------------------------*
*       Fetch the device category from table EQUI based on the
*       equipment number
*----------------------------------------------------------------------*
*      <--P_LI_EQUI  text
*----------------------------------------------------------------------*
FORM fetch_device_category  CHANGING p_li_equi TYPE tt_equi.

  SORT i_input BY zequnr.

  SELECT
    equnr
    matnr
    sparte
    FROM equi INTO TABLE p_li_equi
    FOR ALL ENTRIES IN i_input
    WHERE
    equnr = i_input-zequnr.

ENDFORM.                    " FETCH_DEVICE_CATEGORY
*&---------------------------------------------------------------------*
*&      Form  DATA_UPDATE
*&      Form  DATA_UPDATE
*&---------------------------------------------------------------------*
*       Update tables T04 and T05 for the Route Sets whose AMCG values
*       have been changed to Cutover Completed
*----------------------------------------------------------------------*
FORM data_update .

  TYPES: BEGIN OF lty_eger,
           equnr        TYPE equnr,             "Equipment Number
           bis          TYPE biszeitsch,        "Date at Which Time Slice Expires
           devloc       TYPE devloc,            "Device Location
           amcg_cap_grp TYPE e_ami_ams_cap_grp, "AMCG
         END OF lty_eger.

  DATA: li_t01      TYPE STANDARD TABLE OF ztdm_se_car_t01,
        li_t05      TYPE STANDARD TABLE OF ztdm_se_car_t05,
        li_temp_t05 TYPE STANDARD TABLE OF ztdm_se_car_t05,
        li_t01_temp TYPE STANDARD TABLE OF ztdm_se_car_t01,
        li_eger     TYPE STANDARD TABLE OF lty_eger.

  DATA: lwa_route_data TYPE ztdm_se_car_t04,
        lwa_t05        TYPE ztdm_se_car_t05,
        lwa_t01        TYPE ztdm_se_car_t01,
        lwa_t01_temp   LIKE LINE OF li_t01_temp,
        lwa_eger       LIKE LINE OF li_eger.

  DATA: lv_tabix       TYPE sy-tabix.

  DATA:lt_opt_out  TYPE STANDARD TABLE OF zbi_opt_out,
       lwa_opt_out TYPE zbi_opt_out,
       lv_index    TYPE sy-tabix.

*-- Fetching data from T04 table
  SELECT SINGLE * FROM ztdm_se_car_t04 INTO lwa_route_data
    WHERE
    zrtset = p_route.

  IF sy-subrc IS INITIAL.
    MOVE:
    'CUTC'    TO lwa_route_data-zrtsetstat,
    sy-datum  TO lwa_route_data-zrtsetcut.

*-- Updating data in T04 table
    MODIFY ztdm_se_car_t04 FROM lwa_route_data.
    IF sy-subrc IS INITIAL.
      COMMIT WORK AND WAIT.
    ENDIF.

  ENDIF.

****Get the MRU data for the Devices for which AMCG swithing is complete
  SELECT *
    FROM ztdm_se_car_t01
    INTO TABLE li_t01
     FOR ALL ENTRIES IN i_validated_dloc
   WHERE zcardevloc =  i_validated_dloc-zdevloc
     AND zcarequnr  = i_validated_dloc-zequnr.
  IF sy-subrc EQ 0.
**Copy the data to a temp table for T01 update based on V_EGER
    APPEND LINES OF li_t01 TO li_t01_temp.

***Get the Unique MRU number from the above data
    SORT li_t01 BY zcarableinh.
    DELETE ADJACENT DUPLICATES FROM li_t01 COMPARING zcarableinh.

***Fetch the MRU data from T05 table
    SELECT *
      FROM ztdm_se_car_t05
      INTO TABLE li_t05
       FOR ALL ENTRIES IN li_t01
      WHERE zcarmru = li_t01-zcarableinh.
    IF sy-subrc EQ 0.
      SORT li_t05 BY zcarmru.
    ENDIF.
***Check if every MRU has the cutover comeplete indicator already. If exists we dont need to change
***If not we have to change it to 'X' with current date and Job Name
    LOOP AT li_t01 INTO lwa_t01.
      READ TABLE li_t05 INTO lwa_t05 WITH KEY zcarmru = lwa_t01-zcarableinh.
      IF sy-subrc EQ 0.
        IF lwa_t05-zcarsmruflag IS INITIAL.
          lwa_t05-zcarsmruflag = 'X'.
          lwa_t05-zcarsmrudate = sy-datum.
          lwa_t05-zcarsbatch = p_name.
          APPEND lwa_t05 TO li_temp_t05.
          CLEAR lwa_t05.
        ENDIF.
      ELSE.
        lwa_t05-zcarmru = lwa_t01-zcarableinh.
        lwa_t05-zcarsattgt = '0.00'.
        lwa_t05-zcarsmruflag = 'X'.
        lwa_t05-zcarsatdate = sy-datum.
        lwa_t05-zcarsattime = sy-uzeit.
        lwa_t05-zcarsatuid = sy-uname.
        lwa_t05-zcarsmrudate = sy-datum.
        lwa_t05-zcarsbatch = p_name.
        APPEND lwa_t05 TO li_temp_t05.
        CLEAR lwa_t05.
      ENDIF.
    ENDLOOP.
***If the MRU's have to be updated with CARS Indicator, then update the table
    IF li_temp_t05 IS NOT INITIAL.
      MODIFY ztdm_se_car_t05 FROM TABLE li_temp_t05.
      COMMIT WORK AND WAIT.
    ENDIF.

***Select data from V_EGER table
    SORT li_t01_temp BY zcarequnr zcardevloc.

    SELECT
    equnr                            " Equipment Number
    bis                              " Date at Which a Time Slice Expires
    devloc                           " Device Location
    amcg_cap_grp                     " Capability Group of Advanced Metering System
    INTO TABLE li_eger
    FROM v_eger
    FOR ALL ENTRIES IN li_t01_temp
    WHERE
    equnr        EQ li_t01_temp-zcarequnr  AND    " Equipment number
    bis          EQ '99991231'             AND
    devloc       EQ li_t01_temp-zcardevloc.       " Device location

    IF sy-subrc IS INITIAL.

      SORT li_eger BY equnr devloc.

      LOOP AT li_t01_temp INTO lwa_t01_temp.

        MOVE sy-tabix TO lv_tabix.

        READ TABLE li_eger INTO lwa_eger
        WITH KEY
        equnr  = lwa_t01_temp-zcarequnr
        devloc = lwa_t01_temp-zcardevloc
        BINARY SEARCH.

        IF sy-subrc IS INITIAL.

          MOVE lwa_eger-amcg_cap_grp TO lwa_t01_temp-zcaramcg_cap_grp.

          MODIFY li_t01_temp FROM lwa_t01_temp INDEX lv_tabix TRANSPORTING zcaramcg_cap_grp.

        ENDIF.

        CLEAR: lwa_t01_temp, lwa_eger.

      ENDLOOP.

      IF li_t01_temp IS NOT INITIAL.
        MODIFY ztdm_se_car_t01 FROM TABLE li_t01_temp.
        COMMIT WORK AND WAIT.
      ENDIF.


    ENDIF.

  ENDIF.

****Update T04 one more time again just in case as the status is critical for next pass
*-- Fetching data from T04 table
  CLEAR lwa_route_data.
  SELECT SINGLE * FROM ztdm_se_car_t04 INTO lwa_route_data
    WHERE
    zrtset = p_route.

  IF sy-subrc IS INITIAL.
    MOVE:
    'CUTC'    TO lwa_route_data-zrtsetstat,
    sy-datum  TO lwa_route_data-zrtsetcut.

*-- Updating data in T04 table
    MODIFY ztdm_se_car_t04 FROM lwa_route_data.
    IF sy-subrc IS INITIAL.
      COMMIT WORK AND WAIT.
    ENDIF.

  ENDIF.

ENDFORM.                    " DATA_UPDATE
*&---------------------------------------------------------------------*
*&      Form  SEND_EMAIL_TO_SAP
*&---------------------------------------------------------------------*
* Send mail to the SAP inbox of user who submitted this job
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM send_email_to_sap .

  DATA: maildata TYPE sodocchgi1,
        mailpack TYPE STANDARD TABLE OF sopcklsti1,
        mailbin  TYPE STANDARD TABLE OF solisti1,
        mailtxt  TYPE STANDARD TABLE OF solisti1,
        mailrec  TYPE STANDARD TABLE OF somlreci1,
        pdf      TYPE STANDARD TABLE OF tline.

  DATA: l_wa_mailpack TYPE sopcklsti1,
        l_wa_mailtxt  TYPE solisti1,
        l_wa_mailrec  TYPE somlreci1,
        tab_lines     TYPE i,
        lv_spono      TYPE tsp01-rqident,
        lv_char_spono TYPE string.

  CLEAR: l_wa_mailpack, l_wa_mailtxt, l_wa_mailrec.

  REFRESH: mailpack, mailbin, mailtxt, mailrec.

  MOVE  sy-spono TO : lv_spono, lv_char_spono.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
    EXPORTING
      input  = lv_char_spono
    IMPORTING
      output = lv_char_spono.

* Creation of the document to be sent
* Mail Subject
  CONCATENATE 'Change AMCG Summary'(011) 'for spool #'(012) lv_char_spono INTO maildata-obj_descr
  SEPARATED BY space.

* Mail Contents
  l_wa_mailtxt-line = 'Please click on an attachement to know more details'(013).
  APPEND l_wa_mailtxt TO mailtxt.

  DESCRIBE TABLE mailtxt LINES tab_lines.
  READ TABLE mailtxt INTO l_wa_mailtxt INDEX tab_lines.
  maildata-doc_size = ( tab_lines - 1 ) * 255 + strlen( l_wa_mailtxt ).


  CALL FUNCTION 'CONVERT_ABAPSPOOLJOB_2_PDF'
    EXPORTING
      src_spoolid = lv_spono
    TABLES
      pdf         = pdf.

  CALL FUNCTION 'QCE1_CONVERT'
    TABLES
      t_source_tab = pdf
      t_target_tab = mailbin.

*Describe the body of the message
  l_wa_mailpack-transf_bin = space.
  l_wa_mailpack-head_start = 1.
  l_wa_mailpack-head_num = 0.
  l_wa_mailpack-body_start = 1.
  l_wa_mailpack-body_num = tab_lines.
  l_wa_mailpack-doc_type = 'RAW'.
  APPEND l_wa_mailpack TO mailpack.
  CLEAR:l_wa_mailpack.

*Create attachment notification
  CLEAR: tab_lines.
  DESCRIBE TABLE mailbin LINES tab_lines.
  l_wa_mailpack-transf_bin = 'X'.
  l_wa_mailpack-head_start = 1.
  l_wa_mailpack-head_num = 1.
  l_wa_mailpack-body_start = 1.
  l_wa_mailpack-body_num = tab_lines.
  CONCATENATE 'Generated File for Spool#'(014) lv_char_spono INTO l_wa_mailpack-obj_descr
  SEPARATED BY space.
  l_wa_mailpack-doc_type = 'PDF'.
  l_wa_mailpack-doc_size = tab_lines * 255.
  APPEND l_wa_mailpack TO mailpack.
  CLEAR:l_wa_mailpack.

* Set recipient - email address here!!!
  l_wa_mailrec-receiver = sy-uname.
  l_wa_mailrec-rec_type = 'B'.
  l_wa_mailrec-express = 'X'.
  APPEND l_wa_mailrec TO mailrec.

  ##fm_subrc_ok
* Sending the document
  CALL FUNCTION 'SO_NEW_DOCUMENT_ATT_SEND_API1'
    EXPORTING
      document_data              = maildata
      put_in_outbox              = ' '
      commit_work                = 'X'
    TABLES
      packing_list               = mailpack
      contents_bin               = mailbin
      contents_txt               = mailtxt
      receivers                  = mailrec
    EXCEPTIONS
      too_many_receivers         = 1
      document_not_sent          = 2
      operation_no_authorization = 4
      OTHERS                     = 99.

ENDFORM.                    " SEND_EMAIL_TO_SAP
*&---------------------------------------------------------------------*
*&      Form  UPDATE_ZBI_OPT_OUT_TABLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM update_zbi_opt_out_table.

  TYPES: BEGIN OF lty_error_opt,
           message TYPE char255,
         END OF lty_error_opt.

  DATA: li_t03     TYPE STANDARD TABLE OF ztdm_se_car_t03,
        li_t01     TYPE STANDARD TABLE OF ztdm_se_car_t01,
        lwa_t01    TYPE ztdm_se_car_t01,
        lv_count   TYPE i,
        lv_opt_out TYPE char1.

  DATA: li_error_opt  TYPE STANDARD TABLE OF lty_error_opt,
        li_opt_out    TYPE STANDARD TABLE OF zbi_opt_out,
        lwa_opt_out   TYPE zbi_opt_out,
        lwa_error_opt TYPE lty_error_opt,
        lv_err_cnt    TYPE i,
        lv_succ_cnt   TYPE i,
        lv_index      TYPE sy-tabix.

  CLEAR:li_t03[],li_t01[],li_error_opt[],li_opt_out[],lwa_t01,lv_count,lv_opt_out,
        lwa_opt_out,lv_err_cnt,lv_succ_cnt,lv_index.

  WRITE: sy-uline.

  WRITE:/28 'Update Billing Opt Out Table Summary'(017).

  SKIP 1.

  SELECT COUNT(*)
      FROM tvarvc
      WHERE name = text-t02
        AND low  = abap_true.
  IF sy-subrc EQ 0.
    lv_opt_out = abap_true.
  ELSE.
    WRITE:/2 'TVARVC Entry Z_OPT_OUT_BILLING is not set for billing update'.
    WRITE:/2 'ZBI_OPT_OUT table will not updated with cutover date if Z_OPT_OUT_BILLING is not set to X'.
  ENDIF.

  IF lv_opt_out EQ abap_true.
    REFRESH li_t03.
    CLEAR lv_count.
    SELECT *
      FROM ztdm_se_car_t03
       INTO TABLE li_t03
      WHERE zrtset = p_route.
    IF sy-subrc EQ 0.
      DESCRIBE TABLE li_t03 LINES lv_count.
      WRITE:/2 'Total MRUs in Route Set:'(016),
             60 lv_count.
    ENDIF.

    IF i_validated_dloc[] IS NOT INITIAL.
****Get the MRU data for the Devices for which AMCG swithing is complete
      SELECT *
        FROM ztdm_se_car_t01
        INTO TABLE li_t01
         FOR ALL ENTRIES IN i_validated_dloc
       WHERE zcardevloc =  i_validated_dloc-zdevloc
         AND zcarequnr  = i_validated_dloc-zequnr.
      IF sy-subrc EQ 0.
***Get the Unique MRU number from the above data
        SORT li_t01 BY zcarableinh.
        DELETE ADJACENT DUPLICATES FROM li_t01 COMPARING zcarableinh.

*****Begin of change by valuru for Relase 3 Project
        CLEAR:li_opt_out[].
        IF li_t01[] IS NOT INITIAL.
          SELECT *
            FROM zbi_opt_out
            INTO TABLE li_opt_out
             FOR ALL ENTRIES IN li_t01
            WHERE ableinh = li_t01-zcarableinh
              AND sparte  IN s_div.   " p_div. "R4C post cutover changes
          IF sy-subrc EQ 0.
            SORT li_opt_out BY ableinh.
            LOOP AT li_t01  INTO lwa_t01.
              CLEAR lwa_opt_out.
***If the entry is found in Opt Out Table and Cutover Date is not populated
***then Update it
              READ TABLE li_opt_out INTO lwa_opt_out WITH KEY ableinh = lwa_t01-zcarableinh
                                    BINARY SEARCH.
              IF sy-subrc EQ 0.
                CLEAR lv_index.
                lv_index = sy-tabix.
                IF lwa_opt_out-zcodate IS INITIAL.
                  lwa_opt_out-zcodate = sy-datum.
                  lwa_opt_out-aedat = sy-datum.
                  lwa_opt_out-aenam = sy-uname.
                  lwa_opt_out-aezet = sy-uzeit.
                  MODIFY  li_opt_out FROM lwa_opt_out INDEX lv_index.
                  CLEAR lwa_opt_out.
                  lv_succ_cnt = lv_succ_cnt + 1.
                ELSE.
                  lv_err_cnt = lv_err_cnt + 1.
                  CONCATENATE lwa_t01-zcarableinh 'MRU is already Cutover in ZBI_OPT_OUT Billing table' INTO lwa_error_opt-message SEPARATED BY space.
                  APPEND lwa_error_opt-message TO li_error_opt.
                  CLEAR lwa_error_opt-message.
                ENDIF.
              ELSE.
                lv_err_cnt = lv_err_cnt + 1.
                CONCATENATE 'No Entry in table ZBI_OPT_OUT for MRU' lwa_t01-zcarableinh INTO lwa_error_opt-message.
                APPEND lwa_error_opt-message TO li_error_opt.
                CLEAR lwa_error_opt-message.
              ENDIF.
            ENDLOOP.
          ELSE.
            WRITE:/2 'No MRUs found in ZBI_OPT_OUT table to update Cutover Date'.
          ENDIF.


          IF li_opt_out IS NOT INITIAL.
            MODIFY zbi_opt_out FROM TABLE li_opt_out.
            IF sy-subrc EQ 0.
              COMMIT WORK AND WAIT.
            ENDIF.
          ENDIF.
        ENDIF.
      ELSE.
        WRITE:/2 'ZBI_OPT_OUT table was not updated with MRU Cutover Date as no Devices are Cutover to Automated Reads'.
      ENDIF.
    ELSE.
      WRITE:/2 'ZBI_OPT_OUT table was not updated with MRU Cutover Date as no Devices are Cutover to Automated Reads'.
    ENDIF.
  ENDIF.


  WRITE:/2 'Total MRUs Cutover Date Update in ZBI_OPT_OUT Billing Table:'(018),
         60 lv_succ_cnt.

  WRITE:/2 'Total Error Records:',
        60 lv_err_cnt.

  IF li_error_opt IS NOT INITIAL.
    SKIP 1.
    WRITE sy-uline.
    WRITE:/2 'Error Records with Reasons as below'.
    WRITE sy-uline.
    LOOP AT li_error_opt INTO lwa_error_opt.
      WRITE:/2 lwa_error_opt-message.
    ENDLOOP.
  ENDIF.

  REFRESH:li_opt_out.

ENDFORM.                    " UPDATE_ZBI_OPT_OUT_TABLE
