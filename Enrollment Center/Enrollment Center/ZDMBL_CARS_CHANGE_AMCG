*&      Form  CHECK_ALL_COMPLETE
*&---------------------------------------------------------------------*
*       Check if all the child jobs are complete and have been closed
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM check_all_complete .

  DATA : lswc_job    TYPE swc_object,
         li_guid     TYPE STANDARD TABLE OF ztca_cs_edsintf,
         lwa_guid    TYPE ztca_cs_edsintf,
         lv_status   TYPE char20,
         lv_key      TYPE char40,
         lv_expected TYPE sy-tfill.

  DO.
    REFRESH li_guid.
    SELECT *
      FROM ztca_cs_edsintf
      INTO TABLE li_guid
      WHERE runid       = p_runid.
    lv_expected = p_name+26(4).
    DESCRIBE TABLE li_guid LINES sy-tfill.
    IF lv_expected GT sy-tfill.
      WAIT UP TO 2 SECONDS.
    ELSE.
      EXIT.
    ENDIF.
  ENDDO.

  LOOP AT li_guid INTO lwa_guid.
    CLEAR lv_key.

* Skip loop pass for current job or else it will go into
* an infinite loop
    IF lwa_guid-runid    = p_runid AND
       lwa_guid-jobname  = p_name  AND
       lwa_guid-jobcount = p_count.
      CONTINUE.
    ENDIF.

    DO.
      CONCATENATE lwa_guid-jobname
                  lwa_guid-jobcount
           INTO lv_key
           RESPECTING BLANKS.

      swc_create_object lswc_job
                        'BPJOB_SMAN'
                        lv_key.

      CLEAR lv_status.

      ##fm_subrc_ok
      swc_get_property lswc_job
                       'State'
                       lv_status.
      IF lv_status EQ 'FINISHED' OR
         lv_status EQ 'ABORTED'.
        EXIT.
      ENDIF.

*--- Initialise the local variables
      CLEAR : lv_key , lswc_job.
    ENDDO.

  ENDLOOP.

ENDFORM.                    " CHECK_ALL_COMPLETE
