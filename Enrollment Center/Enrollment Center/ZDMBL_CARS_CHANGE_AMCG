                    EXPORTING
                      im_serial_number   = lwa_input-zsernr
                      im_key_date        = lv_key_date
                      im_device_category = lwa_equi-matnr
                      im_amcg            = lwa_amcg_data-amcg_cap_grp
                    IMPORTING
                      ex_message         = lv_error
                    EXCEPTIONS
                      error_exists       = 1
                      OTHERS             = 2.

                  IF sy-subrc NE 0.
                    lf_error = abap_true.
                  ENDIF.
                ENDIF.
              ENDIF.
            ELSE.
*              CONCATENATE 'Rate Category value not found in table ZTDM_SE_CAR_T09 for the Installation'(103)
*                                        lwa_equi-matnr INTO lv_error  SEPARATED BY space.
              CONCATENATE  'Rate category'(105) lv_tariftyp 'not configured for OTA billing in the ZTDM_SE_CAR_T09 table'(106)
                           INTO lv_error  SEPARATED BY space.
              lf_error = abap_true.

            ENDIF.
          ELSE.
            CONCATENATE 'Valid Rate Category Missing for the validation in table ZTCC_BILINS_ELEC for Device Category'(101)
                      lwa_equi-matnr INTO lv_error  SEPARATED BY space.
            lf_error = abap_true.


          ENDIF.
        ELSE.
          lv_error = text-104.
          lf_error = abap_true.
        ENDIF.
      ENDIF.
******End of Change by Har Mayank for Post cutover to IB 01/19/2015


      IF lf_error  EQ abap_true.
        lwa_error-zdevloc       = lwa_input-zdevloc.
        lwa_error-zsernr        = lwa_input-zsernr.
        lwa_error-zequnr        = lwa_input-zequnr.
        lwa_error-error         = lv_error.
        lwa_error-keydate       = lv_key_date.
        APPEND lwa_error TO i_error.
        CLEAR lwa_error.
      ELSE.
        lwa_car_t06-zcardevloc  =  lwa_input-zdevloc.
        lwa_car_t06-zcarsdlflag = 'X'.
        lwa_car_t06-zcarsdldate = sy-datum.
        lwa_car_t06-zcarsbatch  = p_name.
        lwa_car_t06-zsernr = lwa_input-zsernr.
        APPEND  lwa_car_t06 TO li_car_t06.
        CLEAR lwa_car_t06.
      ENDIF.

*--- Initialise the work area
      CLEAR : lwa_input,
              lwa_equi.

* Begin of R4C Changes by SKOTHURI
      CLEAR: lv_error,
             lwa_return.
      REFRESH: lit_return.
      CLEAR: lwa_eablg,lwa_eabl,lv_error,lwa_error,lf_error,lwa_etdz,lv_zwnummer,lv_key_date.
* End of R4C Changes by SKOTHURI
    ENDLOOP.

    IF li_car_t06 IS NOT INITIAL.
      MODIFY ztdm_se_car_t06 FROM TABLE li_car_t06.
      IF sy-subrc EQ 0.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'.
      ENDIF.
    ENDIF.

  ENDIF.

ENDFORM.                    " CHAGE_AMCG_SWITCH
