*---------------------------------------------------------------------*
*      Form  Determine_Prev_MoveOut_Date
*---------------------------------------------------------------------*
*      Get the previous moveout date
*----------------------------------------------------------------------*
*      P_W_MOVEOUT_DOC    - moveout document
*      P_W_MOVEOUT_DATE   - moveout date
*      P_W_MOVEOUT_FORCED - moveout forced
*----------------------------------------------------------------------*
FORM determine_prev_moveout_date  CHANGING
                                           p_w_moveout_doc
                                           p_w_moveout_date
                                           p_w_moveout_forced.
* Local data declaration
  DATA: lt_prev_move_outs TYPE swc_object OCCURS 5.
  DATA: lw_prev_move_outs TYPE swc_object.
  DATA: lw_auszbeleg TYPE eaus-auszbeleg.
  DATA: lw_auszdat TYPE eausv-auszdat.
  DATA: l_objref_moveout_doc TYPE swc_object.
  DATA: lw_kennzx TYPE regen-kennzx.
  DATA: l_moveoutdate TYPE eausv-auszdat.
  DATA: l_moveoutforced TYPE regen-kennzx.
* For accessing moveoutdoc,moveoutdate,moveoutforce for previous doc no.
  DATA: BEGIN OF lw_moveouts,
          auszbeleg TYPE eaus-auszbeleg,
          auszdat   TYPE eausv-auszdat,
          kennzx    TYPE regen-kennzx,
        END OF lw_moveouts.
*Internal table for previous document numbers
  DATA:lt_moveouts LIKE lw_moveouts OCCURS 5.
*Access the attributes from previousmoveouts from moveindoc
  swc_get_table_property self 'PreviousMoveOuts' lt_prev_move_outs.
*Loop at the internal table
  LOOP AT lt_prev_move_outs INTO lw_prev_move_outs.
*Get the object key for object lw_prev_move_outs
    swc_get_object_key lw_prev_move_outs lw_auszbeleg.
*Access the attributes MoveOutDate, MoveOutForce for the recent document
    swc_create_object l_objref_moveout_doc 'MOVEOUTDOC' lw_auszbeleg.
    swc_get_property l_objref_moveout_doc 'MoveOutDate' lw_auszdat.
    swc_get_property l_objref_moveout_doc 'MoveOutForced' lw_kennzx.
    lw_moveouts-auszbeleg  = lw_auszbeleg.
    lw_moveouts-auszdat    = lw_auszdat.
    lw_moveouts-kennzx     = lw_kennzx.
    APPEND lw_moveouts TO lt_moveouts.
    CLEAR lw_moveouts.
  ENDLOOP.
* If the table is initial then come out of the form
  IF lt_moveouts IS  INITIAL.
    EXIT.
  ENDIF.
*To get the most recent document numbers
  SORT lt_moveouts BY auszbeleg DESCENDING.
*Read table line-by-line
  READ TABLE lt_moveouts INTO lw_moveouts INDEX 1.
  p_w_moveout_doc =    lw_moveouts-auszbeleg.
  p_w_moveout_date =   lw_moveouts-auszdat.
  p_w_moveout_forced = lw_moveouts-kennzx.
* Create object reference for moveoutdoc
  swc_create_object obj_moveoutdoc 'MOVEOUTDOC' p_w_moveout_doc.
  swc_get_property obj_moveoutdoc 'MoveOutForced' l_moveoutforced.
  swc_get_property obj_moveoutdoc 'MoveOutDate' l_moveoutdate.
ENDFORM.                    " Determine_Prev_MoveOut_Date

*---------------------------------------------------------------------*
*      Form  Get_Out_Put_Info
*---------------------------------------------------------------------*
*      Gets the movein date and performs all the actions
*----------------------------------------------------------------------*
FORM get_out_put_info USING w_moveout_doc TYPE eaus-auszbeleg
                            w_moveout_date TYPE sy-datum.
* Local data declaration
  DATA: lw_anlage TYPE eanl-anlage.
  DATA: lobjref_instln TYPE swc_object OCCURS 0 WITH HEADER LINE.
  DATA: lobjref_discon TYPE swc_object.
  DATA: lw_instln_type TYPE eanl-anlart.
  DATA: lw_max_discon_doc_status TYPE ediscdoc-status.
  DATA: lw_movein_date TYPE eeinsup-einzdat.
  DATA: lw_gstrp TYPE afko-gstrp.
  DATA: lw_ordernum TYPE afko-aufnr.
  DATA: l_orderno TYPE aufk-aufnr.
  DATA: lw_diff_days TYPE i.
  DATA: lw_auszdat TYPE eausv-auszdat.
  DATA: lw_vstelle  TYPE evbs-vstelle.
  DATA: premise_ref TYPE swc_object.
  DATA: lw_premise_type TYPE evbs-vbsart.
  DATA: lw_auszbeleg  TYPE eaus-auszbeleg.
  DATA: w_ilart TYPE afih-ilart.
  DATA: w_moveoutdate TYPE eausv-auszdat.
  DATA: lobj_connobj TYPE swc_object.
  DATA: isusmorder_ref TYPE swc_object.
  DATA: lw_regiogroup TYPE adrreggrp-regiogroup.
  DATA: l_device_key     TYPE equi-equnr. "Device Object Key
* Container Declaration
  swc_container recon_container.
* Flags used
  DATA: lfl_metered TYPE c.
  DATA: lfl_no_act_disc_docs TYPE c.
  DATA: lfl_read_only_move_out_date TYPE c.
*  DATA: lfl_creat_read_move_ord_mo_dat TYPE c.
  DATA: lfl_creat_read_move_ord_mi_dat TYPE c.
* Constants declaration
  CONSTANTS: lc_x TYPE c VALUE 'X'.
* Access the attribute moveInDate
  swc_get_property self 'MoveInDate' lw_movein_date.

* If movein date is greater than today's
  IF lw_movein_date GE sy-datum.
* Access the attribute Instlns
    swc_get_table_property self 'Instlns' lt_instlns.
* Loop at instlns into work area
    LOOP AT lt_instlns INTO lwa_instlns.
* Get the values of Installation Number
      swc_get_object_key lwa_instlns lw_anlage.
      swc_create_object lwa_instlns 'INSTLN' lw_anlage.
* Get the installation type
      swc_get_property lwa_instlns 'InstallationType' lw_instln_type.
* Process only if the Installation type is one among these
      CASE lw_instln_type.
        WHEN 'BARN' OR 'MOP' OR 'POOL' OR 'PRIM' OR 'PUMP' OR 'SHOP'.
          REFRESH lt_cdevices.
          swc_get_table_property lwa_instlns 'zCurrentDevices' lt_cdevices.
          CLEAR lfl_metered.
* If there are  values in internal table
          IF lt_cdevices[] IS NOT INITIAL.
* Set the flag as metered
            CLEAR lfl_metered.
            lfl_metered = lc_x.
          ENDIF.
* Get Disconnection documents
          swc_get_table_property lwa_instlns 'ActDisconnectionDocuments'
                                 lt_act_discon_docs.
          CLEAR lfl_no_act_disc_docs.
* If disconnection documents does not exists
          IF lt_act_discon_docs[] IS INITIAL.
* Set the flag as no disconnection document exists
            lfl_no_act_disc_docs = lc_x.
          ELSE.
* Get the status for the disconnection document
            PERFORM get_status_discon_docs TABLES lt_act_discon_docs
                                      CHANGING lw_max_discon_doc_status
                                          lobjref_discon.
* Check with the disconnection document status
            CASE lw_max_discon_doc_status.
              WHEN '21'.
* When it is 21, create reconnection order
                PERFORM create_reconnection_order USING lobjref_discon
                                                        lw_movein_date.

* When it is 22 set the flag as no disconnection document
              WHEN '22'.
                lfl_no_act_disc_docs  = lc_x.
* When it is 20 identify disconnection service order
              WHEN '20'.

                PERFORM identify_service_order USING lobjref_discon
                                                   CHANGING lw_ordernum.
* Identify start date on service order
                SELECT SINGLE gstrp FROM afko INTO lw_gstrp "Basic start date
                         WHERE aufnr = lw_ordernum. "Order Number
* Get the difference in basic start date movein date
                IF sy-subrc = 0.
                  lw_diff_days = lw_movein_date - lw_gstrp .
                  lw_diff_days = abs( lw_diff_days ).
                ENDIF.
                CLEAR w_days.
* Select zzdays from ZMOVE_IO_DAYS into some variable
                SELECT SINGLE zzdays FROM zmove_io_days INTO w_days.
* If the difference is greater than w_days
                IF lw_diff_days GT w_days.
* Reconnection order is performed
                  PERFORM create_reconnection_order USING lobjref_discon
                                                          lw_movein_date.

* Else cancel the service order
                ELSE.
                  IF w_moveout_date GE sy-datum.
*                  PERFORM cancel_service_order USING lw_ordernum.
* Cancel the disconnection document activity.
*              PERFORM cancel_discon_doc_activity USING lobjref_discon.
* If basic start date equals to todays date
                    IF lw_gstrp = sy-datum.
* Subroutine for Presenting Same Day Work Alert
                      PERFORM present_same_work_day_alert USING lw_ordernum
                                                              w_moveoutdate
                                                          CHANGING w_ilart.
*                  ENDIF.
                    ELSE.
                      PERFORM cancel_service_order USING lw_ordernum.
* Cancel the disconnection document activity.
                      PERFORM cancel_discon_doc_activity USING lobjref_discon.

                      CLEAR lfl_read_only_move_out_date.
* If move-out-date equals todays date
*                  IF w_moveout_date GE sy-datum.
* Set flag as read only move out date
                      lfl_read_only_move_out_date = lc_x.
                    ENDIF.
                  ELSE.

                    PERFORM create_reconnection_order USING lobjref_discon
                                                            lw_movein_date.

                  ENDIF.

                ENDIF.


* When disconnection document status is different
              WHEN OTHERS.
* Set the flag as no activity disconnection document
                lfl_no_act_disc_docs  = lc_x.
            ENDCASE.
*          ENDIF.
*      ENDCASE.
*    ENDLOOP.
          ENDIF.
          swc_create_object obj_movoutdoc 'MOVEOUTDOC' w_moveout_doc.
* If disconnection document status is checked and flag is metered and
* Consecutive number of move-out document is greater to sy-datum
          IF lfl_no_act_disc_docs = 'X'.
            IF lfl_metered = 'X'.
              CLEAR lfl_read_only_move_out_date.
              IF w_moveout_date GE sy-datum.
* Set flag to forced move out date
                lfl_read_only_move_out_date = lc_x.
                swc_get_property lwa_instlns 'zGOS' w_gos.
                IF w_gos EQ 1.
                  REFRESH lt_cdevices.
                  swc_get_table_property lwa_instlns 'zCurrentDevices' lt_cdevices.
                  LOOP AT lt_cdevices INTO lwa_cdevices.
*            swc_get_object_key lobjref_instln w_key.
* Call subroutine remove_orange_seal_order                             "
                    PERFORM remove_orange_seal_order USING w_moveout_doc
                                                          w_moveout_date
                                                          lwa_cdevices.
                  ENDLOOP.
* Call subroutine reset gos field
*          PERFORM reset_gos_field USING lobjref_instln.
                  PERFORM reset_gos_field USING lwa_instlns. "Satya
                ENDIF.
              ELSE.
* Set the flag for forced movein date
                lfl_creat_read_move_ord_mi_dat = lc_x.
              ENDIF.
            ELSE.
* Get the object reference for the premise
              swc_get_property lwa_instlns 'Premises' premise_ref.
* swc_create_object premise_ref 'PREMISE' lw_vstelle.
              swc_get_property premise_ref 'ZTYPE' lw_premise_type.
* When the premise type is TEMP do not do anything
              CASE lw_premise_type.
                WHEN 'TEMP'.
* Do Nothing.
                WHEN OTHERS.
* Subroutine for create install meter order
                  PERFORM create_install_meter_order USING lwa_instlns
                                                         obj_isusmorder
                                                         obj_moveoutdoc
                                                         lw_movein_date.
              ENDCASE.
            ENDIF.
          ENDIF.
      ENDCASE.
*    ENDLOOP.
*  ENDIF.
* If read only move out date is set then call subroutine
      IF lfl_read_only_move_out_date = lc_x.
* Subroutine for read only order
        LOOP AT lt_cdevices INTO lwa_cdevices.
          PERFORM zcreate_read_only_order USING obj_moveoutdoc
                                                w_moveout_date
                                                lwa_cdevices  .
        ENDLOOP.
      ENDIF.
* If read only move order mi date is set then call subroutine
      IF  lfl_creat_read_move_ord_mi_dat = lc_x.
* Subroutine for read order mi date
        LOOP AT lt_cdevices INTO lwa_cdevices.
          PERFORM zcreate_read_only_order USING  self
                                                  lw_movein_date
                                                  lwa_cdevices.
        ENDLOOP.
      ENDIF.
      CLEAR lfl_read_only_move_out_date.
      CLEAR lfl_creat_read_move_ord_mi_dat.
    ENDLOOP.
  ENDIF.
ENDFORM.                    " Get_Out_Put_Info

*---------------------------------------------------------------------*
*      Form  Get_Status_Discon_Docs
*---------------------------------------------------------------------*
*      Gets the status of disconnection document
*----------------------------------------------------------------------*
*      P_LT_ACT_DISCON_DOCS activity disconnect
*      P_LW_MAX_DICON_DOC_STATUS max status
*----------------------------------------------------------------------*
FORM get_status_discon_docs
             TABLES   p_lt_act_discon_docs STRUCTURE t_struct
             CHANGING p_lw_max_dicon_doc_status
                      p_lobjref_discon.
* Local data declaration
  DATA: lw_discon_doc_status TYPE ediscdoc-status.
  DATA: lobjref_discon TYPE swc_object.
  DATA: lw_max_status TYPE ediscdoc-status.
  lt_act_discon_docs[] = p_lt_act_discon_docs[].
  LOOP AT lt_act_discon_docs INTO lwa_act_discon_docs.
    swc_get_property lwa_act_discon_docs 'State' lw_discon_doc_status.
    IF sy-tabix = 1.
      CLEAR: lw_max_status.
      lw_max_status = lw_discon_doc_status.
    ELSE.
      IF lw_max_status LT lw_discon_doc_status.
        lw_max_status = lw_discon_doc_status.
        lobjref_discon = lwa_act_discon_docs.
      ENDIF.
    ENDIF.
    CLEAR: lw_discon_doc_status.
  ENDLOOP.
*set the global disconnetion document
*  lwa_act_discon_docs = lobjref_discon.
  lobjref_discon = lwa_act_discon_docs.
  p_lw_max_dicon_doc_status = lw_max_status.
  p_lobjref_discon = lobjref_discon.
ENDFORM.                    " Get_Status_Discon_Docs

