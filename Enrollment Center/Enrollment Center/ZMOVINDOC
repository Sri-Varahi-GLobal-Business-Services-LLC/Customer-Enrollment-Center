begin_method zupdinstfacts changing container.
DATA: lt_ettifn      TYPE isu_iettifn,
      lv_inst        TYPE anlage,
      lv_operand     TYPE e_operand,
      lt_ettifn_del  TYPE isu_iettifn,
      lt_ettifn_upd  TYPE isu_iettifn,
      ls_ettifn_upd  TYPE LINE OF isu_iettifn,
      lv_movein_date TYPE eeinv-einzdat.
FIELD-SYMBOLS: <ettifn>  TYPE LINE OF isu_iettifn.
CONSTANTS: lc_opt_out TYPE e_operand VALUE 'ESMOPT_OUT',
           lc_opt_pnd TYPE e_operand VALUE 'ESMOPT_PND',
           lc_bis     TYPE datum VALUE '99991231',
           lc_x       TYPE string3 VALUE 'X',
           lc_upd     TYPE regen-upd_mode VALUE 'I',
           lc_del     TYPE regen-upd_mode VALUE 'D'.
DATA: lv_opt_out TYPE e_operand,
      lv_opt_pnd TYPE e_operand.

*-> we assume there is only one install / one contract
DATA:
  t_instlns   TYPE swc_object OCCURS 0 WITH HEADER LINE,
  t_contracts TYPE swc_object OCCURS 0 WITH HEADER LINE,
  wa_instln   TYPE swc_object,
  wa_contract TYPE swc_object.

* Get the Installations from Zmovindoc
swc_get_table_property self 'INSTLNS' t_instlns.
* Read First Installation into Work area.
READ TABLE t_instlns INTO wa_instln INDEX 1.
* Get the Key Value of Installation.
swc_get_object_key wa_instln lv_inst.
IF lv_inst IS INITIAL.
* No Installation Found from the Move-in Doc
  exit_return 9011 sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
ENDIF.

swc_get_element container 'Opt_Out'           lv_opt_out.
swc_get_element container 'Opt_Pnd'           lv_opt_pnd.
swc_get_element container 'NewMoveInDate'     lv_movein_date.

IF lv_opt_out = abap_true.
  lv_operand = lc_opt_out.
  CALL FUNCTION 'ISU_DB_ETTIFN_SELECT_ACTIVE'
    EXPORTING
      x_anlage      = lv_inst
      x_operand     = lc_opt_out
    IMPORTING
      y_iettifn     = lt_ettifn
    EXCEPTIONS
      not_found     = 1
      not_qualified = 2
      OTHERS        = 3.
  IF sy-subrc <> 0.
*Error finding existing installation facts.
    exit_return 9001 object-key-number lv_inst '' ''.
  ENDIF.
ELSEIF lv_opt_pnd = abap_true.
  lv_operand = lc_opt_pnd.
  CALL FUNCTION 'ISU_DB_ETTIFN_SELECT_ACTIVE'
    EXPORTING
      x_anlage      = lv_inst
      x_operand     = lc_opt_pnd
    IMPORTING
      y_iettifn     = lt_ettifn
    EXCEPTIONS
      not_found     = 1
      not_qualified = 2
      OTHERS        = 3.
  IF sy-subrc <> 0.
*Error finding existing installation facts.
    exit_return 9001 object-key-number lv_inst '' ''.
  ENDIF.
ENDIF.

LOOP AT lt_ettifn ASSIGNING <ettifn>.
  IF sy-subrc <> 0.
    ls_ettifn_upd-anlage = lv_inst.
    ls_ettifn_upd-operand = lv_operand.
    ls_ettifn_upd-ab = lv_movein_date + 1.
