    ls_ettifn_upd-string3 = lc_x.
    IF lt_ettifn_upd IS INITIAL.
      APPEND ls_ettifn_upd TO lt_ettifn_upd.
    ENDIF.
  ELSEIF <ettifn>-bis < lc_bis OR <ettifn>-ab <> lv_movein_date.
    APPEND <ettifn> TO lt_ettifn_del.
    IF lt_ettifn_upd IS INITIAL.
      <ettifn>-ab = lv_movein_date + 1.
      <ettifn>-bis = lc_bis.
      APPEND <ettifn> TO lt_ettifn_upd.
    ENDIF.
  ELSEIF <ettifn>-bis = lc_bis OR <ettifn>-ab = lv_movein_date.
    EXIT.
  ENDIF.
ENDLOOP.
IF lt_ettifn_upd IS NOT INITIAL.
  CALL FUNCTION 'ISU_DB_ETTIFN_UPDATE'
    EXPORTING
      x_upd_mode = lc_upd
      x_iettifn  = lt_ettifn_upd.
ENDIF.
IF lt_ettifn_del IS NOT INITIAL.
  CALL FUNCTION 'ISU_DB_ETTIFN_UPDATE'
    EXPORTING
      x_upd_mode = lc_del
      x_iettifn  = lt_ettifn_del.
ENDIF.

end_method.

