FORM z_create_appl_log  USING p_i_msg TYPE fkk_bal_msg_t
                       CHANGING p_lognum TYPE bal_s_lgnm-lognumber.
*----------------------------------------------------------------------*
*               C O N S T A N T S                                      *
*----------------------------------------------------------------------*
  CONSTANTS : c_eprog(10)    TYPE c VALUE 'ERROR_PROG'.
*----------------------------------------------------------------------*
*               L O C A L   D E C L A R A T I O N S                    *
*----------------------------------------------------------------------*

  DATA :  l_s_log      TYPE bal_s_log,
          l_log_handle TYPE bal_s_lgnm-log_handle,
          l_lognum     TYPE bal_t_lgnm,
          l_wa_lognum  TYPE bal_s_lgnm,
          l_s_msg      TYPE bal_s_msg,
          l_logs       TYPE bal_t_logh,
          l_msgty      TYPE bal_s_msg-msgty,
          l_msgid      TYPE bal_s_msg-msgid,
          l_msgno      TYPE bal_s_msg-msgno,
          lt_logs      TYPE bal_t_logh.

*If the log table is not initial
  IF  p_i_msg IS NOT INITIAL.
    l_s_log-object = c_eprog.
    l_s_log-aldate = sy-datum.
    l_s_log-altime = sy-uzeit.
    l_s_log-aluser = sy-uname.
    l_s_log-alprog = sy-repid.
*Create Log
    CALL FUNCTION 'BAL_LOG_CREATE'
      EXPORTING
        i_s_log                 = l_s_log
      IMPORTING
        e_log_handle            = l_log_handle
      EXCEPTIONS
        log_header_inconsistent = 1
        OTHERS                  = 2.
    IF sy-subrc <> 0.
    ENDIF.
*Add message to the log
    LOOP AT  p_i_msg INTO  l_s_msg.
      CALL FUNCTION 'BAL_LOG_MSG_ADD'
        EXPORTING
          i_log_handle     = l_log_handle
          i_s_msg          = l_s_msg
        EXCEPTIONS
          log_not_found    = 1
          msg_inconsistent = 2
          log_is_full      = 3
          OTHERS           = 4.
      IF sy-subrc <> 0.
      ENDIF.
      CLEAR l_s_msg.
    ENDLOOP.
  ENDIF.
*Save message to the log
  IF NOT l_log_handle IS INITIAL.
    APPEND l_log_handle TO l_logs.
    CALL FUNCTION 'BAL_DB_SAVE'
      EXPORTING
        i_client         = sy-mandt
        i_t_log_handle   = l_logs
      IMPORTING
        e_new_lognumbers = l_lognum
      EXCEPTIONS
        log_not_found    = 1
        save_not_allowed = 2
        numbering_error  = 3
        OTHERS           = 4.
    IF sy-subrc <> 0.
    ENDIF.
  ENDIF.
  READ TABLE l_lognum INTO l_wa_lognum INDEX 1.
  p_lognum = l_wa_lognum-lognumber.
ENDFORM.                                             " z_create_appl_log
