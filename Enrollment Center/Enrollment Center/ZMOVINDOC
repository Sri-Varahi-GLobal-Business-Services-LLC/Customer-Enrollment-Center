*----------------------------------------------------------------------*
FORM present_same_work_day_alert USING p_aufnr
                                       p_w_moveoutdate
                                     CHANGING p_ilart.
  DATA: lw_workctr TYPE aufk-vaplz,
        lw_acttext TYPE t353i_t-ilatx.
  DATA: l_p_aufnr(12) TYPE c.
  DATA: l_zero(1) TYPE c.
  DATA: lw_text1(200),
        lw_text2(60),
        lw_text3(60),
        lw_answer,
        wa_isusmorder   TYPE swc_object.

* Get Main work center for maintenance tasks
  SELECT SINGLE vaplz FROM aufk INTO lw_workctr
                                WHERE aufnr EQ p_aufnr.
* If it is unsuccessful the clear the variable
  IF sy-subrc NE 0.
    CLEAR lw_workctr.
  ENDIF.
* Get Maintenance activity type
  SELECT SINGLE ilart FROM afih INTO p_ilart
                      WHERE aufnr EQ p_aufnr.
  IF sy-subrc NE 0.
    CLEAR p_ilart.
  ENDIF.
* Get Description of maintenance activity type
  SELECT SINGLE ilatx FROM t353i_t INTO lw_acttext
                                 WHERE ilart = p_ilart.
  IF sy-subrc NE 0.
    CLEAR p_ilart.
  ENDIF.
  DATA: ld_txt(60) TYPE c.
* Create dialog window or pop up displaying the details
  WRITE: p_aufnr TO l_p_aufnr NO-ZERO.

  CONCATENATE 'Order' l_p_aufnr lw_acttext INTO ld_txt SEPARATED BY space.
  CONCATENATE 'for area'(005) lw_workctr
   'will be cancelled' INTO lw_text1 SEPARATED BY space.
*      'will be cancelled'(006) INTO lw_text1 SEPARATED BY space.
  lw_text2 = 'This Order is scheduled to be worked today.'(007).
  lw_text3 = 'Please contact crews to advise.'(008).
  CALL FUNCTION 'POPUP_WITH_2_BUTTONS_TO_CHOOSE'
    EXPORTING
      diagnosetext1 = ld_txt
      diagnosetext2 = lw_text1
      textline1     = lw_text2
      textline2     = lw_text3
      textline3     = space
      text_option1  = 'DISPLAY'
      text_option2  = 'CONTINUE'
      titel         = 'SAME DAY WORK ALERT'(009)
    IMPORTING
      answer        = lw_answer.
  IF lw_answer = '1'.
*  Instantiate the Order Object using the Order Number
    swc_create_object wa_isusmorder 'ISUSMORDER' p_aufnr.
    swc_call_method  wa_isusmorder 'Display' t_container.
  ENDIF.
