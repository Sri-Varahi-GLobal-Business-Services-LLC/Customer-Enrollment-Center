begin_method cancelnodialog changing container.
************************************************************************
* Programmer:  Michael Robson
* Date:        01/23/2012
* Defect:      3290 (Smart_Grid project)
* Transport:   E2DK916890
* Description: A temporary exception will be raised if a foreign key
*              exception is returned by ISU_S_MOVE_IN_CANCEL.
************************************************************************
* Programmer:  Michael Robson
* Date:        10/29/2008
* SC Problem:  PM788290
* Transport:   ECDK953747
* Description: Cancels the move-in document without a dialog. Mainly
*              copied from the MoveInDoc.Cancel business object method,
*              with the move-in document number look-up code taken out.
************************************************************************
DATA: l_einzbeleg    TYPE eein-einzbeleg,
      l_msgv1        TYPE syst-msgv1,
      l_msgv2        TYPE syst-msgv2,
      l_msgv3        TYPE syst-msgv3,
      l_msgv4        TYPE syst-msgv4,
      l_msgtext(100) TYPE c.

swc_get_element container 'MoveInDocument' l_einzbeleg.

IF l_einzbeleg IS INITIAL.
  l_einzbeleg = object-key-number.
ENDIF.

CHECK l_einzbeleg IS NOT INITIAL.

CALL FUNCTION 'ISU_S_MOVE_IN_CANCEL'
  EXPORTING
    x_einzbeleg       = l_einzbeleg
    x_no_dialog       = 'X'
    x_suppress_dialog = 'X'
    x_no_message      = 'X'
  EXCEPTIONS
    not_found         = 1
    foreign_lock      = 2
    number_error      = 3
    input_error       = 4
    action_failed     = 5
    not_authorized    = 6
    internal_error    = 7
    invalid_key       = 8
    OTHERS            = 9.

CASE sy-subrc.
  WHEN 0.
  WHEN 1.
    exit_object_not_found.
*----|START-OF-CHANGE|MMRobson|01/23/2012|Defect 3290|----*
  WHEN 2.
    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
      WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO l_msgtext.

    l_msgv1 = l_msgtext.
    IF l_msgtext+50(1) = space.
      l_msgv2 = l_msgtext+49.
    ELSE.
      l_msgv2 = l_msgtext+50.
    ENDIF.
    l_msgv3 = l_einzbeleg.
    CONCATENATE sy-msgid sy-msgno INTO l_msgv4.

    swc_set_element container 'MessageText' l_msgtext.

    exit_return 9002 l_msgv1 l_msgv2 l_msgv3 l_msgv4.
*----|END-OF-CHANGE|MMRobson|01/23/2012|Defect 3290|----*
  WHEN OTHERS.
*   This should allow for enhanced error message handling
    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
      WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO l_msgtext.

    l_msgv1 = l_msgtext.
*----|START-OF-CHANGE|MMRobson|01/23/2012|Defect 3290|----*
*    l_msgv2 = l_msgtext+49.
    IF l_msgtext+50(1) = space.
      l_msgv2 = l_msgtext+49.
    ELSE.
      l_msgv2 = l_msgtext+50.
    ENDIF.
*----|END-OF-CHANGE|MMRobson|01/23/2012|Defect 3290|----*
    l_msgv3 = l_einzbeleg.
    CONCATENATE sy-msgid sy-msgno INTO l_msgv4.

    swc_set_element container 'MessageText' l_msgtext.

    exit_return 9001 l_msgv1 l_msgv2 l_msgv3 l_msgv4.
ENDCASE.

