*  Move In Date
      w_moveindate    TYPE eeinsup-einzdat,
*  Prev Move Out Date
      w_moveoutdate   TYPE eausv-auszdat,

*  Reverse Forced Move Out flag
      w_rvsefmo       TYPE ewxgen-ivalue,
*  Owner allocation flag
      fl_active       TYPE c.
* START OF CHANGE WRT FUNCTIONAL SPEC VERSION 4.
DATA: w_moveoutdate_imp TYPE eausv-auszdat,
      t_modoc           TYPE TABLE OF swc_object.
* END OF CHANGE WRT FUNCTIONAL SPEC VERSION 4.
*  Constants
CONSTANTS: c_x(1)     TYPE c VALUE 'X'.

* Create Container for data
swc_create_container t_container.

* get the Reverse Move Out Flag
swc_get_element container 'RvseFMO' w_rvsefmo.
* START OF CHANGE WRT FUNCTIONAL SPEC VERSION 4.
swc_get_table container 'PreviousMoveOutDoc' t_modoc.
swc_get_element container 'MoveOutDate' w_moveoutdate.
* END OF CHANGE WRT FUNCTIONAL SPEC VERSION 4.
* get the Movein Document object
moveindoc_obj = self.
*swc_get_element container 'MOVEINDOC_OBJ' moveindoc_obj.
* Get all the installations for the Move In document
swc_get_table_property self 'Instlns' t_instln.
* Check if more than one then get Premise for the first one.
READ TABLE t_instln INTO wa_instln INDEX 1.
*if a entry is found
IF sy-subrc = 0.
*Get the Premises for the Installation
  swc_get_property wa_instln 'PREMISES' w_premise.
* Get the Device Locations for this Premises
  PERFORM get_device_location USING w_premise.
ENDIF.   " sy-subrc = 0 for read table instln
swc_get_property self  'MoveInDate'  w_moveindate.
LOOP AT t_instln INTO wa_instln.
* Obtain the value is Instlntype from W_instln
  PERFORM get_installation_type USING    wa_instln
                                CHANGING f_instlntype.               .
* Check installation type is not equal light installations
  CHECK f_instlntype = c_x.
  REFRESH t_discdoc.
* Get all the Active Disconnection documents for this instln
  swc_get_table_property wa_instln
                             'ACTDISCONNECTIONDOCUMENTS' t_discdoc.
* Now for Each Disconnection check the status
  LOOP AT t_discdoc INTO wa_discdoc.
    CLEAR w_state.
*  Get the Order Status
    swc_get_property wa_discdoc 'State' w_state.
    CHECK w_state = '22' OR w_state = '20'. " Check Reconnection Started

*  check pending disconnection
*  Get the disconnection documents
    PERFORM determine_disconn_documents USING     wa_discdoc
                                                  w_moveindate.
  ENDLOOP.   " t_disconnections
* START OF CHANGE WRT FUNCTIONAL SPEC VERSION 4.
*  Get the Previous move out date
  PERFORM determine_prev_moveout_date_2 USING t_modoc
                                        CHANGING w_moveoutdate_imp.
* END OF CHANGE WRT FUNCTIONAL SPEC VERSION 4.
** Set the Order status variable in the container
*  SWC_GET_TABLE T_CONTAINER  't_ro_Orders' T_RO_ORDERS.
** Determine read only order
*  REFRESH T_RO_ORDERS.
  PERFORM find_service_orders USING wa_instln w_moveoutdate
                                    'REA'.

  IF w_rvsefmo = 1.
    REFRESH t_ro_orders.
* Set the Order status variable in the container
    swc_get_table t_container  'T_RO_ORDERS' t_ro_orders.

* if original movein date > system date
    IF w_moveindate GT sy-datum.
      LOOP AT t_ro_orders INTO wa_orders.
        PERFORM cancel_service_order_2 USING wa_orders-aufnr.
* if start date = system date
        IF wa_orders-gstrp EQ sy-datum.
* Present Alert for Same Day
*          PERFORM PRESENT_SAME_DAY_ALERT USING WA_ORDERS-AUFNR
*                                               WA_ORDERS-ILART
*                                               W_MOVEOUTDATE.
          PERFORM present_same_work_day_alert USING wa_orders-aufnr
                                                    w_moveoutdate
                                               CHANGING wa_orders-ilart.
        ENDIF.
      ENDLOOP. " t_ro_orders

** Set the Order status variable in the container
*      SWC_GET_TABLE T_CONTAINER  'T_OR_ORDERS' T_OR_ORDERS.
** Determine read only order
*      REFRESH T_OR_ORDERS.

* Find remove Orange Seal Orders
      PERFORM find_service_orders USING wa_instln w_moveoutdate
                                        'OSR'.
      REFRESH t_or_orders.
* Set the Order status variable in the container
      swc_get_table t_container  'T_OR_ORDERS' t_or_orders.
      LOOP AT t_or_orders INTO wa_orders.

*  Cancel the Orange Orders
        PERFORM cancel_service_order_2 USING wa_orders-aufnr.
        IF wa_orders-gstrp EQ sy-datum.
* Present Alert for Same Day
*          PERFORM PRESENT_SAME_DAY_ALERT USING WA_ORDERS-AUFNR
*                                               WA_ORDERS-ILART
*                                               W_MOVEOUTDATE.
          PERFORM present_same_work_day_alert USING wa_orders-aufnr
                                                    w_moveoutdate
                                              CHANGING  wa_orders-ilart.

        ENDIF.
        AT LAST.
*  Reset GOS field to Life Support
          PERFORM z_reset_gos_field USING wa_instln.
        ENDAT.
      ENDLOOP. " t_or_orders
    ENDIF.

  ELSE. " ( Move out is not to be reversed)
*  Check Owner Allocation Active
    fl_active = ' '.
    PERFORM z_owner_allocation_check USING    wa_instln
                                     CHANGING fl_active.
*  if original movein date greater than or equal to system date
    IF w_moveindate GE sy-datum AND fl_active NE 'X' .
      swc_get_table t_container  'T_RO_ORDERS' t_ro_orders.
      IF w_moveoutdate GE sy-datum. " if moveout greater than current date
        LOOP AT t_ro_orders INTO wa_orders.
*  Cancel the Read Only Orders
          PERFORM cancel_service_order_2 USING wa_orders-aufnr.
          IF wa_orders-gstrp EQ sy-datum.
* Present Alert for Same Day
*          PERFORM PRESENT_SAME_DAY_ALERT USING WA_ORDERS-AUFNR
*                                               WA_ORDERS-ILART
*                                               W_MOVEOUTDATE.
            PERFORM present_same_work_day_alert USING wa_orders-aufnr
                                                     w_moveoutdate
                                               CHANGING wa_orders-ilart.
          ENDIF.
        ENDLOOP.
*  Create Disconnection Document & Order
        PERFORM create_disconnect_doc USING wa_instln
                                            w_moveoutdate.


*    " if Prev move out doc less than system date
      ELSEIF w_moveoutdate LT sy-datum .

        PERFORM check_pending_disconn USING wa_instln
                                            w_moveoutdate.
      ENDIF. " Move out endif
    ELSEIF w_moveindate LT sy-datum.
*  Create disconnection doc for next working day
      PERFORM create_disconn_next_day USING wa_instln.
    ENDIF. " Move in End if
  ENDIF.

ENDLOOP. " Installations


swc_get_element container 'MOVEINDOC_OBJ' moveindoc_obj.
swc_get_table container  'ISUSMORDER' t_isusmorder.
end_method.
