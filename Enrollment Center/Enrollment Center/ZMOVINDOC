get_property owneractive changing container.

DATA:
  lv_owneractive TYPE boole_d,
  lv_from_date   TYPE datum,
  lv_to_date     TYPE datum,
  lv_premise     TYPE evbs-vstelle,
  lv_key_date    TYPE syst-datum,
  lv_owner       TYPE eprop-owner,
  lv_property    TYPE eprop-property,
  ls_eprop       TYPE eprop,
  lt_eprop       TYPE ieeprop.

SELECT  SINGLE vstelle auszdat
INTO    (lv_premise, lv_key_date)
FROM    eausv
WHERE   auszbeleg EQ object-key-number.

CHECK lv_premise IS NOT INITIAL.

IF lv_key_date IS INITIAL.
* Use the current date by default
  lv_key_date = sy-datum.
ENDIF.

CALL FUNCTION 'ISU_S_OWNER_FOR_PREMISE'
  EXPORTING
    x_vstelle     = lv_premise
    x_keydate     = lv_key_date
  IMPORTING
    y_owner       = lv_owner
    y_property    = lv_property
    yt_eprop      = lt_eprop
  EXCEPTIONS
    not_found     = 1
    not_unique    = 2
    general_fault = 3
    OTHERS        = 4.

IF sy-subrc = 0 AND lv_owner IS NOT INITIAL.
* Loop through active owner allocation records
  LOOP AT lt_eprop INTO ls_eprop WHERE acbact = abap_true.

*   Assign from and to dates for the validity period, using the key
*   date's year.
    CONCATENATE lv_key_date(4) ls_eprop-activefrom INTO lv_from_date.
    CONCATENATE lv_key_date(4) ls_eprop-activeto   INTO lv_to_date.

*   Check whether the validity period should start at the end of the
*   given year and end at the beginning of the next year
    IF lv_from_date > lv_to_date.
      IF lv_key_date > lv_to_date.
*       The period ends at the beginning of the next year
        lv_to_date(4) = lv_key_date(4) + 1.
      ELSE.
*       The period starts at the beginning of the previous year
        lv_from_date(4) = lv_key_date(4) - 1.
      ENDIF.
    ENDIF.

*   Correct for Leap year problems
    IF ls_eprop-activefrom = '0229'.
      CALL FUNCTION 'DATE_CHECK_PLAUSIBILITY'
        EXPORTING
          date   = lv_from_date
        EXCEPTIONS
          OTHERS = 1.

      IF sy-subrc <> 0.
        lv_from_date+4 = '0228'.
      ENDIF.
    ENDIF.

    IF ls_eprop-activeto = '0229'.
      CALL FUNCTION 'DATE_CHECK_PLAUSIBILITY'
        EXPORTING
          date   = lv_to_date
        EXCEPTIONS
          OTHERS = 1.

      IF sy-subrc <> 0.
        lv_to_date+4 = '0228'.
      ENDIF.
    ENDIF.

*   Check whether the owner is active during the validity period
    IF lv_from_date <= lv_key_date AND lv_to_date >= lv_key_date.
      lv_owneractive = abap_true.
      EXIT.
    ENDIF.
  ENDLOOP.

ENDIF.

swc_set_element container 'OwnerActive' lv_owneractive.

end_property.


*{ Ins : Tapas Pradhan : DMND0001431 : 20th June, 2016
* Method to update the Dunning Procedure on Contract Account
begin_method updatedunningproc changing container.
TYPES : BEGIN OF ty_old_ca,
          anlage  TYPE anlage,
          vkonto  TYPE vkont_kk,
          auszdat TYPE auszdat,
        END OF   ty_old_ca,

        BEGIN OF ty_anlage,
          anlage TYPE anlage,
        END OF   ty_anlage.

DATA : it_return              TYPE TABLE OF bapiret2,
       it_contract_det        TYPE TABLE OF bapifkkvkp1,
       it_ctracpartnerdetail  TYPE TABLE OF bapifkkvkpi1,
       it_ctracpartnerdetailx TYPE TABLE OF bapifkkvkpi1x,
       it_instln              TYPE TABLE OF ty_anlage,
       it_old_ca              TYPE TABLE OF ty_old_ca,
       wa_old_ca              TYPE ty_old_ca,
       wa_contract_det        TYPE bapifkkvkp1,
       wa_ctracdetail         TYPE bapifkkvki,
       wa_ctracdetailx        TYPE bapifkkvkix,
       wa_ctracpartnerdetail  TYPE bapifkkvkpi1,
       wa_ctracpartnerdetailx TYPE bapifkkvkpi1x,
       lv_cntrct_acnt         TYPE vkont_kk,
       lv_partner             TYPE bu_partner,
       lv_dunn_proc           TYPE mahnv_kk.

CONSTANTS : c_17      TYPE mahnv_kk VALUE '17',
            c_mo_date TYPE auszdat VALUE '99991231'.


* Obtaining values from container
swc_get_element container 'ContractAccount' lv_cntrct_acnt.
swc_get_element container 'Partner'         lv_partner.

* Fetching Installation for the Contract account
SELECT anlage
  FROM ever INTO TABLE it_instln
  WHERE vkonto = lv_cntrct_acnt.

IF it_instln IS NOT INITIAL.
* Fetching new Contract account for the installation obtained above
  SELECT anlage vkonto auszdat
    FROM ever INTO TABLE it_old_ca
    FOR ALL ENTRIES IN it_instln
    WHERE anlage = it_instln-anlage
      AND auszdat < c_mo_date.

  IF sy-subrc = 0.
    SORT it_old_ca BY auszdat DESCENDING.
    DELETE ADJACENT DUPLICATES FROM it_old_ca COMPARING anlage.

    READ TABLE it_old_ca INTO wa_old_ca INDEX 1.
* Fetching the Dunning procedure
    SELECT SINGLE mahnv
      FROM fkkvkp INTO lv_dunn_proc
      WHERE vkont = wa_old_ca-vkonto.

    CHECK lv_dunn_proc = c_17 AND     " CMS Multi dwelling Dunning Procedure
          lv_cntrct_acnt <> space.
* BAPI to get the Contract account details
    CALL FUNCTION 'BAPI_CTRACCONTRACTACCOUNT_GD1'
      EXPORTING
        contractaccount    = lv_cntrct_acnt
      TABLES
        ctracpartnerdetail = it_contract_det.

* Updating the Dunning procedure structures
    wa_ctracpartnerdetail-dunn_proc  = lv_dunn_proc.
    wa_ctracpartnerdetail-buspartner = lv_partner.
    APPEND wa_ctracpartnerdetail TO it_ctracpartnerdetail.

* Sending the flag to update the Dunning procedure
    wa_ctracpartnerdetailx-dunn_proc = abap_true.
    APPEND wa_ctracpartnerdetailx TO it_ctracpartnerdetailx.

    READ TABLE it_contract_det INTO wa_contract_det INDEX 1.
    wa_ctracdetail-acct_name  = wa_contract_det-acct_name.
    wa_ctracdetailx-acct_name = abap_true.

* BAPI to update the Contract account Dunning procedure
    CALL FUNCTION 'BAPI_CTRACCONTRACTACCOUNT_CH1'
      EXPORTING
        contractaccount     = lv_cntrct_acnt
        businesspartner     = lv_partner
        ctracdetail         = wa_ctracdetail
        ctracdetailx        = wa_ctracdetailx
      TABLES
        ctracpartnerdetail  = it_ctracpartnerdetail
        ctracpartnerdetailx = it_ctracpartnerdetailx
        return              = it_return.

* Calling FM to update the Contract Account...
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = abap_true.
  ENDIF.
ENDIF.

CLEAR : lv_partner, lv_dunn_proc, lv_cntrct_acnt,
        wa_contract_det, wa_ctracdetail, wa_ctracdetailx,
        wa_ctracpartnerdetail, wa_ctracpartnerdetailx.

REFRESH : it_return, it_contract_det, it_ctracpartnerdetail,
          it_ctracpartnerdetailx, it_old_ca, it_instln.
end_method.
*} Ins : Tapas Pradhan : DMND0001431 : 20th June, 2016

get_property isforcedmoatpremcancelled changing container.
TYPES:
  BEGIN OF lt_move_out_document,
    account       TYPE vkont_kk,
    document      TYPE cdhdr-objectid,
    installation  TYPE anlage,
    reversed      TYPE abap_bool,
    creation_date TYPE dats,
    creation_time TYPE tims,
  END OF lt_move_out_document.

DATA:
  li_move_out_documents TYPE STANDARD TABLE OF lt_move_out_document,
  lv_premise            TYPE vstelle,
  lv_move_out_date      LIKE eausv-auszdat.

swc_get_property self 'MoveInDocPremise' object-moveindocpremise.
swc_get_property object-moveindocpremise 'Number' lv_premise.

swc_get_property self 'MoveInDate' lv_move_out_date.
SUBTRACT 1 FROM lv_move_out_date.

##too_many_itab_fields
SELECT
    eaus~vkont,
    eaus~auszbeleg,
    eausv~anlage,
    eausv~storausz
  FROM eausv
  JOIN eaus
    ON eaus~auszbeleg = eausv~auszbeleg
  INTO TABLE @li_move_out_documents
  WHERE eausv~vstelle   = @lv_premise
    AND eausv~auszdat   = @lv_move_out_date
    AND eaus~frommovein = @abap_true.

CHECK sy-subrc = 0.

CONSTANTS:
  BEGIN OF lc_change_document,
    BEGIN OF object_class,
      move_in  TYPE cdhdr-objectclas VALUE 'ISU_EEIN',
      move_out TYPE cdhdr-objectclas VALUE 'ISU_EAUS',
    END OF object_class,
  END OF lc_change_document.

TYPES:
  BEGIN OF lt_move_out_creation,
    document TYPE cdhdr-objectid,
    date     TYPE dats,
    time     TYPE tims,
  END OF lt_move_out_creation.

DATA:
  lv_move_in_reversal_date TYPE dats,
  lv_move_in_reversal_time TYPE tims,
  li_move_out_creation     TYPE STANDARD TABLE OF lt_move_out_creation,
  lwa_move_out_creation    TYPE lt_move_out_creation.

FIELD-SYMBOLS:
  <lwa_move_out_document> TYPE lt_move_out_document.

" Get the last date/time the move-in document was updated.
SELECT
    udate,
    utime
  UP TO 1 ROWS
  FROM cdhdr
  INTO (@lv_move_in_reversal_date, @lv_move_in_reversal_time)
  WHERE objectclas = @lc_change_document-object_class-move_in
    AND objectid   = @object-key
  ORDER BY
    udate DESCENDING,
    utime DESCENDING.
ENDSELECT.

" Get the date/time for when the move-out documents were changed
SELECT
    objectid,
    udate,
    utime
  from cdhdr
  into table @li_move_out_creation
  for all entries in @li_move_out_documents
  where objectclas = @lc_change_document-object_class-move_out
    and objectid   = @li_move_out_documents-document.

" Sort to make sure the creation date/time is first
SORT li_move_out_creation BY document ASCENDING date ASCENDING time ASCENDING.

LOOP AT li_move_out_documents ASSIGNING <lwa_move_out_document>.
  READ TABLE li_move_out_creation INTO lwa_move_out_creation BINARY SEARCH
    WITH KEY document = <lwa_move_out_document>-document.

  CHECK sy-subrc = 0
  AND   lwa_move_out_creation-date < lv_move_in_reversal_date
  OR    ( lwa_move_out_creation-date = lv_move_in_reversal_date
  AND     lwa_move_out_creation-time < lv_move_in_reversal_time ).

  " Update the creation date/time for only those created before the move-in was reversed

  <lwa_move_out_document>-creation_date = lwa_move_out_creation-date.
  <lwa_move_out_document>-creation_time = lwa_move_out_creation-time.
ENDLOOP.

" Remove move-out documents created after the move-in reversal
DELETE li_move_out_documents WHERE creation_date IS INITIAL.

CHECK li_move_out_documents[] IS NOT INITIAL.

DATA:
  li_installation_objects      TYPE STANDARD TABLE OF swc_object,
  lwa_installation_object      TYPE swc_object,
  li_installations             TYPE STANDARD TABLE OF anlage,
  lv_installation              TYPE anlage,
  li_accounts                  TYPE STANDARD TABLE OF vkont_kk,
  lv_account                   TYPE vkont_kk,
  lv_account_same_installation TYPE vkont_kk.

" Keep only the last move-out document per installation
SORT li_move_out_documents BY installation ASCENDING creation_date DESCENDING creation_time DESCENDING.
DELETE ADJACENT DUPLICATES FROM li_move_out_documents COMPARING installation.

" Get the installation numbers related to this move-in
swc_get_table_property self 'Instlns' li_installation_objects.
LOOP AT li_installation_objects INTO lwa_installation_object.
  swc_get_property lwa_installation_object 'Number' lv_installation.
  APPEND lv_installation TO li_installations.
ENDLOOP.

" Check whether there are any reversed move-out documents that have the same
" account as one that shares an installation with this move-in document.
LOOP AT li_move_out_documents ASSIGNING <lwa_move_out_document>.
  READ TABLE li_installations TRANSPORTING NO FIELDS
    WITH KEY table_line = <lwa_move_out_document>-installation.
  IF sy-subrc = 0.
    IF <lwa_move_out_document>-reversed = abap_true.
      object-isforcedmoatpremcancelled = abap_true.
      EXIT.
    ENDIF.

    lv_account_same_installation = <lwa_move_out_document>-account.
  ENDIF.

  APPEND <lwa_move_out_document>-account TO li_accounts.

  AT LAST.
    IF lv_account_same_installation IS NOT INITIAL.
      READ TABLE li_accounts TRANSPORTING NO FIELDS
        WITH KEY table_line = lv_account_same_installation.
      object-isforcedmoatpremcancelled = boolc( sy-subrc = 0 ).
    ENDIF.
  ENDAT.
ENDLOOP.

swc_set_element container 'IsForcedMOAtPremCancelled'
     object-isforcedmoatpremcancelled.
end_property.
