begin_method zupdategasratecat changing container.
************************************************************************
* Created by  : Gilbert Chong
* Created on  : 10/25/2007
* Description : Check whether gas installation rate categories need to
*               to be updated. Created for defect 7958.
************************************************************************

* Constants
CONSTANTS : c_gasdiv TYPE spart VALUE '02',
            c_rca250 TYPE tariftyp VALUE 'A_250',
            c_rca260 TYPE tariftyp VALUE 'A_260'.

* Declaration
DATA : it_errormsg LIKE zsfo_bal_msg OCCURS 0 WITH HEADER LINE,
       it_oinstln  TYPE swc_object OCCURS 0 WITH HEADER LINE,
       l_midate    TYPE einzdat,
       l_odiv      TYPE swc_object,
       l_div       TYPE spart,
       l_oratecat  TYPE swc_object,
       l_ratecat   TYPE tariftyp,
       l_instln    TYPE anlage,
       s_instfld   TYPE isu_instln_change_direct,
       s_instfldx  TYPE isu_instln_change_direct_x.
swc_container cnt_instln.

* Initialisation
CLEAR : it_errormsg, it_errormsg[], it_oinstln, it_oinstln[], l_midate,
        l_odiv, l_div, l_oratecat, l_ratecat, cnt_instln,
        cnt_instln[], l_instln, s_instfld, s_instfldx.

* Get container values
swc_get_table container 'ErrorMsg' it_errormsg.

* Collect property values
swc_get_table_property self 'Instlns'    it_oinstln.
swc_get_property       self 'MoveInDate' l_midate.

* For each installation
LOOP AT it_oinstln.
  CLEAR : l_odiv, l_div, l_oratecat, l_ratecat, cnt_instln,
          cnt_instln[], l_instln, it_errormsg, s_instfld, s_instfldx.
* Only interested in gas
  swc_get_property   it_oinstln 'Division' l_odiv.
  swc_get_object_key l_odiv l_div.
  IF l_div EQ c_gasdiv.
*   Only interested in rate categories besides A_250 and A_260
    swc_get_property   it_oinstln 'ActRateCat' l_oratecat.
    swc_get_object_key l_oratecat l_ratecat.
    IF l_ratecat NE c_rca250 AND l_ratecat NE c_rca260.
*     Determine what the new rate category should be
      swc_call_method it_oinstln 'ZDetermineOARateCat' cnt_instln.
      swc_get_element cnt_instln 'UpdRateCat' s_instfld-tariftyp.
*     Only proceed if new rate category found
      IF NOT s_instfld-tariftyp IS INITIAL.
        CLEAR : cnt_instln, cnt_instln[].
*       Update the rate category
        swc_set_element cnt_instln 'KeyDate' l_midate.
        swc_set_element cnt_instln 'Prorate' c_x.
        s_instfldx-tariftyp = c_x.
        swc_set_element cnt_instln 'InstallationFields'  s_instfld.
        swc_set_element cnt_instln 'InstallationFieldsX' s_instfldx.
        swc_call_method it_oinstln 'ChangeDirect'        cnt_instln.
*       Log error if unsuccessful
        IF sy-subrc NE 0.
          swc_get_object_key it_oinstln l_instln.
          MOVE : 'ZFO_PMI'                       TO it_errormsg-msgid,
                 '000'                           TO it_errormsg-msgno,
                 'E'                             TO it_errormsg-msgty,
                 'Unable to update rate cat for' TO it_errormsg-msgv1,
                 l_instln                        TO it_errormsg-msgv2,
                 ' '                           TO it_errormsg-probclass.
          APPEND it_errormsg.
        ENDIF.
      ELSE.
*       Log error
        swc_get_object_key it_oinstln l_instln.
        MOVE : 'ZFO_PMI'                   TO it_errormsg-msgid,
               '000'                       TO it_errormsg-msgno,
               'E'                         TO it_errormsg-msgty,
               'No new rate cat found for' TO it_errormsg-msgv1,
               l_instln                    TO it_errormsg-msgv2,
               ' '                         TO it_errormsg-probclass.
        APPEND it_errormsg.
      ENDIF.
    ENDIF.
  ENDIF.
ENDLOOP.

* Set container values
swc_set_table container 'ErrorMsg' it_errormsg.

end_method.

begin_method zupdatecoratecat changing container.
************************************************************************
* Created by  : Gilbert Chong
* Created on  : 11/14/2007
* Description : Created for defect 8675. Determine whether rate
*               category needs to be changed depending on the supply
*               scenario. This replaces task 93000417 from workflow
*               WS93000084
************************************************************************

* Constants
CONSTANTS : c_gasfull  TYPE e_deregscenario VALUE '900',
            c_elecfull TYPE e_deregscenario VALUE '950'.

* Declaration
TYPES : BEGIN OF t_instratecat,
          bis      TYPE biszeitsch,
          tariftyp TYPE tariftyp_anl,
        END OF t_instratecat.
DATA : it_errormsg    LIKE zsfo_bal_msg OCCURS 0 WITH HEADER LINE,
       l_midate       TYPE einzdat,
       l_date         TYPE datum,
       o_pod          TYPE swc_object,
       o_supply       TYPE swc_object,
       l_supply       TYPE e_deregscenario,
       it_instratecat TYPE t_instratecat OCCURS 0 WITH HEADER LINE,
       l_instln       TYPE anlage,
       s_instfld      TYPE isu_instln_change_direct,
       s_instfldx     TYPE isu_instln_change_direct_x,
       it_oinstln     TYPE swc_object OCCURS 0 WITH HEADER LINE.
swc_container cnt_pod.
swc_container cnt_instln.

* Initialisation
CLEAR : it_errormsg, it_errormsg[], it_oinstln, it_oinstln[], l_date,
        o_pod, cnt_pod, cnt_pod[], o_supply, l_supply, it_instratecat,
        it_instratecat[], l_instln, cnt_instln, cnt_instln[], l_date,
        s_instfldx, s_instfld.

* Get container values
swc_get_table container 'ErrorMsg' it_errormsg.

* Collect property values
swc_get_table_property self 'Instlns'    it_oinstln.
swc_get_property       self 'MoveInDate' l_midate.

* Reference date is move-in date - 1
l_date = l_midate - 1.

* Check each installation
LOOP AT it_oinstln.
* Clear values
  CLEAR : o_pod, cnt_pod, cnt_pod[], o_supply, l_supply, l_instln,
          it_instratecat, it_instratecat[], cnt_instln, cnt_instln[],
          s_instfld, s_instfldx.
* Obtain current POD
  swc_get_property it_oinstln 'CurrentPod' o_pod.
* Check supply scenario
  swc_set_element    cnt_pod 'KeyDate'           l_date.
  swc_call_method    o_pod   'GetSupplyScenario' cnt_pod.
  swc_get_element    cnt_pod 'SupplyScenario'    o_supply.
  swc_get_object_key o_supply l_supply.
* Only change rate category if supply scenario is neither elec nor
* gas full serv.
  IF l_supply NE c_gasfull AND l_supply NE c_elecfull.
*   Obtain installation key
    swc_get_object_key it_oinstln l_instln.
*   Get all rate category history
    SELECT bis tariftyp FROM eanlh
                  INTO TABLE it_instratecat
                       WHERE anlage EQ l_instln
                    ORDER BY bis DESCENDING.
*   Obtain the previous rate category
    READ TABLE it_instratecat INDEX 2.
*   Proceed if previous rate category is found
    IF sy-subrc EQ 0.
*     Update the rate category
      swc_set_element cnt_instln 'KeyDate' l_midate.
      swc_set_element cnt_instln 'Prorate' c_x.
      s_instfld-tariftyp  = it_instratecat-tariftyp.
      s_instfldx-tariftyp = c_x.
      swc_set_element cnt_instln 'InstallationFields'  s_instfld.
      swc_set_element cnt_instln 'InstallationFieldsX' s_instfldx.
      swc_call_method it_oinstln 'ChangeDirect'        cnt_instln.
*     Log error if unsuccessful
      IF sy-subrc NE 0.
        MOVE : 'ZFO_PMI'                       TO it_errormsg-msgid,
               '000'                           TO it_errormsg-msgno,
               'E'                             TO it_errormsg-msgty,
               'Unable to update rate cat for' TO it_errormsg-msgv1,
               l_instln                        TO it_errormsg-msgv2,
               ' '                             TO it_errormsg-probclass.
        APPEND it_errormsg.
      ENDIF.
    ELSE.
*     Log error
*      MOVE : 'ZFO_PMI'                        TO it_errormsg-msgid,
*             '000'                            TO it_errormsg-msgno,
*             'E'                              TO it_errormsg-msgty,
*             'No previous rate cat found for' TO it_errormsg-msgv1,
*             l_instln                         TO it_errormsg-msgv2,
*             ' '                              TO it_errormsg-probclass.
*      APPEND it_errormsg.
    ENDIF.
  ENDIF.
ENDLOOP.

* Set container values
swc_set_table container 'ErrorMsg' it_errormsg.

end_method.

