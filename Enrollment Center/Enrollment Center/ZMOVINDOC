      i_installations  TYPE STANDARD TABLE OF ever-anlage,
      wa_installations TYPE ever-anlage,
      l_i_msg          TYPE STANDARD TABLE OF bal_s_msg,
      l_lognum         TYPE bal_s_lgnm-lognumber,
      l_s_msg          TYPE bal_s_msg,
      l_v_moveindoc    TYPE eein-einzbeleg,
      v_sparte         TYPE eanl-sparte,
      v_code           TYPE ediscd-ordercode.
* 12/12/2007 GCHONG D9412 BEGIN
* More variables
TABLES : eanl, evbs, ehauisu.
DATA : o_sorder    TYPE swc_object,
       o_instln    TYPE swc_object,
