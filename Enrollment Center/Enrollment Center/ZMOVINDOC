*&      Form  get_device_location
*&---------------------------------------------------------------------*
*     Determine Device Location for the Premise
*----------------------------------------------------------------------*
*      -->P_W_PREMISE  Object
*----------------------------------------------------------------------*
FORM get_device_location  USING    p_w_premise TYPE swc_object.
  TYPES: BEGIN OF ty_locate,
           tplnr TYPE iflot-tplnr, " Device Location
         END OF ty_locate,
         BEGIN OF ty_orders,
           aufnr TYPE aufk-aufnr,  " Order Number
         END OF ty_orders.

  DATA: lt_locations TYPE TABLE OF ty_locate WITH HEADER LINE,
        lt_orders    TYPE TABLE OF ty_orders WITH HEADER LINE.
  DATA: l_moveindate TYPE eeinsup-einzdat, "Move In Date
        l_objkey     TYPE evbs-vstelle.
*  Get object Key
  swc_get_object_key p_w_premise l_objkey.
* Get the Original Move In Date
  swc_get_property self 'MoveInDate' l_moveindate.
  IF NOT l_objkey IS INITIAL.
* Get Device Locations from IFLOT Functional Location (Table)
    SELECT tplnr FROM iflot INTO TABLE lt_locations
                                         WHERE prems = l_objkey.
  ENDIF.
  IF NOT lt_locations[] IS INITIAL AND sy-subrc EQ 0.
* Get all the Service Orders with this start date and locations
    SELECT aufnr FROM viaufks INTO TABLE lt_orders
                              FOR ALL ENTRIES IN lt_locations
                              WHERE   tplnr = lt_locations-tplnr
                                AND   ilart = 'MIN'
                                AND   gstrp = l_moveindate.
    IF sy-subrc NE 0.
      EXIT. "Do not perform further processing
    ENDIF. " sy-subrc
  ENDIF. " if not lt_locations is initial
* Cancel Each Order
  LOOP AT lt_orders.
    PERFORM cancel_service_order_2 USING lt_orders-aufnr.
  ENDLOOP.
ENDFORM.                    " get_device_location

