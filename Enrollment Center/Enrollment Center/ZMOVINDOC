*        l_s_msg-msgv1 = l_v_moveindoc.
*        APPEND  l_s_msg TO  l_i_msg.
*        CLEAR  l_s_msg.
*      WHEN OTHERS.
*        l_s_msg-msgty = c_error.
*        l_s_msg-msgid = c_mclass1.
*        l_s_msg-msgno = '016'.
*        l_s_msg-msgv1 = l_v_moveindoc.
*        APPEND  l_s_msg TO  l_i_msg.
*        CLEAR  l_s_msg.
*    ENDCASE.
** Move out the customer message
*    l_s_msg-msgty = c_error.
*    l_s_msg-msgid = c_mclass1.
*    l_s_msg-msgno = '018'.
*    l_s_msg-msgv1 = l_v_moveindoc.
*    APPEND  l_s_msg TO  l_i_msg.
*    CLEAR  l_s_msg.
** Create application log
*    PERFORM z_create_appl_log USING l_i_msg
*                              CHANGING l_lognum.
** Send message to the agents.
*    PERFORM z_send_message USING c_movein
*                                 l_lognum
*                                 l_v_moveindoc.
*    exit_return '9001' space space space space.
    lv_subrc = sy-subrc.

    CLEAR l_s_msg.

    CONCATENATE sy-msgid sy-msgno INTO l_s_msg-msgv4
      SEPARATED BY space.

    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno WITH
      sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO lv_message.

    l_s_msg-msgv1 = lv_message(50).
    IF lv_message+49(1) = space.
      l_s_msg-msgv2 = lv_message+49(50).
    ELSE.
      l_s_msg-msgv2 = lv_message+50(50).
    ENDIF.

    CASE lv_subrc.
      WHEN 2. " foreign lock
        exit_return 9002 l_s_msg-msgv1 l_s_msg-msgv2
          l_s_msg-msgv3 l_s_msg-msgv4.
      WHEN OTHERS.
        exit_return 9003 l_s_msg-msgv1 l_s_msg-msgv2
          l_s_msg-msgv3 l_s_msg-msgv4.
    ENDCASE.
*----|END-OF-CHANGE|MMRobson|07/22/2011|CRM 7 defect 1365|----*
  ENDIF.
