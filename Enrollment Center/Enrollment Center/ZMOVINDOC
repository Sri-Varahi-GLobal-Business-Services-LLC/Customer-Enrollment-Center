                                             CHANGING t_orders.

  REFRESH: t_obj_instln, t_obj_crntdevices.
*obtain the value of installation from MoveIndoc
  swc_get_table_property w_moveindoc 'Instlns' t_obj_instln.
* loop at installations
  LOOP AT t_obj_instln INTO wa_obj_instln.
    REFRESH: t_obj_crntdevices.
    swc_get_table_property wa_obj_instln 'zCurrentDevices' t_obj_crntdevices.

* Obtain the value is Instlntype from W_instln
    swc_get_property wa_obj_instln 'InstallationType' w_instlntype.
* Check for the installation type, process all except LIGHT.
    fl_instlntype = space. "initializing the Flag Fl_INSTLNTYPE
    CASE w_instlntype.
      WHEN 'BARN'
        OR 'MOP'
        OR 'POOL'
        OR 'PRIM'
        OR 'PUMP'
        OR 'SHOP'.
        fl_instlntype   = c_xflag.
      WHEN OTHERS. fl_instlntype = space.
    ENDCASE.
*Obtain value of multiline attribute Currentdevices from t_obj_instln.
    swc_get_table_property wa_obj_instln 'zCurrentDevices' t_obj_crntdevices.

*2s If Metered.
    IF t_obj_crntdevices IS NOT INITIAL.
*3s If original move in date is less than system date.
      IF w_origmi_date < sy-datum.
* fetch the days limit from the table zmove_io_days.
*        SELECT SINGLE ZZDAYS FROM ZMOVE_IO_DAYS
*        INTO W_ZZDAYS.
*calculating date difference.
*        W_DATEDIFF = W_NEWMIDATE - W_ORIGMI_DATE.
        w_datediff = w_newmidate - w_mo_date.
*4s if Original - New MoveIn days > w_ZZDAYS.
        IF w_datediff > w_zzdays.
* call subroutine to obtain next work date.
          PERFORM z_get_next_work_date_edit_mi
                                     USING sy-datum
                                     CHANGING w_nextwrkdate.
*5s if new movein date > next work date.
          IF w_newmidate > w_nextwrkdate.
* call subroutine to create disconnection doc and ord.
            PERFORM z_create_disc_doc_edit_mi USING wa_obj_instln
                                                      w_nextwrkdate.
* obtain the disconnect object created
*           SWC_GET_ELEMENT T_CONTAINER 'DISCONNECT' WA_OBJ_ACTDISDOC.
* obtain the value for the movein doc key.
*           SWC_GET_OBJECT_KEY  W_MIDOC_KEY.
* call subroutine to create reconnection order.
            PERFORM z_create_recon_order_edit_mi USING wa_obj_instln
                                                          w_newmidate
                                                      object-key-number.
*5e endif of 5s (new movein date > next work date.)
          ENDIF.
*4e endif of 4s.
        ENDIF.
*3m else wrt if condition 3s
      ELSE.
* subroutine to determine previous moveouts
*       PERFORM z_get_prevs_mo_date_edit_mi
*                            CHANGING w_mo_date
*                                     w_number
*                                     w_moforced
*                                     w_obj_modoc.
        IF w_mo_date IS NOT INITIAL.
*calculating date difference.
          w_datediff = w_origmi_date - w_mo_date.
*6s if Original MI Date less Previous MO Date > ZMOVE_IO_DAYS days
          IF w_datediff > w_zzdays.
*calculating date difference.
            w_datediff = w_newmidate - w_mo_date.
*7s if new MI date less previous MO date > ZMOVE_IO_DAYS days
            IF w_datediff > w_zzdays.
* obtaining the value of functional location
              swc_get_property wa_obj_instln 'premises' w_obj_premises.
              swc_get_property w_obj_premises 'connobj'  w_obj_connobj.
              swc_get_object_key w_obj_connobj w_functloc.

* loop at the T_ORDERS internal table and on a condition
              SORT t_orders BY aufnr.
              CLEAR w_order_backup.
              LOOP AT t_orders INTO wa_orders.
*8s if order exits for functional location  and activity type 'REC'.
                IF wa_orders-tplnr = w_functloc AND
                   wa_orders-ilart = 'REC' AND
                   wa_orders-flag IS INITIAL.
                  w_txt_fl = 'X'.
* call subroutine to change service order start date
                  CASE w_order_backup.
                    WHEN wa_orders-aufnr.
                    WHEN OTHERS.
                      PERFORM z_change_sord_stddat_edit_mi USING wa_orders
                                                               w_newmidate.
                  ENDCASE.
                  w_order_backup = wa_orders-aufnr.
                  wa_orders-flag = 'X'.
                  MODIFY t_orders FROM wa_orders TRANSPORTING flag
                                            WHERE aufnr = wa_orders-aufnr.
*8e endif wrt 8s
                ENDIF.
              ENDLOOP.
              CLEAR w_order_backup.
*7m else for 7s
            ELSE.
* previous move out date is determined previously
*9s if prev MO date Greater than todays date
              IF w_mo_date GE sy-datum.
                REFRESH : t_obj_actdisdoc.
* obtain value of ActDisconnectionDocuments
                swc_get_table_property wa_obj_instln
                              'ActDisconnectionDocuments' t_obj_actdisdoc.
*10s if ActDisconnectionDocuments is empty
                IF t_obj_actdisdoc IS NOT INITIAL.

* obtaining the value of functional location
                  swc_get_property wa_obj_instln 'premises' w_obj_premises.
                  swc_get_property w_obj_premises 'connobj'  w_obj_connobj.
                  swc_get_object_key w_obj_connobj w_functloc.

                  LOOP AT t_orders INTO wa_orders.
*11s if order exits for functional location  and activity type 'REC'.
                    IF wa_orders-tplnr = w_functloc AND
                       wa_orders-ilart = 'REC' AND
                       wa_orders-flag IS INITIAL.
* call subroutine to cancel service order
                      PERFORM z_cancel_ser_order_edit_mi USING wa_orders.
                      wa_orders-flag = 'X'.
                      MODIFY t_orders FROM wa_orders TRANSPORTING flag .
*11e endif wrt 11s
                    ENDIF.
                  ENDLOOP.
*call subroutine to cancel disconnection doc activity
                  PERFORM z_cancel_disc_doc_act_edit_mi USING t_obj_actdisdoc.
* call subroutine to find pending disc orders
                  REFRESH: t_orders3.
                  PERFORM z_find_disc_order USING w_mo_date
                                                  t_obj_actdisdoc.

*12s If pending  Discon Orders exists
                  CLEAR wa_orders.
*               LOOP AT t_orders3 INTO wa_orders.
                  wa_orders-aufnr = w_reconorder.
                  wa_orders-gstrp = w_mo_date.
* call subroutine to cancel the service order
                  PERFORM z_cancel_ser_order_edit_mi USING wa_orders.


*                 wa_orders-flag = 'X'.
*  MODIFY t_orders3 FROM wa_orders INDEX sy-tabix TRANSPORTING flag .
*                ENDLOOP.
*call subroutine to cancel disconnection doc activity
                  PERFORM z_cancel_disc_doc_act_edit_mi USING t_obj_actdisdoc.
* call subroutine to close disconnection doc.
                  PERFORM z_close_disc_doc_edit_mi USING t_obj_actdisdoc.
* call subroutine to create read order.
                  PERFORM z_create_read_order_edit_mi USING
                                                      wa_obj_instln
                                                      t_obj_crntdevices
                                                      w_obj_modoc
                                                      w_mo_date.
*10e wrt 10s
                ENDIF.
*9m else wrt 9s (if prev MO date Less than todays date )
              ELSE.
                swc_get_property wa_obj_instln 'premises' w_obj_premises.
                swc_get_property w_obj_premises 'connobj'  w_obj_connobj.
                swc_get_property w_obj_connobj 'FunctLocation' w_functloc.
                LOOP AT t_orders INTO wa_orders.
*13s if order exits for functional location  and activity type 'REC'.
                  IF wa_orders-tplnr = w_functloc AND
                     wa_orders-ilart = 'REC' AND
                     wa_orders-flag IS INITIAL.
* call subroutine to cancel service order
*                  PERFORM z_cancel_ser_order_edit_mi USING wa_orders.
                    w_txt_fl = 'X'.
                    PERFORM z_change_sord_stddat_edit_mi USING wa_orders
                                                              w_newmidate.

                    wa_orders-flag = 'X'.
                    MODIFY t_orders FROM wa_orders TRANSPORTING flag .
*13e endif wrt 11s
                  ENDIF.
                ENDLOOP.
*9e endif wrt 9s
              ENDIF.
*7e endif of 7s
            ENDIF.
*6m else wrt 6s (OriginalMIDate less PrevMO Date > w_zzdays)
          ELSE.
*calculating date difference.
            w_datediff = w_newmidate - w_mo_date.
*14s if New MI date - Prev MO date GT ZZdays.
            IF w_datediff GT w_zzdays.
*15s if prev MO date GE today's date
              IF w_mo_date GE sy-datum.
                swc_get_property wa_obj_instln 'premises' w_obj_premises.
                swc_get_property w_obj_premises 'connobj'  w_obj_connobj.
                swc_get_property w_obj_connobj 'FunctLocation' w_functloc.
* subroutine to find service orders
                REFRESH: t_orders2.
                PERFORM z_find_service_orders_edit_mi USING t_obj_crntdevices
                                                            w_mo_date
                                                   CHANGING t_orders2.
                LOOP AT t_orders2 INTO wa_orders.
*16s if order exits for functional location  and activity type 'REA'.
                  IF ( wa_orders-tplnr = w_functloc OR
                     wa_orders-tplnr IS INITIAL ) AND
                     wa_orders-ilart = 'REA'.
* call subroutine to cancel service order
                    PERFORM z_cancel_ser_order_edit_mi USING wa_orders.
                    wa_orders-flag = 'X'.
                    MODIFY t_orders2 FROM wa_orders TRANSPORTING flag .
*16e endif wrt 11s
                  ENDIF.
                ENDLOOP.
*call subroutine to cancel disc doc activity
*          PERFORM z_cancel_disc_doc_act_edit_mi USING t_obj_actdisdoc.

                PERFORM z_create_disc_doc_edit_mi USING wa_obj_instln
                                                        w_mo_date.
*call subroutine to create reconnection order
                PERFORM z_create_recon_order_edit_mi USING wa_obj_instln
                                                              w_newmidate
                                                        object-key-number.

*15m else wrt 15s
              ELSE.
*calculating date difference.
                w_datediff = w_newmidate - w_mo_date.
*17s if New MI date - Prev MO date > zzdays.
                IF w_datediff > w_zzdays.
* subroutine to determine next work date.
                  PERFORM z_get_next_work_date_edit_mi USING sy-datum
                                                   CHANGING w_nextwrkdate.
*18s if New MI daye > Next work date
                  IF w_newmidate > w_nextwrkdate.
*call subroutine to create disc doc activity
*           PERFORM z_cancel_disc_doc_act_edit_mi USING t_obj_actdisdoc.

                    PERFORM z_create_disc_doc_edit_mi USING wa_obj_instln
                                                            w_nextwrkdate.
*call subroutine to create reconnection order
                    PERFORM z_create_recon_order_edit_mi USING wa_obj_instln
                                                                 w_newmidate
                                                           object-key-number.
*18e. endif wrt 18s.
                  ENDIF.
*17e endif wrt 17s.
                ENDIF.
*15e endif wrt 1s
              ENDIF.

*14e endif wrt 14s.
            ENDIF.
*6e endif of 6s
          ENDIF.
        ENDIF.  "W_MO_DATE IS NOT INITIAL
*3e endif wrt original movain date > sy-datum.
      ENDIF.
*2e end of if wrt Meter.
    ENDIF.
* end of loop of installations
  ENDLOOP.
*1m Else (w_NewMoveInDate LT sy-datum.)
ELSE.
  LOOP AT t_orders INTO wa_orders.
* call subroutine to cancel service order
    PERFORM z_cancel_ser_order_edit_mi USING wa_orders.
  ENDLOOP.
*1e end of 1s-if
ENDIF.
*------------------------ PART B ------------------------------*
LOOP AT t_orders INTO wa_orders.
  IF wa_orders-flag = space.
    IF w_newmidate GE sy-datum.
      w_txt_fl = 'X'.
* call subroutine to change service order start date
      PERFORM z_change_sord_stddat_edit_mi USING wa_orders
*                                                 wa_orders-gstrp.
                                                 w_newmidate.
    ELSE.
* call subroutine to cancel service order
      PERFORM z_cancel_ser_order_edit_mi USING wa_orders.
    ENDIF.
  ENDIF.
ENDLOOP.
*---------------------------------------------------------------------*
swc_set_table container 'W_ISUSMORDER' t_isusmorder.
end_method.
*------------------- SUBROUTINES OF EDIT MOVE IN ----------------------*
*>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*
*                   S U B R O U T I N E S                             *
*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<*
*&---------------------------------------------------------------------*
*&      Form  z_find_service_orders_EDIT_MI
*&---------------------------------------------------------------------*
*  Soubroutine to find service orders
*----------------------------------------------------------------------*
*      -->t_obj_crntdevices  text
*      -->w_date
*----------------------------------------------------------------------*
FORM z_find_service_orders_edit_mi USING
                        t_obj_crntdevices       TYPE tt_swcobject
                        w_date                  TYPE sy-datum
                        CHANGING p_t_orders     TYPE tt_orders.
  DATA: lw_orders TYPE x_orders.
  TYPES : BEGIN OF x_afko ,
            aufnr LIKE afih-aufnr,   " order number
            ilart LIKE afih-ilart,   " Maintenance activity type
            equnr LIKE afih-equnr,   " equipment number
            iloan LIKE afih-iloan,   " Location and account assignment
            " for technical object
            gstrp LIKE afko-gstrp,   " Basic start date
          END OF x_afko.

* type for functional location
  TYPES : BEGIN OF x_iflot ,
            aufnr LIKE afih-aufnr,
            iloan LIKE iflot-iloan,  " Location and account assignment
            " for technical object
            ilart LIKE afih-ilart,          " for technical object
            tplnr LIKE iflot-tplnr,  " Functional Location
          END OF x_iflot.

  TYPES : BEGIN OF ty_pendrec ,
            aufnr LIKE afko-aufnr,         " order
          END OF ty_pendrec.

  TYPES: BEGIN OF x_devices,         "To hold Equnr, Devloc and Connobj
           equnr   TYPE equi-equnr, "from devices
           devloc  TYPE egpld-devloc,
           connobj TYPE ehaud-haus,
         END OF x_devices.
  TYPES: BEGIN OF x_temp_orders,    "To hold orders based on status
           aufnr TYPE aufk-aufnr,   "flag
           stat  TYPE jest-stat,
           inact TYPE jest-inact,
         END OF x_temp_orders.
  DATA: l_t_afko          TYPE TABLE OF x_afko,
        l_t_iflot         TYPE TABLE OF x_iflot,
        t_dummy_order     TYPE TABLE OF ty_pendrec WITH HEADER LINE,
        l_wa_afko         TYPE x_afko,
        l_wa_iflot        TYPE x_iflot,
        l_obj_devloc      TYPE swc_object,
        l_obj_connobj     TYPE swc_object,
        l_t_devices       TYPE TABLE OF x_devices,
        l_wa_devices      TYPE x_devices,
        l_t_temp_orders   TYPE TABLE OF x_temp_orders,
        l_wa_temp_orders  TYPE x_temp_orders,
        l_obj_premises    TYPE swc_object,
        l_vstelle         TYPE evbs-vstelle,
        l_t_iflot_premise TYPE TABLE OF x_iflot,
        l_dummy_order     TYPE TABLE OF ty_pendrec WITH HEADER LINE.

  CONSTANTS: c_e0001 TYPE jest-stat VALUE 'E0001',
             c_i0045 TYPE jest-stat VALUE 'I0045'.

* obatin equipment no and functional location from current devices
  LOOP AT t_obj_crntdevices INTO wa_obj_crntdevices.
* obtain the equipment number.
    swc_get_object_key wa_obj_crntdevices l_wa_devices-equnr.
*obtain the device location object
    swc_get_property wa_obj_crntdevices 'DeviceLocation'
                                       l_obj_devloc.
* obtain key of device location object
    swc_get_object_key l_obj_devloc l_wa_devices-devloc.
*obtain the connection object
    swc_get_property l_obj_devloc 'ConnObj' l_obj_connobj.
*obtain the key of connection object
    swc_get_object_key l_obj_connobj l_wa_devices-connobj.
* appen it to devices table
    APPEND l_wa_devices TO l_t_devices.
  ENDLOOP.
* proceed to obtain orders from afko, afih and iflot if L_T_DEVICES is
* not initial.
*  CHECK NOT l_t_devices IS INITIAL.

  REFRESH l_t_afko.
  CLEAR l_wa_afko.
  LOOP AT l_t_devices INTO l_wa_devices.
    SELECT  a~aufnr
            a~ilart
            a~equnr
            a~iloan
            b~gstrp
*  INTO TABLE l_t_afko
     APPENDING TABLE l_t_afko
    FROM afih AS a INNER JOIN afko AS b ON a~aufnr = b~aufnr
*  FOR ALL ENTRIES IN l_t_devices
*  WHERE b~gstrp = w_date AND a~equnr = l_t_devices-equnr.
    WHERE b~gstrp = w_date AND a~equnr = l_wa_devices-equnr.

* if previous select was successfull then proceed further
*  CHECK sy-subrc = 0.
    REFRESH l_t_iflot.
* select Location and account assignment for technical object,Functional
* Location from tables AFIH and IFLOT .
*  SELECT  a~iloan
*          b~tplnr
*  INTO TABLE l_t_iflot
*  FROM afih AS a INNER JOIN iflot AS b ON a~iloan = b~iloan
*  FOR ALL ENTRIES IN l_t_devices
*  WHERE ( b~tplnr = l_t_devices-devloc AND
*          b~fltyp = 'G' )                    OR
*        ( b~tplnr = l_t_devices-connobj AND
*          b~fltyp = 'A' ).

    SELECT a~aufnr a~iloan a~ilart b~tplnr
*             INTO TABLE l_t_iflot
            APPENDING TABLE l_t_iflot
            FROM afih AS a INNER JOIN iflot AS b ON a~iloan = b~iloan
              FOR ALL ENTRIES IN l_t_devices
             WHERE b~tplnr = l_t_devices-devloc AND
             b~fltyp = 'G'.

    SELECT a~aufnr a~iloan a~ilart b~tplnr
         APPENDING TABLE l_t_iflot
         FROM afih AS a INNER JOIN iloa AS b ON a~iloan = b~iloan
                        INNER JOIN objk AS c ON a~obknr = c~obknr
                        FOR ALL ENTRIES IN l_t_devices
                        WHERE b~tplnr = l_t_devices-connobj
                         AND c~equnr = l_t_devices-equnr.

* if previous select was successfull then proceed further
*  CHECK sy-subrc = 0.
    LOOP AT l_t_iflot INTO l_wa_iflot.

      SELECT a~aufnr
*          INTO TABLE t_dummy_order
           APPENDING TABLE t_dummy_order
           FROM afih AS a INNER JOIN afko AS b ON a~aufnr = b~aufnr
            WHERE b~gstrp = w_date
            AND   a~aufnr = l_wa_iflot-aufnr
            AND   a~ilart = l_wa_iflot-ilart
            AND   a~iloan = l_wa_iflot-iloan.
      IF sy-subrc = 0.
        LOOP AT t_dummy_order WHERE aufnr = l_wa_iflot-aufnr.
          lw_orders-aufnr = l_wa_iflot-aufnr.
          lw_orders-ilart = l_wa_iflot-ilart.
          lw_orders-tplnr = l_wa_iflot-tplnr.
          lw_orders-equnr = l_wa_devices-equnr.
          lw_orders-gstrp = w_date.
          lw_orders-flag = space.
          APPEND lw_orders TO p_t_orders.
        ENDLOOP.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

  swc_get_property self 'Instlns' w_installation1.
  swc_get_property w_installation1 'Premises' l_obj_premises.
  swc_get_object_key l_obj_premises l_vstelle.

  SELECT tplnr iloan
                    INTO CORRESPONDING FIELDS OF TABLE l_t_iflot_premise
                    FROM iflot
                    WHERE prems = l_vstelle.

  LOOP AT l_t_iflot_premise INTO l_wa_iflot.
    SELECT aufnr FROM viaufks
            APPENDING TABLE l_dummy_order
            WHERE tplnr = l_wa_iflot-tplnr
            AND gstrp = w_date
*           and iloan = l_wa_iflot-iloan
            AND ilart = 'MIN'.
    IF sy-subrc = 0.
      LOOP AT l_dummy_order.
        lw_orders-aufnr = l_dummy_order-aufnr.
        lw_orders-ilart = l_wa_iflot-ilart.
        lw_orders-tplnr = l_wa_iflot-tplnr.
*          lw_orders-equnr = l_wa_devices-equnr.
        lw_orders-gstrp = w_date.
        lw_orders-flag = space.
        APPEND lw_orders TO p_t_orders.

      ENDLOOP.
    ENDIF.
  ENDLOOP.

  LOOP AT l_t_afko INTO l_wa_afko.

* READ TABLE l_t_iflot INTO l_wa_iflot WITH KEY iloan = l_wa_afko-iloan.
* if read was successfull then proceed further
    CHECK sy-subrc = 0.
    MOVE l_wa_afko-aufnr  TO wa_orders-aufnr.
    MOVE l_wa_afko-ilart  TO wa_orders-ilart.
    MOVE l_wa_afko-equnr  TO wa_orders-equnr.
*    MOVE l_wa_iflot-tplnr TO wa_orders-tplnr.
    MOVE l_wa_afko-gstrp  TO wa_orders-gstrp.
    APPEND wa_orders TO p_t_orders.
  ENDLOOP.
* proceed further when internal table P_T_ORDERS is not initial
*  CHECK NOT p_t_orders IS INITIAL.
*sorting orders table based on order number
  SORT p_t_orders BY aufnr.
* deleting duplicate entries.
  DELETE ADJACENT DUPLICATES FROM p_t_orders.
* select by joining AUFK and JEST on OBJNR.
  SELECT a~aufnr
         b~stat
         b~inact
  INTO TABLE l_t_temp_orders
  FROM aufk AS a INNER JOIN jest AS b
  ON a~objnr = b~objnr
  FOR ALL ENTRIES IN p_t_orders
  WHERE a~aufnr = p_t_orders-aufnr AND
        b~inact = space          AND
      ( b~stat  = c_e0001        OR
        b~stat  = c_i0045  ).

* proceed further if previous select was successfull
  CHECK sy-subrc = 0.
  LOOP AT l_t_temp_orders INTO l_wa_temp_orders.
    DELETE  p_t_orders WHERE aufnr =  l_wa_temp_orders-aufnr.
  ENDLOOP.

ENDFORM.                    " z_find_service_orders_EDIT_MI
*&---------------------------------------------------------------------*
*&      Form  z_get_next_work_date_EDIT_MI
*&---------------------------------------------------------------------*
*  Subroutine to ger next work date
*----------------------------------------------------------------------*
*      -->P_W_NEWMIDATE  New Movein Date
*      <--P_W_NEXTWRKDATE  Newxt Work Date
*----------------------------------------------------------------------*
FORM z_get_next_work_date_edit_mi USING    w_sydatum TYPE sy-datum
                                  CHANGING w_nextwrkdate TYPE scal-date.

  DATA: l_sydatum TYPE sy-datum.
  CONSTANTS: c_us(2) TYPE c VALUE 'US'.
  l_sydatum = w_sydatum + 1.

* function module to get the next work date.

  CALL FUNCTION 'DATE_CONVERT_TO_FACTORYDATE'
    EXPORTING
      correct_option               = '+'
      date                         = l_sydatum
      factory_calendar_id          = 'Z1'
    IMPORTING
      date                         = w_nextwrkdate
*     FACTORYDATE                  =
*     WORKINGDAY_INDICATOR         =
    EXCEPTIONS
      calendar_buffer_not_loadable = 1
      correct_option_invalid       = 2
      date_after_range             = 3
      date_before_range            = 4
      date_invalid                 = 5
      factory_calendar_not_found   = 6
      OTHERS                       = 7.
  IF sy-subrc <> 0.
    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
  ENDIF.

ENDFORM.                    " z_get_next_work_date

*&---------------------------------------------------------------------*
*&      Form  z_CREATE_DISCONNECT_DOC
*&---------------------------------------------------------------------*
*       Create Disconnection Document And Disconnection Order
*----------------------------------------------------------------------*
*      -->P_WA_INSTLN  Installation Object
*----------------------------------------------------------------------*
FORM z_create_disc_doc_edit_mi USING  p_wa_instln    TYPE swc_object
                                      p_w_movoutdate TYPE eausv-auszdat.
* declaration of container.

  DATA: lt_isusmorder TYPE TABLE OF swc_object.
  DATA: l_ordernum      TYPE ediscact-ordernum,
* disconnection order number.
        l_disdocno      TYPE ediscdoc-discno,
* disconnection document object
        l_wa_actdisdoc  TYPE swc_object,
* Service Order Number
        l_wa_isusmorder TYPE swc_object.

  DATA l_key TYPE ediscdoc-discno.

* Constants Declarations
  CONSTANTS: c_discreason     TYPE ediscdoc-discreason
                              VALUE '02',
             c_ordercode      TYPE ediscd-ordercode
                              VALUE 'ZDIS',
             c_plantplan      TYPE ediscd-orderwerk
                              VALUE '1001',
*             C_X          TYPE C VALUE 'X',
             c_moveindoc(9)   TYPE c VALUE 'MOVEINDOC',
             c_moveoutdoc(10) TYPE c VALUE 'MOVEOUTDOC'.
  REFRESH: t_container.
* Setting the values to the export parameters in event container.
