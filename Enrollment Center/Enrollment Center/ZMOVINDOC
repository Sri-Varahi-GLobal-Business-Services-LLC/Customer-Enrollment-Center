FORM create_disconnect_doc  USING    p_wa_instln TYPE swc_object
                                     p_w_movoutdate.


  DATA: lt_isusmorder TYPE TABLE OF swc_object.
  DATA: l_ordernum    TYPE ediscact-ordernum,
* disconnection order number.
        l_disdocno    TYPE ediscdoc-discno,
* disconnection document object
        wa_actdisdoc  TYPE swc_object,
* Service Order Number
        wa_isusmorder TYPE swc_object.

  DATA l_key TYPE ediscdoc-discno.

* Constants Declarations
  CONSTANTS: c_discreason TYPE ediscdoc-discreason
                          VALUE '02',
             c_ordercode  TYPE ediscd-ordercode
                          VALUE 'ZDIS',
             c_plantplan  TYPE ediscd-orderwerk
                          VALUE '1001'.

* Setting the values to the export parameters in event container.
  swc_set_element t_container 'DisconnectionReason' c_discreason.
  swc_set_element t_container 'ReferenceObject'     p_wa_instln.
  swc_set_element t_container 'ObjectType'          'MOVEOUTDOC'.
  swc_set_element t_container 'ObjectKey'            l_disdocno.
* Calling the method CreateFromdata of object disconnect
*  IF F_POSITION = 'X'.
* creating disconnection object whan no disc doc exits.
  swc_create_object wa_actdisdoc 'DISCONNECT' l_disdocno.
*  ENDIF.

  swc_call_method wa_actdisdoc 'CreateFromdata' t_container.

  swc_get_object_key wa_actdisdoc l_key.
* If the method execution failed
  IF sy-subrc NE 0.
* display messsage: Could not create disconnection document
    MESSAGE s008(zcse).
    EXIT.
  ENDIF.
* Setting the values to the export parameters in event container.
  swc_set_element t_container 'OrderCode'  c_ordercode.
  swc_set_element t_container 'PlanPlantForOrd' c_plantplan.
  swc_set_element t_container 'DisconActivityDate' p_w_movoutdate.
  swc_set_element t_container 'SetCommitWork'  'X'.
  swc_set_element t_container 'SetCommitWorkAndWait'  'X'.
* Calling the method DarkCreateDcorder of object disconnect
  swc_call_method wa_actdisdoc 'DarkCreateOfDcorder' t_container.
* If the method execution failed
  IF sy-subrc NE 0.
* DISPLAY MESSAGE: Could not create disconnection order
    MESSAGE s009(zcse).
    EXIT.
  ENDIF.
*Obtaining the order number returned by the method
  swc_get_element t_container 'Order' l_ordernum.
*Instantiating the service order object with the order number.
  swc_create_object wa_isusmorder 'ISUSMORDER' l_ordernum.
*  get the service order object
  swc_get_table t_container   'ISUSMORDER' lt_isusmorder.
*  append the order to the service order object
  APPEND wa_isusmorder TO lt_isusmorder.
*  set back the order back to container
  swc_set_table   t_container 'ISUSMORDER' lt_isusmorder.
ENDFORM.                    " CREATE_DISCONNECT_DOC
*&---------------------------------------------------------------------*
*&      Form  CHECK_PENDING_DISCONN
*&---------------------------------------------------------------------*
*       Check Pending Disconnection/ meter disconnected
*----------------------------------------------------------------------*
*      -->P_WA_INSTLN  Installation Object
*----------------------------------------------------------------------*
FORM check_pending_disconn  USING    p_wa_instln TYPE swc_object
                                     p_w_moveoutdate.
  DATA: lt_device  TYPE TABLE OF swc_object,
*        Internal table for Disconnection Objects
        lt_discdoc TYPE STANDARD TABLE OF swc_object,
        l_discdoc  TYPE swc_object,
        l_state    TYPE ediscdoc-status.


  swc_get_table_property p_wa_instln 'zCurrentDevices' lt_device.
  IF NOT lt_device IS INITIAL.
*    Check Meter is disconnected or pending disconnection
* Get all the Active Disconnection documents for this instln
    swc_get_table_property p_wa_instln
                                 'ACTDISCONNECTIONDOCUMENTS' lt_discdoc.
    IF lt_discdoc[] IS INITIAL.
      PERFORM create_disconn_next_day USING p_wa_instln.

    ENDIF.
* Now for Each Disconnection check the status
    LOOP AT lt_discdoc INTO l_discdoc.
*  Get the Order Status
      swc_get_property l_discdoc 'State' l_state.
      CHECK l_state NE '20'.
      CHECK l_state NE '21'.
*if status is not 20 or 21 then create disc doc
*  Create Disconnection Document & Order
*      PERFORM create_disconnect_doc USING p_wa_instln
*                                          p_w_moveoutdate.
      PERFORM create_disconn_next_day USING p_wa_instln.

    ENDLOOP.   " t_disconnections

  ENDIF.

ENDFORM.                    " CHECK_PENDING_DISCONN
*&---------------------------------------------------------------------*
*&      Form  CREATE_DISCONN_NEXT_DAY
*&---------------------------------------------------------------------*
*       Create Disconnection Document for next working day
*----------------------------------------------------------------------*
*      -->P_WA_INSTLN  Installation object
*----------------------------------------------------------------------*
FORM create_disconn_next_day  USING    p_wa_instln.
  DATA: l_currdate     TYPE scal-date,
        l_working_date TYPE sy-datum,
        l_fdate        TYPE scal-facdate,
        l_indic        TYPE scal-indicator,
        l_currdate1    TYPE scal-facdate.

  l_currdate = sy-datum + 1.
  CALL FUNCTION 'DATE_CONVERT_TO_FACTORYDATE'
    EXPORTING
      correct_option               = '+'
      date                         = l_currdate
      factory_calendar_id          = 'Z1'
    IMPORTING
      date                         = l_working_date
      factorydate                  = l_currdate1
      workingday_indicator         = l_indic
    EXCEPTIONS
      calendar_buffer_not_loadable = 1
      correct_option_invalid       = 2
      date_after_range             = 3
      date_before_range            = 4
      date_invalid                 = 5
      factory_calendar_not_found   = 6
      OTHERS                       = 7.
  IF sy-subrc <> 0.
    MESSAGE ID sy-msgid TYPE 'I' NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
  ENDIF.
*  Create the disconnection document
  PERFORM create_disconnect_doc USING p_wa_instln
                                      l_working_date.

ENDFORM.                    " CREATE_DISCONN_NEXT_DAY
