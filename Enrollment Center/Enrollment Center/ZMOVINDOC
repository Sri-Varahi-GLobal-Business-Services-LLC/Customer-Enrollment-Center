  DATA: lw_premises TYPE evbs-vstelle.
  DATA: lt_iflot TYPE ty_iflot OCCURS 0 WITH HEADER LINE.
  DATA: wa_iflot TYPE ty_iflot .
  DATA: lw_lines1.
*  DATA: lw_lines2 .
  DATA: lw_lines2 TYPE i. "Satya
  DATA: lw_check1.
  DATA: lobj_device TYPE swc_object.
  DATA: lobj_devloc TYPE swc_object.
  DATA: lt_devices TYPE swc_object OCCURS 0 WITH HEADER LINE.
  DATA: lwa_devices TYPE swc_object .
  DATA: lw_devloc TYPE v_eger-devloc.
  DATA: lw_desc TYPE ehau-pltxt.
  DATA: lw_loc TYPE egpld-storttext.
  DATA: lobj_premises TYPE swc_object OCCURS 0 WITH HEADER LINE.
  DATA: lobj_connobj TYPE swc_object OCCURS 0 WITH HEADER LINE.
  DATA: lw_regiogroup TYPE adrreggrp-regiogroup.
*  DATA: LW_WORKCENTER TYPE CAUFVD-VAWRK.
  DATA: lw_workcenter TYPE teregplantwc-vaplz.
  DATA: lw_fun_loc TYPE swc_object.
  DATA: lw_partner TYPE swc_object.
  DATA: BEGIN OF t_index OCCURS 0,
          devloc   LIKE v_eger-devloc,
          desc(80) TYPE c, "EHAU-PLTXT,
          loc      LIKE egpld-storttext,
        END OF t_index.
  DATA: w_titel TYPE char100.
  DATA: w_choise TYPE sy-tabix.
  DATA : c_endpos_col  TYPE int4 VALUE '90'.
  DATA : c_endpos_row  TYPE int4 VALUE '10'.
  DATA : c_startpos_col  TYPE int4 VALUE '10'.
  DATA : c_startpos_row  TYPE int4 VALUE '3'.
  DATA: w_descript TYPE ewogen-descript.
  DATA: w_instln   TYPE eanl-anlage.
  DATA: lw_fun_key TYPE egpld-devloc.
  DATA: obj_premise TYPE swc_object.
  DATA: lw_objref_isusmorder TYPE swc_object.
  DATA: l_aufnr TYPE aufk-aufnr.
  CONSTANTS: c_l_order_code TYPE tewocodes-order_code VALUE 'ZIMT'.
  swc_get_property p_obj_instln 'Premises' obj_premise.
  swc_get_object_key obj_premise lw_premises.

  SELECT  tplnr
  FROM iflot
  INTO TABLE lt_iflot
   WHERE prems = lw_premises.
  DESCRIBE TABLE lt_iflot LINES lw_lines1.
  IF lw_lines1 > 1.
    swc_get_property p_obj_instln 'Number' w_instln.
    swc_get_property p_obj_instln 'ZInstTypeDesc' w_descript.
    CONCATENATE text-010  w_instln  '-' w_descript
     INTO w_titel SEPARATED BY space.
    t_index-devloc = w_titel+0(30).
    t_index-desc = w_titel+30(70).
    APPEND t_index.
    CLEAR t_index.

*     T_INDEX-DEVLOC = SPACE.
*     T_INDEX-DESC = SPACE.
*    APPEND T_INDEX.

    t_index-devloc = 'Dev Loc'.
    t_index-desc = 'Serv Loc'.
    APPEND t_index.
    CLEAR t_index.
    t_index-devloc = '-------'.
    t_index-desc = '---------'.
    APPEND t_index.
    CLEAR t_index.
    LOOP AT lt_iflot INTO wa_iflot.
      swc_create_object lobj_devloc  'DEVLOC' wa_iflot-tplnr.
      swc_get_table_property lobj_devloc 'DEVICES' lt_devices.
*present a dialog listing the device locations available for selection
      swc_get_object_key lobj_devloc lw_devloc.
      swc_get_property lobj_devloc 'Description2' lw_desc.
      swc_get_property lobj_devloc 'LocationText' lw_loc.
*Move to Internal table to pass to FM
      t_index-devloc = lw_devloc.
      t_index-desc = lw_desc.
      t_index-loc = lw_loc.
      APPEND t_index.
    ENDLOOP.

    DESCRIBE TABLE lt_devices LINES lw_lines2.
*    IF lw_lines2 > 0.
    IF lw_lines1 > 0. " AND LW_LINES2 = 0.
      DO.
        CALL FUNCTION 'POPUP_WITH_TABLE_DISPLAY'
          EXPORTING
            endpos_col   = c_endpos_col
            endpos_row   = c_endpos_row
            startpos_col = c_startpos_col
            startpos_row = c_startpos_row
            titletext    = 'Select Device Location'
          IMPORTING
            choise       = w_choise
          TABLES
            valuetab     = t_index
          EXCEPTIONS
            OTHERS       = 2.
        IF sy-subrc = 0 AND w_choise GT 3.
          READ TABLE t_index INDEX w_choise.
*Store Device Location selected by user for further processing.
          lw_devloc = t_index-devloc.
          EXIT.
        ELSE.
          MESSAGE i000(zcse) WITH 'Please choose a Device Location'(l01).
        ENDIF.
      ENDDO.
    ELSE.  "(only one dev loc has 0 meters)
*  Store Device Location for further processing.
      READ TABLE t_index INDEX 1.
      lw_devloc = t_index-devloc.
    ENDIF."(If lW_lines2> 1.)
  ELSE." (only one device location returned)
*Store Device Location for further processing.
    READ TABLE lt_iflot INDEX 1.
    lw_devloc = lt_iflot-tplnr.
  ENDIF."(If LW_check > 1.)

  swc_get_property p_obj_instln 'Premises' lobj_premises.

  swc_get_property lobj_premises 'ConnObj' lobj_connobj.
  swc_get_property lobj_connobj 'RegiogroupBoUp' lw_regiogroup.

  swc_container lt_container.
*  swc_clear_container t_container.
  swc_create_container lt_container.
  swc_set_element lt_container  'OrderCode' c_l_order_code.
  swc_set_element lt_container  'RegioGroup' lw_regiogroup.

*  swc_call_method p_obj_isusmorder 'DeterminePlantWorkcenter'
*                                    lt_container.
  swc_create_object lw_objref_isusmorder 'ISUSMORDER' l_aufnr.
  swc_call_method lw_objref_isusmorder 'DeterminePlantWorkcenter'
                          lt_container.
  swc_get_element lt_container 'WORKCENTER' lw_workcenter.

  swc_get_object_key lobj_devloc lw_fun_key.
  swc_get_property self 'BUSINESSPARTNER' lw_partner.
*  DATA: L_DEVLOC TYPE EGPLD-DEVLOC.
*  DATA: L_T_DEVLOC TYPE SWC_OBJECT OCCURS 0 WITH HEADER LINE.
*  SWC_GET_TABLE_PROPERTY LOBJ_CONNOBJ 'Devlocs' L_T_DEVLOC.
*  READ TABLE L_T_DEVLOC INDEX 1.
*  SWC_GET_OBJECT_KEY L_T_DEVLOC L_DEVLOC.
  swc_clear_container t_container.
*  SWC_SET_ELEMENT T_CONTAINER 'BASICSTARTDATE' SY-DATUM.
  swc_set_element t_container 'BASICSTARTDATE' lw_movein_date.
  swc_set_element t_container 'TechnicalOBJECT' lw_devloc.
*  swc_set_element t_container 'TechnicalOBJECT' lw_fun_key.
  swc_set_element t_container 'TechnicalObjectType' '01'.
  swc_set_element t_container 'Partner' lw_partner.
  swc_set_element  t_container  'PlanningPlant' '1001'.
  swc_set_element t_container 'OrderCode' 'ZIMT'.
  swc_set_element t_container  'PlantforWorkCenter' '1001'.
  swc_set_element t_container 'WORKCENTER' lw_workcenter.
  swc_call_method lw_objref_isusmorder 'CreateByOrderCode' t_container.
* If the method execution success
  IF sy-subrc EQ 0.
* obtaining the object key of the service order.
    swc_get_object_key lw_objref_isusmorder  lw_ordernum2.
*instantiating the service order object with the order number.
    swc_create_object p_isusmorder 'ISUSMORDER' lw_ordernum2.
*appending it to the multiline service order object.
    APPEND p_isusmorder TO t_isusmorder.
  ELSE.
*Could not Create with order code.
    MESSAGE s018(zcse).
    EXIT.
  ENDIF.

ENDFORM.                    " Create_Install_Meter_Order

