FORM z_send_message  USING p_error TYPE c
                           p_log_handle TYPE any
                           p_moveindoc  TYPE any.
*----------------------------------------------------------------------*
*            C O N S T A N T S                                         *
*----------------------------------------------------------------------*
  CONSTANTS : c_notif_rule TYPE rhobjects-object VALUE 'AC93000032',
              c_msg1(100)  TYPE c VALUE 'Some error has occured during creation of ',
              c_msg2(100)  TYPE c VALUE 'Disconnection Document.',
              c_msg3(100)  TYPE c VALUE 'Move in Document.',
              c_msg4(100)  TYPE c VALUE 'Please check the log & for details ',
              c_msg5(100)  TYPE c VALUE 'on the errors through transaction SLG1 ',
              c_msg6(100)  TYPE c VALUE 'for the object ERROR_PROG',
              c_discon(1)  TYPE c VALUE '1',
              c_movout(1)  TYPE c VALUE '2',
              c_subj1(100) TYPE c VALUE 'MoveIn & - Error while',
              c_subj2(100) TYPE c VALUE 'Disconnection',
              c_subj3(100) TYPE c VALUE 'Move out creation',
              c_amp(1)     TYPE c VALUE '&'.
*----------------------------------------------------------------------*
*            L O C A L   D E C L A R A T I O N S                       *
*----------------------------------------------------------------------*
  DATA: l_v_act_object      TYPE rhobjects-object,
        l_wa_doc_chng       TYPE sodocchgi1,
        l_i_actor_container TYPE STANDARD TABLE OF swcont,
        l_wa_msg            TYPE bal_s_msg,
        l_i_objtxt          TYPE STANDARD TABLE OF solisti1,
        l_wa_objtxt         TYPE solisti1,
        l_v_tab_lines       TYPE sy-tabix,
        l_i_objpack         TYPE STANDARD TABLE OF sopcklsti1,
        l_wa_objpack        TYPE sopcklsti1,
        l_wa_receiver       TYPE somlreci1,
        l_i_receiver        TYPE STANDARD TABLE OF somlreci1,
        i_actor_tab         TYPE STANDARD TABLE OF swhactor,
        wa_actor_tab        TYPE swhactor.

* Assign the rule value.
  l_v_act_object = c_notif_rule.
* Get the users responsible using the rule
  CALL FUNCTION 'RH_GET_ACTORS'
    EXPORTING
      act_object                = l_v_act_object
      search_date               = sy-datum
    TABLES
*     actor_container           = p_i_actor_container
      actor_tab                 = i_actor_tab
    EXCEPTIONS
      no_active_plvar           = 1
      no_actor_found            = 2
      exception_of_role_raised  = 3
      no_valid_agent_determined = 4
      no_container              = 5
      OTHERS                    = 6.
  IF sy-subrc EQ 0.

* Concatenate the error message
    IF p_error = c_discon.
      CONCATENATE c_msg1 c_msg2
      INTO l_wa_objtxt-line SEPARATED BY space.
      APPEND l_wa_objtxt TO l_i_objtxt.
    ELSE.
      CONCATENATE c_msg1 c_msg3
      INTO l_wa_objtxt-line SEPARATED BY space.
      APPEND l_wa_objtxt TO l_i_objtxt.
    ENDIF.
    CLEAR l_wa_objtxt.
    CONCATENATE c_msg4 c_msg5 c_msg6
    INTO l_wa_objtxt-line SEPARATED BY space.
    REPLACE c_amp IN l_wa_objtxt-line
    WITH p_log_handle.
* Move the error message to the internal table.
    APPEND l_wa_objtxt TO l_i_objtxt.
    DESCRIBE TABLE l_i_objtxt LINES l_v_tab_lines.

    l_wa_doc_chng-doc_size = ( l_v_tab_lines - 1 ) * 255 +
                                              strlen( l_wa_objtxt ).
    l_wa_doc_chng-obj_name = 'Move In Document'.
    IF p_error = c_discon.
      CONCATENATE c_subj1 c_subj2
      INTO l_wa_doc_chng-obj_descr SEPARATED BY space.
    ELSE.
      CONCATENATE c_subj1 c_subj3
      INTO l_wa_doc_chng-obj_descr SEPARATED BY space.
    ENDIF.
    REPLACE c_amp IN l_wa_doc_chng-obj_descr
    WITH p_moveindoc.
* Creating the entry for the compressed document
    CLEAR l_wa_objpack-transf_bin.
* Header details of the mail
    l_wa_objpack-head_start = 1.
    l_wa_objpack-head_num   = 0.
    l_wa_objpack-body_start = 1.
    l_wa_objpack-body_num   = l_v_tab_lines.
    l_wa_objpack-doc_type   = 'RAW'.

    APPEND l_wa_objpack TO l_i_objpack.

    LOOP AT i_actor_tab INTO wa_actor_tab.
      MOVE wa_actor_tab-objid TO l_wa_receiver-receiver.
      APPEND l_wa_receiver TO l_i_receiver.
      CLEAR: wa_actor_tab,
             l_wa_receiver.
    ENDLOOP.

* FM to send mails to the user ids.
    CALL FUNCTION 'SO_DOCUMENT_SEND_API1'
      EXPORTING
        document_data              = l_wa_doc_chng
        put_in_outbox              = 'X'
        commit_work                = 'X'
      TABLES
        packing_list               = l_i_objpack
        contents_txt               = l_i_objtxt
        receivers                  = l_i_receiver
      EXCEPTIONS
        too_many_receivers         = 1
        document_not_sent          = 2
        document_type_not_exist    = 3
        operation_no_authorization = 4
        parameter_error            = 5
        x_error                    = 6
        enqueue_error              = 7
        OTHERS                     = 8.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE 'E' NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.
  ENDIF.

ENDFORM.                                                " z_send_message

