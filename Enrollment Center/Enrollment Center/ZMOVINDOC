        swc_get_property lt_actions  'Category'  l_category.
        CHECK l_category = '01'.
        w_reconorder = lw_order_num.
        swc_create_object l_isusmorder 'ISUSMORDER' w_reconorder.
*    w_rec_flag = c_xflag.
      ENDIF.
    ENDLOOP.
