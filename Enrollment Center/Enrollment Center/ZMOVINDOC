FORM create_install_meter_order USING  p_obj_instln   TYPE swc_object
                                     p_obj_isusmorder TYPE swc_object
                                     p_obj_movoutdoc  TYPE swc_object
                                    lw_movein_date TYPE eeinsup-einzdat.
  TYPES: BEGIN OF ty_iflot,
           tplnr TYPE iflot-tplnr,
         END OF ty_iflot.
* Local data declaration
