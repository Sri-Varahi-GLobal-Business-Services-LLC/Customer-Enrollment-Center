*----|START-OF-CHANGE|MMRobson|07/22/2011|CRM 7 defect 1365|----*
DATA: lv_message TYPE bapiret2-message,
      lv_subrc   TYPE sy-subrc.
*----|END-OF-CHANGE|MMRobson|07/22/2011|CRM 7 defect 1365|----*

* Get the installations from the container.
swc_get_table container 'Installation' l_i_anlage.
swc_get_element container 'MoveInDocument' l_v_moveindoc.

* Get the active contracts for the installation.
SELECT vertrag
INTO TABLE l_i_vertrag
FROM ever
FOR ALL ENTRIES IN l_i_anlage
WHERE anlage = l_i_anlage-table_line
AND   einzdat LE sy-datum
AND   auszdat GE sy-datum.
IF sy-subrc EQ 0.
  LOOP AT l_i_vertrag INTO l_wa_vertrag.
    l_wa_tvertrag-vertrag = l_wa_vertrag.
    l_wa_tvertrag-auszdat = sy-datum.
    APPEND l_wa_tvertrag TO l_i_tvertrag.
    CLEAR : l_wa_vertrag, l_wa_tvertrag.
  ENDLOOP.
  CALL FUNCTION 'ISU_S_MOVE_OUT_CREATE'
    EXPORTING
      x_upd_online   = 'X'
      x_no_dialog    = 'X'
    TABLES
      tx_vertrag     = l_i_tvertrag
    EXCEPTIONS
      existing       = 1
      foreign_lock   = 2
      number_error   = 3
      general_fault  = 4
      invalid_key    = 5
      param_error    = 6
      input_error    = 7
      not_authorized = 8
      action_failed  = 9
      billed         = 10
      OTHERS         = 11.

  IF sy-subrc <> 0.
*----|START-OF-CHANGE|MMRobson|07/22/2011|CRM 7 defect 1365|----*
** Give the message as Move out creation failed.
**Move the corresponding Exception to the log
*    CASE sy-subrc.
*      WHEN 1.
*        l_s_msg-msgty = c_error.
*        l_s_msg-msgid = c_mclass1.
