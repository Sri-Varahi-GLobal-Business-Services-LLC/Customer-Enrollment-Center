*      P_RECON_CONTAINER  data in the container is passed
*----------------------------------------------------------------------*
FORM create_reconnection_order  USING lobjref_discon TYPE swc_object
                                      p_lw_movein_date.

* Local data declaration
  DATA: lw_movein_date TYPE eeinsup-einzdat.
  DATA: lw_discon_doc_no TYPE ediscdoc-discno.
  DATA: lw_ordernum TYPE ediscact-ordernum.
* Declaring a container
  swc_container l_container.
* Initializing the conatiner
  swc_create_container l_container.
  lw_movein_date = p_lw_movein_date.
*  l_container  =   p_recon_container.
  swc_set_element l_container 'OrderCode' 'ZREC'.
  swc_set_element l_container 'PlanPlantForOrd' '1001'.
  swc_set_element l_container 'DisconActivityDate' lw_movein_date.
  swc_set_element l_container 'ObjectType' 'MOVEINDOC'.
  swc_set_element l_container 'ObjectKey' object-key-number.
  swc_set_element l_container 'SetCommitWork' 'X'.
  swc_set_element l_container 'SetCommitWorkAndWait' 'X'.
*  swc_create_object lobjref_discon 'DISCONNECT' lw_discon_doc_no.
  swc_call_method lobjref_discon 'DarkCreateOfRcorder' l_container.
  IF sy-subrc EQ 0.
* Obtaining the order number returned by the method
    swc_get_element l_container 'Order' lw_ordernum.
* Instantiating the service order object with the order number.
    swc_create_object p_isusmorder 'ISUSMORDER' lw_ordernum.
*Appending it to the multiline service order object.
    APPEND p_isusmorder TO t_isusmorder.
  ELSE.
*Could not create disconnection order.
    MESSAGE s014(zcse).
  ENDIF.
ENDFORM.                    " Create_Reconnection_Order

*---------------------------------------------------------------------*
*      Form  Identify_Service_Order
*---------------------------------------------------------------------*
*       This subroutine identifies the service order
*----------------------------------------------------------------------*
*       p2 changing order number
*----------------------------------------------------------------------*
FORM identify_service_order USING p_wa_discdoc TYPE swc_object
                                  CHANGING p_wa_ordernum.
* Local data declaration
  DATA:   lt_actions TYPE STANDARD TABLE OF swc_object WITH HEADER LINE.
*  Service Order
  DATA: l_order       TYPE aufk-aufnr,
*  Order Catergory
        l_category    TYPE ediscact-discacttyp,
*  Order Start Date
        l_startdate   TYPE viaufks-gstrp,
* Work area for Service Order
        wa_isusmorder TYPE swc_object.
*  Get all the actions on this disconnection document
  swc_get_property p_wa_discdoc 'DisconnectionActions' lt_actions[].
*  Now for each Action check the order catergory
  LOOP AT lt_actions.
*  Get the Order Number
    swc_get_property lt_actions 'Order' p_wa_ordernum.
    IF sy-subrc = 0.
*  Get theOrder Catergory
      swc_get_property lt_actions  'Category'  l_category.
      CHECK l_category = '1'.
*  Instantiate the Order Object using the Order Number
      swc_create_object wa_isusmorder 'ISUSMORDER' p_wa_ordernum.

    ENDIF.
  ENDLOOP.
ENDFORM.                    " Identify_Service_Order
*---------------------------------------------------------------------*
*      Form  Cancel_Service_Order
*---------------------------------------------------------------------*
*      This subroutine identifies cancel srvice order
*----------------------------------------------------------------------*
FORM cancel_service_order USING p_w_aufnr.
* Declaring a container
  swc_container l_container1.
  swc_clear_container l_container1.

* Initializing the container
  swc_create_container l_container1.
  swc_set_element l_container1 'Status' 'E0001'.
  swc_create_object isusmorder_ref 'ISUSMORDER' p_w_aufnr.
  swc_call_method isusmorder_ref 'UserstatusSet1' l_container1.
* If the method execution failed
  IF sy-subrc NE 0.
*Could not Set User Status for Order.
    MESSAGE s015(zcse).
    EXIT.
  ENDIF.

  swc_set_element l_container1 'ReferenceDate' sy-datum.
  swc_set_element l_container1 'ReferenceTime' sy-uzeit.
  swc_call_method isusmorder_ref 'SetStatusTechnCompleted' l_container1.
* If the method execution failed
  IF sy-subrc NE 0.
*Method SetStatusTechCompleted of Object ISUSMORDER failed.
    MESSAGE s016(zcse).
    EXIT.
  ENDIF.
ENDFORM.                    " Cancel_Service_Order

