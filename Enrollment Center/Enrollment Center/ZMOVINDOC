begin_method zcheckmovein changing container.
**********************************************************************
* Name              : ZCHECKMOVEIN
* Author            : HAVENKIT  - Hariharan Venkitaraman
* Date              : 05/04/2007
* FRICE ID          : FO_WFL_160
*----------------------------------------------------------------------
* Type of Program   : Workflow
* Purpose           : This work flow is used to disconnect installations
*                     in the premise which are vacant
* Development Class : ZCC_WFL
*----------------------------------------------------------------------
* Tables Updated    : EDISCDOC
* External Files    : N/A
* Input Parameters  : N/A
* Output Parameters : N/A
*----------------------------------------------------------------------
* Modification History
*
* 1) Request #       :
*    Developer       : Hariharan Venkitaraman
*    Date            : 05/04/2007
*    Description     : Initial development.
*----------------------------------------------------------------------*
*----------------------------------------------------------------------*
*               C O N S T A N T S                                      *
*----------------------------------------------------------------------*
CONSTANTS : c_name_last  TYPE but000-name_first VALUE 'CURRENT',
            c_name_first TYPE but000-name_last VALUE 'CURRENT OCCUPANT',
            c_discstat1  TYPE es31gen-eanldiscst VALUE '21',
            c_discstat2  TYPE es31gen-eanldiscst VALUE '20',
            c_fail       TYPE c VALUE 'X'.
*----------------------------------------------------------------------*
*               T Y P E  D E C L A R A T I O N S                       *
*----------------------------------------------------------------------*
TYPES : BEGIN OF t_name,
          name_last  TYPE but000-name_last,    "Last name
          name_first TYPE but000-name_first,   "First name
        END OF t_name.
*----------------------------------------------------------------------*
*               L O C A L   D E C L A R A T I O N S                    *
*----------------------------------------------------------------------*
* Internal table declarations
* Group of instances of the installations.
DATA : l_i_instln  TYPE STANDARD TABLE OF swc_object,
       l_wa_instln TYPE swc_object.
* List of all active installations
DATA : l_i_anlage  TYPE STANDARD TABLE OF ever-anlage,
       l_wa_anlage TYPE ever-anlage.
* Name
DATA : l_wa_name       TYPE t_name.
* Data Variables
DATA: l_v_stop       TYPE eprop-acbact,               "Stop the workflow
      l_v_moveindoc  TYPE swc_object,                 "MOVEINDOC BO
      l_v_isupartner TYPE swc_object,                 "BP BO
      l_v_objkey     TYPE sweinstcou-objkey,          "Object Key
      l_v_discstat   TYPE es31gen-eanldiscst,         "Discon status
      l_v_discdoc    TYPE ediscdoc-discno,            "Discon doc
      l_v_gpart      TYPE fkkvkp-gpart.               "Business Partner

* Get the BO instance of the MOVEINDOC from the container
swc_get_element container 'MoveInDoc' l_v_moveindoc.

* Get the attribute BP of the MOVEINDOC
swc_get_property l_v_moveindoc 'BusinessPartner' l_v_isupartner.
* Get the Object Key
swc_get_object_key l_v_isupartner l_v_objkey.
* Get the BP value from the object key
l_v_gpart = l_v_objkey+0(10).
* Get all the installations in the MOVEINDOCUMENT.
swc_get_table_property l_v_moveindoc 'Instlns' l_i_instln.
* Check if the BP has the first name as 'Current' and Last name as
* 'Occupant'.
SELECT SINGLE name_last                               "Last name
              name_first                              "First name
FROM but000
INTO l_wa_name
WHERE partner = l_v_gpart.
IF sy-subrc EQ 0.
*  TRANSLATE l_wa_name-name_last TO UPPER CASE.
  TRANSLATE l_wa_name-name_first TO UPPER CASE.
*  IF  l_wa_name-name_last  = c_name_last.
  IF l_wa_name-name_first = c_name_first.
* Check if there any installations in the movein doc which are not in
* Disconnected state.
    LOOP AT l_i_instln INTO l_wa_instln.
      swc_get_property l_wa_instln 'ZDiscDoc' l_v_discdoc.
      SELECT SINGLE status
      FROM ediscdoc
      INTO l_v_discstat
      WHERE discno = l_v_discdoc.
      IF l_v_discstat NE c_discstat1
      AND l_v_discstat NE c_discstat2
      AND l_v_discstat IS INITIAL.
        CLEAR l_v_objkey.
        swc_get_object_key l_wa_instln l_v_objkey.
        l_wa_anlage = l_v_objkey+0(10).
        APPEND l_wa_anlage TO l_i_anlage.
      ENDIF.                                       "Endif l_v_discstat
      CLEAR : l_v_discstat,l_wa_instln,l_wa_anlage,l_v_discdoc.
    ENDLOOP.                                       "Endloop l_i_instln

    IF l_i_anlage IS INITIAL.
      l_v_stop = c_fail.
    ENDIF.                                           "Endif l_i_anlage
  ELSE.
* This is not a dummy move in. Hence, Stop the workflow
    l_v_stop = c_fail.
  ENDIF.                                             "Endif name_last
ENDIF.                                             "Endif sy-subrc
* Set the output parameters back to the container
swc_set_table container  'Installation' l_i_anlage.
swc_set_element container 'Stop' l_v_stop.
end_method.

