*&---------------------------------------------------------------------*
*       Present Same Day Alert
*----------------------------------------------------------------------*
*      -->P_AUFNR  Order Number
*      -->P_W_MOVEOUTDATE  Move out date
*----------------------------------------------------------------------*
FORM zpresent_same_day_alert  USING   p_aufnr
                                     p_ilart
                                     p_w_moveoutdate.
  DATA: l_workctr TYPE aufk-vaplz,
        l_acttext TYPE t353i_t-ilatx.
  DATA: lw_text1(200),
        lw_text2(30),
        lw_text3(30),
        lw_answer,
* Work area for Service Order
        wa_isusmorder   TYPE swc_object.

*Get the Main work center for maintenance tasks
  SELECT SINGLE vaplz INTO l_workctr FROM aufk
                           WHERE  aufnr EQ p_aufnr.
*Get the acitvity text
  SELECT SINGLE ilatx INTO l_acttext FROM t353i_t
                           WHERE ilart EQ p_ilart.
  IF sy-subrc = 0.

    CONCATENATE 'ORDER' p_aufnr l_acttext 'FOR AREA'(005) l_workctr
      'WILL BE CANCELLED'(006) INTO lw_text1 SEPARATED BY space.
    lw_text2 = 'This Order is scheduled to be worked today.'(007).
    lw_text3 = 'Please contact crews to advise.'(008).
    CALL FUNCTION 'POPUP_WITH_2_BUTTONS_TO_CHOOSE'
      EXPORTING
*       DEFAULTOPTION = '1'
        diagnosetext1 = ' '
*       DIAGNOSETEXT2 = ' '
*       DIAGNOSETEXT3 = ' '
        textline1     = lw_text1
        textline2     = lw_text2
        textline3     = lw_text3
        text_option1  = 'DISPLAY'
        text_option2  = 'CONTINUE'
        titel         = 'SAME DAY WORK ALERT'(009)
      IMPORTING
        answer        = lw_answer.

    IF lw_answer = '1'.
      swc_set_element t_container 'Number' p_aufnr.
*  Instantiate the Order Object using the Order Number

      swc_create_object wa_isusmorder 'ISUSMORDER' p_aufnr. "Satya
*      swc_call_method  wa_isusmorder 'DISPLAY' t_container.
      swc_call_method  wa_isusmorder 'Display' t_container.

    ENDIF.

  ENDIF.

ENDFORM.                    " Present_same_day_alert
