*&---------------------------------------------------------------------*
*&      Form  find_service_order
*&---------------------------------------------------------------------*
*       Find the Service Order
*----------------------------------------------------------------------*
*      -->P_WA_INSTLN     Installation Object
*      -->P_W_MOVEOUTDATE Previous Move Out Date
*      -->P_ACTIVITY      Activity
*      <->T_ORDERS        Order Table
*----------------------------------------------------------------------*
FORM find_service_orders  USING p_wa_instln TYPE swc_object
                                p_w_moveoutdate
                                p_activity.
*types definition for equipments
  TYPES: BEGIN OF lty_equip,
           equnr TYPE equi-equnr,
         END OF lty_equip,
*Types definition for Read Only Orders
         BEGIN OF lty_orders,
           aufnr TYPE aufk-aufnr,  " Order Number
           gstrp TYPE afko-gstrp,  " Basic Start Date
           ilart TYPE afih-ilart,  " Maint. Actvity type
         END OF lty_orders.


  DATA: lt_equipment TYPE TABLE OF lty_equip WITH HEADER LINE,
        l_equipment  TYPE lty_equip.
  DATA: lt_device TYPE TABLE OF swc_object WITH HEADER LINE,
        t_orders  TYPE STANDARD TABLE OF lty_orders.

  swc_get_table_property p_wa_instln 'zCurrentDevices' lt_device.

  LOOP AT lt_device.

    swc_get_object_key lt_device l_equipment.
    APPEND l_equipment TO lt_equipment.
    CLEAR l_equipment.
  ENDLOOP.

  IF NOT lt_equipment[] IS INITIAL.
    REFRESH t_orders.
*Select Order Number, Start Date, Maint. Activity Type
    SELECT aufnr gstrp ilart FROM viaufks
                       INTO TABLE t_orders      " Order Table
                       FOR ALL ENTRIES IN lt_equipment
                        WHERE gstrp = p_w_moveoutdate
                        AND   ilart = p_activity
                        AND   equnr = lt_equipment-equnr.
    IF sy-subrc = 0.
      IF p_activity = 'REA'.
* Set the Read Only Order in the container
        swc_set_table t_container  'T_RO_ORDERS' t_orders.
      ELSE.
* Set the Orange Seal Orders in the container
        swc_set_table t_container  'T_OR_ORDERS' t_orders.
      ENDIF.
* Clear the orders if sy-subrc fails
    ELSE.
      swc_set_table t_container  'T_RO_ORDERS' t_orders.
      swc_set_table t_container  'T_OR_ORDERS' t_orders.
    ENDIF.
  ELSE.
    swc_set_table t_container  'T_RO_ORDERS' t_orders.
    swc_set_table t_container  'T_OR_ORDERS' t_orders.
  ENDIF.
ENDFORM.                    " find_service_order
