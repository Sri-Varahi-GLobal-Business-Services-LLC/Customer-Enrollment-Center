*&      Form  z_create_read_order_EDIT_MI
*&---------------------------------------------------------------------*
*                Create Read Order
*----------------------------------------------------------------------*
*      -->P_WA_OBJ_INSTLN  Instllation Object
*      -->P_T_OBJ_CRNTDEVICES  Current Devices
*----------------------------------------------------------------------*
FORM z_create_read_order_edit_mi USING
                               wa_obj_instln     TYPE swc_object
                               t_obj_crntdevices TYPE tt_swcobject
                               w_obj_modoc       TYPE swc_object
                               w_mo_date         TYPE eausv-auszdat.
  DATA:
    l_plantwrkcenter TYPE t399a-vawrk,   "plant work center
    l_workcenter     TYPE caufvd-vaplz, "work center
    l_ordernum       TYPE aufk-aufnr, "Service order number,
    l_regiogroup     TYPE ehauisu-regiogroup, "Regio group
    l_planningplant  TYPE teregplant-iwerk, "Planning plant
    l_device_key     TYPE equi-equnr, "Device Object Key
    l_object         TYPE swc_object, "Object
    l_srnr           TYPE t399a-bzgsernr,
    l_matnr          TYPE v_eger-matnr,
    l_partner        TYPE swc_object,
    l_isusmorder     TYPE swc_object.
  swc_get_property wa_obj_instln 'PREMISES' l_object.
* obtaining the handle of object connobj
  swc_get_property l_object 'CONNOBJ' l_object.
* Obtaining the value of regiogroup
  swc_get_property l_object 'RegiogroupBoUp' l_regiogroup.

  CLEAR: l_object, t_container.
  REFRESH: t_container.
  swc_create_object l_isusmorder 'ISUSMORDER' l_ordernum.
*Setting the values to the export parameters.
  swc_set_element t_container 'OrderCode'  c_zmio.
  swc_set_element t_container 'RegioGroup'  l_regiogroup.

*Calling the method DETERMINEPLANTWORKCENTER of object ISUSMORDER
  swc_call_method l_isusmorder 'DeterminePlantWorkcenter'
                            t_container.
  IF sy-subrc NE 0.
* display message:Failed to determine maintenance planning plant and
*                 work centre
    MESSAGE s010(zcse).
    EXIT.
  ENDIF.
* Obtain the value of the parameters returned by method
  swc_get_element t_container 'PlantForWorkCenter' l_plantwrkcenter.
  swc_get_element t_container 'workcenter '  l_workcenter.
  swc_get_element t_container 'PlanningPlant'  l_planningplant.
* get business partner from moveoutdoc
  swc_get_property w_obj_modoc 'BusinessPartner'  l_partner.
  CLEAR l_object.
* looping at current devices
  LOOP AT t_obj_crntdevices INTO l_object.
    REFRESH: t_container.
*Obtain the value of the attribute serial Number from CurrentDevices
    swc_get_property l_object 'SerialNumber' l_srnr.
*Obtain the value of the attribute MaterialNumber from CurrentDevices
    swc_get_property l_object 'MaterialNumber' l_matnr.

* Obtain the device object key.
    swc_get_object_key l_object l_device_key.
*--------------------------
    DATA: l_partner_key TYPE but000-partner.
    swc_get_object_key l_partner l_partner_key.
*--------------------------
*Setting the export parameters
    swc_set_element t_container 'BasicStartDate'       w_mo_date.
    swc_set_element t_container 'TechnicalObject'      l_matnr.
    swc_set_element t_container 'TechnicalObjectType'  c_03.
    swc_set_element t_container  'Partner'             l_partner.
    swc_set_element t_container 'OrderCode'            c_zmio.
    swc_set_element t_container 'PlantForWorkCenter'   l_plantwrkcenter.
    swc_set_element t_container 'WorkCenter'           l_workcenter.
    swc_set_element t_container 'PlanningPlant'        l_planningplant.
    swc_set_element t_container 'RegioGroup'           l_regiogroup.
    swc_set_element t_container 'SerialNumber'         l_srnr.

*Calling the method CreateByOrderCode with the export parameters.
    swc_call_method l_isusmorder 'CreateByOrderCode' t_container.
* If the method execution failed
*    IF sy-subrc NE 0.
* display message: Could not create with order code
*      MESSAGE s011(zcse).
*      EXIT.
*    ENDIF.
* obtaining the object key of the service order.
    swc_get_object_key l_isusmorder l_ordernum.
    IF l_ordernum IS INITIAL.
      MESSAGE s011(zcse).
    ENDIF.
* creating the service order object with the key obtained.
    swc_create_object l_isusmorder 'ISUSMORDER' l_ordernum .
*Appending it to the multiline service order object.
    APPEND l_isusmorder TO t_isusmorder.
    CLEAR l_isusmorder.
  ENDLOOP.

