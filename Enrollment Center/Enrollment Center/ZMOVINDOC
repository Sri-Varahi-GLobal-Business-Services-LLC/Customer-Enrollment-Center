*&---------------------------------------------------------------------*
*      Get Previous move out date of the doc with highest number
*----------------------------------------------------------------------*
*    <-- P_W_MO_DATE   Move Out date
*    <-- P_W_NUMBER    Document number
*    <-- P_W_MOFORCED  Move Out Forced
*    <-- P_W_OBJ_MODOC Moveout Object
*----------------------------------------------------------------------*
FORM z_get_prevs_mo_date_edit_mi
                        CHANGING p_w_mo_date   TYPE eausv-auszdat
                                 p_w_number    TYPE eaus-auszbeleg
                                 p_w_moforced  TYPE regen-kennzx
                                 p_w_obj_modoc TYPE swc_object.
*local data.
  DATA: l_t_prevmo  TYPE TABLE OF swc_object,
        l_wa_prevmo TYPE swc_object,
        l_obj_modoc TYPE swc_object,
        l_number    TYPE eaus-auszbeleg,
        l_t_number  TYPE TABLE OF eaus-auszbeleg.

* obtain previous move outs.
  swc_get_table_property w_moveindoc 'PreviousMoveOuts' l_t_prevmo.
*  CLEAR P_W_OBJ_MODOC.
  LOOP AT l_t_prevmo INTO p_w_obj_modoc.
    swc_get_object_key p_w_obj_modoc l_number.
    APPEND l_number TO l_t_number.
  ENDLOOP.
*  sort the internal table in descending order
  SORT l_t_number DESCENDING.
  CLEAR: l_number, p_w_obj_modoc.
  READ TABLE l_t_number INTO l_number INDEX 1.
  swc_create_object p_w_obj_modoc 'MOVEOUTDOC' l_number.
* obtain the moveout date
  swc_get_property p_w_obj_modoc 'MoveOutDate' p_w_mo_date.
* obtain forced moveout
  swc_get_property p_w_obj_modoc 'MoveOutForced' p_w_moforced.
* set the move out number
  p_w_number = l_number.

