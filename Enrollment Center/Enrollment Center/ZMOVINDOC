begin_method zcheckvaliddate changing container.
************************************************************************
* Programmer:  Michael Robson
* Date:        12/09/2008
* SC Problem:  PM809779
* Transport:   ECDK954784
* Description: Changed to use the ZPremise.FindOwner business object
*              method to determine if an owner is active. This is done
*              to correct issues the previous code had with seasonal
*              owner activity at the beginning of the year.
************************************************************************
*----|START-OF-CHANGE|MMRobson|PM809779|----*
*TYPES: BEGIN OF l_t_contract,
*         auszdat TYPE ever-auszdat,
*       END OF l_t_contract.
*
*DATA:
*      l_installation  TYPE eanl-anlage,
*      l_allowmovein   TYPE mara-iloos,
*      l_property      TYPE eprop-property,
*      l_activefrom    TYPE eprop-activefrom,
*      l_activeto      TYPE eprop-activeto,
*      l_i_contract    TYPE TABLE OF l_t_contract,
*      l_date_from     TYPE sy-datum,
*      l_date_to       TYPE sy-datum,
*      l_datum         TYPE sy-datum,
*      l_wa_contract   LIKE LINE OF  l_i_contract.
*
*CONSTANTS: l_c_tabix1 TYPE sy-tabix VALUE 1,
*           l_c_yes    TYPE c VALUE 'Y',
*           l_c_no     TYPE c VALUE 'N'.
*
** Get The following data from WorkFlow:
** Property
** Installation
*l_allowmovein = l_c_no.
*swc_get_element container 'Property'           l_property.
*swc_get_element container 'Installation'       l_installation.
*
** Get 'Validity From'  & 'Valid To' period
*SELECT  activefrom
*        activeto
*                  FROM eprop
*                  UP TO 1 ROWS
*                  INTO (l_activefrom,l_activeto)
*                  WHERE property = l_property.
*ENDSELECT.
** Move current date to l_datum. This is needed because from EPROP table
** we will just get the Month/Date and not the year of validity.
*MOVE sy-datum TO l_datum.
** Move Year to 'Valid From' Date
*MOVE l_datum+0(4) TO l_date_from.
** Move Month to 'Valid From' Date
*MOVE l_activefrom+0(2) TO l_date_from+4(2).
** Move Date to 'Valid From' Date
*MOVE l_activefrom+2(2) TO l_date_from+6(2).
*
**If Month/date of 'Valid From' period is greater than that of 'Valid To'
**then, the year of 'Valid To' would be greater than that of 'Valid From'
** E.g. If Valid From = 11/21 And Valid To = 03/23, Current year = 2007
** Valid from date = 11/21/2007  & Valid To date = 03/23/2008
*IF l_date_from+4(2) > l_activeto+0(2) OR
*   ( l_date_from+4(2) = l_activeto+0(2) AND
*     l_date_from+6(2) > l_activeto+2(2) ).
** To increment the year by 1 make the date as 12/31/xxxx
*  MOVE '12' TO l_datum+4(2).
*  MOVE '31' TO l_datum+6(2).
*  l_datum = l_datum + 1.
*ENDIF.
*
** Move Year to 'Valid To' Date
*MOVE l_datum+0(4) TO l_date_to.
** Move Month to 'Valid To' Date
*MOVE l_activeto+0(2) TO l_date_to+4(2).
** Move Date to 'Valid To' Date
*MOVE l_activeto+2(2) TO l_date_to+6(2).
*
** Get the 'Move-out date' of the tenant.
*SELECT auszdat
*       FROM ever
*       INTO TABLE l_i_contract
*       WHERE anlage = l_installation.
*IF sy-subrc EQ 0.
** Get the latest move-out date. (This is the date on which the tenant
** moved out)
*  SORT l_i_contract DESCENDING BY auszdat.
*  READ TABLE l_i_contract INTO  l_wa_contract
*                          INDEX l_c_tabix1.
*  IF sy-subrc EQ 0.
** Owner's Move-In date would be 1 day after the tenant's move-out date
*    l_wa_contract-auszdat = l_wa_contract-auszdat + 1.
** Check if owner's move-in date lies in his validity period (ES53)
*    IF l_wa_contract-auszdat GE l_date_from AND
*       l_wa_contract-auszdat LE l_date_to.
*      l_allowmovein = l_c_yes.
*    ELSE.
*      l_allowmovein = l_c_no.
*    ENDIF.
*  ENDIF.
*ENDIF.
** Pass 'AllowMoveIn' value back to workFlow
*swc_set_element container 'AllowMoveIn' l_allowmovein.
CONSTANTS: lc_yes  TYPE c VALUE 'Y',
           lc_no   TYPE c VALUE 'N',
           lc_true TYPE c VALUE 'X'.

DATA: li_moveout_dates TYPE TABLE OF ever-auszdat.
DATA: lo_installation TYPE swc_object, " INSTLN business object
      lo_premise      TYPE swc_object. " PREMISES business object
DATA: l_installation   TYPE eanl-anlage,
      l_movein_date    TYPE d,
      lfl_allow        TYPE flag VALUE lc_no,
      lfl_owner_active TYPE flag.
* START BJAYARAM IM00169341 05/28/2012
TYPES: BEGIN OF ty_contract,
         vertrag TYPE ever-vertrag,
         auszdat TYPE ever-auszdat,
       END OF ty_contract.
DATA : lv_trigger TYPE char01.
DATA : wa_vertrag TYPE vertrag.
DATA : wa_vende   TYPE e_vende.
DATA : wa_contend TYPE e_vende.
DATA : lt_contract TYPE STANDARD TABLE OF ty_contract,
       lw_contract TYPE ty_contract,
       l_rfcdest   TYPE crmrfcpar-rfcdest.          "Logical Destinatio
CONSTANTS : c_crm(3) TYPE c VALUE 'CRM'.
* END BJAYARAM IM00169341  05/28/2012
swc_container lwa_container.

* Note that the property parameter is no longer used.
swc_get_element container 'Installation' l_installation.
IF l_installation IS NOT INITIAL.
  swc_create_object lo_installation 'INSTLN' l_installation.

  IF sy-subrc = 0.
    swc_get_property lo_installation 'PREMISES' lo_premise.

    IF sy-subrc = 0.
*     Get the move-out dates from the installation's related contracts
      SELECT auszdat
        FROM ever
        INTO TABLE li_moveout_dates
        WHERE anlage = l_installation
          AND loevm  = space.         " not deleted

      IF sy-subrc = 0.
*       Get the latest move-out date
        SORT li_moveout_dates DESCENDING.
        READ TABLE li_moveout_dates INTO l_movein_date INDEX 1.

        IF l_movein_date = '99991231'.
*         The current contract has not been moved out
          CLEAR l_movein_date.
        ELSE.
*         The move-in date will be one day after the latest move-out
*         date
          ADD 1 TO l_movein_date.
        ENDIF.
      ELSE.
*       If no contracts can be found, perhaps because of the very first
*       move-in into the installation was reversed before a contract
*       was created, then use the current date
        l_movein_date = sy-datum.
      ENDIF.

      IF l_movein_date IS NOT INITIAL.
*       Determine whether an owner is active on the move-in date
        swc_set_element lwa_container 'KeyDate' l_movein_date.
        swc_call_method lo_premise 'FindOwner' lwa_container.
        IF sy-subrc = 0.
          swc_get_element lwa_container 'OwnerActive' lfl_owner_active.
          IF lfl_owner_active = lc_true.
*           An owner was found and is active on the move-in date
            lfl_allow = lc_yes.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDIF.

* START BJAYARAM IM00169341 06/29/2012

CLEAR   : lw_contract,l_rfcdest.
REFRESH : lt_contract.

SELECT vertrag auszdat INTO TABLE lt_contract
       FROM ever
       WHERE anlage = l_installation.
SORT lt_contract DESCENDING BY auszdat.
SELECT  rfcdest
       FROM crmrfcpar
       INTO l_rfcdest
       WHERE consumer = c_crm.
ENDSELECT.
READ TABLE lt_contract INTO lw_contract INDEX 1.
CALL FUNCTION 'ZCRM_RFC_WFTERM_CURROWNER_ALLO'
  DESTINATION l_rfcdest
  EXPORTING
    i_contract = lw_contract-vertrag
  IMPORTING
    i_trigger  = lv_trigger.
IF lv_trigger EQ 'X'.
  CLEAR : lfl_allow.
ELSE.
  lfl_allow = lc_yes.
ENDIF.

*END BJAYARAM IM00169341 06/29/2012
swc_set_element container 'AllowMoveIn' lfl_allow.
*----|END-OF-CHANGE|MMRobson|PM809779|----*
end_method.

