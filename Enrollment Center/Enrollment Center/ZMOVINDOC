get_property installationsdisconnected changing container.
************************************************************************
* Programmer:  Michael Robson
* Date:        01/20/2009
* SC Problem:  PM814080
* Transport:   ECDK956021
* Description: Returns "X" if all the installations for the move-in
*              document are in either the fully disconnected (10) or
*              partially disconnected (11) status. Returns space
*              otherwise.
************************************************************************
CONSTANTS: c_disc_stat_disconnected TYPE eanldiscst VALUE '10',
           c_disc_stat_partial_disc TYPE eanldiscst VALUE '11'.

DATA: li_installations TYPE TABLE OF swc_object.
DATA: lo_installation TYPE swc_object.
DATA: l_disc_stat  TYPE eanldiscst,
      l_disc_count TYPE i,
      l_inst_count TYPE i.

swc_get_table_property self 'Instlns' li_installations.

LOOP AT li_installations INTO lo_installation.
  ADD 1 TO l_inst_count.
  CLEAR l_disc_stat.
  swc_get_property lo_installation 'DisconnectionStatus' l_disc_stat.
  IF l_disc_stat = c_disc_stat_disconnected OR
     l_disc_stat = c_disc_stat_partial_disc.
    ADD 1 TO l_disc_count.
  ENDIF.
ENDLOOP.

IF l_inst_count > 0 AND l_inst_count = l_disc_count.
  object-installationsdisconnected = 'X'.
ELSE.
  CLEAR object-installationsdisconnected.
ENDIF.

swc_set_element container 'InstallationsDisconnected'
     object-installationsdisconnected.
end_property.

