begin_method checkinstallationmeters changing container.
************************************************************************
* Programmer:  Michael Robson
* Date:        10/31/2008
* SC Problem:  PM788290
* Transport:   ECDK953747
* Description: Loops through the given list of installation objects
*              and determines if they are metered or meterless.
************************************************************************
DATA: li_installations TYPE TABLE OF swc_object,
      li_metered       TYPE TABLE OF eanl-anlage,
      li_meterless     TYPE TABLE OF eanl-anlage.

DATA: lwa_installation LIKE LINE OF li_installations,
      lwa_metered      LIKE LINE OF li_metered,
      lwa_meterless    LIKE LINE OF li_meterless,
      lwa_device       TYPE swc_object.

DATA: l_key_date     TYPE syst-datum,
      l_installation TYPE eanl-anlage.

swc_container li_container.

swc_get_table container 'Installations' li_installations.
swc_get_element container 'KeyDate' l_key_date.

IF li_installations[] IS INITIAL.
  swc_get_table_property self 'Instlns' li_installations.
ENDIF.

CHECK li_installations[] IS NOT INITIAL.

IF l_key_date IS INITIAL.
  l_key_date = sy-datum.
ENDIF.

LOOP AT li_installations INTO lwa_installation.
  CLEAR: li_container[], lwa_device.
* Get the installation number
  swc_get_object_key lwa_installation l_installation.

* Get the current meter for the installation
  swc_set_element li_container 'KeyDate' l_key_date.
  swc_call_method lwa_installation 'GetCurrentMeterForDate'
    li_container.

  swc_get_element li_container 'Device' lwa_device.
  IF lwa_device IS INITIAL.
    APPEND l_installation TO li_meterless.
  ELSE.
    APPEND l_installation TO li_metered.
  ENDIF.
ENDLOOP.

swc_set_table container 'MeteredInstsallations'  li_metered.
swc_set_table container 'MeterlessInstallations' li_meterless.
end_method.

