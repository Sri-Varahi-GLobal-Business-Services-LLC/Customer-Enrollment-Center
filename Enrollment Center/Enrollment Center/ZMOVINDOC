DATA : l_notif TYPE qmel-qmnum.

*----|START-OF-CHANGE|MMRobson|06/22/2009|PM872770|----*
DATA: l_inst_disc_status TYPE es31gen-eanldiscst.
*----|END-OF-CHANGE|MMRobson|06/22/2009|PM872770|----*

*----|START-OF-CHANGE|MMRobson|09/23/2008|PM799037|----*
*swc_container cnt_snotif.
*----|END-OF-CHANGE|MMRobson|09/23/2008|PM799037|----*
*----|END-OF-CHANGE|MMRobson|08/14/2008|PM775946|----*
swc_container cnt_sorder.
swc_container cnt_instln.
CLEAR : o_sorder, cnt_sorder, cnt_sorder[], s_interface.
* 12/12/2007 GCHONG D9412 END
* 12/17/2007 GCHONG D9413 BEGIN
* Variables
DATA it_discorder TYPE swc_object OCCURS 0 WITH HEADER LINE.
CLEAR : it_discorder, it_discorder[].
* 12/17/2007 GCHONG D9413 END
* 01/02/2008 JJarone Start
DATA:  l_startdate              TYPE datum,
       l_enddate                TYPE datum,
       l_priority               TYPE priok,
       lv_curocc_disc_days      TYPE tvarvc-low,  "CR178474 20110308 Added
       lv_curocc_disc_days_n(3) TYPE n.
swc_get_element container 'EndDate' l_enddate.
swc_get_element container 'Priority' l_priority.
* 01/02/2008 JJarone End
* CR178474 20110308 Tweak start and end dates of disconnect doc(s)
* This is to improve through-time so it should be re-configurable.
* 01/22/2008 Jarone Start Defect 11034
*----|START-OF-CHANGE|MMRobson|08/14/2008|PM775946|----*
*l_startdate = sy-datum + 7.
l_startdate = sy-datum + 30.  "Default
*----|END-OF-CHANGE|MMRobson|08/14/2008|PM775946|----*
l_enddate  =  sy-datum + 30.  "Default
* 01/22/2008 Jarone End Defect 11034
* Retrieve the number of days to be added
SELECT SINGLE low
 INTO lv_curocc_disc_days
 FROM tvarvc
WHERE name EQ 'ZFO_CUROCC_DISCONN_DAYS'
 AND type EQ 'P'.  "Parameter
IF sy-subrc EQ 0.
  MOVE lv_curocc_disc_days TO lv_curocc_disc_days_n.
  l_startdate = sy-datum + lv_curocc_disc_days_n.
  l_enddate   = sy-datum + lv_curocc_disc_days_n.
ENDIF.
* CR178474 20110308 End (appears to be a frequent request!)
* Get Installations
* 01/15/2008 GCHONG D9675 BEGIN
* Variables
DATA o_devloc TYPE swc_object.
* 01/15/2008 GCHONG D9675 BEGIN
swc_get_table container 'Installation' i_installations.
swc_get_element container 'MoveInDocument' l_v_moveindoc.
LOOP AT i_installations INTO wa_installations.
*  01/10/2008 JJarone Start
*  Do not create a disconnect for installation with no meter
*----|START-OF-CHANGE|MMRobson|01/19/2009|PM821460|----*
  CLEAR: o_devices[], o_devices.
*----|END-OF-CHANGE|MMRobson|01/19/2009|PM821460|----*
  swc_create_object  o_instln 'INSTLN' wa_installations.
*----|START-OF-CHANGE|MMRobson|06/22/2009|PM872770|----*
* Only disconnect this installation if its current disconnection
* status is not fully (10) or partially (11) disconnected.
  CLEAR l_inst_disc_status.
  swc_get_property o_instln 'DisconnectionStatus' l_inst_disc_status.
  CHECK l_inst_disc_status <> '10' AND l_inst_disc_status <> '11'.
*----|END-OF-CHANGE|MMRobson|06/22/2009|PM872770|----*
  swc_get_table_property o_instln 'zCurrentDevices' o_devices.
  IF o_devices[] IS INITIAL.
    CONTINUE.
  ENDIF.
  v_key = wa_installations.
* Create Disconnection document
  CALL FUNCTION 'ISU_S_DISCDOC_CREATE'
    EXPORTING
      x_discreason   = '02'
      x_refobjtype   = 'INSTLN'
      x_refobjkey    = v_key
      x_upd_online   = 'X'
      x_no_dialog    = 'X'
    IMPORTING
      y_new_ediscdoc = wa_new   "DISCNO
    EXCEPTIONS
      existing       = 1
      foreign_lock   = 2
      not_authorized = 3
      input_error    = 4
      general_fault  = 5
      OTHERS         = 6.
  IF sy-subrc <> 0.
* Give the message as Disconnection document failed.
*Move the corresponding Exception to the log
    CASE sy-subrc.
      WHEN 1.
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '000'.
        l_s_msg-msgv1 = v_key.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
      WHEN 2.
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '003'.
        l_s_msg-msgv1 = v_key.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
      WHEN 3.
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '004'.
        l_s_msg-msgv1 = v_key.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
      WHEN 4.
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '005'.
        l_s_msg-msgv1 = v_key.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
      WHEN 5.
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '006'.
        l_s_msg-msgv1 = v_key.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
      WHEN OTHERS.
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '007'.
        l_s_msg-msgv1 = v_key.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
    ENDCASE.
* Disconnect other installations message
    l_s_msg-msgty = c_error.
    l_s_msg-msgid = c_mclass1.
    l_s_msg-msgno = '017'.
    l_s_msg-msgv1 = l_v_moveindoc.
    APPEND  l_s_msg TO  l_i_msg.
    CLEAR  l_s_msg.
* Move out the customer message
    l_s_msg-msgty = c_error.
    l_s_msg-msgid = c_mclass1.
    l_s_msg-msgno = '018'.
    l_s_msg-msgv1 = l_v_moveindoc.
    APPEND  l_s_msg TO  l_i_msg.
    CLEAR  l_s_msg.
* Create application log
    PERFORM z_create_appl_log USING l_i_msg
                              CHANGING l_lognum.
* Send message to the agents.
    PERFORM z_send_message USING c_discon
                                 l_lognum
                                 l_v_moveindoc.
* Raise the error message to stop the workflow from proceeding.
    exit_return '9001' space space space space.
  ELSE.
    v_discno = wa_new-discno.
*   12/12/2007 GCHONG D9412 BEGIN
*   Need more info from installation
    CLEAR : eanl, v_sparte, s_interface.
    SELECT SINGLE * FROM eanl
                   WHERE anlage EQ wa_installations.
    v_sparte = eanl-sparte.
*    SELECT SINGLE sparte FROM eanl
*                  INTO v_sparte
*                  WHERE anlage = wa_installations.
*    IF sy-subrc = 0.
    IF NOT v_sparte IS INITIAL.
*   12/12/2007 GCHONG D9412 END
      IF v_sparte = '01'.
        v_code = 'ZTFE'.
      ELSE.
        v_code = 'ZTFG'.
      ENDIF.
      wa_auto-contr-use-okcode = 'X'.
      wa_auto-contr-okcode = 'DARKDCOR'.
      wa_auto-interface-darkdcor-x_ordercode = v_code. "'ZTFG'/'ZTFE'.
*     12/12/2007 GCHONG D9412 BEGIN
*     Do not hardcode plant but derive it. Need 2 things; order code
*     and regional structure group.
      swc_create_object o_sorder   'ISUSMORDER' space.
      swc_set_element   cnt_sorder 'OrderCode'  v_code.
*     01/15/2008 GCHONG D9675 BEGIN
*     The plant should be taken from device location
*      CLEAR : evbs, ehauisu.
**     Look for the regional structure group
*      SELECT SINGLE * FROM evbs
*                     WHERE vstelle EQ eanl-vstelle.
*      IF sy-subrc EQ 0.
*        SELECT SINGLE * FROM ehauisu
*                       WHERE haus EQ evbs-haus.
*        swc_set_element   cnt_sorder 'RegioGroup' ehauisu-regiogroup.
*      ENDIF.
*      swc_call_method   o_sorder 'DeterminePlantWorkcenter' cnt_sorder.
*      swc_get_element   cnt_sorder 'PlanningPlant'
*                        wa_auto-interface-darkdcor-x_orderwerk.
*     Find device location and use the plant value from there
      LOOP AT o_devices.
        CLEAR o_devloc.
        swc_get_property o_devices 'DeviceLocation' o_devloc.
        CHECK sy-subrc EQ 0.
        swc_get_property o_devloc 'MainPlant'
                         wa_auto-interface-darkdcor-x_orderwerk.
        CHECK NOT wa_auto-interface-darkdcor-x_orderwerk IS INITIAL.
        EXIT.
      ENDLOOP.
*     01/15/2008 GCHONG D9675 END
*      wa_auto-interface-darkdcor-x_orderwerk = '0101'.
*     12/12/2007 GCHONG D9412 END
      wa_auto-interface-darkdcor-x_actdate = sy-datum.
      wa_auto-interface-darkdcor-y_new_discact = '0001'.
* CREATE disconnection order
      CALL FUNCTION 'ISU_S_DISCDOC_CHANGE'
        EXPORTING
          x_discno           = v_discno
          x_upd_online       = 'X'
          x_no_dialog        = 'X'
          x_auto             = wa_auto
          x_set_commit_work  = 'X'
*       12/12/2007 GCHONG D9412 BEGIN
*       Obtain the order number
        IMPORTING
          y_interface        = s_interface
*       12/12/2007 GCHONG D9412 END
        EXCEPTIONS
          not_found          = 1
          foreign_lock       = 2
          not_authorized     = 3
          input_error        = 4
          general_fault      = 5
          object_inv_discdoc = 6
          OTHERS             = 7.
      IF sy-subrc <> 0.
* Give the message as Disconnection document failed.
*Move the corresponding Exception to the log
        CASE sy-subrc.
          WHEN 1.
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '001'.
            l_s_msg-msgv1 = v_key.
            APPEND  l_s_msg TO  l_i_msg.
            CLEAR  l_s_msg.
          WHEN 2.
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '008'.
            l_s_msg-msgv1 = v_key.
            APPEND  l_s_msg TO  l_i_msg.
            CLEAR  l_s_msg.
          WHEN 3.
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '009'.
            l_s_msg-msgv1 = v_key.
            APPEND  l_s_msg TO  l_i_msg.
            CLEAR  l_s_msg.
          WHEN 4.
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '010'.
            l_s_msg-msgv1 = v_key.
            APPEND  l_s_msg TO  l_i_msg.
            CLEAR  l_s_msg.
          WHEN 5.
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '011'.
            l_s_msg-msgv1 = v_key.
            APPEND  l_s_msg TO  l_i_msg.
            CLEAR  l_s_msg.
          WHEN OTHERS.
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '012'.
            l_s_msg-msgv1 = v_key.
            APPEND  l_s_msg TO  l_i_msg.
            CLEAR  l_s_msg.
        ENDCASE.
* disconnect other installations message
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '017'.
        l_s_msg-msgv1 = l_v_moveindoc.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
* move out the customer message
        l_s_msg-msgty = c_error.
        l_s_msg-msgid = c_mclass1.
        l_s_msg-msgno = '018'.
        l_s_msg-msgv1 = l_v_moveindoc.
        APPEND  l_s_msg TO  l_i_msg.
        CLEAR  l_s_msg.
* Create application log
        PERFORM z_create_appl_log USING l_i_msg
                                  CHANGING l_lognum.
* Send message to the agents.
        PERFORM z_send_message USING c_discon
                                     l_lognum
                                     l_v_moveindoc.
        exit_return '9002' space space space space.
*     12/12/2007 GCHONG D9412 BEGIN
*     Need to update the order with BP, meter info and set to AUTO
      ELSE.

        CLEAR : it_instord, it_instord[], cnt_sorder,
                cnt_sorder[], o_sorder, l_kunum.
        swc_create_object o_sorder 'ISUSMORDER'
                          s_interface-darkdcor-y_new_ordernum.
*       When the discon order is found
        IF sy-subrc EQ 0.
*----|START-OF-CHANGE|MMRobson|09/17/2008|PM799037|----*
*         Update notification long text with the disconnection reason
          CLEAR o_mnotif.
          swc_get_property o_sorder 'Notification' o_mnotif.
          IF sy-subrc = 0.
            CLEAR: l_notif, i_notif_lines[], wa_notif_line.

            swc_get_property o_mnotif 'Number' l_notif.

            CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
              EXPORTING
                input  = l_notif
              IMPORTING
                output = l_notif.

            IF sy-subrc = 0.
              wa_notif_line-objtype    = 'QMEL'.
              wa_notif_line-format_col = '*'.
              wa_notif_line-text_line  = 'Current Occupant Disconnect'.
              APPEND wa_notif_line TO i_notif_lines.

              CALL FUNCTION 'ZFOCS_NOTIF_TEXT_UPDATE'
                DESTINATION 'NONE'
                EXPORTING
                  notif_number = l_notif
                  commit       = 'X'
                  wait         = 'X'
                TABLES
                  long_text    = i_notif_lines.
            ENDIF.
          ENDIF.
*----|END-OF-CHANGE|MMRobson|09/17/2008|PM799037|----*

*         01/02/2008 jjarone D9412 start
*         Add priority and end date to order
          IF l_enddate IS NOT INITIAL AND l_priority IS NOT INITIAL.
*----|START-OF-CHANGE|MMRobson|08/14/2008|PM775946|----*
            swc_call_method o_sorder 'ZGetLongText' cnt_sorder.
            swc_get_table cnt_sorder 'Long_Text' i_lines.
            wa_line-tdformat = '*'.
            wa_line-tdline   = 'Current Occupant Disconnect'.
            APPEND wa_line TO i_lines.

            CLEAR: cnt_sorder, cnt_sorder[].
            swc_set_table cnt_sorder 'LongText' i_lines.
            CLEAR: i_lines[], wa_line.
*----|END-OF-CHANGE|MMRobson|08/14/2008|PM775946|----*
            swc_set_element   cnt_sorder 'FinishDate' l_enddate.
            swc_set_element   cnt_sorder 'StartDate' l_startdate.
            swc_set_element   cnt_sorder 'Priority' l_priority.
            swc_call_method o_sorder 'UpdateHeader' cnt_sorder.
            CLEAR: cnt_sorder, cnt_sorder[].
          ENDIF.
*         01/02/2008 jjarone D9412 End
*         12/17/2007 GCHONG D9413 BEGIN
*         Store the order number for later use in the workflow
          CLEAR it_discorder.
          it_discorder =  o_sorder.
          APPEND it_discorder.
*         12/17/2007 GCHONG D9413 END
          SELECT SINGLE kunde FROM eein
                              INTO l_kunum
                             WHERE einzbeleg EQ l_v_moveindoc.
*         Call method to update the BP on the order
          swc_set_element   cnt_sorder 'Partner'           l_kunum.
          swc_call_method   o_sorder   'UpdateSoldToParty' cnt_sorder.

          CLEAR : cnt_sorder, cnt_sorder[].
          it_instord-aufnr  = s_interface-darkdcor-y_new_ordernum.
          it_instord-anlage = wa_installations.
          APPEND it_instord.
          swc_set_table cnt_sorder 'Anlage_order'       it_instord.
*         Call the method to do it
          swc_call_method o_sorder 'ZAddEquipReference' cnt_sorder.
*         Error handling
          IF sy-subrc NE 0.
*           Move out the customer message
            l_s_msg-msgty = c_error.
            l_s_msg-msgid = c_mclass1.
            l_s_msg-msgno = '020'.
            APPEND l_s_msg TO l_i_msg.
            CLEAR  l_s_msg.
*           Create application log
            PERFORM z_create_appl_log USING    l_i_msg
                                      CHANGING l_lognum.
*           Send message to the agents.
            PERFORM z_send_message USING c_discon
                                         l_lognum
                                         l_v_moveindoc.
          ENDIF.
*----|START-OF-CHANGE|MMRobson|09/17/2008|PM799037|----*
**----|START-OF-CHANGE|MMRobson|08/27/2008|PM775946|----*
**         Update notification long text with the disconnection reason
*          swc_get_property o_sorder 'Notification' o_mnotif.
*          IF sy-subrc = 0.
*            swc_get_property o_mnotif 'Number' l_notif.
*            swc_create_object o_snotif 'ISUSMNOTIF' l_notif.
*
*            IF sy-subrc = 0.
*              wa_notif_line-objtype    = 'QMEL'.
*              wa_notif_line-format_col = '*'.
*              wa_notif_line-text_line  = 'Current Occupant Disconnect'.
*              APPEND wa_notif_line TO i_notif_lines.
*
*              swc_set_table cnt_snotif 'NotFullTxt' i_notif_lines.
*              swc_call_method o_snotif 'AddData' cnt_snotif.
*
*              CLEAR: cnt_snotif[], cnt_snotif.
*              swc_call_method o_snotif 'Save' cnt_snotif.
*            ENDIF.
*          ENDIF.
*          CLEAR: l_notif, i_notif_lines[], wa_notif_line.
**----|END-OF-CHANGE|MMRobson|08/27/2008|PM775946|----*
*----|END-OF-CHANGE|MMRobson|09/17/2008|PM799037|----*
          COMMIT WORK AND WAIT.
        ENDIF.
*       12/12/2007 GCHONG D9412 END
      ENDIF.
    ENDIF.
  ENDIF.
  CLEAR : wa_installations,v_key, v_sparte,wa_new,v_code,v_discno,
          wa_auto.
ENDLOOP.

* 12/17/2007 GCHONG D9413 BEGIN
* Pass the order table out
swc_set_table container 'DiscOrders' it_discorder.
* 12/17/2007 GCHONG D9413 END

end_method.

