begin_method reversemoveininstln changing container.
************************************************************************
* Created by  : Judy Jarone
* Created on  : 05/24/2007
* Description : reverse reconnection order in the event of move in
*               reversal called from WS93000110
************************************************************************
* Programmer:  Michael Robson
* Date:        02/18/2009
* SC Problem:  PM841485
* Transport:   ECDK956709
* Description: The method will now pass the move-in document's partner
*              object to the Instln.ProcessReconnect method call.
************************************************************************
CONSTANTS:  c_rec_started  TYPE ediscdoc-status VALUE '22',
            c_instln_discd TYPE es31gen-eanldiscst VALUE '10',
            c_discacttyp   TYPE ediscact-discacttyp VALUE '03',
            c_ordstate     TYPE ediscact-ordstate VALUE '00',
            c_newordstate  TYPE ediscact-ordstate VALUE '25'.
DATA:
  wa_instln         TYPE swc_object,
  o_instlns         TYPE swc_object OCCURS 0,
  wa_instlns        TYPE swc_object,
  i_container       TYPE TABLE OF swcont,
  lv_instln_status  TYPE es31gen-eanldiscst,
  lv_discdoc_status TYPE ediscdoc-status.
DATA: wa_err_msg TYPE zsfo_bal_msg,
      i_err_msg  TYPE STANDARD TABLE OF zsfo_bal_msg.

*----|START-OF-CHANGE|MMRobson|02/18/2009|PM841485|----*
DATA: lo_partner TYPE swc_object.
*----|END-OF-CHANGE|MMRobson|02/18/2009|PM841485|----*

swc_get_table container 'ErrMsg' i_err_msg.
*----|START-OF-CHANGE|MMRobson|02/18/2009|PM841485|----*
swc_get_property self 'BusinessPartner' lo_partner.
IF lo_partner IS NOT INITIAL.
  swc_set_element i_container 'Partner' lo_partner.
ENDIF.
*----|END-OF-CHANGE|MMRobson|02/18/2009|PM841485|----*
* Put into container the disconnect activity type we are looking for
* and the status currently in and the confirmation status we want to
* change it to.
swc_set_element i_container 'DiscActTyp' c_discacttyp.
swc_set_element i_container 'OrdState' c_ordstate.
swc_set_element i_container 'NewOrdState' c_newordstate.
* Get all installations involved in the move in reversal.
swc_get_table_property self 'Instlns' o_instlns.
LOOP AT o_instlns INTO wa_instlns.
*  For each installation check if it is disconnected and a reconnect has
*   been started.
  swc_get_property wa_instlns 'DisconnectionStatus' lv_instln_status.
  swc_get_property wa_instlns 'DiscDocStatus' lv_discdoc_status.
  CHECK lv_instln_status   = c_instln_discd AND
       lv_discdoc_status  = c_rec_started.
*   Call method on the installation to cancel the reconnect order for
*   the installation.
  swc_call_method wa_instlns 'ProcessReconnect' i_container.
ENDLOOP.
swc_set_table container 'ErrMsg' i_err_msg.
end_method.

begin_method zcheckcombostatus changing container.
**********************************************************************
* Name              : zcheckcombostatus
* Author            : HAVENKIT  - Hariharan Venkitaraman
* Date              : 05/04/2007
* FRICE ID          : FO_WFL_160
*----------------------------------------------------------------------
* Type of Program   : Workflow
* Purpose           : This work flow is used to disconnect installations
*                     in the premise which are vacant
* Development Class : ZCC_WFL
*----------------------------------------------------------------------
* Tables Updated    : EDISCDOC
* External Files    : N/A
* Input Parameters  : N/A
* Output Parameters : N/A
*----------------------------------------------------------------------
* Modification History
*
* 1) Request #       :
*    Developer       : Hariharan Venkitaraman
*    Date            : 05/04/2007
*    Description     : Initial development.
*----------------------------------------------------------------------*
*----------------------------------------------------------------------*
*               L O C A L   D E C L A R A T I O N S                    *
*----------------------------------------------------------------------*
* Internal table declaration
* The values of all the installations.
DATA: l_i_anlage  TYPE STANDARD TABLE OF ever-anlage,
      l_wa_anlage TYPE ever-anlage.
* Data Variables
DATA : l_v_combo      TYPE swcont-type,            "Combo status
       l_v_elec       TYPE swcont-type,            "Electricity installation
       l_v_datestatus TYPE swcont-type,        "Date Status
       l_v_aug31      TYPE sy-datum,             "Date
       l_v_date1      TYPE sy-datum,                          "April 1
       l_v_date2      TYPE sy-datum,                          "July 17
       l_v_date3      TYPE sy-datum,                          "August 18
       l_v_year(4)    TYPE n,                    "Year
       l_v_einzdat    TYPE eeinv-einzdat,        "Move in date
       l_v_count      TYPE i,                      "Number of installations
       l_v_sparte     TYPE eanl-sparte.            "Division
* Get the values from the method container.
swc_get_table container 'Installation' l_i_anlage.
swc_get_element container 'MoveInDate' l_v_einzdat.

* Check if there are more than 1 installations left.
DESCRIBE TABLE l_i_anlage LINES l_v_count.
IF l_v_count GT 1.
  l_v_combo = 'X'.
ENDIF.
LOOP AT l_i_anlage INTO l_wa_anlage.
  SELECT SINGLE sparte
  FROM eanl
  INTO l_v_sparte
  WHERE anlage = l_wa_anlage.
  IF  sy-subrc EQ 0
  AND l_v_sparte = '01'.
    l_v_elec = 'X'.
*If electric installation is found exit the loop.
    EXIT.
  ENDIF.
  CLEAR : l_v_sparte, l_wa_anlage, l_v_elec.
ENDLOOP.
* Check if the date is between Apr 1 and Aug 31.
* Get the year
l_v_year = l_v_einzdat+0(4).
* April 1.
CONCATENATE l_v_year '04' '01'
INTO l_v_date1.
* July 17
CONCATENATE l_v_year '07' '17'
INTO l_v_date2.
* August 18
CONCATENATE l_v_year '08' '18'
INTO l_v_date3.
* Check if date is between April 1 and July 17.
IF  l_v_einzdat GE l_v_date1
AND l_v_einzdat LT l_v_date2.
  l_v_datestatus = '1'.
* Check if date is between July 17 and August 18.
ELSEIF l_v_einzdat GE l_v_date2
AND    l_v_einzdat LE l_v_date3.
  l_v_datestatus = '2'.
ENDIF.
* Get the Aug31 date for that year.
CONCATENATE l_v_year '08' '31'
INTO l_v_aug31.

* Set the values of the container values.
swc_set_element container 'ComboStatus' l_v_combo.
swc_set_element container 'ElecConnection' l_v_elec.
swc_set_element container 'DateStatus' l_v_datestatus.
swc_set_element container 'Aug31Date'  l_v_aug31.
end_method.

