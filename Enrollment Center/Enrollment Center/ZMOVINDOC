*&      Form  z_change_SORD_STDDAT_EDIT_MI
*&---------------------------------------------------------------------*
*   Subroutine to change Service Order Start Date
*----------------------------------------------------------------------*
*   -->WA_ORDERS Service Order to be edited
*----------------------------------------------------------------------*
FORM z_change_sord_stddat_edit_mi USING wa_orders TYPE x_orders
                                        w_date   TYPE sy-datum.
  DATA: l_vaplz    TYPE aufk-vaplz,
        l_ilart    TYPE afih-ilart,
        l_ilatx    TYPE t353i_t-ilatx,
        l_date(10) TYPE c,
        l_time     TYPE sy-uzeit.
  DATA: lw_text1(200),
        lw_text2(60),
        lw_text3(50),
        lw_text4(50),
        lw_text5(50),
        lw_text6(50),
        lw_answer,
        l_isusmorder TYPE swc_object.
  DATA: lw_order TYPE afko-aufnr.
* constants declarations
  CONSTANTS: c_display(7)  TYPE c VALUE 'DISPLAY',
             c_continue(8) TYPE c VALUE 'CONTINUE'.

*  IF sy-datum = w_date.
  IF sy-datum = wa_orders-gstrp .
* select work center from table AUFK for the given order number
    SELECT SINGLE vaplz FROM aufk
            INTO l_vaplz
            WHERE aufnr = wa_orders-aufnr.
    IF sy-subrc NE 0.
* do nothing
    ENDIF.
* select activity type from table AFIH for the given order number
    SELECT SINGLE ilart FROM afih
           INTO l_ilart
           WHERE aufnr = wa_orders-aufnr.
    IF sy-subrc NE 0.
* do nothing
    ENDIF.
* select description of Description of maintenance activity type
* from table T353I_T for the given order number
    SELECT ilatx UP TO 1 ROWS FROM t353i_t
           INTO l_ilatx
           WHERE ilart = l_ilart.
    ENDSELECT.
    IF sy-subrc NE 0.
* do nothing
    ENDIF.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        input  = wa_orders-aufnr
      IMPORTING
        output = lw_order.

    IF w_txt_fl = 'X'.
* concatenate order number, description, activity type in text 1
      CONCATENATE 'Order' lw_order l_ilatx
                  INTO lw_text1 SEPARATED BY space.
      lw_text2 = text-012.
      lw_text3 = text-013.
      WRITE w_date TO l_date.
      CONCATENATE 'FOR AREA'(005) l_vaplz text-011 l_date INTO lw_text4
      SEPARATED BY space.
    ELSE.
* concatenate order number, description, activity type in text 1
      CONCATENATE 'Order' lw_order l_ilatx INTO lw_text1
*                'FOR AREA'(005) l_vaplz
                  SEPARATED BY space.
      lw_text2 = 'This Order is scheduled to be worked today.'(007).
      lw_text3 = 'Please contact crews to advise.'(008).
      CONCATENATE 'FOR AREA'(005) l_vaplz text-006 INTO lw_text4
      SEPARATED BY space.
    ENDIF.

* call FM to display a pop up
    CALL FUNCTION 'POPUP_WITH_2_BUTTONS_TO_CHOOSE'
      EXPORTING
        diagnosetext1 = lw_text1
        diagnosetext2 = lw_text4
        textline1     = lw_text2
        textline2     = lw_text3
*       TEXTLINE3     = LW_TEXT4
        text_option1  = c_display
        text_option2  = c_continue
        titel         = 'SAME DAY WORK ALERT'(009)
      IMPORTING
        answer        = lw_answer.
    IF lw_answer = '1'.
      REFRESH: t_container.
      swc_set_element t_container 'Number' wa_orders-aufnr.
**  Instantiate the Order Object using the Order Number
      swc_create_object l_isusmorder 'ISUSMORDER' wa_orders-aufnr.
      swc_call_method   l_isusmorder 'Display' t_container.
      IF sy-subrc NE 0.
* DISPLAY MESSAGE: Could not display service order
        MESSAGE s046(zcse).
        EXIT.
      ENDIF.
    ENDIF.
  ENDIF.

*else.
  IF w_txt_fl = 'X'.
    REFRESH: t_container.
* when basic start date is not same a current date
*change the service order start date.
    swc_set_element t_container 'StartDate'  w_date.
    swc_set_element t_container 'FinishDate' w_date.
    l_time = sy-uzeit + 60.
    swc_set_element t_container 'StartTime'   l_time.
    l_time = sy-uzeit + 60.
    swc_set_element t_container 'FinishTime'  l_time.
    swc_create_object l_isusmorder 'ISUSMORDER' wa_orders-aufnr.
    swc_call_method  l_isusmorder 'ChangeStartFinishDate' t_container.
    IF sy-subrc NE 0.
* DISPLAY MESSAGE: Could not change service order dates.
      MESSAGE s048(zcse).
      EXIT.
    ENDIF.
  ENDIF.
  CLEAR w_txt_fl.
ENDFORM.                    " z_change_SORD_STDDAT_EDIT_MI
