begin_method processpremi changing container.
**********************************************************************
* Name              : Premise verification screen
* Author            : Judy Jarone
* Date              : 03/04/2007
* FRICE ID          : FO_ENH_670_1
***********************************************************************
* Programmer:  Michael Robson
* Date:        02/04/2009
* SC Problem:  PM807623
* Transport:   ECDK956250
* Description: Added the A_043 to the list of rate categories that
*              identify a multiple dwelling.
*----------------------------------------------------------------------
* Programmer:  Michael Robson
* Date:        03/19/2009
* SC Problem:  PM835215
* Transport:   ECDK957504
* Description: Changed how the multiple dwelling check is performed.
*              Also added a check for TOU rate categories.
*----------------------------------------------------------------------
* Programmer:  Kennedy
* Date:        02/23/2011
* Change:      FACTA CR178467 for IDF check
* Transport    ECDK965671
* Description  Need to add a check to see if wa_pmi_cos-IDF is set.
*              If so, need to set the IDF indicator in the
*              ZTFO_MI_INSTALL table.
*----------------------------------------------------------------------

DATA:
  partner    TYPE fkkvkp-gpart,
  premiseid  TYPE evbs-vstelle,
  moveindate TYPE eeinv-einzdat,
  envconfig  TYPE ecnconf-config,
  samebpind  TYPE kennzx,
  ratecat    TYPE tariftyp. .

DATA: wa_pmi_cos         TYPE zfocs_pmi_cos,
      i_install_option   TYPE zfocs_install_option_t,
      wa_install_option  TYPE zfocs_install_option,
      wa_ztfo_mi_install TYPE ztfo_mi_install,
      lv_vkont           TYPE vkont_kk,
      lv_action          TYPE zmi_action,
      lv_msg             TYPE char200,
      lv_answer          TYPE char1,
      o_vkont            TYPE swc_object,
      BEGIN OF wa_key,
        contractaccount TYPE fkkvkp-vkont,
        partner         TYPE fkkvkp-gpart,
      END OF wa_key.

*----|START-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
DATA: li_rate_cat_cats TYPE TABLE OF ztfo_ratecatcat-rate_cat_cat.
DATA: l_facta_return TYPE z_facta_return_code.
*----|END-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*

swc_get_element container 'Partner' partner.
swc_get_element container 'PremiseID' premiseid.
swc_get_element container 'MoveInDate' moveindate.
swc_get_element container 'EnvConfig' envconfig.
*----|START-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
swc_get_element container 'FACTAReturnCode' l_facta_return.
*----|END-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*

* Begin of change for PM807623 - DPJ

*----|START-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
*SELECT SINGLE tariftyp INTO ratecat
*  FROM v_eanl
* WHERE vstelle = premiseid
*   AND bis = '99991231'
*   AND ( tariftyp = 'A_251'
**----|START-OF-CHANGE|MMRobson|02/04/2009|PM807623|----*
*    OR   tariftyp = 'A_043'
**----|END-OF-CHANGE|MMRobson|02/04/2009|PM807623|----*
*    OR   tariftyp = 'A_753' ).

* Get the rate category categories for all the installations for the
* given premise
SELECT rcc~rate_cat_cat
  FROM v_eanl AS inst
  JOIN ztfo_ratecatcat AS rcc ON
    rcc~tariftyp = inst~tariftyp
  INTO TABLE li_rate_cat_cats
  WHERE inst~vstelle = premiseid
    AND inst~bis     = '99991231'.
*----|END-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
IF sy-subrc = '0'.
*----|START-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
* CONCATENATE 'Multi Family Dwelling!  - Automated Rate Category update'
*              ' is not allowed.  If update is required, use Change'
*              ' Installation front office Process.  Proceed with '
*              ' Move-in?' INTO lv_msg.
*    CALL FUNCTION 'POPUP_TO_CONFIRM'
*      EXPORTING
*        text_question         = lv_msg
*        display_cancel_button = ' '
*      IMPORTING
*        answer                = lv_answer
*      EXCEPTIONS
*        text_not_found        = 1
*        OTHERS                = 2.
*    IF sy-subrc <> 0.
*      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
*              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
*    ENDIF.
*    IF lv_answer <> '1'.
*      lv_action = 'CNC'.
*      swc_set_element container 'UserAction' lv_action.
*      EXIT.
*    ENDIF.

  READ TABLE li_rate_cat_cats TRANSPORTING NO FIELDS
    WITH KEY table_line = 'MULTDWELL'.

  IF sy-subrc = 0.
    CONCATENATE 'Multi Family Dwelling!  -'
                ' Automated Rate Category update'
                ' is not allowed.  If update is required, use Change'
                ' Installation front office Process.  Proceed with'
                ' Move-in?' INTO lv_msg.

    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        text_question         = lv_msg
        display_cancel_button = ' '
      IMPORTING
        answer                = lv_answer
      EXCEPTIONS
        text_not_found        = 1
        OTHERS                = 2.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.
    IF lv_answer <> '1'.
      lv_action = 'CNC'.
      swc_set_element container 'UserAction' lv_action.
      EXIT.
    ENDIF.
  ELSE.
    READ TABLE li_rate_cat_cats TRANSPORTING NO FIELDS
      WITH KEY table_line = 'TOD'.

    IF sy-subrc = 0.
      CONCATENATE 'This is a Time of Day account -'
                  ' Transfer to Time of Day contact' INTO lv_msg.

      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          text_question         = lv_msg
          text_button_1         = 'Continue'
          text_button_2         = 'Cancel'
          display_cancel_button = ' '
        IMPORTING
          answer                = lv_answer
        EXCEPTIONS
          text_not_found        = 1
          OTHERS                = 2.

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.
      IF lv_answer <> '1'.
        lv_action = 'CNC'.
        swc_set_element container 'UserAction' lv_action.
        EXIT.
      ENDIF.
    ENDIF.
  ENDIF.
*----|END-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
ENDIF.
*  End of change for PM807623 - DPJ.



CALL FUNCTION 'Z_MI_VERIFY_PREMISE'
  EXPORTING
    i_partner          = partner
    i_vstelle          = premiseid
    i_einzdat          = moveindate
    i_config           = envconfig
*----|START-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
    i_facta_return     = l_facta_return
*----|END-OF-CHANGE|MMRobson|03/19/2009|PM835215|----*
  IMPORTING
    e_pmi_cos          = wa_pmi_cos
    e_install_option   = i_install_option
    e_contract_account = lv_vkont
    e_mi_action        = lv_action
    e_einzdat          = moveindate
    e_same_bp          = samebpind.

CASE lv_action.
  WHEN 'PMI'.
    LOOP AT i_install_option INTO wa_install_option
      WHERE selecx = 'X'.
      IF wa_install_option-sec_deposit IS INITIAL.
*         DO NOTHING.
      ELSE.
**      Insert into temp storage table for move in screen retrieval
        MOVE:  partner TO wa_ztfo_mi_install-partner,
               wa_install_option-anlage
                TO wa_ztfo_mi_install-anlage,
               wa_install_option-sec_deposit
                TO wa_ztfo_mi_install-sec_deposit.
        "Kennedy 2/23/2011 FACTA start of change
        IF wa_pmi_cos-idf IS NOT INITIAL.   "JBK
          wa_ztfo_mi_install-idf = 'X'.    "JBK
        ENDIF.                              "JBK
        "Kennedy 2/23/2011 FACTA end of change
        MODIFY ztfo_mi_install FROM wa_ztfo_mi_install.
      ENDIF.
    ENDLOOP.
    IF lv_vkont IS NOT INITIAL.
      MOVE: lv_vkont TO wa_key-contractaccount,
            partner  TO wa_key-partner.
    ENDIF.
    swc_create_object o_vkont 'ISUACCOUNT' wa_key.
    swc_set_element container 'UserAction' lv_action.
    swc_set_element container 'ContractAccount' o_vkont.
    swc_set_element container 'PMICos' wa_pmi_cos.
    swc_set_table   container 'InstallOptions' i_install_option.
    swc_set_element container 'MoveInDate' moveindate.
    swc_set_element container 'SameBPInd' samebpind.
ENDCASE.
end_method.

