METHOD process_mdm_synchronize.
  DATA: lv_profile     TYPE e_profile,
        lv_tou_logikzw TYPE t_register.
*        lv_tou_logikzw       TYPE logikzw.

  lv_tou_logikzw = me->get_timeofuse_reg( ).
  my_tou_logikzw = lv_tou_logikzw.

  IF NOT lv_tou_logikzw IS INITIAL.
    lv_profile =  me->get_allocated_profiles( lv_tou_logikzw-logikzw ).
    IF NOT lv_profile IS INITIAL.
      me->synchronize_interval_profile( lv_profile ).
    ENDIF.
  ENDIF.
ENDMETHOD.
