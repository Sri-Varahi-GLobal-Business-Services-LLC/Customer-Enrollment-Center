        v_sparte     = v_error_sparte
      EXCEPTIONS
        order_locked = 1
        OTHERS       = 2.
*----|END-OF-CHANGE|MMRobson|03/25/2009|PM821131|----*
  ENDIF.
*----|END-OF-CHANGE|MMRobson|03/28/2008|QC 13397|----*

*-----This is being done to capture the error messages for each device.
* We will consider only those messages when either v_error_dept or v_error_sparte is populated.
* This is because whenever, a workitem needs to be sent, wither of v_error_dept or v_error_sparte will be populated.
* Also, refer to perform refresh_global_data.
  CONCATENATE v_error_title1
              v_error_title2
              v_error_title3
              v_error_title4
              v_error_title5
              INTO v_error_title
              SEPARATED BY space.

  CONCATENATE v_error_txt1
              v_error_txt2
              v_error_txt3
              v_error_txt4
              v_error_txt5
              INTO v_error_txt
              SEPARATED BY space.

*-----Work Item will be sent only when the flag (e_error) is marked and (either e_dept or e_sparte) has some value
  e_error       = v_error.
  e_error_txt   = v_error_txt.
  e_error_title = v_error_title.
  e_sparte      = v_error_sparte.
  e_dept        = v_error_dept.

  IF v_error_dept   IS NOT INITIAL OR
      v_error_sparte IS NOT INITIAL.
    e_error = c_flag_x.
  ENDIF.

  DATA(lv_short_aufnr) = shift_left( val = v_aufnr sub = '0' ).
  " SWWWIHEAD-WI_TEXT field is 120 characters, but only 100 characters are displayed
  " in the SAP Business Workplace (SBWP) list view, 2 characters for the colon and space.
  DATA(lv_max_title_length) = 100 - strlen( lv_short_aufnr ) - 2.

  IF e_error = abap_true.
    IF e_error_title IS INITIAL.
      e_error_title = e_error_txt.
    ENDIF.

    IF find( val = e_error_title regex = lv_short_aufnr ) < 0.
      IF strlen( e_error_title ) > lv_max_title_length.
        e_error_title = |{ e_error_title(lv_max_title_length) }: { lv_short_aufnr }|.
      ELSE.
        e_error_title = |{ e_error_title }: { lv_short_aufnr }|.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFUNCTION.
