METHOD process_profile_creation.
  DATA: lv_profile     TYPE e_profile,
        lv_tou_logikzw TYPE t_register. "logikzw.
  lv_tou_logikzw = me->get_timeofuse_reg( ).
  my_tou_logikzw = lv_tou_logikzw.
  IF NOT lv_tou_logikzw IS INITIAL.
    lv_profile =  me->get_allocated_profiles( lv_tou_logikzw-logikzw ).
    IF lv_profile IS INITIAL.
      lv_profile = me->get_unallocated_profile( ).
      IF lv_profile IS INITIAL.
        lv_profile = me->check_profile( ).
        IF lv_profile IS INITIAL.
          lv_profile = me->create_edm_profile( lv_tou_logikzw ).
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDMETHOD.
