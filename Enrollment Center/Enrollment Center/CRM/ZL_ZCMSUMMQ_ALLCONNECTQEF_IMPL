      EXPORTING
        iv_attr_name = 'LASTNAME'                             "#EC NOTEXT
      IMPORTING
        ev_result    = lv_lname.

* Get the BP standard address
    lr_bpstdadd = lr_account->get_related_entity( iv_relation_name = 'BuilStandardAddressRel').

