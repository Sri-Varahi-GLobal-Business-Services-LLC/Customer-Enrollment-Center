    CALL METHOD lr_premise->get_property_as_value
      EXPORTING
        iv_attr_name = 'VS_HOUSE_NUM2'                      "#EC NOTEXT
      IMPORTING
        ev_result    = lv_apt.
* End of changes by VGORRELA Defect 2644
* Get the confirmed address.
    lr_address = lr_premise->get_related_entity( iv_relation_name = 'PremiseAddressObjectRel' ). "#EC NOTEXT

    IF lr_address IS BOUND.

* defect 2271 9/23/11 - also get the house no and pass with street
* Get the house number
      CALL METHOD lr_address->get_property_as_value
        EXPORTING
          iv_attr_name = 'HOUSE_NUM1'                       "#EC NOTEXT
        IMPORTING
          ev_result    = lv_houseno.

* Get the street
      CALL METHOD lr_address->get_property_as_value
        EXPORTING
          iv_attr_name = 'STREET'                           "#EC NOTEXT
        IMPORTING
          ev_result    = lv_street.

      CONCATENATE lv_houseno lv_street INTO lv_street SEPARATED BY space.

* end defect 2271

* Get the city
      CALL METHOD lr_address->get_property_as_value
        EXPORTING
          iv_attr_name = 'CITY1'                            "#EC NOTEXT
        IMPORTING
          ev_result    = lv_city.

* Get the region
      CALL METHOD lr_address->get_property_as_value
        EXPORTING
          iv_attr_name = 'REGION'                           "#EC NOTEXT
        IMPORTING
          ev_result    = lv_region.

* Get the zip code
      CALL METHOD lr_address->get_property_as_value
        EXPORTING
          iv_attr_name = 'POST_CODE1'                       "#EC NOTEXT
        IMPORTING
          ev_result    = lv_zipcode.

* Get the street 1
      CALL METHOD lr_address->get_property_as_value
        EXPORTING
          iv_attr_name = 'STR_SUPPL1'                       "#EC NOTEXT
        IMPORTING
          ev_result    = lv_str_suppl1.

    ENDIF.
* Begin of changes by VGORRELA - Defect 2991
* Get contract number
    lr_coco ?= me->comp_controller.
    lr_ebill ?= lr_coco->typed_context->zebillallcnct->collection_wrapper->get_current( ).

    CALL METHOD lr_ebill->if_bol_bo_property_access~get_property_as_value
      EXPORTING
        iv_attr_name = 'CONTR_GUID'
      IMPORTING
        ev_result    = lv_guid.
* End of changes by VGORRELA - Defect 2991

* Start of insert vnagaraj-Defect 2991 - Get all Contract guids.
* Get Order Item entity
    CALL METHOD cl_crm_iu_order_agent=>get_order_item_entity
      EXPORTING
        guid     = lv_guid
      RECEIVING
        instance = lr_itm_entity.

* Get Order Header guid
    CALL METHOD lr_itm_entity->get_property_as_value
      EXPORTING
        iv_attr_name = 'HEADER'
      IMPORTING
        ev_result    = lv_hdr_guid.

* Get Order Header entity
    CALL METHOD cl_crm_iu_order_agent=>get_order_header_entity
      EXPORTING
        guid     = lv_hdr_guid
      RECEIVING
        instance = lr_hdr_entity.

* Get all Contract items
    TRY.
        lr_tmp_ent ?= lr_hdr_entity->get_related_entity( iv_relation_name = 'BTHeaderItemsExt' ).

        CALL METHOD lr_tmp_ent->get_related_entities
          EXPORTING
            iv_relation_name = 'BTOrderItemAll'
          RECEIVING
            rv_result        = lr_contr_col.

        IF lr_contr_col IS BOUND.
          lr_iter = lr_contr_col->get_iterator( ).
          lr_tmp_ent ?= lr_iter->get_first( ).
          WHILE lr_tmp_ent IS BOUND.
            CALL METHOD cl_crm_iu_order_agent=>get_order_item_ent_4_admini
              EXPORTING
                entity   = lr_tmp_ent
              RECEIVING
                instance = lr_tmp_ent.
* Get the divison
            CALL METHOD lr_tmp_ent->get_property_as_value
              EXPORTING
                iv_attr_name = 'DIVISION'
              IMPORTING
                ev_result    = lv_division.
* Get contract start date
            CASE lv_division.
* Get electric contract start date
              WHEN '01'.
                CALL METHOD lr_tmp_ent->get_property_as_value
                  EXPORTING
                    iv_attr_name = 'CONTSTART'
                  IMPORTING
                    ev_result    = lv_ele_start_date.
                EXIT.
* Get gas contract start date
              WHEN '02'.
                CALL METHOD lr_tmp_ent->get_property_as_value
                  EXPORTING
                    iv_attr_name = 'CONTSTART'
                  IMPORTING
                    ev_result    = lv_gas_start_date.
                EXIT.
              WHEN OTHERS.
            ENDCASE.
* Access next entity
            lr_tmp_ent ?= lr_iter->get_next( ).
          ENDWHILE.
        ENDIF.
      CATCH cx_crm_genil_model_error .
    ENDTRY.
* End of insert vnagaraj-Defect 2991 - Get all Contract guids.

    CALL FUNCTION 'Z_TRANSFER_ALLCONNECT_WRAPPER' DESTINATION ls_r3dest-rfcdest
      EXPORTING
        i_name_first      = lv_fname
        i_namemiddle      = lv_mname
        i_name_lst2       = lv_lname
        i_street          = lv_street
* Begin of changes by VGORRELA Defect 2644
*       i_str_suppl1      = lv_str_suppl1
        i_str_suppl1      = lv_apt
* End of changes by VGORRELA Defect 2644
        i_city1           = lv_city
        i_region          = lv_region
        i_post_code1      = lv_zipcode
        i_zzbest_cont_no  = lv_phone
        i_zzspecialist_id = sy-uname
        i_zzdata_value    = lv_buagid
        i_einzbeleg       = lv_vertrag
* Begin of by changes VGORRELA - Defect 2991
        i_start_date      = lv_ele_start_date
        i_gas_start_date  = lv_gas_start_date
* End of changes by VGORRELA - Defect 2991
      IMPORTING
        e_connect_flag    = lv_flag.

  ENDIF.
  IF lr_valuenode IS BOUND.
    CLEAR lv_no.
    CALL METHOD lr_valuenode->set_property_as_string
      EXPORTING
        iv_attr_name = 'NOFLAG'                     "ECC NOTEXT
        iv_value     = lv_no.

    CLEAR lv_yes.
    CALL METHOD lr_valuenode->set_property_as_string
      EXPORTING
        iv_attr_name = 'YESFLAG'                     "ECC NOTEXT
        iv_value     = lv_yes.
  ENDIF.
  IF lr_skip IS BOUND.
    CALL METHOD lr_skip->set_property_as_string
      EXPORTING
        iv_attr_name = 'SKIPREASON'                     "ECC NOTEXT
        iv_value     = lv_yes.                    "Just clearing the reason in value node
  ENDIF.
  CLEAR : gc_noflag, gc_spanish.

* Navigate to the identification view
  op_toidentification( ).

ENDMETHOD.


