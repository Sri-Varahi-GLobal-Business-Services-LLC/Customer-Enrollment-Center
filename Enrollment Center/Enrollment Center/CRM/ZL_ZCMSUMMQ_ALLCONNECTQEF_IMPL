* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZL_ZCMSUMMQ_ALLCONNECTQEF_IMPL->CHK_CUST_PRG_ELIG
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RE_CUST_PRG_OFFERED            TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD chk_cust_prg_elig.
    CONSTANTS: lc_event                   TYPE string VALUE 'CUST_POPUP_CLOSE'.
    DATA: lr_bdc       TYPE REF TO if_crm_ui_data_context,
          lr_comp      TYPE REF TO zl_zdpp_enr_bspwdcomponen_impl,
          lr_current   TYPE REF TO if_bol_bo_property_access,
          lr_customer  TYPE REF TO cl_crm_bol_entity,
          lr_contract  TYPE REF TO if_bol_bo_property_access,
          lr_device    TYPE REF TO if_bol_bo_property_access,
          ls_contract  TYPE crm_isu_il_md_contract,
          ls_device    TYPE crm_isu_device_attr,
          lr_buag      TYPE REF TO cl_crm_bol_entity,
          ls_buag      TYPE crmt_buag_ic_attr,
          lr_iterator  TYPE REF TO if_bol_bo_col_iterator,
          lr_coll      TYPE REF TO if_bol_bo_col,
          lv_dest      TYPE rfcdest,
          lv_available TYPE boolean.

    DATA: lr_msg_srv TYPE REF TO cl_bsp_wd_message_service.

    lr_msg_srv = cl_bsp_wd_message_service=>get_instance( ).

    TRY.
*       Get GDC
        lr_bdc  = cl_crm_ui_data_context_srv=>get_instance( ).
        CHECK lr_bdc IS BOUND.

*       Get Confirmed Customer
        lr_current = lr_bdc->get_entity( 'CURRENTCUSTOMER' ).

*       Check for bound
        IF lr_current IS BOUND.
          lr_customer ?= lr_current.
        ELSE.
          re_cust_prg_offered = abap_false.
          lr_msg_srv->add_message(
              iv_msg_type       = if_genil_message_container=>mt_error
              iv_msg_id         = 'ZPGM_ENROLL'
              iv_msg_number     = 001 ).
          EXIT.
        ENDIF.

*       Get Confirmed Business Agreement
        lr_current = lr_bdc->get_entity( 'CURRENTBUAG' ).

*       Check for bound
        IF lr_current IS NOT BOUND.
          re_cust_prg_offered = abap_false.
          lr_msg_srv->add_message(
              iv_msg_type       = if_genil_message_container=>mt_error
              iv_msg_id         = 'ZPGM_ENROLL'
              iv_msg_number     = 002 ).
          EXIT.
        ELSE.
          lr_buag ?= lr_current.
          IF lr_buag IS BOUND.
            lr_buag->reread(
                iv_invalidate_children = abap_true ).
          ENDIF.
          lr_current->get_properties(
            IMPORTING
              es_attributes = ls_buag
          ).
        ENDIF.

*       Check for Bound
        CHECK lr_customer IS BOUND OR
              lr_buag IS BOUND.

        lr_coll = lr_buag->get_related_entities(
               iv_relation_name = 'BuAgIsuContractRel' ).

        IF lr_coll IS NOT BOUND OR lr_coll->size( ) = 0.
          re_cust_prg_offered = abap_false.
*          lr_msg_srv->add_message(
*              iv_msg_type       = if_genil_message_container=>mt_error
*              iv_msg_id         = 'ZPGM_ENROLL'
*              iv_msg_number     = 003 ).
*          EXIT.
*        ENDIF.
          get_devloc_from_premise( ).
        ELSE.
*       Get iterator
          lr_iterator ?= lr_coll->get_iterator( ).

          CHECK lr_iterator IS BOUND.
          lr_current ?= lr_iterator->get_first( ).

          WHILE lr_current IS BOUND.

*         Get Properties and check for valid electric contract
            lr_current->get_properties(
              IMPORTING
                es_attributes = ls_contract ).

*         Get Device location
            get_devloc(
              EXPORTING
                ir_current = lr_current " Access Interface for BO Attributes
                iv_sparte  = ls_contract-sparte    " Division
            ).

            lr_current ?= lr_iterator->get_next( ).
          ENDWHILE.
        ENDIF.
      CATCH cx_root.
    ENDTRY.

*   Get the RFC destination
    cl_crm_isu_il_tools=>get_backend_dest(
    EXPORTING
      iv_check_avlbl  = abap_true
    IMPORTING
      ev_backend_dest = lv_dest
      ev_available    = lv_available
    EXCEPTIONS
      no_backend_dest = 1
      OTHERS          = 2 ).

    IF lv_dest IS NOT INITIAL  and
     ( gv_enrlsdp_el IS NOT INITIAL OR
       gv_enrlsdp_gs IS NOT INITIAL ).
.
*     Check over the air meter
      CALL FUNCTION 'ZPGM_OVERTHEAIR_CHK'
        DESTINATION lv_dest
        EXPORTING
          iv_devloc_el  = gv_enrlsdp_el
          iv_devloc_gs  = gv_enrlsdp_gs
        IMPORTING
          ev_overtheair = re_cust_prg_offered.
    ENDIF.

    IF re_cust_prg_offered = abap_true.
      CALL METHOD comp_controller->window_manager->create_popup_2_confirm
        EXPORTING
          iv_title          = 'Enrollment Center Prompt'
          iv_text           = 'Customer is eligible for Customer Programs. Access Enrollment Center for details.'
          iv_btncombination = if_bsp_wd_window_manager=>co_btncomb_ok
        RECEIVING
          rv_result         = gr_conf_popup.

*     Set on close event for popup
      CALL METHOD gr_conf_popup->set_on_close_event
        EXPORTING
          iv_view       = me
          iv_event_name = lc_event.

*     Open popup
      gr_conf_popup->open( ).

    ENDIF.

  ENDMETHOD.


