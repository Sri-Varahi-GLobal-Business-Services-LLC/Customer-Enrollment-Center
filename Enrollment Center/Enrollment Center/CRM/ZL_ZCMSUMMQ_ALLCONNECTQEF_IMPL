      IMPORTING
        ev_result    = lv_fname.

    CALL METHOD lr_account->get_property_as_value              " First Name
      EXPORTING
        iv_attr_name = 'MIDDLENAME'                           "#EC NOTEXT
      IMPORTING
        ev_result    = lv_mname.

