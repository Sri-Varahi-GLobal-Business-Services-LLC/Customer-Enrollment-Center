* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZL_ZCMSUMMQ_ALLCONNECTQEF_IMPL->OFFER_CSDD
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RE_CSDD_OFFERED                TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD offer_csdd.
******************************************************************
*  Method Name               : OFFER_CSDD
*  Author                    : Eric Dietzel
*  Date                      : 3/12/2015
*  SAP Transport Request #   : C7DK900279
*----------------------------------------------------------------*
*  Description: Check to see if the user is eligible for the Customer
*               Selects Due Date (CSDD) program. This method is
*               also called from view AllConnectQEF. If you change it
*               here it will also have to be changed there.
*----------------------------------------------------------------*
* MODIFICATION HISTORY
*
*  SAP Transport Request #   :
*  Author                    : Firstname Lastname
*  Modification Date         : MM/DD/YYYY
*  Description               :
******************************************************************


  CONSTANTS: lc_remote_meter_reading    TYPE crm_isu_e_ami_capabilities VALUE '0003',
             lc_on_demand_meter_reading TYPE crm_isu_e_ami_capabilities VALUE '0005',
             lc_event                   TYPE string VALUE 'CONFIRM_POPUP_CLOSED',
             lc_contract_end            TYPE string VALUE '99991231',
             lc_collective_account      TYPE string VALUE '02'.

  DATA: lr_premise          TYPE REF TO cl_crm_bol_entity,
        lr_device           TYPE REF TO cl_crm_bol_entity,
        lr_cap              TYPE REF TO cl_crm_bol_entity,
        lr_isupremise       TYPE REF TO cl_crm_bol_entity,
        lr_install          TYPE REF TO cl_crm_bol_entity,
        lr_pod              TYPE REF TO cl_crm_bol_entity,
        lr_opt              TYPE REF TO cl_crm_bol_entity,
        lr_item             TYPE REF TO cl_crm_bol_entity,
        lr_install_col      TYPE REF TO if_bol_bo_col,
        lr_device_col       TYPE REF TO if_bol_bo_col,
        lr_cap_col          TYPE REF TO if_bol_bo_col,
        lr_pod_col          TYPE REF TO if_bol_bo_col,
        lr_coco             TYPE REF TO zl_zcmsummq_bspwdcomponen_impl,
        lr_ebill            TYPE REF TO if_bol_bo_property_access,
        lr_buag             TYPE REF TO if_bol_bo_property_access,
        lv_rate_cat         TYPE crm_isu_tariftyp_anl,
        lv_product_guid     TYPE crmt_ordered_prod_db,
        lv_product          TYPE crmd_orderadm_i-ordered_prod,
        lv_title            TYPE string,
        lv_text             TYPE string,
        lv_guid             TYPE crmd_isuexta4-guid,
        lv_capability       TYPE crm_isu_e_ami_capabilities,
        lv_buag_class       TYPE string,
        lv_ok_popup_flg     TYPE boolean,
        lv_yes_no_popup_flg TYPE boolean,
        lv_opt_out          TYPE boolean.

  DATA: lr_query        TYPE REF TO cl_crm_bol_query_service,
        lr_results      TYPE REF TO if_bol_entity_col,
        lr_contract     TYPE REF TO cl_crm_bol_entity,
        lr_ent_buag     TYPE REF TO cl_crm_bol_entity,
        lr_contract_col TYPE REF TO if_bol_bo_col.

* Opt Out - Don't offer the CSDD popup if any of the accounts are Opt Out
  lr_query = cl_crm_bol_query_service=>get_instance( 'BuAgQuery' ).

  lr_query->set_property(
    iv_attr_name = 'BUAG_ID'
    iv_value     = typed_context->datatrvn->collection_wrapper->get_current( )->get_property_as_string( 'BUAG' ) ).

  lr_results = lr_query->get_query_result( ).

  CHECK lr_results IS BOUND AND lr_results->size( ) > 0.

  lr_ent_buag = lr_results->get_first( ).

  TRY.
      lr_contract_col = lr_ent_buag->get_related_entities( EXPORTING iv_relation_name = 'BuAgIsuContractRel' ).
    CATCH cx_root.
  ENDTRY.

  IF lr_contract_col IS BOUND.

    TRY.

        lr_contract ?= lr_contract_col->get_first( ).

        WHILE lr_contract IS BOUND.

          z_smartenergy_tools=>is_contract_opt_out( EXPORTING iv_contract = lr_contract IMPORTING ev_opt_out = lv_opt_out ).

          IF lv_opt_out = abap_true.

            re_csdd_offered = abap_false.

            EXIT.

          ENDIF.

          lr_contract ?= lr_contract_col->get_next( ).

        ENDWHILE.

      CATCH cx_root.

    ENDTRY.

  ENDIF.

  IF lv_opt_out = abap_false.

* Check to see if we have a Collective Account
    lr_buag = zcl_sge_util=>get_current_buag( ).

    CHECK lr_buag IS BOUND.

    lv_buag_class = lr_buag->get_property_as_string( 'BUAG_CLASS' ).

* If a Collective Account, they are not eligible for CSDD
    IF lv_buag_class <> lc_collective_account.

      lr_premise ?= zcl_sge_util=>get_current_premise( ).

      CHECK lr_premise IS BOUND.

*Get Isu Premise
      lr_isupremise ?= lr_premise->get_related_entity( iv_relation_name = 'PremiseIsuPremiseRel' ).

      CHECK lr_isupremise IS BOUND.

*Get Installation Collection
      lr_install_col ?= lr_isupremise->get_related_entities( iv_relation_name = 'IsuPremiseInstallationRel' ).

*Get the first Installation
      lr_install ?= lr_install_col->get_first( ).

      WHILE lr_install IS BOUND.

        re_csdd_offered = abap_false.

*Get Device Collection
        lr_device_col ?= lr_install->get_related_entities( iv_relation_name = 'IsuInstallationDeviceRel').

*Get the first Device
        lr_device ?= lr_device_col->get_first( ).

        WHILE lr_device IS BOUND.

*Get Capabilities Collection
          lr_cap_col ?= lr_device->get_related_entities( iv_relation_name = 'IsuDeviceDeviceCapabilitiesRel' ).

*Get the first Capability
          lr_cap ?= lr_cap_col->get_first( ).

          WHILE lr_cap IS BOUND.

            lv_capability = lr_cap->get_property_as_string( 'CAPABILITIES' ).

*Check to see if we have an AMI/Smart Meter
            IF lv_capability = lc_remote_meter_reading OR lv_capability = lc_on_demand_meter_reading.

              IF lr_cap->get_property_as_string( iv_attr_name = 'AMS_RELEVANT' ) = abap_true AND
                 lr_cap->get_property_as_string( iv_attr_name = 'AMCG_RELEVANT' ) = abap_true.

*Get POD Collection
                lr_pod_col ?= lr_install->get_related_entities( iv_relation_name = 'IsuInstallationPODRel' ).

*Get the first POD
                lr_pod ?= lr_pod_col->get_first( ).

                WHILE lr_pod IS BOUND.

                  lv_product_guid = lr_pod->get_property_as_string( EXPORTING iv_attr_name = 'PD_INT_UI' ).

*Select the current guid
                  SELECT guid
                    FROM crmd_isuexta4
                    INTO lv_guid
                   WHERE a4podguid   = lv_product_guid
*                 AND a4contstart <= sy-datum
                     AND a4contend   = lc_contract_end
                     AND a4cancelled <> 'X'.
                  ENDSELECT.

                  IF sy-subrc = 0.

*Select the current Product
                    SELECT ordered_prod
                      FROM crmd_orderadm_i
                      INTO lv_product
                     WHERE guid = lv_guid.
                    ENDSELECT.

                    IF sy-subrc = 0.

*Verify the Product that was selected is a valid one for the CSDD program
                      SELECT tariftyp
                        FROM zbi_csdd_rcat
                        INTO lv_rate_cat
                       WHERE tariftyp = lv_product.
                      ENDSELECT.

                      IF lv_rate_cat IS NOT INITIAL.

                        lr_coco ?= me->comp_controller.

                        lr_ebill = lr_coco->typed_context->zebillallcnct->collection_wrapper->get_current( ).

                        lv_title = text-001.

                        CONCATENATE text-002 text-003 INTO lv_text SEPARATED BY space.

* Check to see what popup we want to show at the end of this method
                        IF lr_ebill->get_property_as_string( 'ALLCNCT_FLAG' ) = abap_true.

                          lv_ok_popup_flg = abap_true.

                          re_csdd_offered = abap_true.

                        ELSE.

                          lv_yes_no_popup_flg = abap_true.

                          re_csdd_offered = abap_true.

                        ENDIF.
                      ENDIF.
                    ENDIF.
                  ENDIF.

                  lr_pod ?= lr_pod_col->get_next( ).

                ENDWHILE.

              ENDIF.

            ENDIF.

            lr_cap ?= lr_cap_col->get_next( ).

          ENDWHILE.

          lr_device ?= lr_device_col->get_next( ).

        ENDWHILE.

* If a combo account, both the electric and gas need to pass the CSDD validation
        IF re_csdd_offered = abap_false.

          RETURN.

        ENDIF.

        lr_install ?= lr_install_col->get_next( ).

      ENDWHILE.

      IF lv_ok_popup_flg = abap_true.

        CALL METHOD comp_controller->window_manager->create_popup_2_confirm
          EXPORTING
            iv_title          = lv_title
            iv_text           = lv_text
            iv_btncombination = if_bsp_wd_window_manager=>co_btncomb_ok
          RECEIVING
            rv_result         = gr_conf_popup.

      ELSEIF lv_yes_no_popup_flg = abap_true.

        CALL METHOD comp_controller->window_manager->create_popup_2_confirm
          EXPORTING
            iv_title          = lv_title
            iv_text           = lv_text
            iv_btncombination = if_bsp_wd_window_manager=>co_btncomb_yesno
          RECEIVING
            rv_result         = gr_conf_popup.

      ENDIF.

*Set on close event for popup
      CALL METHOD gr_conf_popup->set_on_close_event
        EXPORTING
          iv_view       = me
          iv_event_name = lc_event.

*Open popup
      gr_conf_popup->open( ).

    ENDIF.

    re_csdd_offered = abap_false.

  ENDIF.

ENDMETHOD.


