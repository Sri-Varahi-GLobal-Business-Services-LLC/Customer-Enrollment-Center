    IF lr_buag IS BOUND.
* Display the contract number.
      lr_contracts ?= cl_crm_iu_order_agent=>get_items_by_ref_entity( source = lr_buag
                                                                      only_valid_contracts = lc_x ).
* Begin of changes by VGORRELA Defect 2991
*      CHECK lr_contracts IS BOUND.            ">>INS defect 1728
*      lr_iter = lr_contracts->get_iterator( ).
*      CHECK lr_iter IS BOUND.                 ">>INS defect 1728
*      lr_ent ?= lr_iter->get_first( ).
*      CHECK lr_ent IS BOUND.                  ">>INS defect 1728
*      lv_guid_str = lr_ent->get_property_as_string( 'GUID' ).
      IF lr_contracts IS BOUND.
        lr_iter = lr_contracts->get_iterator( ).
        IF lr_iter IS BOUND.
          lr_ent ?= lr_iter->get_first( ).
          IF lr_ent IS BOUND.
            lv_guid_str = lr_ent->get_property_as_string( 'GUID' ).
          ENDIF.
        ENDIF.
      ENDIF.
* End of changes by VGORRELA Defect 2991
      MOVE lv_guid_str TO lv_guid.
    ENDIF.
* Start of insert vnagaraj-Defect 2991
    IF lv_guid IS INITIAL.
      CLEAR lv_guid.
      CALL METHOD lr_ebill->if_bol_bo_property_access~get_property_as_value
        EXPORTING
          iv_attr_name = 'CONTR_GUID'
        IMPORTING
          ev_result    = lv_guid.
    ENDIF.
    IF NOT lv_guid IS INITIAL.
* End of insert vnagaraj-Defect 2991
      CLEAR lv_contr.
      SELECT SINGLE a4isucontr FROM crmd_isuexta4 INTO lv_contr WHERE guid EQ lv_guid.
      IF sy-subrc EQ 0.
* Display the contract number
        CALL METHOD lr_datatr->set_property
          EXPORTING
            iv_value     = lv_contr
            iv_attr_name = 'BP_CONTRACT'.
      ELSE.
* defect 2644 by jchakrav: try to contract number from entity itself
        CLEAR lv_contr.
        lv_contr = lr_ent->get_property_as_string( 'ISUCONTRACT_ID' ).
        IF NOT lv_contr IS INITIAL.
          CALL METHOD lr_datatr->set_property
            EXPORTING
              iv_value     = lv_contr
              iv_attr_name = 'BP_CONTRACT'.
        ENDIF.
      ENDIF.

    ENDIF.
  ENDIF.  "VGORRELA

* Begin of change by - Raghavendra Dasari - 11/24/2015 - Smart Energy R5
* The CSDD eligibility check has been removed from this process as part of the development
* PJT03030.R5.SAP.FS.DPP.ENH012.CSDD.Updates.For.Enrollment.Center.v.01
* as it is now embedded in to the Program Enrollment Center component ZPGMENROLL_CNTR to handle all CSDD enrollments and de-enrollments

