* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZL_ZCMSUMMQ_ALLCONNECTQEF_IMPL->GET_DEVLOC
* +-------------------------------------------------------------------------------------------------+
* | [--->] IR_CURRENT                     TYPE REF TO IF_BOL_BO_PROPERTY_ACCESS
* | [--->] IV_SPARTE                      TYPE        CRM_ISU_SPARTE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_devloc.
    DATA: lr_coll   TYPE REF TO if_bol_bo_col,
          lr_device TYPE REF TO if_bol_bo_property_access,
          lr_inst   TYPE REF TO if_bol_bo_property_access,
          ls_device TYPE crm_isu_device_attr,
          lr_entity TYPE REF TO cl_crm_bol_entity.

*   get collection of dependent nodes
    lr_entity ?= ir_current.
    CHECK lr_entity IS BOUND.
    TRY.
        lr_coll = lr_entity->get_related_entities(
               iv_relation_name = 'IsuContractInstallationRel' ).

      CATCH cx_crm_genil_model_error.
*       should never happen
        EXIT.
      CATCH cx_sy_ref_is_initial.
    ENDTRY.

    CHECK lr_coll IS BOUND.
    lr_inst ?= lr_coll->get_current( ).
    CHECK lr_inst IS BOUND.

*   get collection of dependent nodes
    lr_entity ?= lr_inst.
    CHECK lr_entity IS BOUND.
    TRY.
        lr_coll = lr_entity->get_related_entities(
               iv_relation_name = 'IsuInstallationDeviceRel' ).

        CHECK lr_coll IS BOUND.
        lr_device ?= lr_coll->get_current( ).
        CHECK lr_device IS BOUND.
        lr_device->get_properties(
          IMPORTING
            es_attributes = ls_device
        ).
        IF iv_sparte = '01'.
          gv_enrlsdp_el = ls_device-devloc.

        ELSEIF iv_sparte = '02'.
          gv_enrlsdp_gs = ls_device-devloc.

        ENDIF.
      CATCH cx_crm_genil_model_error.
*       should never happen
        EXIT.
      CATCH cx_sy_ref_is_initial.
    ENDTRY.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZL_ZCMSUMMQ_ALLCONNECTQEF_IMPL->GET_DEVLOC_FROM_PREMISE
* +-------------------------------------------------------------------------------------------------+
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method GET_DEVLOC_FROM_PREMISE.
    DATA: lr_bdc      TYPE REF TO if_crm_ui_data_context,
          lr_current  TYPE REF TO if_bol_bo_property_access,
          lr_premise  TYPE REF TO cl_crm_bol_entity,
          lr_pod      TYPE REF TO cl_crm_bol_entity,
          ls_pod      TYPE crm_isu_tec_pd,
          ls_devloc   TYPE crm_isu_devloc_attr,
          lr_iterator TYPE REF TO if_bol_bo_col_iterator,
          lr_iter     TYPE REF TO if_bol_bo_col_iterator,
          lr_coll     TYPE REF TO if_bol_bo_col.

    TRY.
*       Get GDC
        lr_bdc  = cl_crm_ui_data_context_srv=>get_instance( ).
        CHECK lr_bdc IS BOUND.

*       Get Confirmed Customer
        lr_current = lr_bdc->get_entity( 'CURRENTPREMISE' ).

*       Check for bound
        IF lr_current IS BOUND.
          lr_premise ?= lr_current.
        ELSE.
          EXIT.
        ENDIF.

*       Check for Bound
        CHECK lr_premise IS BOUND.

        lr_coll = lr_premise->get_related_entities(
               iv_relation_name = 'PointOfDeliveryRel' ).

        IF lr_coll IS NOT BOUND OR lr_coll->size( ) = 0.
          EXIT.
        ENDIF.

*       Get iterator
        lr_iterator ?= lr_coll->get_iterator( ).

        CHECK lr_iterator IS BOUND.
        lr_current ?= lr_iterator->get_first( ).

        WHILE lr_current IS BOUND.
*         Get Properties of POD
          lr_current->get_properties(
            IMPORTING
              es_attributes = ls_pod ).
          lr_pod ?= lr_current.


*       Check for Bound
          IF lr_pod IS BOUND.

            lr_coll = lr_pod->get_related_entities(
                   iv_relation_name = 'PoDIsuDevLocRel' ).

            IF lr_coll IS NOT BOUND OR lr_coll->size( ) = 0.
            ELSE.

*       Get iterator
              lr_iter ?= lr_coll->get_iterator( ).

              CHECK lr_iter IS BOUND.
              lr_current ?= lr_iter->get_first( ).

              WHILE lr_current IS BOUND.
*         Get Properties of DEVLOC
                lr_current->get_properties(
                  IMPORTING
                    es_attributes = ls_devloc ).
                IF ls_pod-pd_sparte = '01'.
                  gv_enrlsdp_el = ls_devloc-devloc.

                ELSEIF ls_pod-pd_sparte = '02'.
                  gv_enrlsdp_gs = ls_devloc-devloc.

                ENDIF.

                lr_current ?= lr_iter->get_next( ).
              ENDWHILE.
            ENDIF.
          ENDIF.
          lr_current ?= lr_iterator->get_next( ).
        ENDWHILE.

      CATCH cx_root.
    ENDTRY.
  endmethod.


