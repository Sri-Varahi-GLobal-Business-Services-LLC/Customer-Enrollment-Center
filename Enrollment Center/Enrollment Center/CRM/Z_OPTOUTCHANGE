*&---------------------------------------------------------------------*
*&      Form  form200_ALV_DISPLAY
*&---------------------------------------------------------------------*
* Call the ALV_Display with out output data
*----------------------------------------------------------------------*
FORM form200_alv_display .

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      i_callback_program = sy-repid
      it_fieldcat        = i_fieldcat
    TABLES
      t_outtab           = lt_output
    EXCEPTIONS
      program_error      = 1
      OTHERS             = 2.

  IF sy-subrc <> 0.
    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
  ENDIF.
ENDFORM.                    " ALV_DISPLAY










*&---------------------------------------------------------------------*
*&      Form  create_header_line
*&---------------------------------------------------------------------*
* Add headers to output data for Excel attachment for E-Mail
*----------------------------------------------------------------------*
FORM create_header_line.
  CONCATENATE 'Business Partner' gc_tab
              'Premise' gc_tab
              'Functional Location' gc_tab
              'Meter' gc_tab
              'Operand' gc_tab
              'Change Date' gc_tab
              'Change Reason' gc_tab
              'Move Out Date' gc_tab
              'Type' gc_crlf
              lv_string
              INTO lv_string.
ENDFORM.                    "create_header_line










*&---------------------------------------------------------------------*
*&      Form  send_email
*&---------------------------------------------------------------------*
* Create and Send Email
*----------------------------------------------------------------------*
FORM send_email.
  DATA:
    send_request    TYPE REF TO cl_bcs,
    binary_content  TYPE solix_tab,
    size            TYPE so_obj_len,
    lv_from         TYPE char10,
    lv_to           TYPE char10,
    lv_body         TYPE soli,
    main_text       TYPE bcsy_text,
    document        TYPE REF TO cl_document_bcs,
    lv_recip        TYPE adr6-smtp_addr,
    recipient       TYPE REF TO if_recipient_bcs,
    sent_to_all     TYPE os_boolean,
    bcs_exception   TYPE REF TO cx_bcs.

  TRY.
*     -------- create persistent send request ------------------------
      send_request = cl_bcs=>create_persistent( ).

      TRY.
          cl_bcs_convert=>string_to_solix(
            EXPORTING
              iv_string   = lv_string
              iv_codepage = '4103'  "suitable for MS Excel, leave empty
              iv_add_bom  = 'X'     "for other doc types
            IMPORTING
              et_solix  = binary_content
              ev_size   = size ).
        CATCH cx_bcs.
          MESSAGE e445(so).
      ENDTRY.

      WRITE p_frdate TO lv_from MM/DD/YYYY.
      WRITE p_todate TO lv_to MM/DD/YYYY.
      IF p_todate <> p_frdate.
        CONCATENATE 'Opt-Out Flag was changed between' lv_from 'and' lv_to INTO lv_body SEPARATED BY space.
      ELSE.
        CONCATENATE 'Opt-Out Flag was changed on' lv_from INTO lv_body SEPARATED BY space.
      ENDIF.
      APPEND lv_body TO main_text.                          "#EC NOTEXT

      document = cl_document_bcs=>create_document(
        i_type    = 'RAW'
        i_text    = main_text
        i_subject = 'Opt Out Flag Changed - Alert' ).       "#EC NOTEXT

*     add the spread sheet as attachment to document object
      document->add_attachment(
        i_attachment_type    = 'csv'                        "#EC NOTEXT
        i_attachment_subject = 'Opt Out Flag Changes'       "#EC NOTEXT
        i_attachment_size    = size
        i_att_content_hex    = binary_content ).

      send_request->set_document( document ).

      LOOP AT p_recip.

        lv_recip = p_recip-low.

        recipient = cl_cam_address_bcs=>create_internet_address( lv_recip ).

        send_request->add_recipient( recipient ).
      ENDLOOP.

      sent_to_all = send_request->send( i_with_error_screen = 'X' ).

      IF sent_to_all IS NOT INITIAL.

        COMMIT WORK.

        WRITE: 'E-Mail Sent Successfully'.

      ENDIF.

    CATCH cx_bcs INTO bcs_exception.
      MESSAGE i865(so) WITH bcs_exception->error_type.
  ENDTRY.

ENDFORM.                    "send_email

