*&---------------------------------------------------------------------*
*& Report  Z_OPTOUTCHANGE
*&
*&---------------------------------------------------------------------*
*&
*&
*&---------------------------------------------------------------------*

REPORT  z_optoutchange.

*include for SWC
INCLUDE <cntn01>.

*some data declared here for use throughout forms
DATA:
      lt_changes  TYPE TABLE OF zsoptoutchange,
      lv_string   TYPE string,
      lt_output   TYPE TABLE OF zsoptoutchangerep WITH HEADER LINE,
      gc_tab      TYPE c VALUE cl_bcs_convert=>gc_tab,
      gc_crlf     TYPE c VALUE cl_bcs_convert=>gc_crlf,
      i_fieldcat  TYPE slis_t_fieldcat_alv,
      wa_fieldcat TYPE slis_fieldcat_alv.










*********Selection Screen*********
SELECTION-SCREEN BEGIN OF BLOCK 100 WITH FRAME TITLE text-100.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN POSITION 1.
PARAMETER p_frdate TYPE datum.
SELECTION-SCREEN POSITION 20.
PARAMETER p_todate  TYPE datum.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK 100.

SELECTION-SCREEN BEGIN OF BLOCK 200 WITH FRAME TITLE text-200.
PARAMETERS: p_email AS CHECKBOX DEFAULT ' '.
SELECT-OPTIONS: p_recip FOR (email) DEFAULT ' '.
SELECTION-SCREEN END OF BLOCK 200.

SELECTION-SCREEN BEGIN OF BLOCK 300 WITH FRAME TITLE text-300.
PARAMETERS: p_bp     TYPE efindd-c_bupart DEFAULT ' ',
            p_funloc TYPE efindd-l_devloc DEFAULT ' '.
SELECTION-SCREEN END OF BLOCK 300.










*********At Selection Screen*********
*Basic validations to avoid misprocessing before the report is executed
*we expect either a date range, a business partner or a device location to be input
AT SELECTION-SCREEN.

*default the dates if only one is populated
   IF p_frdate IS NOT INITIAL AND p_todate IS INITIAL.
    p_todate = p_frdate.
  ENDIF.

*default the dates if only one is populated
  IF p_todate IS NOT INITIAL AND p_frdate IS INITIAL.
    p_frdate = p_todate.
  ENDIF.

  IF p_todate < p_frdate.
    MESSAGE 'From Date exceeds To Date'(001) TYPE 'E'.
  ENDIF.

  IF p_recip-low IS NOT INITIAL AND p_email IS INITIAL.
    MESSAGE 'You must check E-mail if you want to e-mail report'(004) TYPE 'E'.
  ENDIF.

*Several more validations prior to execution
  IF p_frdate IS INITIAL AND p_todate IS INITIAL AND p_email IS INITIAL AND p_bp IS INITIAL AND p_funloc IS INITIAL.
    MESSAGE 'Please enter selection criteria'(005) TYPE 'E'.
    EXIT.
  ENDIF.

*email validations
  IF p_email IS NOT INITIAL.
    IF p_recip-low IS INITIAL.
      MESSAGE 'You must enter at least one e-mail address'(002) TYPE 'E'.
      EXIT.
    ENDIF.
  ENDIF.










*********Start Of Selection*********
START-OF-SELECTION.

*begin processing
*get data to output/email
  PERFORM gather_data.

*don't proceed if we have no data selected
  CHECK lt_changes IS NOT INITIAL.

*If E-mail is requested and we have data
  IF p_email IS NOT INITIAL.

    "Add headers to the data for Excel
    PERFORM create_header_line.

    "Create and Send email
    PERFORM send_email.

*Otherwise display output in ALV Grid if we have data
  ELSE.

    "prep for the ALV_Display
    PERFORM form100_main_fieldcat.

    "call the ALV_Display
    PERFORM form200_alv_display.

  ENDIF.










*&---------------------------------------------------------------------*
*&      Form  gather_data
*&---------------------------------------------------------------------*
* Retrieve data from ZCS_OPTOUTCHANGE and format for display or email
*----------------------------------------------------------------------*
FORM gather_data.
  DATA: lv_selinst TYPE anlage,
        ls_output  TYPE zsoptoutchangerep,
        lv_inst    TYPE anlage,
        lo_instln  TYPE swc_object,
        lo_premise TYPE swc_object,
        lv_premise TYPE vstelle,
        ls_findpar TYPE efindpar,
        lt_result  TYPE STANDARD TABLE OF efindres,
        ls_result  TYPE efindres,
        lo_devices TYPE swc_object,
        lv_meter   TYPE geraet.

  FIELD-SYMBOLS: <changes> TYPE zsoptoutchange.




*If the functional location parameter is populated then select data accordingly
  IF p_funloc IS NOT INITIAL.
    "Set parameter for ISU_FINDER
    ls_findpar-l_devloc = p_funloc.
    CALL FUNCTION 'ISU_FINDER'
      EXPORTING
        x_objtype                   = 'INSTLN'
        x_findpar                   = ls_findpar
      TABLES
        yt_result                   = lt_result
      EXCEPTIONS
        insufficient_selection      = 1
        objtype_not_supported       = 2
        additional_selection_needed = 3
        OTHERS                      = 4.
    IF sy-subrc = 0.
      "If we have a result we should only have one
      READ TABLE lt_result INTO ls_result INDEX 1.
      lv_selinst = ls_result-objkey.
    ENDIF.

    SELECT * FROM zcs_optoutchange APPENDING TABLE lt_changes WHERE installation = lv_selinst.

  "filter results if BP was input
    IF p_bp IS NOT INITIAL.
      DELETE lt_changes WHERE bp <> p_bp.
    ENDIF.

  "filter results if dates were input
    IF p_frdate IS NOT INITIAL AND p_todate IS NOT INITIAL.
      DELETE lt_changes WHERE changedate > p_todate OR changedate < p_frdate.
    ENDIF.


*If the BP parameter is populated then select data accordingly
    ELSEIF p_bp IS NOT INITIAL.
      SELECT * FROM zcs_optoutchange APPENDING TABLE lt_changes WHERE  bp = p_bp.

    "filter results if dates were input
      IF p_frdate IS NOT INITIAL AND p_todate IS NOT INITIAL.
        DELETE lt_changes WHERE changedate > p_todate OR changedate < p_frdate.
      ENDIF.

*Otherwise we expect the date parameters to be populated
    ELSE.
      SELECT * FROM zcs_optoutchange APPENDING TABLE lt_changes
             WHERE  changedate  >= p_frdate
             AND    changedate <= p_todate.
    ENDIF.

*Do not proceed if we have no data
    IF lt_changes IS INITIAL.
      MESSAGE 'No Data Selected for Date Range'(010) TYPE 'S'.
      EXIT.
*We have data so proceed
    ELSE.
      CLEAR: ls_findpar, lt_result, ls_result.

      LOOP AT lt_changes ASSIGNING <changes>.

*Business Partner
        ls_output-bp = <changes>-bp.

*Premise
        lv_inst = <changes>-installation.
        "create instance of Instln
        swc_create_object lo_instln  'INSTLN' lv_inst.
        "traverse to Premises
        swc_get_property lo_instln 'Premises' lo_premise.
        "get premise number
        swc_get_property lo_premise 'Number' lv_premise.

        ls_output-premise = lv_premise.

*Functional Location
        "Set parameter for ISU_FINDER
        ls_findpar-i_anlage = <changes>-installation.
        CALL FUNCTION 'ISU_FINDER'
          EXPORTING
            x_objtype                   = 'DEVLOC'
            x_findpar                   = ls_findpar
          TABLES
            yt_result                   = lt_result
          EXCEPTIONS
            insufficient_selection      = 1
            objtype_not_supported       = 2
            additional_selection_needed = 3
            OTHERS                      = 4.
        IF sy-subrc = 0.
          "If we have a result we should only have one
          READ TABLE lt_result INTO ls_result INDEX 1.
          ls_output-funcloc = ls_result-objkey.
        ENDIF.

*Meter
        "traverse to Current Devices from existing Instln object
        swc_get_property lo_instln 'CurrentDevices' lo_devices.
        "Get serial number of meter
        swc_get_property lo_devices 'SerialNumber' lv_meter.

        ls_output-meter = lv_meter.

*Operand
        ls_output-operand = <changes>-operand.

*Change Date
        WRITE <changes>-changedate TO ls_output-changedate MM/DD/YYYY.

*Change Reason
        ls_output-reason = <changes>-reason.

*Move Out Date
        IF <changes>-moveoutdate IS INITIAL.
          CLEAR ls_output-moveoutdate.
        ELSE.
          WRITE <changes>-moveoutdate TO ls_output-moveoutdate MM/DD/YYYY.
        ENDIF.

*Type of change
        ls_output-type = <changes>-type.

*If an E-Mail is requested we need to format a string
        IF p_email IS NOT INITIAL.
          CONCATENATE lv_string
                      ls_output-bp gc_tab
                      ls_output-premise gc_tab
                      ls_output-funcloc gc_tab
                      ls_output-meter gc_tab
                      ls_output-operand gc_tab
                      ls_output-changedate gc_tab
                      ls_output-reason gc_tab
                      ls_output-moveoutdate gc_tab
                      ls_output-type gc_crlf
                      INTO lv_string.

*Otherwise we build the table for ALV_Display
        ELSE.
          APPEND ls_output TO lt_output.
        ENDIF.
        CLEAR ls_output.
      ENDLOOP.
    ENDIF.

  ENDFORM.                    "gather_data










