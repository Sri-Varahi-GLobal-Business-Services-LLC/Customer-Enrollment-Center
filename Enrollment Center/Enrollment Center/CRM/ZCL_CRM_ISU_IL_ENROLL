* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_ENROLL->IF_CRM_IU_IL_ABSTR_ROOT~CREATE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_NUMBER                      TYPE        INT4
* | [--->] IS_PARAMETERS                  TYPE        ANY(optional)
* | [--->] IV_ROOT_LIST                   TYPE REF TO IF_GENIL_CONT_ROOT_OBJECTLIST
* | [--->] IT_PARAMETERS                  TYPE        CRMT_NAME_VALUE_PAIR_TAB(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_root~create.
    DATA: lv_root       TYPE REF TO if_genil_cont_root_object,
          ls_parameters TYPE zspgm_create,
          lv_key        TYPE zspgm_key,
          ls_msg        TYPE ty_msg,
          lt_bapiret2   TYPE bapiret2_t.
    MOVE-CORRESPONDING is_parameters TO ls_parameters.

    IF cl_crm_isu_il_tools=>check_backend_func_available(
           iv_function  = 'ZISU_IL_ENROLL_CREATE'
           iv_rfc_dest  = rfc_dest ) = abap_true.

      CALL FUNCTION 'ZISU_IL_ENROLL_CREATE'
        DESTINATION rfc_dest
        EXPORTING
          is_enroll_create      = ls_parameters
          iv_commit             = abap_false
        IMPORTING
          e_enroll_key          = lv_key
        TABLES
          et_return             = lt_bapiret2
        EXCEPTIONS
          communication_failure = 1
          system_failure        = 2.

      IF sy-subrc = 0.

* Check lt_bapiret local table for messages of type "A"(abort)
* E" (Error) or "X"
        LOOP AT lt_bapiret2 TRANSPORTING NO FIELDS
                            WHERE type CA 'AEX'.
        ENDLOOP.

* If there are no Abort, Error, or X messages
        IF sy-subrc <> 0.

          gv_create_called = abap_true.

          TRY.
              lv_root = iv_root_list->add_object(
                                        iv_object_name = gc_obj_enroll
                                        is_object_key  = lv_key ).

            CATCH cx_crm_genil_duplicate_rel
                  cx_crm_genil_model_error.             "#EC NO_HANDLER
          ENDTRY.

        ENDIF.

*     add global message
        add_gmsg(
          it_msg            = lt_bapiret2
          iv_show_only_once = abap_true
          iv_root_list      = iv_root_list ).

      ENDIF.

    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_ENROLL->IF_CRM_IU_IL_ABSTR_ROOT~INIT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KEY                         TYPE        ANY
* | [--->] IV_ID                          TYPE        CRMT_GENIL_OBJECT_ID
* | [--->] IV_MSG_SERVICE_ACCESS          TYPE REF TO IF_GENIL_MSG_SERVICE_ACCESS
* | [<---] ET_ADDITIONAL_OBJ              TYPE        CRMT_GENIL_OBJ_INST_LINE_TAB
* | [<---] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_root~init.
    DATA: lv_key  TYPE zspgm_key.

    CHECK rfc_dest IS NOT INITIAL.

* order object key
    lv_key = iv_key.
    CHECK lv_key IS NOT INITIAL.

    rv_success = unlock( iv_key = iv_key ).

    IF cl_crm_isu_il_tools=>check_backend_func_available(
         iv_function  = 'ZISU_IL_ENROLL_INIT'
         iv_rfc_dest  = rfc_dest ) = abap_true.

      CALL FUNCTION 'ZISU_IL_ENROLL_INIT'
        DESTINATION rfc_dest
        EXPORTING
          is_key = lv_key.

    ENDIF.

* delete corresponding message container entry
    DELETE me->gt_msg WHERE key = lv_key.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_ENROLL->IF_CRM_IU_IL_ABSTR_ROOT~LOCK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KEY                         TYPE        ANY
* | [--->] IV_ID                          TYPE        CRMT_GENIL_OBJECT_ID
* | [--->] IV_MSG_SERVICE_ACCESS          TYPE REF TO IF_GENIL_MSG_SERVICE_ACCESS
* | [<---] ET_ADDITIONAL_OBJ              TYPE        CRMT_GENIL_OBJ_INST_LINE_TAB
* | [<---] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_root~lock.
    DATA: lv_key       TYPE zspgm_key,
          lt_return    TYPE bapiret2_t,
          temp_counter TYPE i.

    CHECK rfc_dest IS NOT INITIAL.

* order object key
    lv_key = iv_key.
    CHECK lv_key IS NOT INITIAL.

    IF cl_crm_isu_il_tools=>check_backend_func_available(
         iv_function  = 'ZISU_IL_ENROLL_LOCK'
         iv_rfc_dest  = rfc_dest ) = abap_true.

      CALL FUNCTION 'ZISU_IL_ENROLL_LOCK'
        DESTINATION rfc_dest
        EXPORTING
          is_key                = lv_key
        TABLES
          et_return             = lt_return
        EXCEPTIONS
          communication_failure = 1
          system_failure        = 2.

      LOOP AT lt_return TRANSPORTING NO FIELDS
                        WHERE type CA 'AEX'.
      ENDLOOP.

      IF sy-subrc = 0.

        add_msg(
          iv_obj_name = gc_obj_enroll
          iv_key = lv_key
          it_msg      = lt_return ).

      ELSE.
        is_locked = abap_true.
        rv_success = abap_true.


      ENDIF.

    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_ENROLL->IF_CRM_IU_IL_ABSTR_ROOT~SAVE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KEY                         TYPE        ANY
* | [--->] IV_ID                          TYPE        CRMT_GENIL_OBJECT_ID
* | [--->] IV_MSG_SERVICE_ACCESS          TYPE REF TO IF_GENIL_MSG_SERVICE_ACCESS
* | [<---] ET_ID_MAPPING                  TYPE        CRMT_GENIL_ID_MAPPING_TAB
* | [<---] ET_ADDITIONAL_SAVED_OBJ        TYPE        CRMT_GENIL_OBJ_INST_LINE_TAB
* | [<---] RV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_root~save.
    DATA: lv_key    TYPE zspgm_key,
          lt_return TYPE bapiret2_t.

    lv_key = iv_key.

    IF cl_crm_isu_il_tools=>check_backend_func_available(
         iv_function  = 'ZISU_IL_ENROLL_SAVE'
         iv_rfc_dest  = rfc_dest ) = abap_true.

      CALL FUNCTION 'ZISU_IL_ENROLL_SAVE'
        DESTINATION rfc_dest
        EXPORTING
          is_key                = lv_key
          i_create_save_needed  = gv_create_called
        TABLES
          et_return             = lt_return
        EXCEPTIONS
          communication_failure = 1
          system_failure        = 2.

      IF sy-subrc = 0.

* clear create flag
        gv_create_called = abap_false.

        LOOP AT lt_return TRANSPORTING NO FIELDS
                          WHERE type CA 'AEX'.
        ENDLOOP.
        IF sy-subrc = 0.

          add_msg(
            iv_obj_name = gc_obj_enroll
            iv_key = lv_key
            it_msg      = lt_return ).

        ELSE.
          rv_success = abap_true.
        ENDIF.

      ENDIF.
    ENDIF.

*  if at a later stage the init method is enhanced # then this
*  enhancements will definitially also need to be called after save
*  We dont read the return value. (see usage in cl_ibase_ist_genil_root)
    CALL METHOD if_crm_iu_il_abstr_root~init
      EXPORTING
        iv_key                = iv_key
        iv_id                 = iv_id
        iv_msg_service_access = iv_msg_service_access.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_ENROLL->IF_CRM_IU_IL_ABSTR~RESET
* +-------------------------------------------------------------------------------------------------+
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr~reset.
    DATA: lrs_msg TYPE REF TO ty_msg.

    CALL METHOD super->if_crm_iu_il_abstr~reset.

* clear message container(s)
    LOOP AT gt_msg REFERENCE INTO lrs_msg.
      lrs_msg->msg->reset( ).
      FREE lrs_msg->msg.
    ENDLOOP.
    CLEAR gt_msg.

    FREE gr_gmsg.
    CLEAR gr_gmsg.
*    .
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CRM_ISU_IL_ENROLL->UNLOCK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KEY                         TYPE        ZSPGM_KEY
* | [<-()] RV_UNLOCKED                    TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method UNLOCK.

  DATA: lv_key   TYPE zspgm_key.

  CHECK rfc_dest IS NOT INITIAL.

* order object key
  lv_key = iv_key.
  CHECK lv_key IS NOT INITIAL.

  IF cl_crm_isu_il_tools=>check_backend_func_available(
       iv_function  = 'ZISU_IL_ENROLL_UNLOCK'
       iv_rfc_dest  = rfc_dest ) = abap_true.

    CALL FUNCTION 'ZISU_IL_ENROLL_UNLOCK'
      DESTINATION rfc_dest
      EXPORTING
        is_key           = iv_key
      EXCEPTIONS
        communication_failure = 1
        system_failure        = 2.

    IF sy-subrc =  0.
      is_locked = abap_false.
      rv_unlocked = abap_true.
    ENDIF.

  ENDIF.


  endmethod.
ENDCLASS.
