METHOD if_bsp_dlc_obj_type_callback~get_object_sub_types.

  DATA:   lv_sub_object TYPE bsp_dlc_object_sub_type.

  IF iv_object_type = 'ZIUICCON'.

    lv_sub_object = 'ZRESCOM'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

* Begin of changes by VGORRELA Defect 2713
* Add 'ZCOMQUE' subobject to display Commerical questionnaire
* w/o showing 'Primary residence' dropdown option.
    lv_sub_object = 'ZCOMQUE'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.
* End of changes by VGORRELA Defect 2713

    lv_sub_object = 'ZRESY'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

    lv_sub_object = 'ZRESN'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

    lv_sub_object = 'ZCOMR'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

    lv_sub_object = 'ZCOMR1'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

    lv_sub_object = 'ZRESYC'.
    APPEND lv_sub_object TO result.

    lv_sub_object = 'ZRESNC'.
    APPEND lv_sub_object TO result.

* LAVieth 03/15/17 start - new sub types needed to add "Copy Preferences" question
    lv_sub_object = 'ZRESYP'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

    lv_sub_object = 'ZRESNP'.
    APPEND lv_sub_object TO result.
    CLEAR lv_sub_object.

    lv_sub_object = 'ZRESYCP'.
    APPEND lv_sub_object TO result.

    lv_sub_object = 'ZRESNCP'.
    APPEND lv_sub_object TO result.
* LAVieth 03/15/17 end

  ENDIF.

ENDMETHOD.
