* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_PGENRL->IF_CRM_IU_IL_ABSTR_NROOT~EXECUTE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KEY                         TYPE        ANY
* | [--->] IV_ID                          TYPE        CRMT_GENIL_OBJECT_ID
* | [--->] IV_METHOD_NAME                 TYPE        CRMT_OBJ_METHOD_NAME
* | [--->] IT_PARAMETERS                  TYPE        CRMT_NAME_VALUE_PAIR_TAB
* | [--->] IV_ROOTLIST                    TYPE REF TO IF_GENIL_CONT_ROOT_OBJECTLIST
* | [--->] IV_MSG_SERVICE_ACCESS          TYPE REF TO IF_GENIL_MSG_SERVICE_ACCESS
* | [<---] ET_CHANGED_OBJECTS             TYPE        CRMT_GENIL_OBJ_INSTANCE_TAB
* | [<---] EV_SUCCESS                     TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_nroot~execute.
    DATA: lv_key            TYPE zspgmen_key,
          lt_return         TYPE bapiret2_t,
          ls_attr           TYPE zspgmen_attr,
          lv_root           TYPE REF TO if_genil_cont_root_object,
          ls_msg            TYPE ty_msg,
          lt_all_msg        TYPE bapiret2_t,
          lv_methodnotfound TYPE abap_bool.

    FIELD-SYMBOLS: <line>  TYPE crmt_name_value_pair,
                   <value> TYPE data.

    ev_success = abap_true.

    CHECK  rfc_dest IS NOT INITIAL.

* Get the order no. from the root object. Not from parameter structure!
    lv_key = iv_key.
    CHECK lv_key IS NOT INITIAL.

* get order attributes from parameters
    CALL METHOD cl_crm_isu_il_tools=>fill_struct_from_nvp_tab
      EXPORTING
        it_parameters = it_parameters
      CHANGING
        cs_parameter  = ls_attr.

    CASE iv_method_name.

*     Execute Eligibility Check
      WHEN 'ExecuteEligibilityCheck'.
        REFRESH gt_messages.
        IF cl_crm_isu_il_tools=>check_backend_func_available(
             iv_function  = 'ZPGM_EC_ELIGIBILITYCHECK'
             iv_rfc_dest  = rfc_dest ) = abap_true.

          CALL FUNCTION 'ZPGM_EC_ELIGIBILITYCHECK'
            DESTINATION rfc_dest
            EXPORTING
              is_attr               = ls_attr
            TABLES
              et_return             = lt_return
              et_msg                = gt_messages
            EXCEPTIONS
              communication_failure = 1
              system_failure        = 2.

        ENDIF.

*     Get Enrollment
      WHEN 'ExecuteGetEnrollment'.
        REFRESH: gt_enroll.
        IF cl_crm_isu_il_tools=>check_backend_func_available(
             iv_function  = 'ZPGM_EC_GETENROLLMENT'
             iv_rfc_dest  = rfc_dest ) = abap_true.

          CALL FUNCTION 'ZPGM_EC_GETENROLLMENT'
            DESTINATION rfc_dest
            EXPORTING
              is_attr               = ls_attr
            TABLES
              et_return             = lt_return
              et_enroll             = gt_enroll
              et_enroll_his         = gt_enroll_his
            EXCEPTIONS
              communication_failure = 1
              system_failure        = 2.

        ENDIF.

      WHEN OTHERS.
*      Method was not found, set flag to false
*      Execute2 should then be called
        ev_success = abap_false.
        lv_methodnotfound  = abap_true.

    ENDCASE.

* * report success, error to framework
    lt_all_msg = zcl_crm_isu_il_pgenrl_comp=>get_messages(
     is_system_message = sy
     it_message = lt_return
     ).

    IF zcl_crm_isu_il_pgenrl_comp=>error_messages_exist( lt_all_msg ) = abap_false AND
      lv_methodnotfound = abap_false.

      DATA: ls_changed_object       LIKE LINE OF et_changed_objects.

      ls_changed_object-object_name = gc_pgmenroll.
      ls_changed_object-object_id   = iv_id.
      APPEND ls_changed_object TO et_changed_objects.

    ELSE. " report error
      ev_success = abap_false.
*      add_msg(
*       iv_obj_name = gc_pgmenroll
*       iv_order_no = lv_key
*       it_msg      = lt_all_msg ).

    ENDIF.

*  if execute failed AND entity was not locked externally (or explicitly).
    IF ev_success = abap_false AND is_locked = abap_false.

*    release any lock made by the execute method internally in the backend.
      if_crm_iu_il_abstr_root~init(
        iv_key                = lv_key
        iv_id                 = iv_id
        iv_msg_service_access = iv_msg_service_access ).

    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_PGENRL->IF_CRM_IU_IL_ABSTR_NROOT~MODIFY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_OBJECT                      TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_DELTA                       TYPE        CRMT_DELTA
* | [--->] IO_OBJECT_LIST                 TYPE REF TO IF_GENIL_CONT_OBJECT_LIST_BASE
* | [<---] EO_NEXT_OBJECT                 TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [<-->] CT_CHANGED_OBJECTS             TYPE        CRMT_GENIL_OBJ_INSTANCE_TAB
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_nroot~modify.
    DATA: ls_pg_key         TYPE zspgmen_key,
          lt_result         TYPE crmt_attr_name_tab,
          lv_changed_field  TYPE REF TO name_komp,
          ls_pg_attr        TYPE zspgmen_attr,
          ls_changed_object LIKE LINE OF ct_changed_objects.

    FIELD-SYMBOLS: <previous_value> TYPE any,
                   <changed_value>  TYPE any,
                   <ls_pg_attr_old> TYPE zspgmen_attr.

* order object key and attributes
    iv_object->get_key( IMPORTING es_key = ls_pg_key ).
    iv_object->get_attributes( IMPORTING es_attributes = ls_pg_attr ) .

* Get Attribute Value
    READ TABLE zcl_crm_isu_il_pgenrl=>gt_pgenroll[]
      ASSIGNING <ls_pg_attr_old>
    WITH KEY zenrlbp = ls_pg_key-zenrlbp
             zenrlca = ls_pg_key-zenrlca.


    CHECK iv_delta = 'M'.
*    We get the fields that can be changed. These fields which
*    can be changed are specified in
*    IF_CRM_IU_IL_ABSTR_NROOT~READ_ATTR.
    lt_result = get_changed_fields( iv_object ).

* Check for initial
    CHECK NOT lt_result IS INITIAL.

    LOOP AT lt_result REFERENCE INTO lv_changed_field.

      ASSIGN COMPONENT lv_changed_field->*
                       OF STRUCTURE ls_pg_attr TO <changed_value>.

      IF sy-subrc = 0 .
        IF <changed_value> IS ASSIGNED.

          ASSIGN COMPONENT lv_changed_field->*
                           OF STRUCTURE <ls_pg_attr_old> TO <previous_value>.

*            - If the new value is different from the buffer value
*                    store the new value in the buffer
          IF sy-subrc = 0     .
            IF <previous_value> IS ASSIGNED .

              IF <changed_value> <> <previous_value>.

                <previous_value> = <changed_value>.
              ENDIF.

            ENDIF.
*
          ENDIF.


        ENDIF.
      ENDIF.
    ENDLOOP.

* Add Changed Object
    ls_changed_object-object_name = iv_object->get_name( ).
    ls_changed_object-object_id   = iv_object->get_object_id( ).
    APPEND ls_changed_object TO ct_changed_objects.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_PGENRL->IF_CRM_IU_IL_ABSTR_NROOT~READ_ATTR
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_OBJECT                      TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IT_REQUESTED_ATTR              TYPE        CRMT_ATTR_NAME_TAB(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_nroot~read_attr.
    DATA: ls_pg_key           TYPE zspgmen_key,
          ls_pg_attr          TYPE zspgmen_attr,
          lt_dd03             TYPE STANDARD TABLE OF dd03p,
          le_dd03             TYPE dd03p,
          lt_changeable_field TYPE crm_isu_fieldname_tab,
          ls_changeable_field TYPE fieldname,
          lv_root             TYPE REF TO if_genil_cont_root_object.

* object key
    CALL METHOD iv_object->get_key
      IMPORTING
        es_key = ls_pg_key.

* Get Attribute Value
    READ TABLE zcl_crm_isu_il_pgenrl=>gt_pgenroll[]
      INTO ls_pg_attr
    WITH KEY zenrlbp = ls_pg_key-zenrlbp
             zenrlca = ls_pg_key-zenrlca.

* Get Custom Fields
  CALL FUNCTION 'DD_TABD_GET'
    EXPORTING
      tabl_name      = 'ZSPGMEN_ATTR'
    TABLES
      dd03p_tab_a    = lt_dd03
    EXCEPTIONS
      access_failure = 1
      OTHERS         = 2.
  IF sy-subrc <> 0.
    EXIT.
  ENDIF.


  LOOP AT lt_dd03 INTO le_dd03
    WHERE fieldname <> 'ZENRLBP'
    and   fieldname <> 'ZENRLCA'.

*   definition of changeable fields
    ls_changeable_field = le_dd03-fieldname.
    APPEND ls_changeable_field TO lt_changeable_field.

  ENDLOOP.

* conveying to the framework the fields which should be changeable
  set_field_properties(
    iv_object    = iv_object
    iv_property  = if_genil_obj_attr_properties=>changeable
    it_fieldname = lt_changeable_field ).

* providing the data to the framework
  iv_object->set_attributes( ls_pg_attr ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_PGENRL->IF_CRM_IU_IL_ABSTR_NROOT~READ_DEPENDENT_REL
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_OBJECT                      TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_CHILD_TEMPLATE              TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_CHILD_NAME                  TYPE        CRMT_EXT_OBJ_NAME
* | [--->] IV_RELATION_NAME               TYPE        CRMT_RELATION_NAME
* | [--->] IV_FILTER                      TYPE REF TO IF_GENIL_RELATION_FILTER(optional)
* | [--->] IS_PARAM                       TYPE        GENILT_RELATION_REQUEST_PARAMS(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_crm_iu_il_abstr_nroot~read_dependent_rel.
    DATA:
      lv_child         TYPE REF TO if_genil_container_object,
      lv_relation_name TYPE crmt_relation_name,
      lv_root          TYPE REF TO if_genil_cont_root_object.

* Get Child Template
    iv_child_template->get_parent_relation( IMPORTING ev_relation_name = lv_relation_name ).

    CASE lv_relation_name.
      WHEN 'ProgramEnrolledRel'.

*       Get Eligible Enrollement
        CALL METHOD get_enrolled
          EXPORTING
            iv_object         = iv_object
            iv_child_template = iv_child_template
            iv_child_name     = iv_child_name
            iv_relation_name  = iv_relation_name
            iv_filter         = iv_filter
            is_param          = is_param.

      WHEN 'ProgramAvailableRel'.

*       Get Available Rel
        CALL METHOD get_available
          EXPORTING
            iv_object         = iv_object
            iv_child_template = iv_child_template
            iv_child_name     = iv_child_name
            iv_relation_name  = iv_relation_name
            iv_filter         = iv_filter
            is_param          = is_param.

      WHEN 'ProgramMessageRel'.

*       Get Message Rel
        CALL METHOD get_message
          EXPORTING
            iv_object         = iv_object
            iv_child_template = iv_child_template
            iv_child_name     = iv_child_name
            iv_relation_name  = iv_relation_name
            iv_filter         = iv_filter
            is_param          = is_param.

      WHEN 'ProgramHistoryRel'.

*       Get History Rel
        CALL METHOD get_history
          EXPORTING
            iv_object         = iv_object
            iv_child_template = iv_child_template
            iv_child_name     = iv_child_name
            iv_relation_name  = iv_relation_name
            iv_filter         = iv_filter
            is_param          = is_param.


    ENDCASE.
  ENDMETHOD.


