CLASS ZCL_CRM_ISU_IL_PGENRL IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CRM_ISU_IL_PGENRL=>CLASS_CONSTRUCTOR
* +-------------------------------------------------------------------------------------------------+
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD class_constructor.
*   check for initial
    CHECK gt_prog_id[] IS INITIAL.

* Check Backend FM exist or not
    cl_crm_isu_il_tools=>get_backend_dest(
      EXPORTING
        iv_check_avlbl    = abap_true
      IMPORTING
        ev_backend_dest   = gv_rfcdest
      EXCEPTIONS
        no_backend_dest   = 1
        OTHERS            = 2 ).
    IF sy-subrc <> 0.
*    clear result.
    ENDIF.

    IF cl_crm_isu_il_tools=>check_backend_func_available(
             iv_function  = 'ZPGM_EC_GETPGMID'
             iv_rfc_dest  = gv_rfcdest ) = abap_true.
*     Get Program ID
      CALL FUNCTION 'ZPGM_EC_GETPGMID'
        DESTINATION gv_rfcdest
        TABLES
          et_progid             = gt_prog_id
          et_proglink           = gt_prog_link
        EXCEPTIONS
          communication_failure = 1
          system_failure        = 2.
      IF sy-subrc = 0.

      ENDIF.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_PGENRL->GET_AVAILABLE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_OBJECT                      TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_CHILD_TEMPLATE              TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_CHILD_NAME                  TYPE        CRMT_EXT_OBJ_NAME
* | [--->] IV_RELATION_NAME               TYPE        CRMT_RELATION_NAME
* | [--->] IV_FILTER                      TYPE REF TO IF_GENIL_RELATION_FILTER(optional)
* | [--->] IS_PARAM                       TYPE        GENILT_RELATION_REQUEST_PARAMS(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_available.
    DATA: lv_child         TYPE REF TO if_genil_container_object,
          ls_pg_key        TYPE zspgmen_key,
          ls_pg_attr       TYPE zspgmen_attr,
          lv_relation_name TYPE crmt_relation_name,
          ls_pgav_key      TYPE zspgmavail_key,
          ls_pgav_attr     TYPE zspgmavail_attr,
          lv_tabix         TYPE sytabix,
          ls_messages      LIKE LINE OF gt_messages,
          lv_root          TYPE REF TO if_genil_cont_root_object.

    FIELD-SYMBOLS:<fs_enroll> TYPE zspgm_enroll.

*   object key
    CALL METHOD iv_object->get_key
      IMPORTING
        es_key = ls_pg_key.

    LOOP AT gt_prog_id
            INTO gs_prog_id.
      CLEAR: ls_pgav_key, ls_pgav_attr.
      READ TABLE gt_enroll
        ASSIGNING <fs_enroll>
      WITH KEY zenrlbp = ls_pg_key-zenrlbp
               zenrlca = ls_pg_key-zenrlca
               zpgm_type = gs_prog_id-zpgm_type.
      CHECK sy-subrc <> 0.
      lv_tabix = lv_tabix + 1.
      ls_pgav_key-zpgm_type = gs_prog_id-zpgm_type.
      ls_pgav_key-zenrlbp = ls_pg_key-zenrlbp.
      ls_pgav_key-zenrlca = ls_pg_key-zenrlca.
      MOVE-CORRESPONDING ls_pgav_key TO ls_pgav_attr.
      ls_pgav_attr-priority = gs_prog_id-priority.
      ls_pgav_attr-description  = gs_prog_id-description .
      ls_pgav_attr-longtext  = gs_prog_id-longtext .

*     Get Logical Link
      READ TABLE gt_prog_link
        INTO gs_prog_link
      WITH KEY zpgm_type = gs_prog_id-zpgm_type
               link_type  = 01.
      IF sy-subrc = 0.
        ls_pgav_attr-link_id = gs_prog_link-link_id.
      ENDIF.

*     Read Error
*      READ TABLE gt_messages
*        WITH KEY zenrlbp = ls_pg_key-zenrlbp
*                     zenrlca = ls_pg_key-zenrlca
*                     zpgm_type = gs_prog_id-zpgm_type
*      TRANSPORTING NO FIELDS.
      LOOP AT gt_messages INTO ls_messages
        WHERE zenrlbp = ls_pg_key-zenrlbp
        AND   zenrlca = ls_pg_key-zenrlca
        AND   zpgm_type = gs_prog_id-zpgm_type
        AND ( type = 'E' OR type = 'A' OR type = 'X' ).
      ENDLOOP.
      IF sy-subrc <> 0.
        ls_pgav_attr-eligibile = abap_true.
      ENDIF.


      IF lv_tabix = 1.
        lv_child = iv_child_template.
      ELSE.
        lv_child = iv_child_template->copy_self_with_structure( iv_relation_name = lv_relation_name ).
      ENDIF.

*     Set Key and Attribute
      lv_child->set_key( ls_pgav_key ).
      lv_child->set_attributes( ls_pgav_attr ).

    ENDLOOP.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CRM_ISU_IL_PGENRL->GET_ENROLLED
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_OBJECT                      TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_CHILD_TEMPLATE              TYPE REF TO IF_GENIL_CONTAINER_OBJECT
* | [--->] IV_CHILD_NAME                  TYPE        CRMT_EXT_OBJ_NAME
* | [--->] IV_RELATION_NAME               TYPE        CRMT_RELATION_NAME
* | [--->] IV_FILTER                      TYPE REF TO IF_GENIL_RELATION_FILTER(optional)
* | [--->] IS_PARAM                       TYPE        GENILT_RELATION_REQUEST_PARAMS(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_enrolled.
    DATA: lv_child         TYPE REF TO if_genil_container_object,
          ls_pg_key        TYPE zspgmen_key,
          ls_pg_attr       TYPE zspgmen_attr,
          lv_relation_name TYPE crmt_relation_name,
          ls_pgen_key      TYPE zspgmenrolled_key,
          ls_pgen_attr     TYPE zspgmenrolled_attr,
          lv_tabix         TYPE sytabix,
          lv_root          TYPE REF TO if_genil_cont_root_object,
          lv_struct_descr  TYPE REF TO cl_abap_structdescr.

    FIELD-SYMBOLS:<fs_enroll> TYPE zspgm_enroll.

* object key
    CALL METHOD iv_object->get_key
      IMPORTING
        es_key = ls_pg_key.

    LOOP AT gt_enroll ASSIGNING <fs_enroll>
    WHERE zenrlbp = ls_pg_key-zenrlbp
    AND   zenrlca = ls_pg_key-zenrlca.
      CLEAR: ls_pgen_key, ls_pgen_attr.
      MOVE-CORRESPONDING <fs_enroll> TO: ls_pgen_key, ls_pgen_attr.
      lv_tabix = lv_tabix + 1.
*     Get Logical Link
      READ TABLE gt_prog_link
        INTO gs_prog_link
      WITH KEY zpgm_type = <fs_enroll>-zpgm_type
               link_type  = 02.
      IF sy-subrc = 0.
        ls_pgen_attr-link_id = gs_prog_link-link_id.
      ENDIF.

*   Get Program ID Details
      READ TABLE gt_prog_id
        INTO gs_prog_id
      WITH KEY zpgm_type = <fs_enroll>-zpgm_type.
      IF sy-subrc = 0.
        ls_pgen_attr-priority = gs_prog_id-priority.
        ls_pgen_attr-description  = gs_prog_id-description .
        ls_pgen_attr-longtext  = gs_prog_id-longtext .
      ENDIF.

      IF lv_tabix = 1.
        lv_child = iv_child_template.
      ELSE.
        lv_child = iv_child_template->copy_self_with_structure( iv_relation_name = lv_relation_name ).
      ENDIF.

*     Set Key and Attribute
      lv_child->set_key( ls_pgen_key ).
      lv_child->set_attributes( ls_pgen_attr ).

    ENDLOOP.

  ENDMETHOD.


