        !is_param          TYPE genilt_relation_request_params OPTIONAL .
    METHODS get_message
      IMPORTING
        !iv_object         TYPE REF TO if_genil_container_object
        !iv_child_template TYPE REF TO if_genil_container_object
        !iv_child_name     TYPE crmt_ext_obj_name
        !iv_relation_name  TYPE crmt_relation_name
        !iv_filter         TYPE REF TO if_genil_relation_filter OPTIONAL
