******************************************************************
    CONSTANTS : lc_leg_pnd TYPE char24 VALUE 'Enrollment Initiated' ##NO_TEXT.

    DATA: lv_datetime   TYPE xsddatetime_z,
          lv_fieldname  TYPE rollname,
          lv_uuid       TYPE sysuuid_c,
          lv_uu         TYPE sysuuid_x,
          ls_proxy_data TYPE zcreated_end_device_service_r1,
          ls_property   TYPE zmessage_property27,
          ls_error      TYPE zerror_type9,
          ls_pan_work   TYPE zpan_service_works5,
          ls_bapiret2   TYPE bapiret2,
          ls_customer   TYPE zcustomer12,
          ls_enrollment TYPE zenrollment5,
          ls_contact    TYPE zcontact2,
          ls_dd04t      TYPE dd04t,
          lt_dd04t      TYPE STANDARD TABLE OF dd04t,
          loref_excep   TYPE REF TO cx_root.

    CLEAR: lv_datetime, lv_fieldname, lv_uuid, ls_proxy_data,
          ls_property, ls_error, ls_pan_work, ls_bapiret2,
          ls_customer, ls_enrollment, ls_contact, ls_dd04t,
          lt_dd04t[].

*   Popuate Header
    ls_proxy_data-created_end_device_service_req-header-verb = 'created'(109).
    ls_proxy_data-created_end_device_service_req-header-noun = 'EndDeviceServiceRequests'(113).
    ls_proxy_data-created_end_device_service_req-header-user-user_id = sy-uname.
    lv_uuid = create_guid( ).

    TRY.
        CALL METHOD cl_gdt_conversion=>guid_outbound
          EXPORTING
            im_guid_c = lv_uuid    " GUID in Character Display
          IMPORTING
            ex_value  = ls_proxy_data-created_end_device_service_req-header-message_id.    " GUID / UUID in XML Display

      CATCH cx_gdt_conversion INTO loref_excep ##CATCH_ALL.
        zcl_int_err_handler=>raise_proxy_exception( loref_excep ).

    ENDTRY.

*    TRY.
*        CLEAR lv_uu.
*        lv_uu = x_input-pgm_int_data-zcorrelid.
*        ls_proxy_data-created_end_device_service_req-header-correlation_id = lv_uuid. "Should be uncommented while integration testing..
**        CALL METHOD cl_gdt_conversion=>guid_outbound
**          EXPORTING
**            im_guid_x = lv_uu    " GUID in Character Display
**          IMPORTING
**            ex_value  = ls_proxy_data-created_end_device_service_req-header-correlation_id.    " GUID / UUID in XML Display
*
*      CATCH cx_gdt_conversion INTO loref_excep ##CATCH_ALL.
*        zcl_int_err_handler=>raise_proxy_exception( loref_excep ).
*
*    ENDTRY.

    ls_proxy_data-created_end_device_service_req-header-correlation_id = x_input-pgm_int_data-zcorrelid.
    ls_proxy_data-created_end_device_service_req-header-source = 'SAP'(110).
    GET TIME STAMP FIELD ls_proxy_data-created_end_device_service_req-header-timestamp.
    ls_proxy_data-created_end_device_service_req-header-context = sy-sysid.
    ls_property-name = 'Stereotype'(101).
    ls_property-value = 'DPPEnrollment'(102).
    APPEND ls_property TO ls_proxy_data-created_end_device_service_req-header-property ##ENH_OK.

*   Populate Error or Success
    IF iv_retstatus = 'Success'(103).
      ls_proxy_data-created_end_device_service_req-reply-result = 'OK'(104).
      ls_enrollment-process_flag = abap_true.
    ELSEIF iv_retstatus = 'Failure'(111).
      ls_proxy_data-created_end_device_service_req-reply-result = 'FAILED'(105).
      LOOP AT it_bapiret INTO ls_bapiret2.
        CLEAR : lv_fieldname,
                ls_error,
                lt_dd04t,
                ls_dd04t.

        ls_error-details = ls_bapiret2-message.
        lv_fieldname = ls_bapiret2-field.
        CALL FUNCTION 'DD_DTEL_GET'
          EXPORTING
            roll_name     = lv_fieldname
          TABLES
            dd04t_tab_a   = lt_dd04t
          EXCEPTIONS
            illegal_value = 1
            OTHERS        = 2.
        IF sy-subrc = 0.
          DELETE lt_dd04t WHERE ddlanguage <> sy-langu.
          READ TABLE lt_dd04t INTO ls_dd04t WITH KEY rollname = lv_fieldname.
          IF sy-subrc IS INITIAL.
            ls_error-reason = |Invalid| & | | & |{ ls_dd04t-scrtext_l }|.
            CONCATENATE ls_error-reason '-' ls_error-details
            INTO ls_error-reason SEPARATED BY space.
          ENDIF.
        ENDIF.
        MOVE : 'DPPServiceRequest_Failure'(106) TO ls_error-code.
        APPEND ls_error TO ls_proxy_data-created_end_device_service_req-reply-error ##ENH_OK.
      ENDLOOP.

    ENDIF.

*   Populate customer data
    ls_customer-m_rid = x_input-pgm_int_data-zenrlbp.
    ls_customer-customer_accounts-m_rid = x_input-pgm_int_data-zenrlca.
    ls_customer-customer_accounts-customer_agreements-usage_points-m_rid = x_input-pgm_int_data-zenrlsdp.
    CLEAR lv_datetime.
    IF NOT x_input-pgm_int_data-zenrl_date IS INITIAL.
      TRY.
          CALL METHOD cl_bs_soa_convert_xsddatetime=>map_xsddatetime_z_out
            EXPORTING
              iv_date         = x_input-pgm_int_data-zenrl_date
              iv_time         = sy-uzeit
            IMPORTING
              ev_xsd_datetime = lv_datetime.
        CATCH cx_root INTO loref_excep ##CATCH_ALL ##NO_HANDLER.
          zcl_int_err_handler=>raise_proxy_exception( loref_excep ).
      ENDTRY.
    ENDIF.
    ls_enrollment-enrollment_date = lv_datetime.
    ls_enrollment-enrollment_status = lc_leg_pnd.
    ls_enrollment-program-m_rid = x_input-pgm_int_data-zprgmid.
    ls_enrollment-program-name = x_input-pgm_enroll-zpgm_type."'DPP Program'(108).
    ls_customer-enrollments = ls_enrollment ##ENH_OK.

*   Populate preference data
    ls_customer-customer_accounts-contact_preference-nick_name = 'DPP Preference'.
    IF x_input-pgm_int_data-phone_sma IS NOT INITIAL. "SMS
      ls_contact-contact_value = x_input-pgm_int_data-phone_sma.
      ls_contact-contact_type  = 'SMS'.
      APPEND ls_contact TO ls_customer-customer_accounts-contact_preference-contacts.
    ENDIF.

    IF x_input-pgm_int_data-email IS NOT INITIAL. "EMAIL
      ls_contact-contact_value = x_input-pgm_int_data-email.
      ls_contact-contact_type  = 'E_MAIL'.
      APPEND ls_contact TO ls_customer-customer_accounts-contact_preference-contacts.
    ENDIF.

    IF x_input-pgm_int_data-phone IS NOT INITIAL. "Voice
      ls_contact-contact_value = x_input-pgm_int_data-phone.
      ls_contact-contact_type  = 'IVR'.
      APPEND ls_contact TO ls_customer-customer_accounts-contact_preference-contacts.
    ENDIF.
    ls_pan_work-customers = ls_customer ##ENH_OK.


    APPEND ls_pan_work TO ls_proxy_data-created_end_device_service_req-payload-end_device_service_requests-pan_service_works ##ENH_OK.

    x_output = ls_proxy_data.

  ENDMETHOD.


