* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_ISU_SE_MAP_DPP->MAP_DPPENVREQUEST_IN
* +-------------------------------------------------------------------------------------------------+
* | [--->] X_INPUT                        TYPE        ZCREATE_END_DEVICE_SERVICE_RE1
* | [<-->] XY_LOG                         TYPE        APPLMSGTAB(optional)
* | [<-->] XY_APPLDATA                    TYPE        ZSDPP_INT_DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD map_dppenvrequest_in.
******************************************************************
*  Author                    : Rajanidhi Rajasekeran
*  Date                      : 10/13/2015
*----------------------------------------------------------------*
*  Description: This Method handles mapping for the Enrollment
*               Request from Enrollment Vendor
*----------------------------------------------------------------*
* MODIFICATION HISTORY
*
*  SAP Transport Request #   :
*  Author                    :
*  Modification Date         :
*  Description               :
*  Defect #                  :
*  Modification flag         :
******************************************************************
    FIELD-SYMBOLS: <fs_payload>           TYPE zend_device_service_requests_8 ##NEEDED,
                   <fs_pan_service_works> TYPE zpan_service_works4,
                   <fs_contact>           TYPE zcontact1.

    DATA: loref_err_obj TYPE REF TO cx_root,
          lt_contact    TYPE zcontact_tab.

    CLEAR: lt_contact[],
           xy_appldata.

    READ TABLE x_input-create_end_device_service_requ-payload-end_device_service_requests-pan_service_works
               ASSIGNING <fs_pan_service_works> INDEX 1.

    IF <fs_pan_service_works> IS ASSIGNED.
      xy_appldata-pgm_int_data-zmsguuid = guid_inbound( x_input-create_end_device_service_requ-header-message_id ).
*      xy_appldata-pgm_int_data-zcorrelid = guid_inbound( x_input-create_end_device_service_requ-header-correlation_id ).
      xy_appldata-pgm_int_data-zcorrelid = x_input-create_end_device_service_requ-header-correlation_id.
*      xy_appldata-pgm_int_data-zmsguuid = x_input-create_end_device_service_requ-header-message_id.
*      xy_appldata-pgm_int_data-zcorrelid = x_input-create_end_device_service_requ-header-correlation_id.

      MOVE : <fs_pan_service_works>-customers-m_rid                         TO xy_appldata-pgm_int_data-zenrlbp,
             <fs_pan_service_works>-customers-enrollments-caller_name       TO xy_appldata-pgm_int_data-zcallername,
             <fs_pan_service_works>-customers-enrollments-notes             TO xy_appldata-pgm_int_data-zenrlnote,
             <fs_pan_service_works>-customers-customer_accounts-m_rid       TO xy_appldata-pgm_int_data-zenrlca,
             <fs_pan_service_works>-customers-enrollments-program-m_rid     TO xy_appldata-pgm_int_data-zprgmid,
             <fs_pan_service_works>-customers-customer_accounts-customer_agreements-usage_points-m_rid
                                                                            TO xy_appldata-pgm_int_data-zenrlsdp.

      xy_appldata-pgm_int_data-zreq_type = 'ENRL'.
      xy_appldata-pgm_int_data-zenrl_source = 'INT'.
*** Enrollment Date & Time
      IF NOT <fs_pan_service_works>-customers-enrollments-enrollment_date IS INITIAL.
        TRY.
            CALL METHOD cl_bs_soa_convert_xsddatetime=>map_xsddatetime_z_in
              EXPORTING
                iv_xsd_datetime = <fs_pan_service_works>-customers-enrollments-enrollment_date
                iv_timezone     = sy-zonlo
              IMPORTING
                ev_date         = xy_appldata-pgm_int_data-zenrl_date.
*                  ev_time         = lwa_dla_int_struc-zdla_cust_prof-zenrltim.
          CATCH cx_root INTO loref_err_obj ##CATCH_ALL.
            zcl_int_err_handler=>raise_proxy_exception( loref_err_obj ).
        ENDTRY.
      ENDIF.

*     Get Preferences
      lt_contact = <fs_pan_service_works>-customers-customer_accounts-contact_preference-contacts.

      LOOP AT lt_contact ASSIGNING <fs_contact>.
        TRANSLATE <fs_contact>-contact_type TO UPPER CASE.
        CASE <fs_contact>-contact_type.

          WHEN 'SMS'.
            xy_appldata-pgm_int_data-phone_sma = <fs_contact>-contact_value.

          WHEN 'E_MAIL'.
            xy_appldata-pgm_int_data-email = <fs_contact>-contact_value.

          WHEN 'IVR'.
            xy_appldata-pgm_int_data-phone = <fs_contact>-contact_value.

          WHEN 'IHD'.

        ENDCASE.
      ENDLOOP.

      xy_appldata-pgm_enroll-zenrlbp = xy_appldata-pgm_int_data-zenrlbp.
      xy_appldata-pgm_enroll-zenrlca = xy_appldata-pgm_int_data-zenrlca.

*     Get the program type from the custom table
      SELECT SINGLE program_type ##WARN_OK
        INTO xy_appldata-pgm_enroll-zpgm_type
        FROM ztpgm_progid
      WHERE program_uuid = xy_appldata-pgm_int_data-zprgmid ##WARN_OK.

      xy_appldata-pgm_int_data-zpgm_type = xy_appldata-pgm_enroll-zpgm_type.
      xy_appldata-pgm_enroll-zenrl_reqdat = xy_appldata-pgm_int_data-zenrl_date.
      xy_appldata-pgm_enroll-zenrlstatus = '001'.
      xy_appldata-pgm_enroll-zenrlsdp = xy_appldata-pgm_int_data-zenrlsdp.

      xy_appldata-pgm_enroll-zcrtdat =
      xy_appldata-pgm_int_data-zcrtdat = sy-datum.
      xy_appldata-pgm_enroll-zcrttm =
      xy_appldata-pgm_int_data-zcrttm = sy-uzeit.
      xy_appldata-pgm_enroll-zcrtby =
      xy_appldata-pgm_int_data-zcrtby = sy-uname.

    ENDIF.

  ENDMETHOD.


