* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>BI_PERSISTENT~FIND_BY_LPOR
* +-------------------------------------------------------------------------------------------------+
* | [--->] LPOR                           TYPE        SIBFLPOR
* | [<-()] RESULT                         TYPE REF TO BI_PERSISTENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD bi_persistent~find_by_lpor.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Sarat
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Find Using Local Persistent Object Reference
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Sarat    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------
  DATA:
       loref_object        TYPE REF TO zcl_cs_ami_utility,
       lwa_instance_buffer TYPE t_wa_instance_buffer,
       loref_error           TYPE REF TO cx_bo_error,
       lv_key              TYPE zbi_disconnection_details.

  CONSTANTS : lc_alphabets TYPE string VALUE 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
              lc_underscore TYPE c VALUE '_'.


  IF lpor-instid CA lc_alphabets.
    SPLIT lpor-instid AT lc_underscore INTO lv_key-refobjtype lv_key-refobjkey IN CHARACTER MODE.
  ELSE.
    lv_key-discno = lpor-instid(22).
  ENDIF.

  READ TABLE _instance_buffer INTO lwa_instance_buffer
       WITH TABLE KEY instid = lv_key.
  IF sy-subrc <> 0 AND ( NOT lv_key IS INITIAL ).
    TRY.
        CREATE OBJECT loref_object
          EXPORTING
            im_disc_data = lv_key.

        IF lines( loref_object->discon_details ) GT 1.
          LOOP AT loref_object->discon_details INTO lwa_instance_buffer-instid.
            lwa_instance_buffer-object ?= loref_object.
            INSERT lwa_instance_buffer INTO TABLE _instance_buffer.
          ENDLOOP.
        ELSE.
          READ TABLE loref_object->discon_details INTO loref_object->discon_data INDEX 1.
            lwa_instance_buffer-instid = loref_object->discon_data.
            lwa_instance_buffer-object ?= loref_object.
            INSERT lwa_instance_buffer INTO TABLE _instance_buffer.
        ENDIF.
      CATCH cx_bo_error.
        loref_error->IF_MESSAGE~GET_TEXT( ).
    ENDTRY.
  ENDIF.

  result ?= lwa_instance_buffer-object.
ENDMETHOD.


