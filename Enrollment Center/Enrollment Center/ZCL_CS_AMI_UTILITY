  FIELD-SYMBOLS:
      <lf_discon_data> TYPE zbi_disconnection_details.

  IF im_discno IS INITIAL.
    CALL FUNCTION 'ISU_S_DISCDOC_CREATE'
      EXPORTING
*       X_DISCNO       =
        x_discreason   = im_discon_reason
        x_refobjtype   = im_refobjtype
        x_refobjkey    = im_refobjkey
        x_upd_online   = abap_true
