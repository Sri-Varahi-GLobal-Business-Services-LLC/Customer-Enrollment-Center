        EXIT.
      ENDLOOP.
*
*      READ TABLE li_devcapabilities INTO lw_devcapabilities  WITH KEY capabilities = co_value1 ."AND ams_relevant = co_flag AND amcg_relevant = co_flag.
*      IF sy-subrc = 0.
*
*
*      ENDIF.
      IF sy-subrc EQ 0.
        rv_is_smart_meter = co_flag.
*        EXIT.
      ENDIF.
    ENDIF.
  ENDIF.

