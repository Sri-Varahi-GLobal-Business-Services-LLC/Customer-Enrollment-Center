* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>GET_DISCDOC_DATA
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DISCNO                      TYPE        DISCNO
* | [<---] EV_INSTALLATION                TYPE        ANLAGE
* | [<---] EV_IS_COMBO_ACCOUNT            TYPE        FLAG
* | [<---] EV_IS_SMART_METER              TYPE        FLAG
* | [<---] ET_EDISCPOS                    TYPE        TT_EDISCPOS
* | [<---] ET_EDISCOBJ                    TYPE        TT_EDISCOBJ
* | [<---] ET_EDISCOBJH                   TYPE        TT_EDISCOBJH
* | [<---] ET_EDISCACT                    TYPE        TT_EDISCACT
* | [<---] EV_ISNONSNP                    TYPE        FLAG
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_discdoc_data.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Sarat
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Get Disconnection Document Details
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Sarat    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------

  TYPES : BEGIN OF ty_ever,
           sparte TYPE sparte,
           anlage TYPE anlage,
          END OF ty_ever.

  DATA: ls_ediscdoc TYPE ediscdoc,
        lv_equnr TYPE equnr,
        ls_ever TYPE ever,
        lv_vkonto TYPE vkont_kk,
        lv_anlage TYPE anlage,
        lt_ever TYPE TABLE OF ty_ever.

  CONSTANTS :
      lc_cust TYPE discprocv VALUE 'CUST',
      lc_01   TYPE sparte    VALUE '01',
      lc_02   TYPE sparte    VALUE '02'.

  CLEAR : lv_anlage,lv_vkonto,lv_equnr,lt_ever,ls_ediscdoc.

  " Get Disconnection document details
  CALL FUNCTION 'ISU_DB_EDCN_SELECT'
    EXPORTING
      x_discno     = iv_discno
    IMPORTING
      y_ediscdoc   = ls_ediscdoc
    TABLES
      yt_ediscobj  = et_ediscobj
      yt_ediscobjh = et_ediscobjh
      yt_ediscact  = et_ediscact
      yt_ediscpos  = et_ediscpos
    EXCEPTIONS
      not_found    = 1
      system_error = 2
      OTHERS       = 3.

  IF ( sy-subrc EQ 0 ) AND ( ls_ediscdoc IS NOT INITIAL ).


    IF ls_ediscdoc-refobjtype EQ text-003."'ISUACCOUNT'

      lv_vkonto = ls_ediscdoc-refobjkey+0(12).
      "check Combo Account
      SELECT sparte
             anlage
      INTO TABLE lt_ever
      FROM  ever
      WHERE vkonto  = lv_vkonto
      AND  auszdat GE sy-datum.
      IF sy-subrc  = 0.
        SORT lt_ever BY sparte ASCENDING.
        READ TABLE lt_ever INTO ls_ever WITH KEY sparte = lc_02 "Gas
                                                 BINARY SEARCH.
        IF  sy-subrc = 0 AND lines( lt_ever ) = 2.
          ev_is_combo_account = abap_true.
        ENDIF.
        " check whether it is smart meter
        LOOP AT lt_ever INTO ls_ever WHERE sparte = lc_01." Get Electric Installation
          EXIT.
        ENDLOOP.
        IF sy-subrc = 0.
          ev_is_smart_meter = zcl_cs_ami_utility=>is_installation_smartmeter( iv_installation = ls_ever-anlage ).
          ev_installation = ls_ever-anlage.
        ENDIF.
      ENDIF.

    ELSEIF ls_ediscdoc-refobjtype EQ text-001."INSTLN  "check Combo Account AND smart meter

      lv_anlage =  ls_ediscdoc-refobjkey.
      zcl_cs_ami_utility=>is_installation_comboaccount(
        EXPORTING
          iv_installation     =   lv_anlage
        IMPORTING
          v_is_combo          =  ev_is_combo_account ).

      ev_is_smart_meter   = zcl_cs_ami_utility=>is_installation_smartmeter( iv_installation =  lv_anlage ).
      ev_installation = lv_anlage.

    ELSEIF ls_ediscdoc-refobjtype EQ text-002."DEVICE

      lv_equnr = ls_ediscdoc-refobjkey.
      " Get installation from egerh  based on  table eastl by date and logiknr
      SELECT es~anlage FROM eastl AS es
      INNER JOIN egerh AS eg
      ON eg~logiknr = es~logiknr
      INTO lv_anlage
      WHERE eg~equnr  = lv_equnr
      AND ( eg~ab LE sy-datum AND eg~bis GE sy-datum )
      AND ( es~ab LE sy-datum AND es~bis GE sy-datum ).
      ENDSELECT.
      IF sy-subrc = 0.
        zcl_cs_ami_utility=>is_installation_comboaccount(
          EXPORTING
            iv_installation     =   lv_anlage
          IMPORTING
            v_is_combo          =   ev_is_combo_account ).

        ev_is_smart_meter   = zcl_cs_ami_utility=>is_installation_smartmeter( iv_installation =  lv_anlage ).
        ev_installation = lv_anlage.
      ENDIF.
    ENDIF.

    " Check Non-SNP process
    IF ls_ediscdoc-discprocv = lc_cust.
      ev_isnonsnp = abap_true.
    ENDIF.
  ENDIF.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CS_AMI_UTILITY->GET_DISCDOC_DETAILS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IM_DISC_DATA                   TYPE        TT_DISC_DATA
* | [<---] FINAL_DISC_DETAILS             TYPE        TT_DISC_DETAILS
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_discdoc_details.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Disconnection Details
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------

  TYPES:
      BEGIN OF t_contract_info,
        vkonto  TYPE vkont_kk,
        gpart   TYPE gpart_kk,
        vertrag TYPE vertrag,
        sparte  TYPE sparte,
        anlage  TYPE anlage,
      END OF t_contract_info,

      BEGIN OF t_equip_info,
        anlage  TYPE anlage,
        equnr   TYPE equnr,
        logiknr TYPE logiknr,
      END OF t_equip_info,

      BEGIN OF t_discon,
        discno     TYPE discno,
        discobj	   TYPE discobj,
        discobjtyp TYPE discobjtyp,
        anlage     TYPE anlage,
        logiknr	   TYPE logiknr,
        discstate	 TYPE discstate,
        discprocv	 TYPE discprocv,
        discreason TYPE discreason,
        status     TYPE edcdocstat,
        refobjtype TYPE edc_refobj,
        refobjkey	 TYPE edc_refkey,
      END OF t_discon.

  DATA:
    r_partner          TYPE RANGE OF gpart,
    r_vkont            TYPE RANGE OF vkont_kk,
    r_anlage           TYPE RANGE OF anlage,
    r_vertrag          TYPE RANGE OF vertrag,
    r_vstelle          TYPE RANGE OF vstelle,
    r_equnr            TYPE RANGE OF equnr,

    lt_contract_info   TYPE TABLE OF t_contract_info,
    lt_equip_info      TYPE TABLE OF t_equip_info,
    lt_devcapabilities TYPE tab_eami_smart_meter_capa,
    lt_discon          TYPE TABLE OF t_discon,

    ls_range_gpart     LIKE LINE OF r_partner,
    ls_range_vkont     LIKE LINE OF r_vkont,
    ls_range_anlage    LIKE LINE OF r_anlage,
    ls_range_contract  LIKE LINE OF r_vertrag,
    ls_range_premise   LIKE LINE OF r_vstelle,
    ls_range_equnr     LIKE LINE OF r_equnr,
*    ls_amcg            TYPE e_ami_amcg_cap_grp,
    ls_disc_data       TYPE emg_ddc_header,
    ls_contract_info   TYPE t_contract_info,
    ls_equip_info      TYPE t_equip_info,
    ls_disc_details    TYPE zbi_disconnection_details,
    ls_discon          TYPE t_discon.

  CLEAR: ls_discon,ls_disc_details,ls_equip_info,ls_contract_info,
         ls_disc_data,ls_range_equnr,ls_range_premise,
         ls_range_contract,ls_range_anlage,ls_range_vkont,ls_range_gpart,
         lt_discon,lt_devcapabilities,lt_equip_info,lt_contract_info,
         r_partner,r_vkont,r_anlage,r_vertrag,r_vstelle,r_equnr.

  CONSTANTS :
    lc_i     TYPE c VALUE 'I',
    lc_eq(2) TYPE c VALUE 'EQ',
    lc_00    TYPE edcdocstat VALUE '00',
    lc_20    TYPE edcdocstat VALUE '20',
    lc_21    TYPE edcdocstat VALUE '21',
    lc_22    TYPE edcdocstat VALUE '22',
    lc_1     TYPE e_ami_capabilities VALUE 1,
    lc_2     TYPE e_ami_capabilities VALUE 2.


  LOOP AT im_disc_data INTO ls_disc_data.
    IF ls_disc_data-refobjtype EQ text-004."ISUPARTNER
      ls_range_gpart-sign    = lc_i.
      ls_range_gpart-option  = lc_eq.
      ls_range_gpart-low     = ls_disc_data-refobjkey.
      APPEND ls_range_gpart TO r_partner.
    ELSEIF ls_disc_data-refobjtype EQ text-003."ISUACCOUNT
      ls_range_vkont-sign    = lc_i.
      ls_range_vkont-option  = lc_eq.
      ls_range_vkont-low     = ls_disc_data-refobjkey.
      APPEND ls_range_vkont TO r_vkont.
    ELSEIF ls_disc_data-refobjtype EQ  text-005."PREMISE
      ls_range_premise-sign    = lc_i.
      ls_range_premise-option  = lc_eq.
      ls_range_premise-low     = ls_disc_data-refobjkey.
      APPEND ls_range_premise TO r_vstelle.
    ELSEIF ls_disc_data-refobjtype EQ text-001."INSTLN
      ls_range_anlage-sign    = lc_i.
      ls_range_anlage-option  = lc_eq.
      ls_range_anlage-low     = ls_disc_data-refobjkey.
      APPEND ls_range_anlage TO r_anlage.
    ELSEIF ls_disc_data-refobjtype EQ text-006."CONTRACT'
      ls_range_contract-sign    = lc_i.
      ls_range_contract-option  = lc_eq.
      ls_range_contract-low     = ls_disc_data-refobjkey.
      APPEND ls_range_contract TO r_vertrag.
    ELSEIF ls_disc_data-refobjtype EQ text-002."DEVICE
      ls_range_equnr-sign    = lc_i.
      ls_range_equnr-option  = lc_eq.
      ls_range_equnr-low     = ls_disc_data-refobjkey.
      APPEND ls_range_equnr TO r_equnr.
    ENDIF.
  ENDLOOP.

  IF  r_vstelle IS NOT INITIAL
    OR r_equnr IS NOT INITIAL
    OR r_anlage IS NOT INITIAL.

    SELECT ea~anlage
           eg~equnr
           eg~logiknr
           FROM eanl AS ea
           INNER JOIN eastl AS es ON es~anlage = ea~anlage
           INNER JOIN egerh AS eg ON eg~logiknr = es~logiknr
           INTO TABLE lt_equip_info
           WHERE ea~anlage  IN r_anlage
             AND ea~vstelle IN r_vstelle
             AND eg~equnr   IN r_equnr
                AND ( eg~ab LE sy-datum AND eg~bis GE sy-datum )
                AND ( es~ab LE sy-datum AND es~bis GE sy-datum ).

  ENDIF.

*  IF sy-subrc EQ 0 AND ( lt_equip_info IS NOT INITIAL ) AND
*       ( r_anlage IS  INITIAL ).
    LOOP AT lt_equip_info INTO ls_equip_info.
      ls_range_anlage-sign    = lc_i.
      ls_range_anlage-option  = lc_eq.
      ls_range_anlage-low     = ls_equip_info-anlage.
      APPEND  ls_range_anlage TO r_anlage.
    ENDLOOP.
*  ENDIF.

  IF r_partner IS NOT INITIAL OR r_vkont IS NOT INITIAL
    OR r_vertrag IS NOT INITIAL OR r_anlage IS NOT INITIAL.
    SELECT fk~vkont
           fk~gpart
           ev~vertrag
           ev~sparte
           ev~anlage
           FROM fkkvkp AS fk
           INNER JOIN ever AS ev
           ON ev~vkonto = fk~vkont
           INTO TABLE lt_contract_info
           WHERE fk~vkont    IN r_vkont
             AND fk~gpart    IN r_partner
             AND ev~vertrag  IN r_vertrag
             AND ev~anlage   IN r_anlage
             AND  ev~auszdat GE sy-datum.
  ENDIF.

  IF sy-subrc EQ 0 AND ( lt_equip_info IS INITIAL ) AND ( r_anlage IS INITIAL ).
    LOOP AT lt_contract_info INTO ls_contract_info.
      ls_range_anlage-sign    = lc_i.
      ls_range_anlage-option  = lc_eq.
      ls_range_anlage-low     = ls_contract_info-anlage.
      APPEND  ls_range_anlage TO r_anlage.
    ENDLOOP.

    SELECT ea~anlage
           eg~equnr
           eg~logiknr
           FROM eanl AS ea
           INNER JOIN eastl AS es ON es~anlage = ea~anlage
           INNER JOIN egerh AS eg ON eg~logiknr = es~logiknr
           INTO TABLE lt_equip_info
           WHERE ea~anlage IN r_anlage
           AND ( eg~ab LE sy-datum AND eg~bis GE sy-datum )
           AND ( es~ab LE sy-datum AND es~bis GE sy-datum ).

  ENDIF.
*  IF ( sy-subrc EQ 0 ) OR ( lt_equip_info IS NOT INITIAL ).
  IF lt_equip_info IS NOT INITIAL.

    SELECT o~discno o~discobj o~discobjtyp
           o~anlage o~logiknr o~discstate
           d~discprocv d~discreason d~status
           d~refobjtype d~refobjkey
      FROM ediscobj AS o
      INNER JOIN ediscdoc AS d
      ON d~discno = o~discno
      INTO TABLE lt_discon
      FOR ALL ENTRIES IN lt_equip_info
      WHERE o~logiknr = lt_equip_info-logiknr
        AND ( d~status  = lc_00
         OR   d~status  = lc_20
         OR   d~status  = lc_21
         OR   d~status  = lc_22 ).
  ENDIF.

  IF sy-subrc NE 0.
    CLEAR : lt_discon.
  ENDIF.

  LOOP AT lt_equip_info INTO ls_equip_info.
    SORT lt_contract_info BY anlage ASCENDING.
    READ TABLE lt_contract_info INTO ls_contract_info
                                WITH KEY anlage = ls_equip_info-anlage
                                BINARY SEARCH.

    SORT lt_discon BY logiknr ASCENDING.
    READ TABLE lt_discon INTO ls_discon WITH KEY logiknr = ls_equip_info-logiknr
                                                           BINARY SEARCH.
    IF sy-subrc = 0.
      ls_disc_details-discno       = ls_discon-discno.
      ls_disc_details-discprocv    = ls_discon-discprocv.
      ls_disc_details-discreason   = ls_discon-discreason.
      ls_disc_details-disc_status  = ls_discon-status.
      ls_disc_details-refobjtype   = ls_discon-refobjtype.
      ls_disc_details-refobjkey    = ls_discon-refobjkey.
    ENDIF.
    ls_disc_details-partner = ls_contract_info-gpart.
    ls_disc_details-vkonto  = ls_contract_info-vkonto.
    ls_disc_details-anlage  = ls_equip_info-anlage.
    ls_disc_details-equnr   = ls_equip_info-equnr.
    ls_disc_details-vertrag = ls_contract_info-vertrag.
    ls_disc_details-sparte  = ls_contract_info-sparte.

    CALL METHOD cl_isu_ami_dm_manager=>determine_ami_relevant_data
      EXPORTING
        x_equnr             = ls_equip_info-equnr
      IMPORTING
*       y_amcg_cap_grp      = ls_amcg
        yt_ami_capabilities = lt_devcapabilities.

    LOOP AT lt_devcapabilities TRANSPORTING NO FIELDS  WHERE ( capabilities = lc_1 OR capabilities = lc_2 )
                                                         AND   ams_relevant = abap_true AND amcg_relevant = abap_true.
      EXIT.
    ENDLOOP.
    IF sy-subrc EQ 0.
      ls_disc_details-smart_meter = abap_true.
    ENDIF.
    APPEND ls_disc_details TO final_disc_details.
  ENDLOOP.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>GET_GAS_DISCNO
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_VKONTO                      TYPE        VKONT_KK
* | [--->] IT_CONTRACTS                   TYPE        ISU_EVER_TAB(optional)
* | [<-()] RV_DISCNO                      TYPE        DISCNO
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_gas_discno.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Get the gas disconnection document number
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------
  DATA :
    lv_logiknr  TYPE logiknr,
    lv_discno   TYPE discno,
    lt_ever     TYPE isu_ever_tab,
    lw_ever     TYPE ever.

  CONSTANTS:
    lc_bis      TYPE dats      VALUE '99991231',
    lc_01       TYPE discstate VALUE '01',
    lc_02       TYPE sparte    VALUE '02'.

  CLEAR : lt_ever.

  IF ( it_contracts IS INITIAL ) AND ( NOT iv_vkonto IS INITIAL ).
    " Fetch divisions for contract account.
    SELECT *
       INTO TABLE lt_ever
       FROM  ever
       WHERE vkonto  = iv_vkonto
       AND  auszdat GE sy-datum.

    IF sy-subrc NE 0.
      CLEAR : lt_ever.
    ENDIF.
  ELSE.
    lt_ever = it_contracts.
  ENDIF.

  IF ( sy-subrc EQ 0 ) AND ( lt_ever IS NOT INITIAL ).
    SORT lt_ever BY sparte ASCENDING.
    " Check Gas meter is there and 2 installtions are existing for the contract account
    READ TABLE lt_ever INTO lw_ever WITH KEY sparte = lc_02 BINARY SEARCH. "Gas
    IF ( sy-subrc = 0 ) AND lines( lt_ever ) GE 2.
      "select Latest logical No of te installation
      SELECT  logiknr FROM eastl
                      INTO lv_logiknr
                      WHERE anlage = lw_ever-anlage
                      AND   bis    = lc_bis.
      ENDSELECT.
      IF sy-subrc EQ 0.
        "retrieve the diconnection document of Gas
        SELECT discno FROM v_ediscobj
                      INTO lv_discno
                      WHERE logiknr = lv_logiknr
                      AND bis       = lc_bis.
        ENDSELECT.
      ENDIF.
      IF sy-subrc EQ 0.
        rv_discno = lv_discno.
      ENDIF.
    ENDIF.
  ENDIF.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>GET_NONSNP_ORDERCODE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PROCESS                     TYPE        CHAR10
* | [--->] IV_DISCTYPE                    TYPE        ZDISCTYPE
* | [--->] IV_DIVISION                    TYPE        SPARTE
* | [--->] IV_IS_COMBO                    TYPE        FLAG (default =SPACE)
* | [<-()] RV_ORDER_CODE                  TYPE        ORDER_CODE
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_nonsnp_ordercode.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Get Non-SNP Order Code
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------

  "calling BRF PLUS Decisin table to retrieve the Order Code
  CONSTANTS:
    lc_func_id     TYPE if_fdt_types=>id VALUE '68B5999264261EE499D54BBBBA65830E',

    lc_input1       TYPE char30   VALUE  'V_PROCESS',
    lc_input2       TYPE char30   VALUE  'V_IS_COMBO',
    lc_input3       TYPE char30   VALUE  'V_DISCTYPE',
    lc_input4       TYPE char30   VALUE  'V_DIVISION'.

  DATA:
    loref_function TYPE REF TO if_fdt_function,
    loref_context  TYPE REF TO if_fdt_context,
    loref_fdt      TYPE REF TO cx_fdt,
    lv_text        TYPE string,
    loref_result   TYPE REF TO if_fdt_result.

  cl_fdt_factory=>destruct_object( ).
  cl_fdt_factory=>clear_buffers( ).

  loref_function = cl_fdt_factory=>if_fdt_factory~get_instance( )->get_function( lc_func_id ).
  loref_context  = loref_function->get_process_context( ).

  loref_context->set_value( iv_name  =  lc_input1
                            ia_value =  iv_process  ).

  loref_context->set_value( iv_name =   lc_input2
                            ia_value =  iv_is_combo ).

  loref_context->set_value( iv_name  =  lc_input3
                            ia_value =  iv_disctype ).

  loref_context->set_value( iv_name  =  lc_input4
                            ia_value =  iv_division ).

  TRY.
*   Now let us call the function
      loref_function->process( EXPORTING io_context = loref_context
                               IMPORTING eo_result  = loref_result ).
    CATCH cx_fdt INTO loref_fdt.
      CLEAR : lv_text.
      lv_text = loref_fdt->if_message~get_text( ).
  ENDTRY.


  loref_result->get_value( IMPORTING ea_value =  rv_order_code ).


ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>IS_DISDOC_NONSNP
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DISCNO                      TYPE        DISCNO
* | [<-()] RV_IS_NONSNP                   TYPE        FLAG
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD is_disdoc_nonsnp.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Check Disconnection Document is Non-SNP
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------
  TYPES : BEGIN OF ty_ediscdoc,
            discprocv TYPE discprocv,
            discreason TYPE discreason,
          END OF ty_ediscdoc.

  DATA: ls_ediscdoc TYPE ty_ediscdoc.
  CLEAR  :ls_ediscdoc.

  "calling BRF PLUS descision Table
  CONSTANTS:
    lc_func_id     TYPE if_fdt_types=>id VALUE '68B5999264261EE499D5487CBC5E4314',
    lc_active      TYPE char30           VALUE 'V_ACTIVE',
    lc_99          TYPE edcdocstat       VALUE '99',
    lc_non_snp     TYPE char10           VALUE 'NON_SNP',
    lc_input1      TYPE char30           VALUE 'V_DISCDOC_REASON',
    lc_input2      TYPE char30           VALUE 'V_DISCDOC_VARIANT'.

  DATA:
    loref_function TYPE REF TO if_fdt_function,
    loref_context  TYPE REF TO if_fdt_context,
    loref_fdt      TYPE REF TO cx_fdt,
    lv_text        TYPE string,
    loref_result   TYPE REF TO if_fdt_result,
    lv_process     TYPE char10.


  "retrieve Duconnection document data
  SELECT discprocv
          discreason
    FROM ediscdoc
    INTO ls_ediscdoc
    WHERE discno = iv_discno
      AND status <> lc_99.
  ENDSELECT.

  IF sy-subrc EQ 0 .

    cl_fdt_factory=>destruct_object( ).
*    cl_fdt_factory=>clear_buffers( ).

    loref_function = cl_fdt_factory=>if_fdt_factory~get_instance( )->get_function( lc_func_id ).
    loref_context  = loref_function->get_process_context( ).

    loref_context->set_value( iv_name  =  lc_active
                              ia_value =  abap_true ).

    loref_context->set_value( iv_name  = lc_input1
                              ia_value = ls_ediscdoc-discreason ).

    loref_context->set_value( iv_name  = lc_input2
                              ia_value = ls_ediscdoc-discprocv ).


    TRY.
*   Now let us call the  BRF Plus function
        loref_function->process( EXPORTING io_context = loref_context
                                 IMPORTING eo_result  = loref_result ).

      CATCH cx_fdt INTO loref_fdt.
        CLEAR : lv_text.
        lv_text = loref_fdt->if_message~get_text( ).
    ENDTRY.


    loref_result->get_value( IMPORTING ea_value =  lv_process ).

    IF lv_process = lc_non_snp.
      rv_is_nonsnp = abap_true.
    ENDIF.
  ENDIF.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>IS_INSTALLATION_COMBOACCOUNT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_INSTALLATION                TYPE        ANLAGE
* | [<---] V_IS_COMBO                     TYPE        FDT_BOOLEAN
* | [<---] EX_CONTRACTS                   TYPE        ISU_EVER_TAB
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD is_installation_comboaccount.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Check Installation is a Combo Account
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------

  DATA :
   lv_vkonto       TYPE vkont_kk.

  CONSTANTS :
      lc_02 TYPE sparte VALUE '02'.

  CLEAR : lv_vkonto.

  " Fetch contract account from instalaltion
  SELECT  vkonto
    INTO lv_vkonto
    FROM  ever
    WHERE anlage  = iv_installation
      AND auszdat  GE sy-datum.
  ENDSELECT.

  IF sy-subrc EQ 0.
    " Fetch divisions for contract account.
    SELECT * INTO TABLE ex_contracts
     FROM  ever
     WHERE vkonto  = lv_vkonto
      AND  auszdat GE sy-datum.
    IF sy-subrc EQ 0 .
      " Check Gas meter is there and 2 installtions are existing for the contract account
      SORT ex_contracts BY sparte ASCENDING.
      READ TABLE ex_contracts WITH KEY sparte = lc_02 TRANSPORTING NO FIELDS "Gas
                                                       BINARY SEARCH.
      IF ( sy-subrc = 0 ) AND lines( ex_contracts ) GE 2.
        v_is_combo = abap_true.
      ENDIF.
    ENDIF.
  ENDIF.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>IS_INSTALLATION_SMARTMETER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_INSTALLATION                TYPE        ANLAGE(optional)
* | [<-()] RV_HAS_SMART_METER             TYPE        BOOLEAN
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD is_installation_smartmeter.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Check Installation is a Smart Meter
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------

  DATA:
    li_devcapabilities TYPE tab_eami_smart_meter_capa,
    ls_equnr           TYPE equnr.
*    ls_amcg            TYPE e_ami_amcg_cap_grp,

  CLEAR : li_devcapabilities,ls_equnr.

  CONSTANTS : co_flag   TYPE c VALUE 'X',
              co_value1 TYPE n VALUE '1',
              co_value2 TYPE n VALUE '2',
              co_value3 TYPE n VALUE '3'.

  IF NOT iv_installation IS INITIAL.
    " Get the EQUNR from egerh  based on  table eastl by date and logiknr
    SELECT eg~equnr
       FROM eastl AS es
        INNER JOIN egerh AS eg
         ON eg~logiknr = es~logiknr
       INTO ls_equnr
        WHERE anlage = iv_installation
        AND ( eg~ab LE sy-datum AND eg~bis GE sy-datum )
        AND ( es~ab LE sy-datum AND es~bis GE sy-datum ).
    ENDSELECT.
  ENDIF.

  IF sy-subrc EQ 0.
    "Check  meter is smart meter or not
    CALL METHOD cl_isu_ami_dm_manager=>determine_ami_relevant_data
      EXPORTING
        x_equnr             = ls_equnr
      IMPORTING
*       y_amcg_cap_grp      = ls_amcg
        yt_ami_capabilities = li_devcapabilities.

    LOOP AT li_devcapabilities TRANSPORTING NO FIELDS WHERE ( capabilities = co_value1    "Remote Disconnection
                                                           OR capabilities = co_value2    "Remote Reconnection
                                                           OR capabilities = co_value3  ) "Remote Meter Reading
                                                         AND   ams_relevant = co_flag AND amcg_relevant = co_flag.
      EXIT.
    ENDLOOP.
    IF sy-subrc EQ 0.
      rv_has_smart_meter = co_flag.
*      EXIT.
    ENDIF.
  ENDIF.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>WRITE_EMMA_MESSAGE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_OBJECT                      TYPE        BALOBJ_D
* | [--->] IV_SUBOBJECT                   TYPE        BALSUBOBJ
* | [--->] IV_OPERATION                   TYPE        EMMA_PROC_LOGOP
* | [--->] IV_BPAREA                      TYPE        EMMA_BPAREA
* | [--->] IV_BPCODE                      TYPE        EMMA_BPCODE
* | [--->] IV_TCODE                       TYPE        TCODE
* | [--->] IV_OBJTYPE                     TYPE        SWO_OBJTYP
* | [--->] IV_OBJKEY                      TYPE        CHAR10
* | [--->] IV_MSGTY                       TYPE        SYMSGTY
* | [--->] IV_MSGID                       TYPE        SYMSGID
* | [--->] IV_MSGNO                       TYPE        SYMSGNO
* | [--->] IV_MSGV1                       TYPE        SYMSGV(optional)
* | [--->] IV_MSGV2                       TYPE        SYMSGV(optional)
* | [--->] IV_MSGV3                       TYPE        SYMSGV(optional)
* | [--->] IV_MSGV4                       TYPE        SYMSGV(optional)
* | [--->] IT_MESSAGES                    TYPE        ZBPEM_LOG_MESSAGE_TAB(optional)
* | [<-()] RV_IS_SUCCESS                  TYPE        FLAG
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD write_emma_message.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          : Write BPEM message
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------

  DATA :  l_log_handle   TYPE bal_s_lgnm-log_handle,
          ls_log_info    TYPE emma_proc_log_open.

  FIELD-SYMBOLS : <fs_message> TYPE zbpem_log_message.

  ls_log_info-object    = iv_object.
  ls_log_info-subobject = iv_subobject.
  ls_log_info-operation = iv_operation.

  "Start EMMA start

  CALL FUNCTION 'EMMA_LOG_PROCESS_START'
    EXPORTING
      iv_bparea                      = iv_bparea
      iv_bpcode                      = iv_bpcode
      iv_tcode                       = iv_tcode
      iv_main_bus_objtype            = iv_objtype
      iv_main_bus_objkey             = iv_objkey
      is_log_info                    = ls_log_info
      iv_runmode                     = '1'
    IMPORTING
      ev_log_handle                  = l_log_handle
    EXCEPTIONS
      bparea_not_found               = 1
      bparea_meas_inactive           = 2
      bpcode_not_found               = 3
      logobject_subobject_not_specif = 4
      system_error                   = 5
      OTHERS                         = 6.

  CHECK sy-subrc = 0.
  " in case of single messages
  IF it_messages IS INITIAL.

    CALL FUNCTION 'EMMA_LOG_PROCESS_MSG_WRITE'
      EXPORTING
        iv_bparea            = iv_bparea
        iv_bpcode            = iv_bpcode
        iv_tcode             = iv_tcode
        iv_log_handle        = l_log_handle
        iv_msgty             = iv_msgty
        iv_msgid             = iv_msgid
        iv_msgno             = iv_msgno
        iv_msgv1             = iv_msgv1
        iv_msgv2             = iv_msgv2
        iv_msgv3             = iv_msgv3
        iv_msgv4             = iv_msgv4
        iv_force_msg         = 'X'
      EXCEPTIONS
        bparea_not_found     = 1
        bparea_meas_inactive = 2
        bpcode_not_found     = 3
        system_error         = 4
        OTHERS               = 5.

    "in case of multiple message
  ELSEIF it_messages IS NOT INITIAL.
    LOOP AT it_messages ASSIGNING <fs_message>.

      CALL FUNCTION 'EMMA_LOG_PROCESS_MSG_WRITE'
        EXPORTING
          iv_bparea            = iv_bparea
          iv_bpcode            = iv_bpcode
          iv_tcode             = iv_tcode
          iv_log_handle        = l_log_handle
          iv_msgty             = iv_msgty
          iv_msgid             = iv_msgid
          iv_msgno             = iv_msgno
          iv_msgv1             = <fs_message>-msgv1
          iv_msgv2             = <fs_message>-msgv2
          iv_msgv3             = <fs_message>-msgv3
          iv_msgv4             = <fs_message>-msgv4
          iv_force_msg         = 'X'
        EXCEPTIONS
          bparea_not_found     = 1
          bparea_meas_inactive = 2
          bpcode_not_found     = 3
          system_error         = 4
          OTHERS               = 5.

    ENDLOOP.

  ENDIF.

  IF sy-subrc = 0.

    "End EMMA log
    CALL FUNCTION 'EMMA_LOG_PROCESS_END'
      EXPORTING
        iv_bparea            = iv_bparea
        iv_bpcode            = iv_bpcode
        iv_tcode             = iv_tcode
        iv_main_bus_objtype  = iv_objtype
        iv_main_bus_objkey   = iv_objkey
        iv_log_handle        = l_log_handle
      EXCEPTIONS
        bparea_not_found     = 1
        bparea_meas_inactive = 2
        bpcode_not_found     = 3
        system_error         = 4
        OTHERS               = 5.

  ENDIF.

  IF sy-subrc EQ 0.
    rv_is_success = abap_true.
  ENDIF.


ENDMETHOD.
ENDCLASS.
