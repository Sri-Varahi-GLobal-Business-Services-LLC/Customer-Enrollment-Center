        OTHERS         = 6.
    IF ( sy-subrc = 0 ) AND ( NOT ls_ediscdoc IS INITIAL ).

      IF im_refobjtype EQ  text-001."'INSTLN'.

        IF NOT me->discon_details IS INITIAL.

          SORT discon_details BY anlage ASCENDING.
          READ TABLE me->discon_details ASSIGNING  <lf_discon_data>
                                        WITH KEY anlage = im_refobjkey
                                        BINARY SEARCH.
          IF sy-subrc = 0.
            <lf_discon_data>-discno = ls_ediscdoc-discno.
            <lf_discon_data>-discprocv  = im_refobjtype.
            <lf_discon_data>-discreason = im_discon_reason.
            <lf_discon_data>-refobjtype = im_refobjtype.
            <lf_discon_data>-refobjkey  = im_refobjkey.
          ENDIF.
        ELSE.
          me->discon_data-discno     = ls_ediscdoc-discno.
          me->discon_data-discprocv  = im_refobjtype.
          me->discon_data-discreason = im_discon_reason.
          me->discon_data-refobjtype = im_refobjtype.
          me->discon_data-refobjkey  = im_refobjkey.
        ENDIF.
      ENDIF.

      lv_discno = ls_ediscdoc-discno.
    ENDIF.
  ELSE.
    lv_discno = im_discno.
  ENDIF.


  IF NOT lv_discno IS INITIAL.
    lv_objtype = text-007."'DISCONNECT'
    lv_objkey  = lv_discno .

    swc_create_object lr_disconnect lv_objtype lv_objkey.
    swc_container container.

    swc_clear_container container.
    swc_set_element container lc_disconactivitydate im_disc_act_date.
    IF sy-subrc = 0.
      swc_set_element container lc_disconactivitytime im_disc_act_time.
    ENDIF.
    IF  sy-subrc = 0.
      swc_call_method lr_disconnect 'DarkCreateOfDcorder' container.
    ENDIF.
    swc_get_element container lc_disconnectactivity ex_discact.
    CHECK sy-subrc EQ 0.
  ENDIF.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>CREATE_NONSNP_SERVICEORDER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DISCDOC                     TYPE        DISCNO(optional)
* | [--->] IV_ANLAGE                      TYPE        ANLAGE(optional)
* | [--->] IV_NOTE                        TYPE        CHAR200(optional)
* | [--->] IV_EQUNR                       TYPE        EQUNR(optional)
* | [--->] IV_TYPE                        TYPE        CHAR10(optional)
* | [--->] IV_PROCESS                     TYPE        CHAR10
* | [--->] IV_VKONT                       TYPE        VKONT_KK(optional)
* | [<-()] RV_SUCCESS                     TYPE        FLAG
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD create_nonsnp_serviceorder.
*&
* Name              : Utility Class for AMI Customer Service
* Author            : Riyas/Vinay
* Date              : 11/04/2014
* FRICE ID          : CS_ENH_RTF_014
* Type of Program   : Method
* Development Class : ZCC_ENH
*  Purpose          :Create NON-SNP Service Order
*----------------------------------------------------------------------
* Modification Log                Place latest at top :
*----------------------------------------------------------------------
* Author      Date        Change Req#   Task #          Change Driver
*----------------------------------------------------------------------
* Riyas    11/04/2014     E2DK934883     Initial      *
*----------------------------------------------------------------------
*&---------------------------------------------------------------------
  CONSTANTS:
    lc_01 TYPE discobjtyp VALUE '01',
    lc_03 TYPE discacttyp VALUE '03',
    lc_10 TYPE edc_ordstat VALUE '10'.

  DATA:
    lt_contracts  TYPE isu_ever_tab,
    lt_messages   TYPE bal_t_msg,
    lt_v_ediscpos TYPE STANDARD TABLE OF v_ediscpos,

    ls_return     TYPE bapiret2,
    ls_v_ediscpos TYPE v_ediscpos,
    ls_ediscact   TYPE ediscact,
    ls_viaufkst   TYPE bapi_alm_order_header_e,

    lv_combo_acct TYPE boolean,
    lv_nonsnp     TYPE flag,
    lv_anlage     TYPE anlage,
    lv_discno     TYPE discno,
    iv_order_code TYPE order_code,
    lv_sparte     TYPE sparte,
    lv_comboacct  TYPE flag.

*  DATA: lv_x TYPE c.
*  DO.
*    IF lv_x = 'X'.
*      EXIT.
*    ENDIF.
*  ENDDO.

  "Get Division from installation
  SELECT sparte
    FROM eanl
    INTO lv_sparte
    WHERE anlage = iv_anlage.
  ENDSELECT.
  IF sy-subrc = 0.
*  check for comboaccount
    is_installation_comboaccount(
      EXPORTING
        iv_installation     =  iv_anlage
      IMPORTING
        v_is_combo          =  lv_comboacct
        ex_contracts        =  lt_contracts ).

*   Check for Snp or NonSnp flag
    iv_order_code =  get_nonsnp_ordercode( iv_process     = iv_process
                                           iv_disctype    = iv_type
                                           iv_division    = lv_sparte
                                           iv_is_combo    = lv_comboacct ).

* Get Gas service order when contract account is a combo account
    IF lv_comboacct EQ abap_true.
*  check if it is NON SNP scenario
      lv_nonsnp = zcl_cs_ami_utility=>is_disdoc_nonsnp( iv_discdoc ).

*      IF lv_nonsnp = abap_true.
*    get the gas discno
        lv_discno = zcl_cs_ami_utility=>get_gas_discno(  iv_vkonto    = iv_vkont
                                                         it_contracts = lt_contracts ).
        IF NOT lv_discno IS INITIAL.
          SELECT *
            INTO TABLE lt_v_ediscpos
            FROM v_ediscpos
            WHERE discno     = lv_discno
              AND discobjtyp = lc_01 .   "Device
          IF sy-subrc = 0.
            SORT lt_v_ediscpos DESCENDING BY discact.

            READ TABLE lt_v_ediscpos INTO ls_v_ediscpos INDEX 1.
            IF sy-subrc = 0.
              SELECT SINGLE *
                FROM ediscact
                INTO ls_ediscact
               WHERE discno      =  ls_v_ediscpos-discno
                 AND discact     =  ls_v_ediscpos-discact
                 AND discacttyp  =  lc_03
                 AND ordstate    NE lc_10
                 AND disccanceld NE abap_true
                 AND ordernum    NE space.
              IF sy-subrc = 0.
                CALL FUNCTION 'IBAPI_ALM_ORDERHEAD_READ'
                  EXPORTING
                    iv_orderid         = ls_ediscact-ordernum
                    iv_ltext_requested = abap_false
                  IMPORTING
                    es_header          = ls_viaufkst
                  TABLES
                    et_messages        = lt_messages.
                READ TABLE lt_messages WITH KEY msgty = 'E'
                  TRANSPORTING NO FIELDS.
                IF sy-subrc <> 0.
                  IF ls_viaufkst-pmacttype = 'TON'.
                    iv_order_code = 'ZTNE'.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
*      ENDIF.
    ENDIF.

    "creta Sevice order.
    CALL FUNCTION 'Z_ISU_DISCDOC_SERVICE_ORDER'
      EXPORTING
        i_disconndocnumber   = iv_discdoc
        i_anlage             = iv_anlage
        i_order_code         = iv_order_code
        i_equnr              = iv_equnr
        i_note               = iv_note
        i_vkont              = iv_vkont
        i_process            = iv_type
      EXCEPTIONS
        cant_create_job      = 1
        invalid_job_data     = 2
        jobname_missing      = 3
        cant_start_immediate = 4
        invalid_startdate    = 5
        job_close_failed     = 6
        job_nosteps          = 7
        lock_failed          = 8
        job_notex            = 9
        OTHERS               = 10.

    IF sy-subrc = 0.
      rv_success  = abap_true.
    ENDIF.
  ENDIF.
ENDMETHOD.


