* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Static Public Method ZCL_CS_AMI_UTILITY=>CHECK_BP_CURRENT_OCCUPANT
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_DISCNO                       TYPE        DISCNO(optional)
* | [--->] I_ANLAGE                       TYPE        ANLAGE
* | [--->] I_EQUNR                        TYPE        EQUNR(optional)
* | [<-()] E_CURRENT_OCCUPANT             TYPE        BOOLEAN
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD check_bp_current_occupant.

  CONSTANTS:
    c_current_occupant TYPE but000-name_first VALUE 'CURRENT OCCUPANT'.

  DATA:
     lv_name_first  TYPE but000-name_first,

     lwa_ever       TYPE ever,
     lwa_fkkvkp     TYPE fkkvkp.

  SELECT SINGLE * FROM ever
    INTO lwa_ever
    WHERE anlage = i_anlage
      AND einzdat LE sy-datum
      AND auszdat GE sy-datum.
  IF sy-subrc = 0.
    SELECT SINGLE * FROM fkkvkp
      INTO lwa_fkkvkp
      WHERE vkont = lwa_ever-vkonto.
    IF sy-subrc = 0.
      SELECT SINGLE name_first
        INTO lv_name_first
        FROM but000
       WHERE partner = lwa_fkkvkp-gpart
         AND name_first = c_current_occupant.
      IF sy-subrc = 0.
        e_current_occupant = abap_true.
      ENDIF.
    ENDIF.
  ENDIF.
ENDMETHOD.


